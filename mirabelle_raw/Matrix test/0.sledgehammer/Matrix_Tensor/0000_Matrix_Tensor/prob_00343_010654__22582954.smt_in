; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 279
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort B_set$ 0)
(declare-sort B_list$ 0)
(declare-fun a$ () B$)
(declare-fun m$ () B_list$)
(declare-fun x$ () B$)
(declare-fun set$ (B_list$) B_set$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun member$ (B$ B_set$) Bool)
(assert (! (not (or (= x$ a$) (member$ x$ (set$ m$)))) :named conjecture0))
(assert (! (member$ x$ (set$ (cons$ a$ m$))) :named a1))
(check-sat)
(get-proof)
