; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 361
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun m$ () Nat$)
(declare-fun n$ () Nat$)
(declare-fun m1$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (minus$ (times$ (plus$ (times$ m1$ b$) m$) c$) (times$ n$ c$)) (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (plus$ (times$ (plus$ (times$ m1$ b$) m$) c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)) (plus$ (times$ n$ c$) (modulo$ a$ c$))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= ?v0 (plus$ (times$ (divide$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v0) ?v1)) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (times$ ?v0 ?v1) ?v1) zero$)) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ (times$ ?v0 ?v1) ?v2) ?v1) (modulo$ ?v2 ?v1))) :named a5))
(assert (! (forall ((?v0 Nat$)) (= ?v0 (plus$ ?v0 zero$))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v1) ?v0)) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (modulo$ ?v0 ?v1) ?v0) (= (divide$ ?v0 ?v1) zero$))) :named a8))
(check-sat)
(get-proof)
