; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 265
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun x$ () A$)
(declare-fun ws$ () A_list$)
(declare-fun xs$ () A_list$)
(declare-fun ys$ () A_list$)
(declare-fun zs$ () A_list$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun xss$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(assert (! (not (exists ((?v0 A$) (?v1 A_list$)) (and (= ys$ (cons$ ?v0 ?v1)) (= (size$ ?v1) k$)))) :named conjecture0))
(assert (! (and (= (size$ zs$) (size$ ws$)) (and (= (size$ xs$) (size$ ys$)) (= (size$ xs$) (suc$ k$)))) :named a1))
(assert (! (and (= xs$ (cons$ x$ xss$)) (= (size$ xss$) k$)) :named a2))
(check-sat)
(get-proof)
