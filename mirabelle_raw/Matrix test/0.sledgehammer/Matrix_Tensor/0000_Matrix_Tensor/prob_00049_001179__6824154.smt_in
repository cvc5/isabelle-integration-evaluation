; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 237
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A$)
(declare-fun id$ () A$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun nil$a () A_list_list_list_list$)
(declare-fun nil$b () A_list_list_list$)
(declare-fun nil$c () A_list_list$)
(declare-fun times$ (A_a_a_fun_fun$ A$) A_list_a_list_fun$)
(declare-fun concat$ (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$a (A_list_list_list$) A_list_list$)
(declare-fun concat$b (A_list_list$) A_list$)
(declare-fun fun_app$ (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun fun_app$a (A_a_fun$ A$) A$)
(declare-fun fun_app$b (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (not (= (fun_app$ (times$ f$ v$) (cons$ id$ nil$)) (cons$ v$ nil$))) :named conjecture0))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$ (times$ f$ ?v0) nil$) nil$) :pattern ((times$ f$ ?v0)))) :named a1))
(assert (! (forall ((?v0 A$)) (= (fun_app$a (fun_app$b f$ ?v0) id$) ?v0)) :named a2))
(assert (! (= (concat$ nil$a) nil$b) :named a3))
(assert (! (= (concat$a nil$b) nil$c) :named a4))
(assert (! (= (concat$b nil$c) nil$) :named a5))
(check-sat)
(get-proof)
