; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun y$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (size$ (vec_vec_Tensor$ f$ nil$ y$)) zero$)) :named conjecture0))
(assert (! (forall ((?v0 A_list$)) (! (= (vec_vec_Tensor$ f$ nil$ ?v0) nil$) :pattern ((vec_vec_Tensor$ f$ nil$ ?v0)))) :named a1))
(assert (! (= (size$ nil$) zero$) :named a2))
(check-sat)
(get-proof)
