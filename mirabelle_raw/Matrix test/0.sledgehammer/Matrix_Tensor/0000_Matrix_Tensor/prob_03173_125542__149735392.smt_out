unsat
(assume conjecture15 (! (not (! (fun_app$q (! (fun_app$r less$ j$) :named @p_1) (fun_app$d (fun_app$e times$ (size$ (mat_multI$ zer$ g$ f$ (row_length$ a1$) a1$ a2$))) (size$ (mat_multI$ zer$ g$ f$ (row_length$ b1$) b1$ b2$)))) :named @p_2)) :named @p_3))
(assume a28 (! (= (! (fun_app$q @p_1 (fun_app$d (fun_app$e times$ (size$ a2$)) (size$ b2$))) :named @p_4) @p_2) :named @p_5))
(assume a32 @p_4)
(step t0 (cl (= @p_2 @p_4)) :rule symm :premises (a28))
(step t1 (cl @p_2 (! (not @p_4) :named @p_6)) :rule equiv2 :premises (t0))
(step t2 (cl @p_6) :rule resolution :premises (t1 conjecture15))
(step t3 (cl) :rule resolution :premises (a32 t2))
