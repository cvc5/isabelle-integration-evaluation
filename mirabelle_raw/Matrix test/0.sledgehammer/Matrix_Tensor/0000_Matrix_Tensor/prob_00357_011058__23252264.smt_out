unsat
(assume conjecture2 (! (not (! (mat$ zero$ zero$ m$) :named @p_1)) :named @p_2))
(assume a30 (! (mat$ zero$ zero$ nil$) :named @p_3))
(assume a92 (! (= m$ nil$) :named @p_4))
(step t0 (cl (not (! (= (! (= true false) :named @p_5) false) :named @p_9)) (not @p_5) false) :rule equiv_pos2)
(step t1 (cl @p_9) :rule evaluate)
(step t2 (cl (= (! (= @p_3 true) :named @p_8) @p_3)) :rule equiv_simplify)
