(step t13 (cl @p_5) :rule trans :premises (t5 t7 t12))
(step t14 (cl false) :rule resolution :premises (t0 t1 t13))
(step t15 (cl (not false)) :rule false)
(step t16 (cl) :rule resolution :premises (t14 t15))
