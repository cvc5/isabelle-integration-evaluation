; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 818
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun ws$ () A_list$)
(declare-fun xs$ () A_list$)
(declare-fun ys$ () A_list$)
(declare-fun zs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ (append$ xs$ zs$) (append$ ys$ ws$)) (scalar_product$ f$ zer$ g$ zs$ ws$))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (= (= (append$ ?v0 ?v1) ?v1) (= ?v0 nil$))) :named a1))
(assert (! (= xs$ nil$) :named a2))
(check-sat)
(get-proof)
