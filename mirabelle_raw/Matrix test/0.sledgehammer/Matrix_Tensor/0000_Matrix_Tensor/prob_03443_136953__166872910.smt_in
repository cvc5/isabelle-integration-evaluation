; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-sort B_b_prod_list$ 0)
(declare-sort B_c_prod_list$ 0)
(declare-sort C_b_prod_list$ 0)
(declare-sort C_c_prod_list$ 0)
(declare-sort B_b_c_prod_prod_list$ 0)
(declare-sort B_c_prod_b_prod_list$ 0)
(declare-sort B_c_prod_c_prod_list$ 0)
(declare-sort C_b_c_prod_prod_list$ 0)
(declare-sort C_c_prod_b_prod_list$ 0)
(declare-sort B_c_prod_b_c_prod_prod_list$ 0)
(declare-fun ws$ () C_list$)
(declare-fun xs$ () B_list$)
(declare-fun ys$ () C_list$)
(declare-fun zs$ () B_list$)
(declare-fun zip$ (B_list$ C_list$) B_c_prod_list$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun zip$a (B_list$ B_list$) B_b_prod_list$)
(declare-fun zip$b (C_list$ B_list$) C_b_prod_list$)
(declare-fun zip$c (C_list$ C_list$) C_c_prod_list$)
(declare-fun zip$d (B_c_prod_list$ B_list$) B_c_prod_b_prod_list$)
(declare-fun zip$e (B_c_prod_list$ C_list$) B_c_prod_c_prod_list$)
(declare-fun zip$f (B_list$ B_c_prod_list$) B_b_c_prod_prod_list$)
(declare-fun zip$g (C_list$ B_c_prod_list$) C_b_c_prod_prod_list$)
(declare-fun zip$h (B_c_prod_list$ B_c_prod_list$) B_c_prod_b_c_prod_prod_list$)
(declare-fun zip$i (C_c_prod_list$ B_list$) C_c_prod_b_prod_list$)
(declare-fun size$a (C_list$) Nat$)
(declare-fun size$b (B_c_prod_list$) Nat$)
(declare-fun size$c (C_c_prod_list$) Nat$)
(declare-fun append$ (B_list$ B_list$) B_list$)
(declare-fun append$a (C_list$ C_list$) C_list$)
(declare-fun append$b (B_c_prod_list$ B_c_prod_list$) B_c_prod_list$)
(declare-fun append$c (B_b_prod_list$ B_b_prod_list$) B_b_prod_list$)
(declare-fun append$d (C_b_prod_list$ C_b_prod_list$) C_b_prod_list$)
(declare-fun append$e (C_c_prod_list$ C_c_prod_list$) C_c_prod_list$)
(declare-fun append$f (B_c_prod_b_prod_list$ B_c_prod_b_prod_list$) B_c_prod_b_prod_list$)
(declare-fun append$g (B_c_prod_c_prod_list$ B_c_prod_c_prod_list$) B_c_prod_c_prod_list$)
(declare-fun append$h (B_b_c_prod_prod_list$ B_b_c_prod_prod_list$) B_b_c_prod_prod_list$)
(declare-fun append$i (C_b_c_prod_prod_list$ C_b_c_prod_prod_list$) C_b_c_prod_prod_list$)
(declare-fun append$j (B_c_prod_b_c_prod_prod_list$ B_c_prod_b_c_prod_prod_list$) B_c_prod_b_c_prod_prod_list$)
(declare-fun append$k (C_c_prod_b_prod_list$ C_c_prod_b_prod_list$) C_c_prod_b_prod_list$)
(assert (! (not (= (zip$ (append$ xs$ zs$) (append$a ys$ ws$)) (append$b (zip$ xs$ ys$) (zip$ zs$ ws$)))) :named conjecture0))
(assert (! (and (= (size$ zs$) (size$a ws$)) (= (size$ xs$) (size$a ys$))) :named hypothesis1))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 B_list$) (?v3 B_list$)) (=> (= (size$ ?v0) (size$ ?v1)) (= (zip$a (append$ ?v0 ?v2) (append$ ?v1 ?v3)) (append$c (zip$a ?v0 ?v1) (zip$a ?v2 ?v3))))) :named a2))
(assert (! (forall ((?v0 B_list$) (?v1 C_list$) (?v2 B_list$) (?v3 C_list$)) (=> (= (size$ ?v0) (size$a ?v1)) (= (zip$ (append$ ?v0 ?v2) (append$a ?v1 ?v3)) (append$b (zip$ ?v0 ?v1) (zip$ ?v2 ?v3))))) :named a3))
(assert (! (forall ((?v0 C_list$) (?v1 B_list$) (?v2 C_list$) (?v3 B_list$)) (=> (= (size$a ?v0) (size$ ?v1)) (= (zip$b (append$a ?v0 ?v2) (append$ ?v1 ?v3)) (append$d (zip$b ?v0 ?v1) (zip$b ?v2 ?v3))))) :named a4))
(assert (! (forall ((?v0 C_list$) (?v1 C_list$) (?v2 C_list$) (?v3 C_list$)) (=> (= (size$a ?v0) (size$a ?v1)) (= (zip$c (append$a ?v0 ?v2) (append$a ?v1 ?v3)) (append$e (zip$c ?v0 ?v1) (zip$c ?v2 ?v3))))) :named a5))
(assert (! (forall ((?v0 B_c_prod_list$) (?v1 B_list$) (?v2 B_c_prod_list$) (?v3 B_list$)) (=> (= (size$b ?v0) (size$ ?v1)) (= (zip$d (append$b ?v0 ?v2) (append$ ?v1 ?v3)) (append$f (zip$d ?v0 ?v1) (zip$d ?v2 ?v3))))) :named a6))
(assert (! (forall ((?v0 B_c_prod_list$) (?v1 C_list$) (?v2 B_c_prod_list$) (?v3 C_list$)) (=> (= (size$b ?v0) (size$a ?v1)) (= (zip$e (append$b ?v0 ?v2) (append$a ?v1 ?v3)) (append$g (zip$e ?v0 ?v1) (zip$e ?v2 ?v3))))) :named a7))
(assert (! (forall ((?v0 B_list$) (?v1 B_c_prod_list$) (?v2 B_list$) (?v3 B_c_prod_list$)) (=> (= (size$ ?v0) (size$b ?v1)) (= (zip$f (append$ ?v0 ?v2) (append$b ?v1 ?v3)) (append$h (zip$f ?v0 ?v1) (zip$f ?v2 ?v3))))) :named a8))
(assert (! (forall ((?v0 C_list$) (?v1 B_c_prod_list$) (?v2 C_list$) (?v3 B_c_prod_list$)) (=> (= (size$a ?v0) (size$b ?v1)) (= (zip$g (append$a ?v0 ?v2) (append$b ?v1 ?v3)) (append$i (zip$g ?v0 ?v1) (zip$g ?v2 ?v3))))) :named a9))
(assert (! (forall ((?v0 B_c_prod_list$) (?v1 B_c_prod_list$) (?v2 B_c_prod_list$) (?v3 B_c_prod_list$)) (=> (= (size$b ?v0) (size$b ?v1)) (= (zip$h (append$b ?v0 ?v2) (append$b ?v1 ?v3)) (append$j (zip$h ?v0 ?v1) (zip$h ?v2 ?v3))))) :named a10))
(assert (! (forall ((?v0 C_c_prod_list$) (?v1 B_list$) (?v2 C_c_prod_list$) (?v3 B_list$)) (=> (= (size$c ?v0) (size$ ?v1)) (= (zip$i (append$e ?v0 ?v2) (append$ ?v1 ?v3)) (append$k (zip$i ?v0 ?v1) (zip$i ?v2 ?v3))))) :named a11))
(check-sat)
(get-proof)
