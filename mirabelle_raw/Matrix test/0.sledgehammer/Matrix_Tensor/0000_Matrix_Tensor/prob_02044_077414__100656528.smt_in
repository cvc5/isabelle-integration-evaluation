; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 217
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun nil$ () B_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(assert (! (not (=> (less$ i$ zero$) (= (cons$ (nth$ nil$ i$) nil$) nil$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a1))
(check-sat)
(get-proof)
