(assert (! (forall ((?v0 Nat$)) (= (< 0 (of_nat$ ?v0)) (less$ zero$ ?v0))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ ?v0 (minus$ ?v1 ?v2)) (less$ (plus$ ?v0 ?v2) ?v1))) :named a11))
(assert (! (forall ((?v0 Int)) (=> (<= 0 ?v0) (= (suc$ (nat$ ?v0)) (nat$ (+ 1 ?v0))))) :named a12))
(assert (! (forall ((?v0 Nat$)) (= ?v0 (plus$ ?v0 zero$))) :named a13))
(assert (! (forall ((?v0 Int)) (= ?v0 (+ ?v0 0))) :named a14))
(assert (! (= (size$ nil$) zero$) :named a15))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less$ ?v0 ?v1)) (less$ ?v1 (suc$ ?v0)))) :named a16))
