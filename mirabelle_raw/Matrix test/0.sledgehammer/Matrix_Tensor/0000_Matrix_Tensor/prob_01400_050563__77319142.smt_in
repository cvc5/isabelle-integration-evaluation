(assert (! (=> (and (less$ zero$ j$) (less$ (nat$ (+ (of_nat$ j$) (- 1))) (size$ (cons$ b$ n$)))) (less$ (plus$ (nat$ (+ (of_nat$ j$) (- 1))) one$) (size$ (cons$ a$ (cons$ b$ n$))))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (= one$ (suc$ zero$)) :named a3))
(assert (! (forall ((?v0 Nat$)) (=> (less$ zero$ ?v0) (= (plus$ (nat$ (+ (of_nat$ ?v0) (- 1))) one$) ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (+ ?v0 ?v1) ?v1) ?v0)) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v1) ?v0)) :named a7))
