; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun y$ () A$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(assert (! (not (= (times$ f$ y$ w2$) nil$)) :named conjecture0))
(assert (! (and (= (size$ w1$) (size$ w2$)) (= (size$ w1$) zero$)) :named a1))
(assert (! (=> (and (= (size$ w1$) (size$ w2$)) (= (size$ w1$) zero$)) (= w2$ nil$)) :named a2))
(check-sat)
(get-proof)
