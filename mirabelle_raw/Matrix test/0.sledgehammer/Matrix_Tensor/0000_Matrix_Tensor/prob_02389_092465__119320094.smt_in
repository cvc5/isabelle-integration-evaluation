; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 254
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun dvd$ (Nat$ Nat$) Bool)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)) zero$)) :named conjecture0))
(assert (! (less$ (modulo$ a$ c$) c$) :named a1))
(assert (! (less$ (modulo$ (modulo$ a$ (times$ b$ c$)) c$) c$) :named a2))
(assert (! (less$ (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)) c$) :named a3))
(assert (! (dvd$ c$ (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (dvd$ ?v0 ?v1) (= (modulo$ ?v1 ?v0) zero$)) :pattern ((dvd$ ?v0 ?v1)))) :named a5))
(check-sat)
(get-proof)
