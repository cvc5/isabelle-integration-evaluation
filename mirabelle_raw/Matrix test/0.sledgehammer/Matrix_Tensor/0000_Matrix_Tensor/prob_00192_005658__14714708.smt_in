; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_list_bool_fun$ 0)
(declare-sort B_list_list_list$ 0)
(declare-sort B_list_list_list_list$ 0)
(declare-sort B_list_list_list_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun bot$ () B_list_set$)
(declare-fun nil$ () B_list_list$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun vec$ (Nat$) B_list_bool_fun$)
(declare-fun nil$a () B_list_list_list_list$)
(declare-fun nil$b () B_list$)
(declare-fun nil$c () B_list_list_list$)
(declare-fun nil$d () B_list_list_list_list_list$)
(declare-fun size$ (B_list_list_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun size$b (B_list_list_list$) Nat$)
(declare-fun size$c (B_list_list$) Nat$)
(declare-fun concat$ (B_list_list_list_list_list$) B_list_list_list_list$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(declare-fun concat$a (B_list_list_list_list$) B_list_list_list$)
(declare-fun concat$b (B_list_list_list$) B_list_list$)
(declare-fun concat$c (B_list_list$) B_list$)
(declare-fun fun_app$ (B_list_bool_fun$ B_list$) Bool)
(assert (! (not (forall ((?v0 B_list$)) (=> (member$ ?v0 (set$ m$)) (fun_app$ (vec$ zero$) ?v0)))) :named conjecture0))
(assert (! (forall ((?v0 B_list_set$) (?v1 B_list_bool_fun$)) (= (forall ((?v2 B_list$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))) (forall ((?v2 B_list$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))))) :named a1))
(assert (! (= (set$ m$) bot$) :named a2))
(assert (! (= m$ nil$) :named a3))
(assert (! (forall ((?v0 B_list_bool_fun$)) (= (forall ((?v1 B_list$)) (=> (member$ ?v1 bot$) (fun_app$ ?v0 ?v1))) true)) :named a4))
(assert (! (= (size$ nil$a) zero$) :named a5))
(assert (! (= (size$a nil$b) zero$) :named a6))
(assert (! (= (size$b nil$c) zero$) :named a7))
(assert (! (= (size$c nil$) zero$) :named a8))
(assert (! (= (concat$ nil$d) nil$a) :named a9))
(assert (! (= (concat$a nil$a) nil$c) :named a10))
(assert (! (= (concat$b nil$c) nil$) :named a11))
(assert (! (= (concat$c nil$) nil$b) :named a12))
(check-sat)
(get-proof)
