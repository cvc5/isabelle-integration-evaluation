; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 228
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun nil$ () B_list_list$)
(declare-fun nr1$ () Nat$)
(declare-fun nr2$ () Nat$)
(assert (! (not (= nr1$ nr2$)) :named conjecture0))
(assert (! (= m$ nil$) :named a1))
(check-sat)
(get-proof)
