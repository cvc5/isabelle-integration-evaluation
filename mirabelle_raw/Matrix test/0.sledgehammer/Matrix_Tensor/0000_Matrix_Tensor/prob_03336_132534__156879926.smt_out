unsat
(assume conjecture0 (! (not (! (= (f$ zer$ x$) (f$ (! (g$ zer$ zer$) :named @p_1) x$)) :named @p_2)) :named @p_3))
(assume a1 (! (= @p_1 zer$) :named @p_4))
(step t0 (cl (! (=> (! (= zer$ @p_1) :named @p_5) @p_2) :named @p_7) @p_5) :rule implies_neg1)
(anchor :step t1)
(assume t1.a0 @p_5)
(step t1.t0 (cl @p_5) :rule symm :premises (a1))
(step t1.t1 (cl (= x$ x$)) :rule refl)
(step t1.t2 (cl @p_2) :rule cong :premises (t1.t0 t1.t1))
(step t1 (cl (! (not @p_5) :named @p_6) @p_2) :rule subproof :discharge (t1.a0))
(step t2 (cl @p_7 @p_2) :rule resolution :premises (t0 t1))
(step t3 (cl @p_7 @p_3) :rule implies_neg2)
(step t4 (cl @p_7 @p_7) :rule resolution :premises (t2 t3))
(step t5 (cl @p_7) :rule contraction :premises (t4))
(step t6 (cl @p_6 @p_2) :rule implies :premises (t5))
(step t7 (cl @p_2 @p_6) :rule reordering :premises (t6))
(step t8 (cl @p_5) :rule symm :premises (a1))
(step t9 (cl) :rule resolution :premises (t7 t8 conjecture0))
