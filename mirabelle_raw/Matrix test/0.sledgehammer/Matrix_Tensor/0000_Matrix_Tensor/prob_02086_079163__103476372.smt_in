; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 237
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list_list_list_list$)
(declare-fun nil$b () A_list_list_list$)
(declare-fun nil$c () A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun concat$ (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$a (A_list_list_list$) A_list_list$)
(declare-fun concat$b (A_list_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (times$ (size$ v$) (row_length$ (cons$ w$ n$))) zero$)) :named conjecture0))
(assert (! (= w$ nil$) :named a1))
(assert (! (= (row_length$ (cons$ w$ n$)) (size$ w$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a3))
(assert (! (= (concat$ nil$a) nil$b) :named a4))
(assert (! (= (concat$a nil$b) nil$c) :named a5))
(assert (! (= (concat$b nil$c) nil$) :named a6))
(check-sat)
(get-proof)
