; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 240
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun j$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (less$ j$ (times$ (size$ (cons$ v$ nil$)) (size$ (cons$ w$ n$)))) (less$ j$ (size$ (cons$ w$ n$))))) :named conjecture0))
(assert (! (= (size$ (cons$ v$ nil$)) one$) :named a1))
(assert (! (= m2$ (cons$ w$ n$)) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a3))
(assert (! (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (less_eq$ one$ (divide$ j$ (size$ (cons$ w$ n$))))) :named a4))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ zero$ ?v0) (= (less$ (divide$ ?v1 ?v0) ?v2) (less$ ?v1 (times$ ?v2 ?v0))))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v2) ?v1))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less$ ?v0 ?v1)) (less_eq$ ?v1 ?v0))) :named a8))
(check-sat)
(get-proof)
