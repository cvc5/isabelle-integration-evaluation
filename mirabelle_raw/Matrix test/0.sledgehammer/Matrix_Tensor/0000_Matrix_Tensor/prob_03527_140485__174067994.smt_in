; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 219
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun x$ () A$)
(declare-fun y$ () A$)
(declare-fun ws$ () A_list$)
(declare-fun xs$ () A_list$)
(declare-fun ys$ () A_list$)
(declare-fun zs$ () A_list$)
(declare-fun xss$ () A_list$)
(declare-fun yss$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (fun_app$ (fun_app$a g$ (scalar_product$ f$ zer$ g$ xs$ ys$)) (scalar_product$ f$ zer$ g$ zs$ ws$)) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ x$) y$)) (scalar_product$ f$ zer$ g$ xss$ yss$))) (scalar_product$ f$ zer$ g$ zs$ ws$)))) :named conjecture0))
(assert (! (= (scalar_product$ f$ zer$ g$ xs$ ys$) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ x$) y$)) (scalar_product$ f$ zer$ g$ xss$ yss$))) :named a1))
(check-sat)
(get-proof)
