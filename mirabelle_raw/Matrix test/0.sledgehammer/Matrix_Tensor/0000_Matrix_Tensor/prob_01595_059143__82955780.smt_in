(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ m2$) j$) (= (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) (minus$ (divide$ j$ (size$ m2$)) one$)))) :named conjecture0))
(assert (! (= (plus$ one$) suc$) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a2))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (fun_app$ (plus$ ?v0) ?v1) ?v0) ?v1)) :named a4))
(assert (! (forall ((?v0 Nat$)) (less_eq$ zero$ ?v0)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ ?v0 ?v1) (ite (or (less$ ?v0 ?v1) (= ?v1 zero$)) zero$ (fun_app$ suc$ (divide$ (minus$ ?v0 ?v1) ?v1))))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ zero$ ?v0) (less_eq$ ?v0 ?v1)) (= (divide$ ?v1 ?v0) (fun_app$ suc$ (divide$ (minus$ ?v1 ?v0) ?v0))))) :named a7))
(check-sat)
(get-proof)
