; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun m1$ () A_list_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun m3$ () A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (forall ((?v0 Nat$)) (=> (less$ ?v0 (times$ (times$ (row_length$ m1$) (row_length$ m2$)) (row_length$ m3$))) (less$ (modulo$ ?v0 (row_length$ (tensor$ f$ m2$ m3$))) (row_length$ (tensor$ f$ m2$ m3$)))))) :named conjecture0))
(assert (! (= (times$ (times$ (row_length$ m1$) (row_length$ m2$)) (row_length$ m3$)) zero$) :named a1))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a2))
(check-sat)
(get-proof)
