; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 240
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun j$ () Nat$)
(declare-fun a2$ () A_list_list$)
(declare-fun b2$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (size$ (col$ a2$ (divide$ j$ (size$a b2$)))) (row_length$ a2$))) :named conjecture0))
(assert (! (less$ (divide$ j$ (size$a b2$)) (size$a a2$)) :named a1))
(assert (! (mat$ (row_length$ a2$) (size$a a2$) a2$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$) (?v3 Nat$)) (=> (and (mat$ ?v0 ?v1 ?v2) (less$ ?v3 ?v1)) (vec$ ?v0 (col$ ?v2 ?v3)))) :named a3))
(check-sat)
(get-proof)
