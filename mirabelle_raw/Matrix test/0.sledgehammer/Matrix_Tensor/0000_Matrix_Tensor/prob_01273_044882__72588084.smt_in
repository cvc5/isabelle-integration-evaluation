; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 238
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (= (vec_mat_Tensor$ f$ v$ nil$) nil$)) :named conjecture0))
(check-sat)
(get-proof)
