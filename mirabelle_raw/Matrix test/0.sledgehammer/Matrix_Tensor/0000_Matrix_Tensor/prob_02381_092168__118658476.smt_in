; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun m$ () Nat$)
(declare-fun n$ () Nat$)
(declare-fun m1$ () Nat$)
(declare-fun dvd$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (dvd$ c$ (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (times$ (minus$ (plus$ (times$ m1$ b$) m$) n$) c$) (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))) :named a1))
(assert (! (= a$ (plus$ (times$ n$ c$) (modulo$ a$ c$))) :named a2))
(assert (! (= (modulo$ a$ (times$ b$ c$)) (plus$ (times$ m$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))) :named a3))
(assert (! (= (minus$ (times$ (plus$ (times$ m1$ b$) m$) c$) (times$ n$ c$)) (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))) :named a4))
(assert (! (= a$ (plus$ (times$ (plus$ (times$ m1$ b$) m$) c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))) :named a5))
(assert (! (= a$ (plus$ (plus$ (times$ (times$ m1$ b$) c$) (times$ m$ c$)) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (dvd$ ?v0 ?v1) (dvd$ ?v0 ?v2)) (dvd$ ?v0 (minus$ ?v1 ?v2)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ (times$ ?v0 ?v1) ?v2) ?v1) (modulo$ ?v2 ?v1))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v1) ?v0)) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (dvd$ ?v0 (minus$ ?v1 (modulo$ ?v1 ?v0)))) :named a10))
(check-sat)
(get-proof)
