unsat
(assume conjecture4 (! (not (! (= (col$ (! (fun_app$d (fun_app$e (! (tensor$ f$) :named @p_1) (cons$ v$ m$)) m2$) :named @p_3) j$) (col$ (! (fun_app$d (append$ (fun_app$d (fun_app$f (vec_mat_Tensor$ f$) v$) m2$)) (fun_app$d (fun_app$e @p_1 m$) m2$)) :named @p_2) j$)) :named @p_4)) :named @p_5))
(assume a8 (! (= @p_3 @p_2) :named @p_6))
(step t0 (cl (! (=> @p_6 @p_4) :named @p_8) @p_6) :rule implies_neg1)
(anchor :step t1)
(assume t1.a0 @p_6)
(step t1.t0 (cl (= j$ j$)) :rule refl)
(step t1.t1 (cl @p_4) :rule cong :premises (t1.a0 t1.t0))
(step t1 (cl (! (not @p_6) :named @p_7) @p_4) :rule subproof :discharge (t1.a0))
(step t2 (cl @p_8 @p_4) :rule resolution :premises (t0 t1))
(step t3 (cl @p_8 @p_5) :rule implies_neg2)
(step t4 (cl @p_8 @p_8) :rule resolution :premises (t2 t3))
(step t5 (cl @p_8) :rule contraction :premises (t4))
(step t6 (cl @p_7 @p_4) :rule implies :premises (t5))
(step t7 (cl @p_4 @p_7) :rule reordering :premises (t6))
(step t8 (cl) :rule resolution :premises (t7 a8 conjecture4))
