(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$) (?v2 A_list_list$) (?v3 A_list_list$)) (=> (matrix_match$ ?v0 ?v1 ?v2 ?v3) (forall ((?v4 Nat$) (?v5 Nat$)) (=> (and (less$ ?v4 (times$ (row_length$ ?v0) (row_length$ ?v2))) (less$ ?v5 (times$ (size$ ?v1) (size$ ?v3)))) (= (nth$ (nth$a (tensor$ f$ (mat_multI$ zer$ g$ f$ (row_length$ ?v0) ?v0 ?v1) (mat_multI$ zer$ g$ f$ (row_length$ ?v2) ?v2 ?v3)) ?v5) ?v4) (nth$ (nth$a (mat_multI$ zer$ g$ f$ (row_length$ (tensor$ f$ ?v0 ?v2)) (tensor$ f$ ?v0 ?v2) (tensor$ f$ ?v1 ?v3)) ?v5) ?v4)))))) :named a2))
