(assume a8 (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (= (fun_app$c (fun_app$d (times$ f$) ?v0) (fun_app$c (cons$a ?v1) ?v2)) (fun_app$c (cons$a (fun_app$f (fun_app$g f$ ?v0) ?v1)) (fun_app$c (fun_app$d (times$ f$) ?v0) ?v2)))))
