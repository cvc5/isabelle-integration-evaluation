unsat
(assume conjecture13 (! (not (! (= c$ zero$a) :named @p_1)) :named @p_2))
(assume a41 (! (or (! (= b$ zero$a) :named @p_3) @p_1) :named @p_4))
(assume a44 (! (not @p_3) :named @p_5))
(step t0 (cl @p_3 @p_1) :rule or :premises (a41))
(step t1 (cl @p_3) :rule resolution :premises (t0 conjecture13))
(step t2 (cl) :rule resolution :premises (t1 a44))
