; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun a1$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun w1$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (vec_vec_Tensor$ f$ (cons$ a1$ u1$) w1$) (append$ (times$ f$ a1$ w1$) (vec_vec_Tensor$ f$ u1$ w1$)))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A_list$)) (! (= (vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2) (append$ (times$ f$ ?v0 ?v2) (vec_vec_Tensor$ f$ ?v1 ?v2))) :pattern ((vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2)))) :named a1))
(check-sat)
(get-proof)
