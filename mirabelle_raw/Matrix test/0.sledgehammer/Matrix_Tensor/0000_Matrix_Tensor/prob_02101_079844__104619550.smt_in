; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 267
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (nth$ (vec_vec_Tensor$ f$ v$ w$) i$) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (size$ w$)))) (nth$ w$ (modulo$ i$ (size$ w$)))))) :named conjecture0))
(assert (! (less$ i$ (times$ (size$ v$) (size$ w$))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (=> (not (= ?v0 nil$)) (forall ((?v2 Nat$)) (=> (less$ ?v2 (times$ (size$ ?v1) (size$ ?v0))) (= (nth$ (vec_vec_Tensor$ f$ ?v1 ?v0) ?v2) (fun_app$ (fun_app$a f$ (nth$ ?v1 (divide$ ?v2 (size$ ?v0)))) (nth$ ?v0 (modulo$ ?v2 (size$ ?v0))))))))) :named a2))
(assert (! (not (= w$ nil$)) :named a3))
(check-sat)
(get-proof)
