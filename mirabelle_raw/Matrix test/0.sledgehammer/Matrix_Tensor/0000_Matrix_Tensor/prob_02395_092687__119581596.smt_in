; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 318
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_set$ 0)
(declare-sort Nat_bool_fun$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun uu$ (Nat$ Nat$) Nat_bool_fun$)
(declare-fun max$ (Nat_set$) Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun collect$ (Nat_bool_fun$) Nat_set$)
(declare-fun fun_app$ (Nat_bool_fun$ Nat$) Bool)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (! (= (fun_app$ (uu$ ?v0 ?v1) ?v2) (less_eq$ (times$ ?v2 ?v1) ?v0)) :pattern ((fun_app$ (uu$ ?v0 ?v1) ?v2)))) :named a0))
(assert (! (not (= (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$))) :named conjecture1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ ?v0 (times$ ?v1 ?v2)) (plus$ (times$ ?v1 (modulo$ (divide$ ?v0 ?v1) ?v2)) (modulo$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v1) ?v0)) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (modulo$ ?v0 (times$ ?v1 ?v2)) ?v2) (modulo$ ?v0 ?v2))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ ?v0 ?v1) (ite (= ?v1 zero$) zero$ (max$ (collect$ (uu$ ?v0 ?v1)))))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ ?v0 (modulo$ ?v0 ?v1)) (times$ (divide$ ?v0 ?v1) ?v1))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (times$ ?v0 ?v1) (times$ ?v0 ?v2)) (or (= ?v0 zero$) (= ?v1 ?v2)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (times$ ?v0 ?v1) ?v0) zero$)) :named a8))
(check-sat)
(get-proof)
