; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort D_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort C_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun m2$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ C_list_list$) Bool)
(declare-fun nil$ () A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun mat$a (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$a () B_list$)
(declare-fun nil$b () D_list$)
(declare-fun nil$c () C_list_list$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun size$b (D_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (and (and (less$ i$ (times$ (row_length$ nil$) (row_length$ m2$))) (less$ j$ (times$ (size$ nil$a) (size$a m2$)))) (and (mat$ (row_length$ nil$) (size$b nil$b) nil$c) (mat$a (row_length$ m2$) (size$a m2$) m2$))) false)) :named conjecture0))
(assert (! (=> (less$ i$ (times$ (row_length$ nil$) (row_length$ m2$))) false) :named a1))
(check-sat)
(get-proof)
