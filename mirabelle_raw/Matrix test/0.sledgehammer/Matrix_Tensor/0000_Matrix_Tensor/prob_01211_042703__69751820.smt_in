; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun j$ () Nat$)
(declare-fun k$ () Nat$)
(declare-fun nat$ (Int) Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not (=> (= j$ (plus$ k$ one$)) (= (nat$ (+ (of_nat$ j$) (- 1))) k$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (= (nat$ (of_nat$ ?v0)) ?v0)) :named a1))
(assert (! (forall ((?v0 Nat$)) (= (suc$ ?v0) (plus$ ?v0 one$))) :named a2))
(check-sat)
(get-proof)
