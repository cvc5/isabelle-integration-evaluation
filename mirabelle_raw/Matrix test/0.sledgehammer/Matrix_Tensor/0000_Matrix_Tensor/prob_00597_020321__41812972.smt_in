; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun m2$ () A_list_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun append$ (A_list_list$ A_list_list$) A_list_list$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (= (size$ (tensor$ f$ (cons$ a$ m1a$) m2$)) (times$ (size$ (cons$ a$ m1a$)) (size$ m2$)))) :named conjecture0))
(assert (! (= (size$ (tensor$ f$ (cons$ a$ m1a$) m2$)) (size$ (append$ (vec_mat_Tensor$ f$ a$ m2$) (tensor$ f$ m1a$ m2$)))) :named a1))
(assert (! (= (size$ (append$ (vec_mat_Tensor$ f$ a$ m2$) (tensor$ f$ m1a$ m2$))) (times$ (fun_app$ (plus$ one$) (size$ m1a$)) (size$ m2$))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (size$ (append$ ?v0 ?v1)) (fun_app$ (plus$ (size$ ?v0)) (size$ ?v1)))) :named a4))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (= nil$ (append$ ?v0 ?v1)) (and (= ?v0 nil$) (= ?v1 nil$)))) :named a5))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 A_list_list$)) (! (= (append$ nil$ ?v0) ?v0) :pattern ((append$ nil$ ?v0)))) :named a7))
(assert (! (forall ((?v0 A_list_list$)) (=> (not (= ?v0 nil$)) (= (fun_app$ (plus$ (size$ (reduct$ ?v0))) one$) (size$ ?v0)))) :named a8))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list_list$)) (! (= (append$ (cons$ ?v0 ?v1) ?v2) (cons$ ?v0 (append$ ?v1 ?v2))) :pattern ((append$ (cons$ ?v0 ?v1) ?v2)))) :named a9))
(assert (! (= (size$ nil$) zero$) :named a10))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (plus$ zero$) ?v0) ?v0)) :named a11))
(assert (! (= (plus$ one$) suc$) :named a12))
(check-sat)
(get-proof)
