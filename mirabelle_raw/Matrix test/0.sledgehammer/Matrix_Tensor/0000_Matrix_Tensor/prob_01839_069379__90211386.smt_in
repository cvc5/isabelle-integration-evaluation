; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 242
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun z$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(assert (! (not (= (divide$ x$ z$) zero$)) :named conjecture0))
(assert (! (= y$ one$) :named hypothesis1))
(assert (! (=> (= y$ one$) (less$ x$ z$)) :named a2))
(assert (! (not (less$ (divide$ x$ z$) y$)) :named a3))
(assert (! (less$ x$ (times$ y$ z$)) :named a4))
(check-sat)
(get-proof)
