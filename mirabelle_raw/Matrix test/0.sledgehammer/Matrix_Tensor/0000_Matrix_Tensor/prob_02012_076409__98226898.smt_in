; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (col$ (cons$ v$ m$) (plus$ (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) one$)) (col$ (cons$ v$ m$) (divide$ j$ (size$ m2$))))) :named conjecture0))
(assert (! (= (col$ (cons$ v$ m$) (plus$ (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) one$)) (col$ m$ (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)))) :named a1))
(assert (! (less_eq$ (size$ m2$) j$) :named a2))
(check-sat)
(get-proof)
