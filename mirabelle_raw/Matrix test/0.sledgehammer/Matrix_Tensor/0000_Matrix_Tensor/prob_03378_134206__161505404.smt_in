; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 244
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_a_prod_list$ 0)
(declare-sort A_list_a_a_fun_fun$ 0)
(declare-sort A_a_a_a_fun_fun_fun$ 0)
(declare-sort A_a_prod_a_a_fun_fun$ 0)
(declare-sort A_a_prod_list_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun x$ () A$)
(declare-fun y$ () A$)
(declare-fun id$ () A_a_fun$)
(declare-fun uu$ () A_a_a_a_fun_fun_fun$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun zip$ (A_list$ A_list$) A_a_prod_list$)
(declare-fun nil$a () A_a_prod_list$)
(declare-fun foldr$ (A_a_prod_a_a_fun_fun$) A_a_prod_list_a_a_fun_fun$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun foldr$a (A_a_a_fun_fun$) A_list_a_a_fun_fun$)
(declare-fun fun_app$ (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun fun_app$a (A_a_a_a_fun_fun_fun$ A$) A_a_a_fun_fun$)
(declare-fun fun_app$b (A_a_fun$ A$) A$)
(declare-fun fun_app$c (A_a_prod_list_a_a_fun_fun$ A_a_prod_list$) A_a_fun$)
(declare-fun fun_app$d (A_list_a_a_fun_fun$ A_list$) A_a_fun$)
(declare-fun case_prod$ (A_a_a_a_fun_fun_fun$) A_a_prod_a_a_fun_fun$)
(assert (! (forall ((?v0 A$) (?v1 A$)) (! (= (fun_app$ (fun_app$a uu$ ?v0) ?v1) (fun_app$ g$ (fun_app$b (fun_app$ f$ ?v0) ?v1))) :pattern ((fun_app$ (fun_app$a uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (= (fun_app$b (fun_app$c (foldr$ (case_prod$ uu$)) (zip$ (times$ f$ x$ w1$) (times$ f$ y$ w2$))) zer$) zer$)) :named conjecture1))
(assert (! (= (times$ f$ x$ w1$) nil$) :named a2))
(assert (! (= (times$ f$ y$ w2$) nil$) :named a3))
(assert (! (forall ((?v0 A_a_a_fun_fun$)) (! (= (fun_app$d (foldr$a ?v0) nil$) id$) :pattern ((foldr$a ?v0)))) :named a4))
(assert (! (forall ((?v0 A_a_prod_a_a_fun_fun$)) (! (= (fun_app$c (foldr$ ?v0) nil$a) id$) :pattern ((foldr$ ?v0)))) :named a5))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$b id$ ?v0) ?v0) :pattern ((fun_app$b id$ ?v0)))) :named a6))
(check-sat)
(get-proof)
