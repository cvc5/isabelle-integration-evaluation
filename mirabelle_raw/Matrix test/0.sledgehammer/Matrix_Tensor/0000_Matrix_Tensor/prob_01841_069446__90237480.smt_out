(assume a3 (! (less$ zero$ one$) :named @p_7))
(step t0 (cl (not (! (= @p_7 (! (less$ @p_1 one$) :named @p_8)) :named @p_11)) (not @p_7) @p_8) :rule equiv_pos2)
(step t1 (cl (not (! (= @p_6 (! (=> @p_4 (! (= zero$ @p_1) :named @p_12)) :named @p_13)) :named @p_14)) (not @p_6) @p_13) :rule equiv_pos2)
(step t2 (cl (= @p_5 @p_12)) :rule rare_rewrite :args ("eq-symm" @p_1 zero$))
