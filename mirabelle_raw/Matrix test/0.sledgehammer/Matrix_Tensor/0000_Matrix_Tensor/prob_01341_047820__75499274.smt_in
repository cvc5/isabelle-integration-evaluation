; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun x$ () A$)
(declare-fun ma$ () A_list_list$)
(declare-fun xs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun size$a (A_list$) Nat$)
(assert (! (not (less$ zero$ (size$ (cons$ a$ ma$)))) :named conjecture0))
(assert (! (forall ((?v0 A_list$)) (= (less$ zero$ (size$a ?v0)) (not (= ?v0 nil$)))) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$a)))) :named a2))
(assert (! (= a$ (cons$a x$ xs$)) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$a (cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (not (= nil$ (cons$a ?v0 ?v1)))) :named a5))
(check-sat)
(get-proof)
