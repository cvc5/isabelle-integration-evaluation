(assert (! (=> (and (less$ zero$ j$) (and (and (less$ i$ (times$ (row_length$ (cons$ b$ n$)) (size$ v$))) (less$ j$ (size$a (cons$ a$ (cons$ b$ n$))))) (mat$ (row_length$ (cons$ b$ n$)) (size$a (cons$ b$ n$)) (cons$ b$ n$)))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ a$ (cons$ b$ n$))) j$) i$) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ b$ n$))))) (nth$ (nth$a (cons$ a$ (cons$ b$ n$)) j$) (modulo$ i$ (row_length$ (cons$ b$ n$))))))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (=> (mat$ (row_length$ (cons$ ?v0 ?v1)) (size$a (cons$ ?v0 ?v1)) (cons$ ?v0 ?v1)) (mat$ (row_length$ ?v1) (size$a ?v1) ?v1))) :named a2))
