unsat
(assume conjecture0 (! (not (! (mat$ (row_length$ m2$) (size$ m2$) m2$) :named @p_1)) :named @p_2))
(assume a1 (! (mat$ (row_length$ (! (fun_app$ (fun_app$a append$ m1a$) m2$) :named @p_3)) (size$ @p_3) @p_3) :named @p_4))
(assume a4 (! (=> @p_4 @p_1) :named @p_5))
(step t0 (cl (! (not @p_5) :named @p_6) (not @p_4) @p_1) :rule implies_pos)
(step t1 (cl @p_6) :rule resolution :premises (t0 a1 conjecture0))
(step t2 (cl) :rule resolution :premises (a4 t1))
