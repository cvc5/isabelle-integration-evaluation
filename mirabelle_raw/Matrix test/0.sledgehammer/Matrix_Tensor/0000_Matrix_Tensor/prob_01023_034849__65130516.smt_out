unsat
(assume conjecture0 (! (not (! (less$ zero$ (size$ y$)) :named @p_1)) :named @p_2))
(assume a1 (! (not (= y$ nil$)) :named @p_3))
(assume a5 (! (=> @p_3 @p_1) :named @p_4))
(step t0 (cl (! (not @p_4) :named @p_5) (not @p_3) @p_1) :rule implies_pos)
(step t1 (cl @p_5) :rule resolution :premises (t0 a1 conjecture0))
(step t2 (cl) :rule resolution :premises (a5 t1))
