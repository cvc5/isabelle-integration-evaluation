; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 227
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (times$ f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$)))) (cons$a (nth$ w$ (modulo$ i$ (size$ w$))) (row$ n$ (modulo$ i$ (row_length$ n$))))) (cons$a (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$))))) (nth$ w$ (modulo$ i$ (size$ w$)))) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$)))) (row$ n$ (modulo$ i$ (row_length$ n$))))))) :named conjecture0))
(assert (! (= (cons$a (nth$ w$ (modulo$ i$ (row_length$ (cons$ w$ n$)))) (row$ n$ (modulo$ i$ (row_length$ (cons$ w$ n$))))) (cons$a (nth$ w$ (modulo$ i$ (size$ w$))) (row$ n$ (modulo$ i$ (row_length$ n$))))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (! (= (times$ f$ ?v0 (cons$a ?v1 ?v2)) (cons$a (fun_app$ (fun_app$a f$ ?v0) ?v1) (times$ f$ ?v0 ?v2))) :pattern ((times$ f$ ?v0 (cons$a ?v1 ?v2))))) :named a2))
(check-sat)
(get-proof)
