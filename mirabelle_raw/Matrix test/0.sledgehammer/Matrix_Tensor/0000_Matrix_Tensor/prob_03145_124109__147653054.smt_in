(assert (! (not (= (less$ j$ (times$ (size$ a2$) (size$ b2$))) (less$ j$ (size$ (tensor$ f$ (mat_multI$ zer$ g$ f$ (row_length$ a1$) a1$ a2$) (mat_multI$ zer$ g$ f$ (row_length$ b1$) b1$ b2$)))))) :named conjecture0))
(assert (! (= (times$ (size$ a2$) (size$ b2$)) (size$ (tensor$ f$ (mat_multI$ zer$ g$ f$ (row_length$ a1$) a1$ a2$) (mat_multI$ zer$ g$ f$ (row_length$ b1$) b1$ b2$)))) :named a1))
(assert (! (= (times$ (row_length$ a1$) (row_length$ b1$)) (row_length$ (tensor$ f$ (mat_multI$ zer$ g$ f$ (row_length$ a1$) a1$ a2$) (mat_multI$ zer$ g$ f$ (row_length$ b1$) b1$ b2$)))) :named a2))
