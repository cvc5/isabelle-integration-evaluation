(assert (! (not (= (vec_vec_Tensor$ f$ x$ nil$) nil$)) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (! (= (fun_app$ (times$ f$ ?v0) (cons$ ?v1 ?v2)) (cons$ (fun_app$a (fun_app$b f$ ?v0) ?v1) (fun_app$ (times$ f$ ?v0) ?v2))) :pattern ((fun_app$ (times$ f$ ?v0) (cons$ ?v1 ?v2))))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (= (size$ (vec_vec_Tensor$ f$ ?v0 ?v1)) (fun_app$c (times$a (size$ ?v0)) (size$ ?v1)))) :named a2))
(assert (! (forall ((?v0 A_list$)) (! (= (vec_vec_Tensor$ f$ nil$ ?v0) nil$) :pattern ((vec_vec_Tensor$ f$ nil$ ?v0)))) :named a3))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$ (times$ f$ ?v0) nil$) nil$) :pattern ((times$ f$ ?v0)))) :named a4))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A_list$)) (! (= (vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2) (append$ (fun_app$ (times$ f$ ?v0) ?v2) (vec_vec_Tensor$ f$ ?v1 ?v2))) :pattern ((vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2)))) :named a5))
(assert (! (forall ((?v0 A_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a6))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$c (times$a ?v0) zero$) zero$) :pattern ((times$a ?v0)))) :named a7))
