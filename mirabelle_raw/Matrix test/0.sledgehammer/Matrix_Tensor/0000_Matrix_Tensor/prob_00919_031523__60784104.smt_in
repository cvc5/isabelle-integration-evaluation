; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 245
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (< (of_nat$ b$) (of_nat$ a$))) :named conjecture0))
(assert (! (less$ b$ a$) :named a1))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (not (<= ?v0 ?v1)) (< ?v1 ?v0))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less_eq$ ?v0 ?v1)) (less$ ?v1 ?v0))) :named a3))
(check-sat)
(get-proof)
