unsat
(assume conjecture16 (! (not (! (= c$ zero$) :named @p_1)) :named @p_2))
(assume a49 (! (or (! (= b$ zero$) :named @p_3) @p_1) :named @p_4))
(assume a286 (! (not @p_3) :named @p_5))
(step t0 (cl @p_3 @p_1) :rule or :premises (a49))
(step t1 (cl @p_3) :rule resolution :premises (t0 conjecture16))
(step t2 (cl) :rule resolution :premises (t1 a286))
