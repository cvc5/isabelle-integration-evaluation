; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 613
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (minus$ (times$ x$ b$) (times$ y$ b$)) (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a1))
(assert (! (= (divide$ a$ c$) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a2))
(assert (! (= a$ (plus$ (times$ x$ (times$ b$ c$)) (modulo$ a$ (times$ b$ c$)))) :named a3))
(assert (! (not (= (times$ b$ c$) zero$)) :named a4))
(assert (! (exists ((?v0 Nat$)) (= a$ (plus$ (times$ ?v0 (times$ b$ c$)) (modulo$ a$ (times$ b$ c$))))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ (modulo$ ?v0 ?v1) ?v1) zero$)) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ (times$ ?v0 ?v1) ?v2) ?v1) (modulo$ ?v2 ?v1))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (times$ ?v0 ?v1) ?v2) (times$ ?v0 (times$ ?v1 ?v2)))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (times$ ?v0 ?v1) ?v0) zero$)) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ ?v0 (modulo$ ?v0 ?v1)) (times$ (divide$ ?v0 ?v1) ?v1))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a12))
(check-sat)
(get-proof)
