unsat
(assume conjecture16 (! (not (! (=> (! (and (= (! (fun_app$n size$b w1$) :named @p_3) (fun_app$n size$b w2$)) (= @p_3 (fun_app$ suc$ k$))) :named @p_4) (! (= (fun_app$q (fun_app$o f$ (fun_app$q (fun_app$o f$ x$) y$)) (fun_app$u (fun_app$v (! (scalar_product$ f$ zer$ g$) :named @p_1) w1$) w2$)) (fun_app$u (fun_app$v @p_1 (fun_app$j (times$ f$ x$) w1$)) (fun_app$j (times$ f$ y$) w2$))) :named @p_2)) :named @p_5)) :named @p_6))
(assume a18 (! (=> (! (and @p_4 @p_4) :named @p_7) @p_2) :named @p_8))
(step t0 (cl (not (! (= @p_8 @p_5) :named @p_9)) (not @p_8) @p_5) :rule equiv_pos2)
(step t1 (cl (= @p_7 @p_4)) :rule aci_simp)
(step t2 (cl (= @p_2 @p_2)) :rule refl)
(step t3 (cl @p_9) :rule cong :premises (t1 t2))
(step t4 (cl @p_5) :rule resolution :premises (t0 t3 a18))
(step t5 (cl) :rule resolution :premises (t4 conjecture16))
