; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_bool_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$) A_list_bool_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun fun_app$ (A_list_bool_fun$ A_list$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (forall ((?v0 A_list$)) (=> (member$ ?v0 (set$ (vec_mat_Tensor$ f$ v$ (cons$ a$ ma$)))) (fun_app$ (vec$ (times$ (row_length$ (cons$ a$ ma$)) (size$ v$))) ?v0)))) :named conjecture0))
(assert (! (forall ((?v0 A_list$)) (=> (member$ ?v0 (set$ (vec_mat_Tensor$ f$ v$ (cons$ a$ ma$)))) (fun_app$ (vec$ (times$ (row_length$ (cons$ a$ ma$)) (size$ v$))) ?v0))) :named a1))
(assert (! (forall ((?v0 A_list_set$) (?v1 A_list_bool_fun$)) (= (forall ((?v2 A_list$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))) (forall ((?v2 A_list$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))))) :named a2))
(check-sat)
(get-proof)
