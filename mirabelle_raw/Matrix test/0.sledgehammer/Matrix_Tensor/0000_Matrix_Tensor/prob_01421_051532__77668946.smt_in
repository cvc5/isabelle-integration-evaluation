; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 258
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun j$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun nat$ (Int) Nat$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not (=> (less$ zero$ j$) (= (nth$ (cons$ b$ n$) (nat$ (+ (of_nat$ j$) (- 1)))) (nth$ (cons$ a$ (cons$ b$ n$)) j$)))) :named conjecture0))
(assert (! (= one$ (suc$ zero$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v1) ?v0)) :named a2))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (+ ?v0 ?v1) ?v1) ?v0)) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$) (?v2 A_list_list$)) (! (=> (less$ zero$ ?v0) (= (nth$ (cons$ ?v1 ?v2) ?v0) (nth$ ?v2 (minus$ ?v0 one$)))) :pattern ((nth$ (cons$ ?v1 ?v2) ?v0)))) :named a4))
(check-sat)
(get-proof)
