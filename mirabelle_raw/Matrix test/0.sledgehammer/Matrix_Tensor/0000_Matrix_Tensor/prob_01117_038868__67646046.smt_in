; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 360
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$) Nat_nat_fun$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (=> (= i$ (size$ y$)) (= (nth$ (cons$ z$ zs$) (divide$ i$ (size$ y$))) (nth$ zs$ zero$)))) :named conjecture0))
(assert (! (= (nth$ (cons$ z$ zs$) one$) (nth$ zs$ zero$)) :named a1))
(assert (! (forall ((?v0 A_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a3))
(assert (! (= (plus$ one$) suc$) :named a4))
(assert (! (not (= y$ nil$)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (minus$ (fun_app$ (plus$ ?v0) ?v1)) ?v0) ?v1)) :named a6))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) ?v2) (ite (= ?v2 zero$) ?v0 (nth$ ?v1 (fun_app$ (minus$ ?v2) one$)))) :pattern ((nth$ (cons$ ?v0 ?v1) ?v2)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ ?v0 ?v1) (ite (or (less$ ?v0 ?v1) (= ?v1 zero$)) zero$ (fun_app$ suc$ (divide$ (fun_app$ (minus$ ?v0) ?v1) ?v1))))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a9))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (modulo$ ?v0) ?v0) zero$) :pattern ((modulo$ ?v0)))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (fun_app$ (modulo$ ?v0) ?v1) ?v0) (= (divide$ ?v0 ?v1) zero$))) :named a11))
(check-sat)
(get-proof)
