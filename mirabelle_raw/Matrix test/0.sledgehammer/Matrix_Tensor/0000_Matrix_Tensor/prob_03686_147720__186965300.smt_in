; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 251
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list_list$)
(declare-fun b$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(assert (! (not (member$ (hd$ a$) (set$ a$))) :named conjecture0))
(assert (! (= a$ (cons$ v$ b$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (hd$ (cons$ ?v0 ?v1)) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(check-sat)
(get-proof)
