(assert (! (forall ((?v0 A_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a18))
(assert (! (forall ((?v0 A_list$) (?v1 Nat$) (?v2 A$) (?v3 A_list$)) (=> (less_eq$ (size$ ?v0) ?v1) (= (nth$ (vec_vec_Tensor$ f$ (cons$ ?v2 ?v3) ?v0) ?v1) (nth$ (vec_vec_Tensor$ f$ ?v3 ?v0) (minus$ ?v1 (size$ ?v0)))))) :named a19))
(assert (! (=> (= i$ (size$ y$)) (= (less$ i$ (times$a (size$ (cons$ z$ zs$)) (size$ y$))) (less$ zero$ (times$a (size$ zs$) (size$ y$))))) :named a20))
