; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 245
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_list_list_list$ 0)
(declare-sort B_list_list_list_list$ 0)
(declare-sort B_list_list_list_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun z$ () B_list$)
(declare-fun hd$ (B_list_list$) B_list$)
(declare-fun nil$ () B_list_list$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun nil$a () B_list_list_list_list_list$)
(declare-fun nil$b () B_list_list_list_list$)
(declare-fun nil$c () B_list_list_list$)
(declare-fun nil$d () B_list$)
(declare-fun concat$ (B_list_list_list_list_list$) B_list_list_list_list$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(declare-fun concat$a (B_list_list_list_list$) B_list_list_list$)
(declare-fun concat$b (B_list_list_list$) B_list_list$)
(declare-fun concat$c (B_list_list$) B_list$)
(assert (! (not (member$ z$ (set$ m$))) :named conjecture0))
(assert (! (not (= m$ nil$)) :named a1))
(assert (! (= z$ (hd$ m$)) :named a2))
(assert (! (= (concat$ nil$a) nil$b) :named a3))
(assert (! (= (concat$a nil$b) nil$c) :named a4))
(assert (! (= (concat$b nil$c) nil$) :named a5))
(assert (! (= (concat$c nil$) nil$d) :named a6))
(check-sat)
(get-proof)
