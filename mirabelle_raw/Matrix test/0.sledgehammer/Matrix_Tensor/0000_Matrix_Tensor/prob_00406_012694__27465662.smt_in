; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 245
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun m$ () A_list_list$)
(declare-fun x$ () A_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun insert$ (A_list$ A_list_set$) A_list_set$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(assert (! (not (=> (member$ x$ (set$ m$)) (vec$ (size$ a$) x$))) :named conjecture0))
(assert (! (=> (member$ x$ (set$ (cons$ a$ m$))) (vec$ (size$ a$) x$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_set$)) (= (member$ ?v0 (insert$ ?v1 ?v2)) (or (= ?v0 ?v1) (member$ ?v0 ?v2)))) :named a2))
(check-sat)
(get-proof)
