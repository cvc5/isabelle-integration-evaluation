unsat
(assume conjecture0 (! (not (! (= (! (size$ (nth$ a$ j$)) :named @p_2) (! (row_length$ a$) :named @p_1)) :named @p_3)) :named @p_4))
(assume a1 (! (= @p_1 nr$) :named @p_5))
(assume a2 (! (= @p_2 nr$) :named @p_6))
(step t0 (cl (not (! (= @p_6 @p_3) :named @p_7)) (not @p_6) @p_3) :rule equiv_pos2)
(step t1 (cl (= @p_6 (! (= nr$ @p_2) :named @p_8))) :rule rare_rewrite :args ("eq-symm" @p_2 nr$))
(step t2 (cl (= nr$ @p_1)) :rule symm :premises (a1))
(step t3 (cl (= @p_2 @p_2)) :rule refl)
(step t4 (cl (= @p_8 (! (= @p_1 @p_2) :named @p_9))) :rule cong :premises (t2 t3))
(step t5 (cl (= @p_9 @p_3)) :rule rare_rewrite :args ("eq-symm" @p_1 @p_2))
(step t6 (cl (= @p_8 @p_3)) :rule trans :premises (t4 t5))
(step t7 (cl @p_7) :rule trans :premises (t1 t6))
(step t8 (cl @p_3) :rule resolution :premises (t0 t7 a2))
(step t9 (cl) :rule resolution :premises (t8 conjecture0))
