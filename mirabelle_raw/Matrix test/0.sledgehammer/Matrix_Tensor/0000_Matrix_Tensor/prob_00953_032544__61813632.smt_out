unsat
(assume conjecture0 (! (not b$) :named @p_1))
(assume a1 (! (=> (! (not a$) :named @p_2) b$) :named @p_3))
(assume a5 (! (=> a$ b$) :named @p_4))
(step t0 (cl @p_2 b$) :rule implies :premises (a5))
(step t1 (cl b$ @p_2) :rule reordering :premises (t0))
(step t2 (cl (not (! (= (! (or (! (not @p_2) :named @p_6) b$) :named @p_7) (! (or a$ b$) :named @p_5)) :named @p_8)) (not @p_7) @p_5) :rule equiv_pos2)
(step t3 (cl (= @p_6 a$)) :rule rare_rewrite :args ("bool-double-not-elim" a$))
(step t4 (cl (= b$ b$)) :rule refl)
(step t5 (cl @p_8) :rule cong :premises (t3 t4))
