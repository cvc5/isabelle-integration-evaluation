; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 229
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun fun_app$ (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$) A_list_a_list_fun$)
(assert (! (not (= (fun_app$ (vec_vec_Tensor$ f$ v$) w$) nil$)) :named conjecture0))
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ (vec_vec_Tensor$ f$ ?v0) nil$) nil$) :pattern ((vec_vec_Tensor$ f$ ?v0)))) :named a1))
(check-sat)
(get-proof)
