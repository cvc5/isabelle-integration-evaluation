unsat
(assume conjecture1 (! (not (! (=> (! (and (= (! (size$ w1$) :named @p_4) (size$ w2$)) (= @p_4 (suc$ k$))) :named @p_5) (! (= (fun_app$b (fun_app$ f$ (fun_app$b (fun_app$ f$ x$) y$)) (fun_app$c (fun_app$d (! (scalar_product$ f$ zer$ g$) :named @p_2) w1$) w2$)) (fun_app$c (fun_app$d @p_2 (fun_app$e (fun_app$f (! (times$ f$) :named @p_1) x$) w1$)) (fun_app$e (fun_app$f @p_1 y$) w2$))) :named @p_3)) :named @p_6)) :named @p_7))
