; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort B$ 0)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-fun f$ (A$ A$) A$)
(declare-fun p$ (B$ C$) Bool)
(declare-fun q$ (B$ C$) Bool)
(declare-fun r$ (B$ C$) Bool)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun of_int$ (Int) Int)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not (forall ((?v0 B$) (?v1 C$)) (=> (p$ ?v0 ?v1) (r$ ?v0 ?v1)))) :named conjecture0))
(assert (! (and (forall ((?v0 B$) (?v1 C$)) (=> (p$ ?v0 ?v1) (q$ ?v0 ?v1))) (forall ((?v0 B$) (?v1 C$)) (=> (q$ ?v0 ?v1) (r$ ?v0 ?v1)))) :named hypothesis1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (= (of_nat$ ?v0) (of_nat$ ?v1)) (= ?v0 ?v1))) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A$)) (= (f$ ?v0 ?v1) (f$ ?v1 ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (of_nat$ ?v0) (of_nat$ ?v1)) (= ?v0 ?v1))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= ?v0 ?v1) (= (of_nat$ ?v0) (of_nat$ ?v1)))) :named a5))
(assert (! (forall ((?v0 Bool) (?v1 Nat$) (?v2 Nat$)) (= (of_nat$ (ite ?v0 ?v1 ?v2)) (ite ?v0 (of_nat$ ?v1) (of_nat$ ?v2)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (of_nat$ ?v0) (of_nat$ ?v1)) (= ?v0 ?v1))) :named a7))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a8))
(assert (! (forall ((?v0 Nat$)) (= (of_int$ (of_nat$ ?v0)) (of_nat$ ?v0))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Int)) (= (= (of_nat$ ?v0) (of_int$ ?v1)) (= ?v1 (of_nat$ ?v0)))) :named a11))
(assert (! (forall ((?v0 Int) (?v1 Nat$)) (= (= (of_int$ ?v0) (of_nat$ ?v1)) (= ?v0 (of_nat$ ?v1)))) :named a12))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (= (of_int$ ?v0) (of_int$ ?v1)) (= ?v0 ?v1))) :named a13))
(check-sat)
(get-proof)
