unsat
(assume conjecture8 (! (not (=> (! (less$ i$ (size$b nil$)) :named @p_1) (= (fun_app$h (nth$c (fun_app$i (times$ f$ a$) nil$a)) i$) (fun_app$j (fun_app$k f$ a$) (fun_app$h (nth$c nil$a) i$))))) :named @p_2))
(assume a11 (! (=> @p_1 false) :named @p_3))
(step t0 (cl (not (! (= @p_3 (! (not @p_1) :named @p_4)) :named @p_5)) (not @p_3) @p_4) :rule equiv_pos2)
(step t1 (cl @p_5) :rule rare_rewrite :args ("bool-impl-false1" @p_1))
(step t2 (cl @p_4) :rule resolution :premises (t0 t1 a11))
(step t3 (cl @p_1) :rule not_implies1 :premises (conjecture8))
