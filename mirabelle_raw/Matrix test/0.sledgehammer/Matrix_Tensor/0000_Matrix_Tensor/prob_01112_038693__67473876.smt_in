; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 311
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (=> (= i$ (size$ y$)) (= (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$ y$))) (less$ zero$ (times$ (size$ zs$) (size$ y$)))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ (plus$ (size$ ?v1)) (fun_app$ suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (= (plus$ one$) suc$) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (less$ ?v0 ?v1) (less$ ?v1 ?v0)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (times$ ?v1 ?v0) ?v0) ?v1))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (fun_app$ (plus$ ?v0) ?v1) ?v1) ?v0)) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (fun_app$ (plus$ ?v0) ?v1) ?v0) ?v1)) :named a7))
(assert (! (forall ((?v0 A_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a10))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a11))
(assert (! (not (= zero$ one$)) :named a12))
(assert (! (=> (= i$ (size$ y$)) (= (modulo$ i$ (size$ y$)) zero$)) :named a13))
(check-sat)
(get-proof)
