(assert (! (forall ((?v0 B_list_b_fun$) (?v1 B_list_list$)) (= (= (fun_app$a (map$ ?v0) ?v1) nil$a) (= ?v1 nil$))) :named a4))
(assert (! (forall ((?v0 B_list_b_list_fun$) (?v1 B_list_list$)) (= (= (fun_app$d (map$c ?v0) ?v1) nil$) (= ?v1 nil$))) :named a5))
