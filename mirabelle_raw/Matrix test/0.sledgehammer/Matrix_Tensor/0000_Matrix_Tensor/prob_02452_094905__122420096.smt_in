; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 263
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$) Nat_nat_fun$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (fun_app$ (minus$ (times$ y$ b$)) (times$ x$ b$)) (fun_app$ (minus$ (divide$ (modulo$ a$ (times$ b$ c$)) c$)) (modulo$ (divide$ a$ c$) b$)))) :named conjecture0))
(assert (! (= (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a1))
(assert (! (= (divide$ a$ c$) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a2))
(assert (! (less$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) b$) :named a3))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (=> (less$ ?v0 ?v1) (= (modulo$ ?v0 ?v1) ?v0)) :pattern ((modulo$ ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (minus$ (plus$ ?v0 ?v1)) ?v1) ?v0)) :named a6))
(check-sat)
(get-proof)
