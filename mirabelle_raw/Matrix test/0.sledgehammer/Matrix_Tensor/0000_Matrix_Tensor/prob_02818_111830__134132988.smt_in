; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 243
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun m1$ () A_list_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun m3$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ (times$ (row_length$ m2$) (row_length$ m3$)) (times$ (size$ m2$) (size$ m3$)) (tensor$ f$ m2$ m3$))) :named conjecture0))
(assert (! (and (mat$ (row_length$ m1$) (size$ m1$) m1$) (and (mat$ (row_length$ m2$) (size$ m2$) m2$) (mat$ (row_length$ m3$) (size$ m3$) m3$))) :named a1))
(check-sat)
(get-proof)
