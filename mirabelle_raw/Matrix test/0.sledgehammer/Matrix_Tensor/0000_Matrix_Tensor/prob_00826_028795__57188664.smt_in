; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun xs$ () B_list$)
(declare-fun ys$ () B_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun append$ (B_list$ B_list$) B_list$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ xs$) i$) (= (nth$ (append$ xs$ ys$) i$) (nth$ ys$ (minus$ i$ (size$ xs$)))))) :named conjecture0))
(assert (! (forall ((?v0 B_list$) (?v1 Nat$) (?v2 B_list$)) (=> (less_eq$ (size$ ?v0) ?v1) (= (nth$ (append$ ?v0 ?v2) ?v1) (nth$ ?v2 (minus$ ?v1 (size$ ?v0)))))) :named a1))
(check-sat)
(get-proof)
