unsat
(assume conjecture1 (! (not (! (= (! (fun_app$c size$ u1$) :named @p_2) (! (fun_app$c size$ u2$) :named @p_1)) :named @p_3)) :named @p_4))
(assume a2 (! (and (= v1$ (fun_app$d (cons$ a1$) u1$)) (! (= @p_2 k$) :named @p_5)) :named @p_6))
(assume a3 (! (and (= v2$ (fun_app$d (cons$ a2$) u2$)) (! (= @p_1 k$) :named @p_7)) :named @p_8))
(step t0 (cl (not (! (= @p_7 @p_3) :named @p_9)) (not @p_7) @p_3) :rule equiv_pos2)
(step t1 (cl (= @p_7 (! (= k$ @p_1) :named @p_10))) :rule rare_rewrite :args ("eq-symm" @p_1 k$))
(step t2 (cl @p_5) :rule and :premises (a2) :args (1))
(step t3 (cl (= k$ @p_2)) :rule symm :premises (t2))
(step t4 (cl (= @p_1 @p_1)) :rule refl)
(step t5 (cl (= @p_10 @p_3)) :rule cong :premises (t3 t4))
(step t6 (cl @p_9) :rule trans :premises (t1 t5))
(step t7 (cl @p_7) :rule and :premises (a3) :args (1))
(step t8 (cl @p_3) :rule resolution :premises (t0 t6 t7))
(step t9 (cl) :rule resolution :premises (t8 conjecture1))
