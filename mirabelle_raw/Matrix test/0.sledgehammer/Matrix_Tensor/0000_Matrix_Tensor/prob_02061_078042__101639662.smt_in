; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 252
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (row$ (cons$ (vec_vec_Tensor$ f$ v$ w$) (vec_mat_Tensor$ f$ v$ n$)) i$) (cons$a (nth$ (vec_vec_Tensor$ f$ v$ w$) i$) (row$ (vec_mat_Tensor$ f$ v$ n$) i$)))) :named conjecture0))
(assert (! (= (row$ (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) i$) (row$ (cons$ (vec_vec_Tensor$ f$ v$ w$) (vec_mat_Tensor$ f$ v$ n$)) i$)) :named a1))
(check-sat)
(get-proof)
