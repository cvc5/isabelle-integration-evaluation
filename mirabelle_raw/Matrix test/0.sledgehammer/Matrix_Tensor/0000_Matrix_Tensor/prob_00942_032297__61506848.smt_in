; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun m$ () Nat$)
(declare-fun n$ () Nat$)
(declare-fun modulo$ (Int Int) Int)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun modulo$a (Nat$ Nat$) Nat$)
(assert (! (not (= (modulo$ (of_nat$ m$) (of_nat$ n$)) (of_nat$ (modulo$a m$ n$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (of_nat$ (modulo$a ?v0 ?v1)) (modulo$ (of_nat$ ?v0) (of_nat$ ?v1)))) :named a1))
(check-sat)
(get-proof)
