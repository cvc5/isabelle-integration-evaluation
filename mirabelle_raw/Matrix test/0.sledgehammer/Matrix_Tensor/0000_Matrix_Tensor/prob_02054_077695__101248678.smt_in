; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun v$ () A_list$)
(declare-fun nr$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun times$a (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (=> (and (less$ i$ (times$ (size$ v$) (row_length$ nil$))) (mat$ nr$ (size$a nil$) nil$)) (= (row$ (vec_mat_Tensor$ f$ v$ nil$) i$) (times$a f$ (nth$ v$ (divide$ i$ (row_length$ nil$))) (row$ nil$ (modulo$ i$ (row_length$ nil$))))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a1))
(assert (! (= (row_length$ nil$) zero$) :named a2))
(check-sat)
(get-proof)
