; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 241
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort Integer$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun one$a () Integer$)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun zero$ () Integer$)
(declare-fun dbl_inc$ (Integer$) Integer$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun nat_of_integer$ (Integer$) Nat$)
(assert (! (not (= (nth$ zs$ j$) (nth$ (cons$ z$ zs$) (fun_app$ (plus$ j$) one$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a1))
(assert (! (= (nat_of_integer$ one$a) one$) :named a2))
(assert (! (= (dbl_inc$ zero$) one$a) :named a3))
(assert (! (= (plus$ one$) suc$) :named a4))
(check-sat)
(get-proof)
