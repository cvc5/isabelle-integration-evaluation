; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 323
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (divide$ a$ b$) (plus$ (divide$ (minus$ a$ b$) b$) one$))) :named conjecture0))
(assert (! (less$ b$ a$) :named a1))
(assert (! (less$ zero$ b$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (less$ ?v0 ?v1) (less$ ?v1 ?v0)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less_eq$ ?v0 ?v1)) (less$ ?v1 ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (less$ ?v0 ?v1)) (= (plus$ ?v1 (minus$ ?v0 ?v1)) ?v0))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (less_eq$ ?v0 ?v1))) :named a6))
(check-sat)
(get-proof)
