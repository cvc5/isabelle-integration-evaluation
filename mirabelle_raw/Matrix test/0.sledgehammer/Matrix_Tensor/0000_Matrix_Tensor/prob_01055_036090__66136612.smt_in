; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 280
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(assert (! (not (=> (less$ (size$ y$) i$) (= (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$ y$))) (less$ (minus$ i$ (size$ y$)) (times$ (size$ zs$) (size$ y$)))))) :named conjecture0))
(assert (! (less$ zero$ (size$ y$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ ?v0 ?v1) (ite (or (less$ ?v0 ?v1) (= ?v1 zero$)) zero$ (suc$ (divide$ (minus$ ?v0 ?v1) ?v1))))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less$ ?v0 ?v1)) (or (less$ ?v1 ?v0) (= ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ zero$ ?v0) (= (less$ (divide$ ?v1 ?v0) ?v2) (less$ ?v1 (times$ ?v2 ?v0))))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (less$ ?v1 ?v2))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v2) ?v1))) :named a6))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (less$ ?v0 ?v1) (less$ ?v1 ?v0)))) :named a8))
(check-sat)
(get-proof)
