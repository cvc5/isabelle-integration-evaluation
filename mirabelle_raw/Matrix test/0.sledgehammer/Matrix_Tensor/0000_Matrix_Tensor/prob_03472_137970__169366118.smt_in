; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun xs$ () A_list$)
(declare-fun ys$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$) A_list_a_list_fun$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun fun_app$b (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ xs$ ys$) zer$)) :named conjecture0))
(assert (! (= xs$ nil$) :named a1))
(assert (! (= ys$ nil$) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A$)) (= (fun_app$ (fun_app$a f$ ?v0) ?v1) (fun_app$ (fun_app$a f$ ?v1) ?v0))) :named a3))
(assert (! (forall ((?v0 A$)) (= (fun_app$ (fun_app$a f$ zer$) ?v0) zer$)) :named a4))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$b (times$ f$ ?v0) nil$) nil$) :pattern ((times$ f$ ?v0)))) :named a5))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A$) (?v3 A$)) (=> (= (size$ ?v0) (size$ ?v1)) (= (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ ?v2) ?v3)) (scalar_product$ f$ zer$ g$ ?v0 ?v1)) (scalar_product$ f$ zer$ g$ (fun_app$b (times$ f$ ?v2) ?v0) (fun_app$b (times$ f$ ?v3) ?v1))))) :named a6))
(check-sat)
(get-proof)
