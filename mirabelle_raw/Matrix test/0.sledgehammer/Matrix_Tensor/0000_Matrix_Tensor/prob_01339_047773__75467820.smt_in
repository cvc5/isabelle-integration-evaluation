; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun x$ () A$)
(declare-fun ma$ () A_list_list$)
(declare-fun xs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nth$a (A_list_list$ Nat$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (forall ((?v0 Nat$)) (=> (less$ ?v0 (times$ (row_length$ (cons$ a$ ma$)) (size$ v$))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ a$ ma$)) zero$) ?v0) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ ?v0 (row_length$ (cons$ a$ ma$))))) (nth$ (nth$a (cons$ a$ ma$) zero$) (modulo$ ?v0 (row_length$ (cons$ a$ ma$))))))))) :named conjecture0))
(assert (! (= (nth$a (vec_mat_Tensor$ f$ v$ (cons$ a$ ma$)) zero$) (vec_vec_Tensor$ f$ v$ a$)) :named a1))
(assert (! (= (row_length$ (cons$ a$ ma$)) (size$ a$)) :named a2))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (times$ (size$ a$) (size$ v$))) (= (nth$ (vec_vec_Tensor$ f$ v$ a$) ?v0) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ ?v0 (size$ a$)))) (nth$ a$ (modulo$ ?v0 (size$ a$))))))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (nth$a (cons$ ?v0 ?v1) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (nth$ (cons$a ?v0 ?v1) zero$) ?v0) :pattern ((cons$a ?v0 ?v1)))) :named a5))
(assert (! (= (size$ nil$) zero$) :named a6))
(assert (! (= a$ (cons$a x$ xs$)) :named a7))
(check-sat)
(get-proof)
