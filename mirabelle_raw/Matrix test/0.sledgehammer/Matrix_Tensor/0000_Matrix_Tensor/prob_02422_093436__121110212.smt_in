; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 289
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun dvd$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (divide$ a$ c$) (plus$ (divide$ (times$ x$ (times$ b$ c$)) c$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= a$ (plus$ (times$ x$ (times$ b$ c$)) (modulo$ a$ (times$ b$ c$)))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (modulo$ ?v0 (times$ ?v1 ?v2)) ?v2) (modulo$ ?v0 ?v2))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (divide$ (plus$ ?v0 ?v1) ?v2) (plus$ (plus$ (divide$ ?v0 ?v2) (divide$ ?v1 ?v2)) (divide$ (plus$ (modulo$ ?v0 ?v2) (modulo$ ?v1 ?v2)) ?v2)))) :named a3))
(assert (! (forall ((?v0 Nat$)) (= (modulo$ ?v0 zero$) ?v0)) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ (modulo$ ?v0 ?v1) ?v1) zero$)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (plus$ ?v0 ?v1) ?v0) (modulo$ ?v1 ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (plus$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (dvd$ ?v0 ?v1) (= (divide$ (plus$ ?v1 ?v2) ?v0) (plus$ (divide$ ?v1 ?v0) (divide$ ?v2 ?v0))))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (dvd$ ?v0 (times$ ?v1 ?v0))) :named a9))
(check-sat)
(get-proof)
