unsat
(assume conjecture0 (! (not (! (fun_app$ (! (mat$ zero$ zero$) :named @p_1) m$) :named @p_2)) :named @p_3))
(assume a3 (! (fun_app$ @p_1 nil$b) :named @p_4))
(assume a7 (! (= m$ nil$b) :named @p_5))
(step t0 (cl (not (! (= (! (= true false) :named @p_6) false) :named @p_10)) (not @p_6) false) :rule equiv_pos2)
(step t1 (cl @p_10) :rule evaluate)
(step t2 (cl (= (! (= @p_4 true) :named @p_9) @p_4)) :rule equiv_simplify)
(step t3 (cl @p_9 (not @p_4)) :rule equiv2 :premises (t2))
(step t4 (cl @p_9) :rule resolution :premises (t3 a3))
(step t5 (cl (= true @p_4)) :rule symm :premises (t4))
