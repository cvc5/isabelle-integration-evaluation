(step t9 (cl @p_7 (! (not @p_3) :named @p_8)) :rule equiv2 :premises (t8))
(step t10 (cl (not @p_8) @p_2) :rule not_not)
(step t11 (cl @p_7 @p_2) :rule resolution :premises (t9 t10))
(step t12 (cl @p_7) :rule resolution :premises (t11 conjecture0))
(step t13 (cl @p_6) :rule trans :premises (t5 t7 t12))
(step t14 (cl false) :rule resolution :premises (t0 t1 t13))
(step t15 (cl (not false)) :rule false)
(step t16 (cl) :rule resolution :premises (t14 t15))
