unsat
(assume conjecture0 (! (not (! (less$ (fun_app$ (minus$ j$) (! (size$ m2$) :named @p_1)) (times$ (size$ m$) @p_1)) :named @p_2)) :named @p_3))
(assume a5 (! (=> (! (less_eq$ @p_1 j$) :named @p_4) @p_2) :named @p_5))
(assume a19 @p_4)
(step t0 (cl (! (not @p_4) :named @p_6) @p_2) :rule implies :premises (a5))
(step t1 (cl @p_2 @p_6) :rule reordering :premises (t0))
(step t2 (cl @p_6) :rule resolution :premises (t1 conjecture0))
(step t3 (cl) :rule resolution :premises (a19 t2))
