; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 267
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A$)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun w$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row$ (cons$ w$ n$) (modulo$ i$ (row_length$ (cons$ w$ n$)))) (cons$a (nth$ w$ (modulo$ i$ (row_length$ (cons$ w$ n$)))) (row$ n$ (modulo$ i$ (row_length$ (cons$ w$ n$))))))) :named conjecture0))
(assert (! (= w$ (cons$a a$ w2$)) :named a1))
(check-sat)
(get-proof)
