; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 291
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun m$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun drop$ (Nat$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun take$ (Nat$ A_list_list$) A_list_list$)
(declare-fun zero$ () Nat$)
(declare-fun append$ (A_list_list$ A_list_list$) A_list_list$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (fun_app$ suc$ (size$ (reduct$ m$))) (size$ m$))) :named conjecture0))
(assert (! (not (= m$ nil$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ (plus$ (size$ ?v1)) (fun_app$ suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a4))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a5))
(assert (! (= (plus$ one$) suc$) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a7))
(assert (! (forall ((?v0 A_list_list$)) (! (= (append$ nil$ ?v0) ?v0) :pattern ((append$ nil$ ?v0)))) :named a8))
(assert (! (forall ((?v0 A_list_list$)) (! (= (take$ zero$ ?v0) nil$) :pattern ((take$ zero$ ?v0)))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (=> (less$ ?v0 (size$ ?v1)) (= ?v1 (append$ (take$ ?v0 ?v1) (cons$ (nth$ ?v1 ?v0) (drop$ (fun_app$ suc$ ?v0) ?v1)))))) :named a10))
(check-sat)
(get-proof)
