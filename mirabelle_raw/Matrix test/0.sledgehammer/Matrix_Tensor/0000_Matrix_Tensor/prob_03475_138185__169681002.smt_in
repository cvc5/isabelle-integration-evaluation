; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun id$ () A$)
(declare-fun ws$ () A_list$)
(declare-fun xs$ () A_list$)
(declare-fun ys$ () A_list$)
(declare-fun zs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun inver$ () A_a_fun$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun plus_mult$ (A$ A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_a_fun$) Bool)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (fun_app$ (fun_app$a g$ (scalar_product$ f$ zer$ g$ xs$ ys$)) (scalar_product$ f$ zer$ g$ zs$ ws$)) (scalar_product$ f$ zer$ g$ zs$ ws$))) :named conjecture0))
(assert (! (forall ((?v0 A$)) (= (fun_app$ (fun_app$a g$ zer$) ?v0) ?v0)) :named a1))
(assert (! (= (scalar_product$ f$ zer$ g$ xs$ ys$) zer$) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A$) (?v3 A_a_a_fun_fun$) (?v4 A_a_fun$) (?v5 A$)) (=> (plus_mult$ ?v0 ?v1 ?v2 ?v3 ?v4) (= (fun_app$ (fun_app$a ?v3 ?v2) ?v5) ?v5))) :named a3))
(assert (! (plus_mult$ id$ f$ zer$ g$ inver$) :named a4))
(assert (! (= ys$ nil$) :named a5))
(assert (! (= xs$ nil$) :named a6))
(check-sat)
(get-proof)
