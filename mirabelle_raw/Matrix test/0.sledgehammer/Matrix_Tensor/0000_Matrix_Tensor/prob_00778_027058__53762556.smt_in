(declare-fun atLeastLessThan$ (Nat$ Nat$) Nat_set$)
(assert (! (forall ((?v0 A_list$) (?v1 A$)) (! (= (fun_app$ (uu$ ?v0) ?v1) (exists ((?v2 Nat$)) (and (= ?v1 (fun_app$a (nth$ ?v0) ?v2)) (less$ ?v2 (size$ ?v0))))) :pattern ((fun_app$ (uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (forall ((?v0 Nat$)) (= (fun_app$a (nth$ (cons$ x$ xs$)) (fun_app$b (plus$ ?v0) one$)) (fun_app$a (nth$ xs$) ?v0)))) :named conjecture1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$b (plus$ ?v0) (fun_app$b suc$ ?v1)) (fun_app$b suc$ (fun_app$b (plus$ ?v0) ?v1)))) :named a2))
(assert (! (= one$ (fun_app$b suc$ zero$)) :named a3))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 Nat$)) (! (= (fun_app$a (nth$ (cons$ ?v0 ?v1)) (fun_app$b suc$ ?v2)) (fun_app$a (nth$ ?v1) ?v2)) :pattern ((fun_app$a (nth$ (cons$ ?v0 ?v1)) (fun_app$b suc$ ?v2))))) :named a4))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$b (plus$ ?v0) zero$) ?v0)) :named a5))
(assert (! (= (size$ nil$) zero$) :named a6))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$b (plus$ (size$ ?v1)) (fun_app$b suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 Nat$)) (! (= (fun_app$a (nth$ (cons$ ?v0 ?v1)) ?v2) (case_nat$ ?v0 (nth$ ?v1) ?v2)) :pattern ((fun_app$a (nth$ (cons$ ?v0 ?v1)) ?v2)))) :named a8))
(assert (! (forall ((?v0 A_list$)) (! (= (append$ nil$ ?v0) ?v0) :pattern ((append$ nil$ ?v0)))) :named a9))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (fun_app$a (nth$ (cons$ ?v0 ?v1)) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$b (plus$ (fun_app$b suc$ ?v0)) ?v1) (fun_app$b suc$ (fun_app$b (plus$ ?v0) ?v1)))) :named a11))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$b (plus$ zero$) ?v0) ?v0)) :named a12))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 Nat$)) (= (fun_app$a (nth$ (append$ ?v0 ?v1)) (fun_app$b (plus$ (size$ ?v0)) ?v2)) (fun_app$a (nth$ ?v1) ?v2))) :named a13))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (size$ xs$)) (= (fun_app$a (nth$ (times$ f$ a$ xs$)) ?v0) (fun_app$c (fun_app$d f$ a$) (fun_app$a (nth$ xs$) ?v0))))) :named a14))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A_list$)) (! (= (append$ (cons$ ?v0 ?v1) ?v2) (cons$ ?v0 (append$ ?v1 ?v2))) :pattern ((append$ (cons$ ?v0 ?v1) ?v2)))) :named a15))
(assert (! (forall ((?v0 A$) (?v1 A_bool_fun$)) (= (member$ ?v0 (collect$ ?v1)) (fun_app$ ?v1 ?v0))) :named a16))
(assert (! (forall ((?v0 Nat$)) (fun_app$e (fun_app$f less_eq$ zero$) ?v0)) :named a17))
(assert (! (forall ((?v0 Nat$)) (not (= (fun_app$b suc$ ?v0) zero$))) :named a18))
(assert (! (forall ((?v0 A_list$)) (=> (and (=> (= ?v0 nil$) false) (forall ((?v1 A$) (?v2 A_list$)) (=> (= ?v0 (cons$ ?v1 ?v2)) false))) false)) :named a19))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$b (minus$ ?v0) zero$) ?v0)) :named a20))
(assert (! (forall ((?v0 A_list$)) (= (set$ ?v0) (collect$ (uu$ ?v0)))) :named a21))
(assert (! (forall ((?v0 Nat$) (?v1 A$) (?v2 A_list$)) (! (=> (less$ zero$ ?v0) (= (fun_app$a (nth$ (cons$ ?v1 ?v2)) ?v0) (fun_app$a (nth$ ?v2) (fun_app$b (minus$ ?v0) one$)))) :pattern ((fun_app$a (nth$ (cons$ ?v1 ?v2)) ?v0)))) :named a22))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$b suc$ ?v0) (fun_app$b (plus$ ?v0) one$))) :named a23))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (= (= (remdups_adj$ ?v0) ?v1) (exists ((?v2 Nat_nat_fun$)) (and (monotone_on$ top$ less_eq$ less_eq$ ?v2) (and (= (image$ ?v2 (atLeastLessThan$ zero$ (size$ ?v0))) (atLeastLessThan$ zero$ (size$ ?v1))) (and (forall ((?v3 Nat$)) (=> (less$ ?v3 (size$ ?v0)) (= (fun_app$a (nth$ ?v0) ?v3) (fun_app$a (nth$ ?v1) (fun_app$b ?v2 ?v3))))) (forall ((?v3 Nat$)) (=> (less$ (fun_app$b (plus$ ?v3) one$) (size$ ?v0)) (= (= (fun_app$a (nth$ ?v0) ?v3) (fun_app$a (nth$ ?v0) (fun_app$b (plus$ ?v3) one$))) (= (fun_app$b ?v2 ?v3) (fun_app$b ?v2 (fun_app$b (plus$ ?v3) one$)))))))))))) :named a24))
(assert (! (forall ((?v0 Nat$)) (less$ zero$ (fun_app$b suc$ ?v0))) :named a25))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 ?v0))) :named a26))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (not (= (cons$ ?v0 ?v1) nil$))) :named a27))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 Nat$)) (! (= (fun_app$a (nth$ (cons$ ?v0 ?v1)) ?v2) (ite (= ?v2 zero$) ?v0 (fun_app$a (nth$ ?v1) (fun_app$b (minus$ ?v2) one$)))) :pattern ((fun_app$a (nth$ (cons$ ?v0 ?v1)) ?v2)))) :named a28))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_set$)) (= (member$ ?v0 (insert$ ?v1 ?v2)) (or (= ?v0 ?v1) (member$ ?v0 ?v2)))) :named a29))
(check-sat)
(get-proof)
