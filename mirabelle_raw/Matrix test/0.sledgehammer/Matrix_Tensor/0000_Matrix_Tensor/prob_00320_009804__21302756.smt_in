(assert (! (not (= (hd$ (tensor$ f$ (cons$ a$ m1a$) (cons$ aa$ m2a$))) (hd$ (vec_mat_Tensor$ f$ a$ (cons$ aa$ m2a$))))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list_list$)) (! (= (tensor$ f$ (cons$ ?v0 ?v1) ?v2) (append$ (vec_mat_Tensor$ f$ ?v0 ?v2) (tensor$ f$ ?v1 ?v2))) :pattern ((tensor$ f$ (cons$ ?v0 ?v1) ?v2)))) :named a1))
(assert (! (= (hd$ (append$ (vec_mat_Tensor$ f$ a$ (cons$ aa$ m2a$)) (tensor$ f$ m1a$ m2a$))) (hd$ (vec_mat_Tensor$ f$ a$ (cons$ aa$ m2a$)))) :named a2))
