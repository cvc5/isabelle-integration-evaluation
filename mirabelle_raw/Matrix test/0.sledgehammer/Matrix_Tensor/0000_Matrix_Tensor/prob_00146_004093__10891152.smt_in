(assert (! (forall ((?v0 A_list_list_list$)) (! (= (append$a nil$a ?v0) ?v0) :pattern ((append$a nil$a ?v0)))) :named a13))
(assert (! (forall ((?v0 A_list_list$)) (! (= (append$b nil$b ?v0) ?v0) :pattern ((append$b nil$b ?v0)))) :named a14))
(assert (! (forall ((?v0 A_list$)) (! (= (take$ zero$ ?v0) nil$) :pattern ((take$ zero$ ?v0)))) :named a15))
