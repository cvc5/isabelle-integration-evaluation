(declare-fun concat$b (A_list_list$) A_list$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (fun_app$ suc$ (size$ (reduct$ m$))) (size$ m$))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ (plus$ (size$ ?v1)) (fun_app$ suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a3))
(assert (! (forall ((?v0 A_list$)) (= (less$ zero$ (size$a ?v0)) (not (= ?v0 nil$)))) :named a4))
(assert (! (forall ((?v0 A_list_list_list$)) (= (less$ zero$ (size$b ?v0)) (not (= ?v0 nil$a)))) :named a5))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$b)))) :named a6))
