(assert (! (= (size$b nil$a) zero$) :named a8))
(assert (! (= (size$ nil$b) zero$) :named a9))
(assert (! (= (plus$ one$) suc$) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a11))
