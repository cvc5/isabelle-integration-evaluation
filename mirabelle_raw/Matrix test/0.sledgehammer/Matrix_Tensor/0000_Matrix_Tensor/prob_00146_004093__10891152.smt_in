(assert (! (forall ((?v0 A_list_list$)) (! (= (take$b zero$ ?v0) nil$b) :pattern ((take$b zero$ ?v0)))) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (=> (less$ ?v0 (size$ ?v1)) (= ?v1 (append$b (take$b ?v0 ?v1) (cons$ (nth$ ?v1 ?v0) (drop$ (fun_app$ suc$ ?v0) ?v1)))))) :named a18))
