; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 236
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun size$ (A_list$) Nat$)
(assert (! (not (= (size$ w2$) (suc$ k$))) :named conjecture0))
(assert (! (and (= (size$ w1$) (size$ w2$)) (= (size$ w1$) (suc$ k$))) :named a1))
(check-sat)
(get-proof)
