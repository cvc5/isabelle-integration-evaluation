; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 246
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun x$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun fun_app$b (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (nth$ (cons$ (fun_app$ (fun_app$a f$ a$) x$) (times$ f$ a$ xs$)) i$) (nth$ (times$ f$ a$ xs$) j$))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (fun_app$b suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (fun_app$b suc$ ?v2))))) :named a1))
(assert (! (= (plus$ one$) suc$) :named a2))
(check-sat)
(get-proof)
