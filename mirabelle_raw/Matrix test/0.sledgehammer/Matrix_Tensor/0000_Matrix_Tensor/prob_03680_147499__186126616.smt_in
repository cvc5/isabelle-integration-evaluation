; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list_list$)
(declare-fun j$ () Nat$)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun vec$a (Nat$ A_list_list$) Bool)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(assert (! (not (forall ((?v0 A_list$)) (=> (member$ ?v0 (set$ a$)) (= (size$ ?v0) nr$)))) :named conjecture0))
(assert (! (less$ j$ (size$a a$)) :named a1))
(assert (! (mat$ nr$ nc$ a$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$ ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$a ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a4))
(check-sat)
(get-proof)
