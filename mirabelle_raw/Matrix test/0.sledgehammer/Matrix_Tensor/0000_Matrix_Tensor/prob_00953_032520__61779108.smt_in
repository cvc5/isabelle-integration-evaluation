; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 224
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-fun a$ () Bool)
(declare-fun b$ () Bool)
(assert (! (not b$) :named conjecture0))
(assert (! (=> a$ b$) :named a1))
(check-sat)
(get-proof)
