unsat
(assume conjecture0 (! (not (! (mat$ nr$ nc$ (! (cons$ a$ n$) :named @p_1)) :named @p_2)) :named @p_3))
(assume a4 (! (= m$ @p_1) :named @p_4))
(assume a7 (! (mat$ nr$ nc$ m$) :named @p_5))
(step t0 (cl (not (! (= @p_5 @p_2) :named @p_6)) (not @p_5) @p_2) :rule equiv_pos2)
(step t1 (cl @p_6) :rule cong :premises (a4))
(step t2 (cl @p_2) :rule resolution :premises (t0 t1 a7))
(step t3 (cl) :rule resolution :premises (t2 conjecture0))
