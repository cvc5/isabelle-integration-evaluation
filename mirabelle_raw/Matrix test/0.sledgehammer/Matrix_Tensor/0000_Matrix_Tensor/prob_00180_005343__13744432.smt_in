; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun x$ () B_list$)
(declare-fun z$ () B_list$)
(declare-fun nr1$ () Nat$)
(declare-fun nr2$ () Nat$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun vec$ (Nat$ B_list$) Bool)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(assert (! (not (forall ((?v0 B_list$)) (=> (member$ ?v0 (set$ m$)) (= nr1$ nr2$)))) :named conjecture0))
(assert (! (=> (and (vec$ nr1$ x$) (vec$ nr2$ x$)) (= nr1$ nr2$)) :named a1))
(assert (! (forall ((?v0 B_list$)) (=> (member$ ?v0 (set$ m$)) (and (vec$ nr1$ ?v0) (vec$ nr2$ ?v0)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 B_list$) (?v2 Nat$)) (=> (and (vec$ ?v0 ?v1) (vec$ ?v2 ?v1)) (= ?v0 ?v2))) :named a3))
(assert (! (forall ((?v0 B_list$)) (=> (member$ ?v0 (set$ m$)) (vec$ nr1$ ?v0))) :named a4))
(assert (! (member$ z$ (set$ m$)) :named a5))
(assert (! (forall ((?v0 B_list$)) (=> (member$ ?v0 (set$ m$)) (vec$ nr2$ ?v0))) :named a6))
(check-sat)
(get-proof)
