; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 279
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_b_fun$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_b_list_fun$ 0)
(declare-sort B_list_b_fun$ 0)
(declare-sort B_list_b_list_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun uu$ (Nat$) B_list_b_fun$)
(declare-fun map$ (B_list_b_fun$ B_list_list$) B_list$)
(declare-fun nil$ () B_list_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun row$ (B_list_list$ Nat$) B_list$)
(declare-fun map$a (B_list_b_list_fun$ B_list_list$) B_list_list$)
(declare-fun map$b (B_b_list_fun$ B_list$) B_list_list$)
(declare-fun map$c (B_b_fun$) B_list_b_list_fun$)
(declare-fun nil$a () B_list$)
(declare-fun fun_app$ (B_list_b_fun$ B_list$) B$)
(declare-fun fun_app$a (B_list_b_list_fun$ B_list$) B_list$)
(assert (! (forall ((?v0 Nat$) (?v1 B_list$)) (! (= (fun_app$ (uu$ ?v0) ?v1) (nth$ ?v1 ?v0)) :pattern ((fun_app$ (uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (= (row$ nil$ i$) nil$a)) :named conjecture1))
(assert (! (forall ((?v0 B_list_list$) (?v1 Nat$)) (= (row$ ?v0 ?v1) (map$ (uu$ ?v1) ?v0))) :named a2))
(assert (! (forall ((?v0 B_list_b_list_fun$) (?v1 B_list_list$)) (= (= (map$a ?v0 ?v1) nil$) (= ?v1 nil$))) :named a3))
(assert (! (forall ((?v0 B_b_list_fun$) (?v1 B_list$)) (= (= (map$b ?v0 ?v1) nil$) (= ?v1 nil$a))) :named a4))
(assert (! (forall ((?v0 B_list_b_fun$) (?v1 B_list_list$)) (= (= (map$ ?v0 ?v1) nil$a) (= ?v1 nil$))) :named a5))
(assert (! (forall ((?v0 B_b_fun$) (?v1 B_list$)) (= (= (fun_app$a (map$c ?v0) ?v1) nil$a) (= ?v1 nil$a))) :named a6))
(check-sat)
(get-proof)
