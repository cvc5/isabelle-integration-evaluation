(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (or (= y$ zero$) (= y$ one$))) :named conjecture0))
(assert (! (less_eq$ y$ one$) :named a1))
(assert (! (not (= zero$ one$)) :named a2))
(assert (! (= one$ one$) :named a3))
(assert (! (forall ((?v0 A$)) (= (f$ id$ ?v0) ?v0)) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a5))
(assert (! (less_eq$ zero$ one$) :named a6))
(assert (! (less_eq$ zero$ one$) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (fun_app$ (divide$ ?v0) ?v2) ?v1))) :named a8))
(assert (! (forall ((?v0 Nat$)) (= (times$ zero$ ?v0) zero$)) :named a9))
(assert (! (less$ x$ (times$ y$ z$)) :named a10))
(assert (! (not (less_eq$ one$ zero$)) :named a11))
(assert (! (forall ((?v0 Nat$)) (= (less_eq$ ?v0 zero$) (= ?v0 zero$))) :named a12))
(assert (! (forall ((?v0 Nat$)) (! (=> (not (= ?v0 zero$)) (= (fun_app$ (divide$ ?v0) ?v0) one$)) :pattern ((divide$ ?v0)))) :named a13))
(assert (! (not (less$ (fun_app$ (divide$ x$) z$) y$)) :named a14))
(assert (! (forall ((?v0 Nat$)) (less_eq$ zero$ ?v0)) :named a15))
(assert (! (forall ((?v0 Nat$)) (=> (and (=> (= ?v0 zero$) false) (=> (not (= ?v0 zero$)) false)) false)) :named a16))
(assert (! (forall ((?v0 Nat$)) (less_eq$ zero$ ?v0)) :named a17))
(assert (! (= zero$ zero$) :named a18))
(assert (! (less_eq$ (fun_app$ (divide$ (times$ y$ z$)) z$) one$) :named a19))
(assert (! (= one$ (suc$ zero$)) :named a20))
(assert (! (forall ((?v0 Nat$)) (= (= one$ ?v0) (= ?v0 one$))) :named a21))
(assert (! (forall ((?v0 Nat$)) (less_eq$ zero$ ?v0)) :named a22))
(assert (! (less_eq$ (fun_app$ (divide$ (times$ y$ z$)) z$) (fun_app$ (divide$ z$) z$)) :named a23))
(assert (! (forall ((?v0 Nat$)) (= (= zero$ ?v0) (= ?v0 zero$))) :named a24))
(assert (! (less_eq$ y$ (fun_app$ (divide$ x$) z$)) :named a25))
(check-sat)
