; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 328
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun m$ () A_list_list$)
(declare-fun n$ () A_list_list$)
(declare-fun x$ () A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun insert$ (A_list$ A_list_set$) A_list_set$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (forall ((?v0 A_list$)) (=> (member$ ?v0 (set$ m$)) (vec$ (row_length$ m$) ?v0)))) :named conjecture0))
(assert (! (=> (member$ x$ (set$ m$)) (vec$ (row_length$ m$) x$)) :named a1))
(assert (! (= (row_length$ m$) (size$ b$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$a ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a3))
(assert (! (= m$ (cons$ b$ n$)) :named a4))
(assert (! (mat$ (row_length$ (cons$ a$ m$)) (size$a (cons$ a$ m$)) (cons$ a$ m$)) :named a5))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (set$ (cons$ ?v0 ?v1)) (insert$ ?v0 (set$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a6))
(assert (! (= (size$ a$) (size$ b$)) :named a7))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_set$)) (= (member$ ?v0 (insert$ ?v1 ?v2)) (or (= ?v0 ?v1) (member$ ?v0 ?v2)))) :named a8))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (member$ ?v0 (set$ (cons$ ?v0 ?v1)))) :named a9))
(check-sat)
(get-proof)
