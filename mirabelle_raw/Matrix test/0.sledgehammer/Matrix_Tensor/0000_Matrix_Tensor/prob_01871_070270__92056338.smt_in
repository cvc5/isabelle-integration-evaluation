(assert (! (not (=> (less$ j$ (size$ (cons$ w$ n$))) (= (nth$ (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) j$) (vec_vec_Tensor$ f$ v$ (nth$ (cons$ w$ n$) j$))))) :named conjecture0))
(assert (! (= (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) (cons$ (vec_vec_Tensor$ f$ v$ w$) (vec_mat_Tensor$ f$ v$ n$))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (size$ n$)) (= (nth$ (vec_mat_Tensor$ f$ v$ n$) ?v0) (vec_vec_Tensor$ f$ v$ (nth$ n$ ?v0))))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A$) (?v2 A_list$)) (=> (= ?v0 (cons$a ?v1 ?v2)) (not (= ?v0 nil$)))) :named a4))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list$) (?v2 A_list_list$)) (=> (= ?v0 (cons$ ?v1 ?v2)) (not (= ?v0 nil$a)))) :named a5))
(assert (! (= (row_length$ (cons$ nil$ nil$a)) zero$) :named a6))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (nth$a (cons$a ?v0 ?v1) zero$) ?v0) :pattern ((cons$a ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (nth$ (cons$ ?v0 ?v1) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a8))
(assert (! (= (size$a nil$) zero$) :named a9))
(assert (! (= (size$ nil$a) zero$) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (minus$ ?v0 ?v1) zero$) (less_eq$ ?v0 ?v1))) :named a11))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less_eq$ ?v0 ?v1) (or (less$ ?v0 ?v1) (= ?v0 ?v1)))) :named a13))
(assert (! (forall ((?v0 Nat$)) (= (minus$ ?v0 zero$) ?v0)) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ zero$ ?v0) (less$ zero$ ?v1)) (less$ (minus$ ?v1 ?v0) ?v1))) :named a15))
