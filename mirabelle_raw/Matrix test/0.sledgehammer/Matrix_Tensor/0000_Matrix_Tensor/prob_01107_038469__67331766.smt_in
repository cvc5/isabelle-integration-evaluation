; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 322
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$) Nat_nat_fun$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (= i$ (size$ y$)) (= (divide$ i$ (size$ y$)) one$))) :named conjecture0))
(assert (! (= one$ (suc$ zero$)) :named a1))
(assert (! (not (= y$ nil$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ ?v0 ?v1) (ite (or (less$ ?v0 ?v1) (= ?v1 zero$)) zero$ (suc$ (divide$ (fun_app$ (minus$ ?v0) ?v1) ?v1))))) :named a3))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less_eq$ ?v0 ?v1)) (less$ ?v1 ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (modulo$ ?v0 ?v1) ?v0) (= (divide$ ?v0 ?v1) zero$))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (fun_app$ (minus$ ?v0) ?v1) zero$) (less_eq$ ?v0 ?v1))) :named a8))
(assert (! (=> (= i$ (size$ y$)) (= (modulo$ i$ (size$ y$)) zero$)) :named a9))
(check-sat)
(get-proof)
