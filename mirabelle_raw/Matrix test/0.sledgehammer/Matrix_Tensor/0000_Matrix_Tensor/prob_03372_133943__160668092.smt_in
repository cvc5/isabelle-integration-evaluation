(declare-fun y$ () A$)
(declare-fun id$ () A$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun inver$ () A_a_fun$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun plus_mult$ (A$ A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_a_fun$) Bool)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (=> (and (= (size$ w1$) (size$ w2$)) (= (size$ w1$) zero$)) (= (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ x$) y$)) (scalar_product$ f$ zer$ g$ w1$ w2$)) zer$))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A$)) (= (fun_app$ (fun_app$a f$ ?v0) ?v1) (fun_app$ (fun_app$a f$ ?v1) ?v0))) :named a1))
(assert (! (=> (and (= (size$ w1$) (size$ w2$)) (= (size$ w1$) zero$)) (= (scalar_product$ f$ zer$ g$ w1$ w2$) zer$)) :named a2))
(assert (! (forall ((?v0 A$)) (= (fun_app$ (fun_app$a f$ zer$) ?v0) zer$)) :named a3))
(assert (! (plus_mult$ id$ f$ zer$ g$ inver$) :named a4))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A$) (?v3 A_a_a_fun_fun$) (?v4 A_a_fun$) (?v5 A$)) (=> (plus_mult$ ?v0 ?v1 ?v2 ?v3 ?v4) (= (fun_app$ (fun_app$a ?v1 ?v2) ?v5) ?v2))) :named a5))
(check-sat)
(get-proof)
