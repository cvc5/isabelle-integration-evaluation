; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 244
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (less$ (minus$ j$ (size$ m2$)) (times$ (size$ m$) (size$ m2$)))) :named conjecture0))
(assert (! (less_eq$ (size$ m2$) j$) :named hypothesis1))
(assert (! (less$ j$ (fun_app$ (plus$ (size$ m2$)) (times$ (size$ m$) (size$ m2$)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (less_eq$ ?v0 ?v1))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (less$ ?v0 ?v1)) (= (fun_app$ (plus$ ?v1) (minus$ ?v0 ?v1)) ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ ?v0 (minus$ ?v1 ?v2)) (less$ (fun_app$ (plus$ ?v0) ?v2) ?v1))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (=> (less$ ?v0 ?v1) false) (and (=> (= ?v0 ?v1) false) (=> (less$ ?v1 ?v0) false))) false)) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (minus$ ?v0 ?v1) zero$) (less_eq$ ?v0 ?v1))) :named a8))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a9))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (less$ (minus$ ?v1 ?v0) ?v2) (less$ ?v1 (fun_app$ (plus$ ?v2) ?v0))))) :named a11))
(assert (! (= (size$ nil$) zero$) :named a12))
(assert (! (= (plus$ one$) suc$) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (times$ (fun_app$ suc$ ?v0) ?v1) (fun_app$ (plus$ ?v1) (times$ ?v0 ?v1))) :pattern ((times$ (fun_app$ suc$ ?v0) ?v1)))) :named a14))
(check-sat)
(get-proof)
