unsat
(assume hypothesis1 (! (= y$ one$) :named @p_1))
(assume a2 (! (=> @p_1 (! (= (! (divide$ x$ z$) :named @p_2) zero$) :named @p_3)) :named @p_4))
(assume a3 (! (less_eq$ y$ @p_2) :named @p_5))
(assume a4 (! (not (! (less_eq$ one$ zero$) :named @p_6)) :named @p_7))
(step t0 (cl (not (! (= @p_7 (! (not (! (less_eq$ one$ @p_2) :named @p_8)) :named @p_10)) :named @p_11)) (not @p_7) @p_10) :rule equiv_pos2)
(step t1 (cl (not (! (= @p_4 (! (=> @p_1 (! (= zero$ @p_2) :named @p_12)) :named @p_13)) :named @p_14)) (not @p_4) @p_13) :rule equiv_pos2)
(step t2 (cl (= @p_3 @p_12)) :rule rare_rewrite :args ("eq-symm" @p_2 zero$))
(step t3 (cl @p_14) :rule cong :premises (t2))
(step t4 (cl @p_13) :rule resolution :premises (t1 t3 a2))
(step t5 (cl (not @p_1) @p_12) :rule implies :premises (t4))
(step t6 (cl @p_12) :rule resolution :premises (t5 hypothesis1))
(step t7 (cl (= @p_6 @p_8)) :rule cong :premises (t6))
(step t8 (cl @p_11) :rule cong :premises (t7))
(step t9 (cl @p_10) :rule resolution :premises (t0 t8 a4))
(step t10 (cl (not (! (= @p_5 @p_8) :named @p_9)) (not @p_5) @p_8) :rule equiv_pos2)
(step t11 (cl (= @p_2 @p_2)) :rule refl)
(step t12 (cl @p_9) :rule cong :premises (hypothesis1 t11))
(step t13 (cl @p_8) :rule resolution :premises (t10 t12 a3))
(step t14 (cl) :rule resolution :premises (t9 t13))
