unsat
(assume conjecture0 (! (not (=> (! (less$ i$ (size$ (vec_vec_Tensor$ f$ nil$ y$))) :named @p_2) (= (nth$ (vec_vec_Tensor$ f$ x$ y$) i$) (fun_app$ (fun_app$a f$ (nth$ x$ (divide$ i$ (! (size$ y$) :named @p_1)))) (nth$ y$ (modulo$ i$ @p_1)))))) :named @p_3))
