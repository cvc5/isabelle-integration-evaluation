unsat
(assume hypothesis1 (! (= y$ one$) :named @p_1))
(assume a2 (! (=> @p_1 (! (less$ (fun_app$ (divide$ x$) z$) y$) :named @p_2)) :named @p_3))
(assume a3 (! (not @p_2) :named @p_4))
(step t0 (cl (! (not @p_1) :named @p_5) @p_2) :rule implies :premises (a2))
(step t1 (cl @p_2 @p_5) :rule reordering :premises (t0))
(step t2 (cl @p_2) :rule resolution :premises (t1 hypothesis1))
(step t3 (cl) :rule resolution :premises (a3 t2))
