; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 267
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun x$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (= (+ (of_nat$ x$) 1) (of_nat$ (plus$ x$ one$)))) :named conjecture0))
(assert (! (= one$ (suc$ zero$)) :named a1))
(assert (! (forall ((?v0 Nat$)) (! (= (of_nat$a (suc$ ?v0)) (plus$ one$ (of_nat$a ?v0))) :pattern ((suc$ ?v0)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (! (= (of_nat$ (suc$ ?v0)) (+ 1 (of_nat$ ?v0))) :pattern ((suc$ ?v0)))) :named a3))
(assert (! (= (of_nat$a zero$) zero$) :named a4))
(assert (! (= (of_nat$ zero$) 0) :named a5))
(check-sat)
(get-proof)
