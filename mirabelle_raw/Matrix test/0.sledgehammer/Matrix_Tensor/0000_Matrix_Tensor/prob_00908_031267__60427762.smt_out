unsat
(assume conjecture0 (! (not (! (= a$ b$) :named @p_1)) :named @p_2))
(assume a1 (! (= (of_nat$ a$) (of_nat$ b$)) :named @p_3))
(assume a2 (forall ((?v0 Nat$) (?v1 Nat$)) (= (= ?v0 ?v1) (= (of_nat$ ?v0) (of_nat$ ?v1)))))
(step t0 (cl (! (=> (forall ((?v0 Nat$) (?v1 Nat$)) (= (= ?v0 ?v1) (= (of_nat$ ?v0) (of_nat$ ?v1)))) (! (= @p_1 @p_3) :named @p_4)) :named @p_8) (forall ((?v0 Nat$) (?v1 Nat$)) (= (= ?v0 ?v1) (= (of_nat$ ?v0) (of_nat$ ?v1))))) :rule implies_neg1)
(anchor :step t1)
(assume t1.a0 (forall ((?v0 Nat$) (?v1 Nat$)) (= (= ?v0 ?v1) (= (of_nat$ ?v0) (of_nat$ ?v1)))))
(step t1.t0 (cl (or (! (not (forall ((?v0 Nat$) (?v1 Nat$)) (= (= ?v0 ?v1) (= (of_nat$ ?v0) (of_nat$ ?v1))))) :named @p_7) @p_4)) :rule forall_inst :args (a$ b$))
(step t1.t1 (cl @p_7 @p_4) :rule or :premises (t1.t0))
(step t1.t2 (cl @p_4) :rule resolution :premises (t1.t1 t1.a0))
(step t1 (cl @p_7 @p_4) :rule subproof :discharge (t1.a0))
(step t2 (cl @p_8 @p_4) :rule resolution :premises (t0 t1))
(step t3 (cl @p_8 (! (not @p_4) :named @p_5)) :rule implies_neg2)
(step t4 (cl @p_8 @p_8) :rule resolution :premises (t2 t3))
(step t5 (cl @p_8) :rule contraction :premises (t4))
(step t6 (cl @p_7 @p_4) :rule implies :premises (t5))
(step t7 (cl @p_5 @p_1 (! (not @p_3) :named @p_6)) :rule equiv_pos1)
(step t8 (cl @p_1 @p_6 @p_5) :rule reordering :premises (t7))
(step t9 (cl @p_5) :rule resolution :premises (t8 conjecture0 a1))
(step t10 (cl) :rule resolution :premises (t6 t9 a2))
