; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun xs$ () B_list$)
(declare-fun ys$ () B_list$)
(declare-fun nil$ () B_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun append$ (B_list$ B_list$) B_list$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ xs$) i$) (= (nth$ (append$ xs$ ys$) i$) (nth$ ys$ (minus$ i$ (size$ xs$)))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (not (less$ ?v1 ?v0)))) :named a1))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 Nat$)) (= (nth$ (append$ ?v0 ?v1) ?v2) (ite (less$ ?v2 (size$ ?v0)) (nth$ ?v0 ?v2) (nth$ ?v1 (minus$ ?v2 (size$ ?v0)))))) :named a2))
(assert (! (forall ((?v0 B_list$) (?v1 Nat$) (?v2 B_list$)) (=> (less_eq$ (size$ ?v0) ?v1) (= (nth$ (append$ ?v0 ?v2) ?v1) (nth$ ?v2 (minus$ ?v1 (size$ ?v0)))))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 B_list$) (?v2 B_list$)) (=> (less$ ?v0 (size$ ?v1)) (= (nth$ (append$ ?v1 ?v2) ?v0) (nth$ ?v1 ?v0)))) :named a4))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 B_list$) (?v3 B_list$)) (=> (or (= (size$ ?v0) (size$ ?v1)) (= (size$ ?v2) (size$ ?v3))) (= (= (append$ ?v0 ?v2) (append$ ?v1 ?v3)) (and (= ?v0 ?v1) (= ?v2 ?v3))))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (minus$ ?v1 (minus$ ?v1 ?v0)) ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 B_list$) (?v2 B_list$)) (=> (less$ ?v0 (size$ ?v1)) (= (nth$ (append$ ?v1 ?v2) ?v0) (nth$ ?v1 ?v0)))) :named a7))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 B_list$)) (= (append$ (append$ ?v0 ?v1) ?v2) (append$ ?v0 (append$ ?v1 ?v2)))) :named a8))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 B_list$)) (= (append$ (append$ ?v0 ?v1) ?v2) (append$ ?v0 (append$ ?v1 ?v2)))) :named a9))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 B_list$)) (= (= (append$ ?v0 ?v1) (append$ ?v0 ?v2)) (= ?v1 ?v2))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a11))
(assert (! (forall ((?v0 Nat$)) (less_eq$ ?v0 ?v0)) :named a12))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 B_list$)) (= (= (append$ ?v0 ?v1) (append$ ?v2 ?v1)) (= ?v0 ?v2))) :named a13))
(assert (! (= one$ (suc$ zero$)) :named a14))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (suc$ ?v2))))) :named a15))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a16))
(assert (! (= (size$ nil$) zero$) :named a17))
(assert (! (forall ((?v0 Nat$)) (less_eq$ ?v0 ?v0)) :named a18))
(assert (! (forall ((?v0 B_list$)) (! (= (append$ nil$ ?v0) ?v0) :pattern ((append$ nil$ ?v0)))) :named a19))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (less_eq$ ?v0 ?v1) (less_eq$ ?v0 ?v2)) (= (= (minus$ ?v1 ?v0) (minus$ ?v2 ?v0)) (= ?v1 ?v2)))) :named a20))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 B_list$)) (! (= (append$ (cons$ ?v0 ?v1) ?v2) (cons$ ?v0 (append$ ?v1 ?v2))) :pattern ((append$ (cons$ ?v0 ?v1) ?v2)))) :named a21))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (less_eq$ ?v0 ?v1) (less_eq$ ?v0 ?v2)) (= (less_eq$ (minus$ ?v1 ?v0) (minus$ ?v2 ?v0)) (less_eq$ ?v1 ?v2)))) :named a22))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a23))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ ?v0 ?v1) (=> (not false) (less$ ?v1 ?v0))) false)) :named a24))
(assert (! (forall ((?v0 Nat$)) (= (minus$ ?v0 zero$) ?v0)) :named a25))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (nth$ (cons$ ?v0 ?v1) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a26))
(check-sat)
(get-proof)
