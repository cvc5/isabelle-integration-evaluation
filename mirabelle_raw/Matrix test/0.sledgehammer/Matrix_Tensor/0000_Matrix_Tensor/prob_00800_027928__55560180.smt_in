; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_bool_fun$ 0)
(declare-fun a$ () A$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun x$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun fun_app$a (A_list_bool_fun$ A_list$) Bool)
(declare-fun fun_app$b (A_a_fun$ A$) A$)
(declare-fun fun_app$c (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (not (=> (less$ i$ (size$ (cons$ x$ xs$))) (less$ j$ (size$ xs$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less$ ?v0 ?v1)) (less$ ?v1 (fun_app$ suc$ ?v0)))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ (plus$ (size$ ?v1)) (fun_app$ suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (= i$ (fun_app$ suc$ j$)) :named a3))
(assert (! (=> (less$ i$ (size$ (cons$ x$ xs$))) (or (less$ i$ (size$ xs$)) (= i$ (size$ xs$)))) :named a4))
(assert (! (forall ((?v0 Nat$)) (= (nth$ (cons$ x$ xs$) (fun_app$ (plus$ ?v0) one$)) (nth$ xs$ ?v0))) :named a5))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A$) (?v3 A_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ (fun_app$ suc$ ?v0) (fun_app$ suc$ ?v1)) (less$ ?v0 ?v1))) :named a8))
(assert (! (forall ((?v0 Nat$)) (less$ ?v0 (fun_app$ suc$ ?v0))) :named a9))
(assert (! (forall ((?v0 A_list_bool_fun$) (?v1 A_list$)) (=> (forall ((?v2 A_list$)) (=> (forall ((?v3 A_list$)) (=> (less$ (size$ ?v3) (size$ ?v2)) (fun_app$a ?v0 ?v3))) (fun_app$a ?v0 ?v2))) (fun_app$a ?v0 ?v1))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ ?v0 (fun_app$ suc$ ?v1)) (or (less$ ?v0 ?v1) (= ?v0 ?v1)))) :named a11))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a12))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ suc$ ?v0) (fun_app$ (plus$ ?v0) one$))) :named a13))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (! (= (times$ f$ ?v0 (cons$ ?v1 ?v2)) (cons$ (fun_app$b (fun_app$c f$ ?v0) ?v1) (times$ f$ ?v0 ?v2))) :pattern ((times$ f$ ?v0 (cons$ ?v1 ?v2))))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (= (= (fun_app$ suc$ ?v0) (size$ ?v1)) (exists ((?v2 A$) (?v3 A_list$)) (and (= ?v1 (cons$ ?v2 ?v3)) (= (size$ ?v3) ?v0))))) :named a15))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (nth$ (cons$ ?v0 ?v1) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a16))
(assert (! (forall ((?v0 A_list$) (?v1 Nat$)) (= (= (size$ ?v0) (fun_app$ suc$ ?v1)) (exists ((?v2 A$) (?v3 A_list$)) (and (= ?v0 (cons$ ?v2 ?v3)) (= (size$ ?v3) ?v1))))) :named a17))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (fun_app$ suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (fun_app$ suc$ ?v2))))) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ (fun_app$ suc$ ?v0) ?v1) (less$ ?v0 ?v1))) :named a19))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) (fun_app$ suc$ ?v1)) (fun_app$ suc$ (fun_app$ (plus$ ?v0) ?v1)))) :named a20))
(assert (! (forall ((?v0 Nat_nat_fun$) (?v1 Nat$) (?v2 Nat$)) (=> (and (forall ((?v3 Nat$)) (less$ (fun_app$ ?v0 ?v3) (fun_app$ ?v0 (fun_app$ suc$ ?v3)))) (less$ ?v1 ?v2)) (less$ (fun_app$ ?v0 ?v1) (fun_app$ ?v0 ?v2)))) :named a21))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (size$ xs$)) (= (nth$ (times$ f$ a$ xs$) ?v0) (fun_app$b (fun_app$c f$ a$) (nth$ xs$ ?v0))))) :named a22))
(assert (! (forall ((?v0 Nat_nat_fun$) (?v1 Nat$) (?v2 Nat$)) (=> (forall ((?v3 Nat$)) (less$ (fun_app$ ?v0 ?v3) (fun_app$ ?v0 (fun_app$ suc$ ?v3)))) (= (less$ (fun_app$ ?v0 ?v1) (fun_app$ ?v0 ?v2)) (less$ ?v1 ?v2)))) :named a23))
(assert (! (= (plus$ one$) suc$) :named a24))
(assert (! (forall ((?v0 Nat$)) (exists ((?v1 A_list$)) (= (size$ ?v1) ?v0))) :named a25))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ (fun_app$ suc$ ?v0) ?v1) (exists ((?v2 Nat$)) (and (= ?v1 (fun_app$ suc$ ?v2)) (less$ ?v0 ?v2))))) :named a26))
(assert (! (forall ((?v0 Nat$)) (= (less$ ?v0 one$) (= ?v0 zero$))) :named a27))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (=> (not (= (size$ ?v0) (size$ ?v1))) (= (= ?v0 ?v1) false))) :named a28))
(check-sat)
(get-proof)
