; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_list$ 0)
(declare-sort Nat_bool_fun$ 0)
(declare-sort B_list_list_list$ 0)
(declare-sort Nat_nat_bool_fun_fun$ 0)
(declare-sort B_list_list_list_list$ 0)
(declare-sort B_list_list_list_list_list$ 0)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun uu$ () Nat_nat_bool_fun_fun$)
(declare-fun mat$ (Nat$ Nat$ B_list_list$) Bool)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun less$ () Nat_nat_bool_fun_fun$)
(declare-fun mat$a (Nat$ Nat$ B_list_list_list_list_list$) Bool)
(declare-fun mat$b (Nat$ Nat$ B_list_list_list_list$) Bool)
(declare-fun mat$c (Nat$ Nat$ B_list_list_list$) Bool)
(declare-fun nth$a (B_list_list$ Nat$) B_list$)
(declare-fun nth$b (B_list_list_list_list$ Nat$) B_list_list_list$)
(declare-fun nth$c (B_list_list_list_list_list$ Nat$) B_list_list_list_list$)
(declare-fun nth$d (B_list_list_list$ Nat$) B_list_list$)
(declare-fun fun_app$ (Nat_bool_fun$ Nat$) Bool)
(declare-fun tranclp$ (Nat_nat_bool_fun_fun$) Nat_nat_bool_fun_fun$)
(declare-fun fun_app$a (Nat_nat_bool_fun_fun$ Nat$) Nat_bool_fun$)
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (fun_app$ (fun_app$a uu$ ?v0) ?v1) (= ?v1 (suc$ ?v0))) :pattern ((fun_app$ (fun_app$a uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (forall ((?v0 B_list_list$) (?v1 B_list_list$)) (=> (and (mat$ nr$ nc$ ?v0) (and (mat$ nr$ nc$ ?v1) (forall ((?v2 Nat$)) (=> (fun_app$ (fun_app$a less$ ?v2) nc$) (forall ((?v3 Nat$)) (=> (fun_app$ (fun_app$a less$ ?v3) nr$) (= (nth$ (nth$a ?v0 ?v2) ?v3) (nth$ (nth$a ?v1 ?v2) ?v3)))))))) (= ?v0 ?v1)))) :named conjecture1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list_list_list_list$) (?v3 B_list_list_list_list_list$)) (=> (and (mat$a ?v0 ?v1 ?v2) (and (mat$a ?v0 ?v1 ?v3) (forall ((?v4 Nat$) (?v5 Nat$)) (=> (and (fun_app$ (fun_app$a less$ ?v4) ?v1) (fun_app$ (fun_app$a less$ ?v5) ?v0)) (= (nth$b (nth$c ?v2 ?v4) ?v5) (nth$b (nth$c ?v3 ?v4) ?v5)))))) (= ?v2 ?v3))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list_list_list$) (?v3 B_list_list_list_list$)) (=> (and (mat$b ?v0 ?v1 ?v2) (and (mat$b ?v0 ?v1 ?v3) (forall ((?v4 Nat$) (?v5 Nat$)) (=> (and (fun_app$ (fun_app$a less$ ?v4) ?v1) (fun_app$ (fun_app$a less$ ?v5) ?v0)) (= (nth$d (nth$b ?v2 ?v4) ?v5) (nth$d (nth$b ?v3 ?v4) ?v5)))))) (= ?v2 ?v3))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list_list$) (?v3 B_list_list_list$)) (=> (and (mat$c ?v0 ?v1 ?v2) (and (mat$c ?v0 ?v1 ?v3) (forall ((?v4 Nat$) (?v5 Nat$)) (=> (and (fun_app$ (fun_app$a less$ ?v4) ?v1) (fun_app$ (fun_app$a less$ ?v5) ?v0)) (= (nth$a (nth$d ?v2 ?v4) ?v5) (nth$a (nth$d ?v3 ?v4) ?v5)))))) (= ?v2 ?v3))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list$) (?v3 B_list_list$)) (=> (and (mat$ ?v0 ?v1 ?v2) (and (mat$ ?v0 ?v1 ?v3) (forall ((?v4 Nat$) (?v5 Nat$)) (=> (and (fun_app$ (fun_app$a less$ ?v4) ?v1) (fun_app$ (fun_app$a less$ ?v5) ?v0)) (= (nth$ (nth$a ?v2 ?v4) ?v5) (nth$ (nth$a ?v3 ?v4) ?v5)))))) (= ?v2 ?v3))) :named a5))
(assert (! (= less$ (tranclp$ uu$)) :named a6))
(check-sat)
(get-proof)
