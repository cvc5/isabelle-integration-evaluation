; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 265
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun x$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (= (+ (of_nat$ x$) 1) (of_nat$ (fun_app$ (plus$ x$) one$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (! (= (of_nat$a (fun_app$ suc$ ?v0)) (fun_app$ (plus$ one$) (of_nat$a ?v0))) :pattern ((fun_app$ suc$ ?v0)))) :named a1))
(assert (! (forall ((?v0 Nat$)) (! (= (of_nat$ (fun_app$ suc$ ?v0)) (+ 1 (of_nat$ ?v0))) :pattern ((fun_app$ suc$ ?v0)))) :named a2))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a3))
(assert (! (= (plus$ one$) suc$) :named a4))
(check-sat)
(get-proof)
