; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 266
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun x$ () A$)
(declare-fun id$ () A$)
(declare-fun zer$ () A$)
(declare-fun inver$ () A_a_fun$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun plus_mult$ (A$ A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_a_fun$) Bool)
(assert (! (not (= zer$ (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ zer$) x$)) zer$))) :named conjecture0))
(assert (! (= (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ zer$) x$)) (fun_app$ inver$ (fun_app$ (fun_app$a f$ zer$) x$))) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ zer$) x$)) (fun_app$ (fun_app$a f$ zer$) x$))) (fun_app$ inver$ (fun_app$ (fun_app$a f$ zer$) x$)))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A$) (?v3 A_a_a_fun_fun$) (?v4 A_a_fun$) (?v5 A$)) (=> (plus_mult$ ?v0 ?v1 ?v2 ?v3 ?v4) (= (fun_app$ (fun_app$a ?v3 ?v5) (fun_app$ ?v4 ?v5)) ?v2))) :named a2))
(assert (! (plus_mult$ id$ f$ zer$ g$ inver$) :named a3))
(check-sat)
(get-proof)
