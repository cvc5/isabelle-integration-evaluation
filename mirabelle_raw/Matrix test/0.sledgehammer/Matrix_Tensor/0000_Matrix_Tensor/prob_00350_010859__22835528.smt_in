(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$ ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$a ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 A_list_list$)) (=> (not (= ?v0 nil$)) (member$ (hd$ ?v0) (set$ ?v0)))) :named a6))
