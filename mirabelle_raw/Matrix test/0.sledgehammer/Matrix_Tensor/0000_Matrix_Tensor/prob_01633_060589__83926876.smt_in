; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 311
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (and (less$ k$ (size$ m$)) (less_eq$ one$ k$)) (= (nth$ m$ (minus$ k$ one$)) (nth$ (cons$ v$ m$) k$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less_eq$ ?v0 ?v1) (not (= ?v0 ?v1))) (less$ ?v0 ?v1))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 ?v1) (less$ (minus$ ?v0 ?v2) ?v1))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (minus$ ?v0 ?v1) zero$) (less_eq$ ?v0 ?v1))) :named a3))
(assert (! (less$ zero$ one$) :named a4))
(check-sat)
(get-proof)
