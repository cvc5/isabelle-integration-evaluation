unsat
(assume conjecture0 (! (not (! (less$ i$ (times$ (row_length$ (mat_multI$ zer$ g$ f$ (! (row_length$ a1$) :named @p_2) a1$ a2$)) (row_length$ (mat_multI$ zer$ g$ f$ (! (row_length$ b1$) :named @p_1) b1$ b2$)))) :named @p_3)) :named @p_4))
(assume a9 (! (less$ i$ (times$ @p_2 @p_1)) :named @p_5))
(assume a10 (! (= @p_5 @p_3) :named @p_6))
(step t0 (cl (! (= @p_3 @p_5) :named @p_7)) :rule symm :premises (a10))
(step t1 (cl (! (not @p_7) :named @p_8) @p_3 (not @p_5)) :rule equiv_pos1)
(step t2 (cl @p_8) :rule resolution :premises (t1 conjecture0 a9))
(step t3 (cl) :rule resolution :premises (t0 t2))
