unsat
(assume conjecture33 (! (not (! (= (! (fun_app$f size$b nil$c) :named @p_1) zero$) :named @p_2)) :named @p_3))
(assume a41 @p_2)
(step t0 (cl (! (= zero$ @p_1) :named @p_4)) :rule symm :premises (a41))
(step t1 (cl (not @p_4)) :rule not_symm :premises (conjecture33))
(step t2 (cl) :rule resolution :premises (t0 t1))
