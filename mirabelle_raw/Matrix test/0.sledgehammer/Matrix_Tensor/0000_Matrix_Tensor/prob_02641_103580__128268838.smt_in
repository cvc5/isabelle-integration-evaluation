; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun m1$ () A_list_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun m3$ () A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (fun_app$ (times$ (fun_app$ (times$ (size$ m1$)) (size$ m2$))) (size$ m3$)) zero$)) :named conjecture0))
(assert (! (= (fun_app$ (times$ (size$ m2$)) (size$ m3$)) zero$) :named a1))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (times$ ?v0) zero$) zero$) :pattern ((times$ ?v0)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (fun_app$ (times$ ?v0) ?v1) (fun_app$ (times$ ?v2) ?v1)) (or (= ?v0 ?v2) (= ?v1 zero$)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$ (times$ (fun_app$ (times$ ?v0) ?v1)) ?v2) (fun_app$ (times$ ?v0) (fun_app$ (times$ ?v1) ?v2)))) :named a4))
(check-sat)
(get-proof)
