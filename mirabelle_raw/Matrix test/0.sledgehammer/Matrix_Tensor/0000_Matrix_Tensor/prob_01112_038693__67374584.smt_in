(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (fun_app$ (times$ ?v0) ?v1) (fun_app$ (times$ ?v0) ?v2)) (and (less$ zero$ ?v0) (less$ ?v1 ?v2)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (fun_app$ (times$ ?v0) ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a7))
(assert (! (=> (less$ i$ (size$ y$)) (= (nth$ (vec_vec_Tensor$ f$ (cons$ z$ zs$) y$) i$) (nth$ (times$a f$ z$ y$) i$))) :named a8))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (times$ ?v0) zero$) zero$) :pattern ((times$ ?v0)))) :named a9))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (fun_app$ (times$ (size$ zs$)) (size$ y$))) (= (nth$ (vec_vec_Tensor$ f$ zs$ y$) ?v0) (fun_app$a (fun_app$b f$ (nth$ zs$ (divide$ ?v0 (size$ y$)))) (nth$ y$ (modulo$ ?v0 (size$ y$))))))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (fun_app$ (times$ ?v0) ?v1) (fun_app$ (times$ ?v0) ?v2)) (or (= ?v1 ?v2) (= ?v0 zero$)))) :named a11))
(assert (! (=> (less$ i$ (size$ y$)) (= (divide$ i$ (size$ y$)) zero$)) :named a12))
(assert (! (=> (not (= y$ nil$)) (less$ zero$ (size$ y$))) :named a13))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a14))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a15))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (fun_app$ (times$ ?v0) ?v1) (fun_app$ (times$ ?v2) ?v1)) (or (= ?v0 ?v2) (= ?v1 zero$)))) :named a17))
(assert (! (forall ((?v0 A_list$) (?v1 Nat$) (?v2 A$) (?v3 A_list$)) (=> (less_eq$ (size$ ?v0) ?v1) (= (nth$ (vec_vec_Tensor$ f$ (cons$ ?v2 ?v3) ?v0) ?v1) (nth$ (vec_vec_Tensor$ f$ ?v3 ?v0) (minus$ ?v1 (size$ ?v0)))))) :named a18))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (times$ zero$) ?v0) zero$)) :named a19))
(assert (! (forall ((?v0 A_list$) (?v1 Nat$) (?v2 A$) (?v3 A_list$)) (=> (and (less$ (size$ ?v0) ?v1) (less$ ?v1 (fun_app$ (times$ (size$ (cons$ ?v2 ?v3))) (size$ ?v0)))) (less$ (minus$ ?v1 (size$ ?v0)) (fun_app$ (times$ (size$ ?v3)) (size$ ?v0))))) :named a20))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a21))
(assert (! (= (size$ nil$) zero$) :named a22))
(assert (! (= one$ (suc$ zero$)) :named a23))
(assert (! (forall ((?v0 Nat$)) (= (less$ ?v0 zero$) false)) :named a24))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (times$ ?v0) zero$) zero$)) :named a25))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (nth$ (cons$ ?v0 ?v1) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a26))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (less_eq$ ?v0 ?v1))) :named a27))
(assert (! (forall ((?v0 A_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a28))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (fun_app$ (times$ ?v0) ?v1) (fun_app$ (times$ ?v0) ?v2)) (or (= ?v0 zero$) (= ?v1 ?v2)))) :named a29))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a30))
