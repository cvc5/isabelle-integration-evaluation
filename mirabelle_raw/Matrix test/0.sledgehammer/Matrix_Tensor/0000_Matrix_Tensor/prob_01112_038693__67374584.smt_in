(assert (! (not (=> (= i$ (size$ y$)) (= (less$ i$ (fun_app$ (times$ (size$ (cons$ z$ zs$))) (size$ y$))) (less$ zero$ (fun_app$ (times$ (size$ zs$)) (size$ y$)))))) :named conjecture0))
(assert (! (not (= y$ nil$)) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A$)) (= (fun_app$a (fun_app$b f$ (fun_app$a (fun_app$b f$ ?v0) ?v1)) ?v2) (fun_app$a (fun_app$b f$ ?v0) (fun_app$a (fun_app$b f$ ?v1) ?v2)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (fun_app$ (times$ ?v0) ?v1) (fun_app$ (times$ ?v2) ?v1)) (and (less$ zero$ ?v1) (less$ ?v0 ?v2)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ zero$ (fun_app$ (times$ ?v0) ?v1)) (and (less$ zero$ ?v0) (less$ zero$ ?v1)))) :named a4))
