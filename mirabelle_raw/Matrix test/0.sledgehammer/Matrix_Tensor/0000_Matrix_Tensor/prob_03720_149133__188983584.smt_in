; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 256
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun a1$ () A_list_list$)
(declare-fun b1$ () A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ (modulo$ i$ (row_length$ b1$)) (row_length$ b1$))) :named conjecture0))
(assert (! (less$ i$ (times$ (row_length$ a1$) (row_length$ b1$))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ (modulo$ ?v0 ?v1) ?v1) zero$)) :named a4))
(check-sat)
(get-proof)
