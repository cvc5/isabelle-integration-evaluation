unsat
(assume conjecture0 (! (not (! (= (size$ (! (tensor$ f$ (cons$ a$ m1a$) m2$) :named @p_2)) (size$ (! (append$ (vec_mat_Tensor$ f$ a$ m2$) (tensor$ f$ m1a$ m2$)) :named @p_1))) :named @p_3)) :named @p_4))
(assume a1 (! (= @p_2 @p_1) :named @p_5))
(step t0 (cl (! (=> @p_5 @p_3) :named @p_7) @p_5) :rule implies_neg1)
(anchor :step t1)
(assume t1.a0 @p_5)
(step t1.t0 (cl @p_3) :rule cong :premises (t1.a0))
(step t1 (cl (! (not @p_5) :named @p_6) @p_3) :rule subproof :discharge (t1.a0))
(step t2 (cl @p_7 @p_3) :rule resolution :premises (t0 t1))
(step t3 (cl @p_7 @p_4) :rule implies_neg2)
(step t4 (cl @p_7 @p_7) :rule resolution :premises (t2 t3))
(step t5 (cl @p_7) :rule contraction :premises (t4))
(step t6 (cl @p_6 @p_3) :rule implies :premises (t5))
(step t7 (cl @p_3 @p_6) :rule reordering :premises (t6))
(step t8 (cl) :rule resolution :premises (t7 a1 conjecture0))
