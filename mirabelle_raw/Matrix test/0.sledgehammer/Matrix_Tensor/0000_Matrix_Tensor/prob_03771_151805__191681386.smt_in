; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 257
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a1$ () A_list_list$)
(declare-fun a2$ () A_list_list$)
(declare-fun b1$ () A_list_list$)
(declare-fun b2$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun matrix_match$ (A_list_list$ A_list_list$ A_list_list$ A_list_list$) Bool)
(assert (! (not (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ ?v0 (times$ (row_length$ a1$) (row_length$ b1$))) (less$ ?v1 (times$ (size$ a2$) (size$ b2$)))) (= (size$a (row$ a1$ (divide$ ?v0 (row_length$ b1$)))) (size$a (col$ a2$ (divide$ ?v1 (size$ b2$)))))))) :named conjecture0))
(assert (! (matrix_match$ a1$ a2$ b1$ b2$) :named a1))
(check-sat)
(get-proof)
