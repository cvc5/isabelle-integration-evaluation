; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 257
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(assert (! (not (=> (= i$ (size$ y$)) (= (divide$ i$ (size$ y$)) one$))) :named conjecture0))
(assert (! (not (= y$ nil$)) :named a1))
(assert (! (= (size$ nil$) zero$) :named a2))
(assert (! (forall ((?v0 A_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a3))
(check-sat)
(get-proof)
