; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$) Nat_nat_fun$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (less$ (fun_app$ (minus$ j$) (size$ m2$)) (times$ (size$ m$) (size$ m2$)))) :named conjecture0))
(assert (! (less_eq$ (size$ m2$) j$) :named hypothesis1))
(assert (! (less$ j$ (fun_app$ (plus$ (size$ m2$)) (times$ (size$ m$) (size$ m2$)))) :named a2))
(assert (! (forall ((?v0 A_list_list$) (?v1 Nat$) (?v2 A_list$) (?v3 A_list_list$)) (=> (and (less$ (size$ ?v0) ?v1) (less$ ?v1 (times$ (size$ (cons$ ?v2 ?v3)) (size$ ?v0)))) (less$ (fun_app$ (minus$ ?v1) (size$ ?v0)) (times$ (size$ ?v3) (size$ ?v0))))) :named a3))
(assert (! (less$ j$ (times$ (fun_app$ (plus$ one$) (size$ m$)) (size$ m2$))) :named a4))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a5))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (plus$ ?v0) zero$) ?v0)) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v0) ?v2)) (less$ ?v1 ?v2))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less_eq$ ?v0 ?v1)) (less$ ?v1 ?v0))) :named a8))
(assert (! (= (plus$ one$) suc$) :named a9))
(assert (! (= (size$ nil$) zero$) :named a10))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a11))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (times$ (fun_app$ suc$ ?v0) ?v1) (fun_app$ (plus$ ?v1) (times$ ?v0 ?v1))) :pattern ((times$ (fun_app$ suc$ ?v0) ?v1)))) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (not (= ?v0 ?v1)) (and (=> (less$ ?v0 ?v1) false) (=> (less$ ?v1 ?v0) false))) false)) :named a14))
(check-sat)
(get-proof)
