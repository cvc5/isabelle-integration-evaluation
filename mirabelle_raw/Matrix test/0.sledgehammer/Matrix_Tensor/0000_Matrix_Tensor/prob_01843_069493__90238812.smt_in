(assert (! (less$ x$ (times$ y$ z$)) :named a6))
(assert (! (or (= y$ zero$) (= y$ one$)) :named a7))
(assert (! (=> (= y$ one$) (= (divide$ x$ z$) zero$)) :named a8))
(assert (! (less_eq$ y$ one$) :named a9))
(assert (! (less_eq$ y$ (divide$ x$ z$)) :named a10))
(assert (! (forall ((?v0 A$)) (= (f$ id$ ?v0) ?v0)) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v2) ?v1))) :named a12))
(assert (! (less_eq$ (times$ (divide$ x$ z$) z$) z$) :named a13))
(assert (! (= one$ one$) :named a14))
(assert (! (less_eq$ (times$ y$ z$) z$) :named a15))
(assert (! (less_eq$ (divide$ (times$ y$ z$) z$) (divide$ z$ z$)) :named a16))
(assert (! (=> (= y$ zero$) (less$ x$ zero$)) :named a17))
(assert (! (less_eq$ (times$ y$ z$) (times$ (divide$ x$ z$) z$)) :named a18))
(assert (! (forall ((?v0 Nat$)) (= (= one$ ?v0) (= ?v0 one$))) :named a19))
