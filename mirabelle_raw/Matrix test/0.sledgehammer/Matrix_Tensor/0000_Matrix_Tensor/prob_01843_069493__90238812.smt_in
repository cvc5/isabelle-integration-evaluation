(assert (! (forall ((?v0 Nat$)) (= (divide$ ?v0 one$) ?v0)) :named a21))
(assert (! (less_eq$ (divide$ (times$ y$ z$) z$) one$) :named a22))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a23))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (=> (less$ ?v0 ?v1) (= (divide$ ?v0 ?v1) zero$)) :pattern ((divide$ ?v0 ?v1)))) :named a24))
(assert (! (less_eq$ zero$ x$) :named a25))
(assert (! (= one$ (suc$ zero$)) :named a26))
(assert (! (less$ zero$ one$) :named a27))
(assert (! (forall ((?v0 Nat$)) (= (less_eq$ ?v0 zero$) (= ?v0 zero$))) :named a28))
(assert (! (forall ((?v0 Nat$)) (! (= (times$ zero$ ?v0) zero$) :pattern ((times$ zero$ ?v0)))) :named a29))
