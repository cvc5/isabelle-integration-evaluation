(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not false) :named conjecture0))
(assert (! (= y$ one$) :named hypothesis1))
(assert (! (=> (= y$ one$) (less$ (divide$ x$ z$) y$)) :named a2))
(assert (! (=> (= y$ zero$) false) :named a3))
(assert (! (not (less$ (divide$ x$ z$) y$)) :named a4))
