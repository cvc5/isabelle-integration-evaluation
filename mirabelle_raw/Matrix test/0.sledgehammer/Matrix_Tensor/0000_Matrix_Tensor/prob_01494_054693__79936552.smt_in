; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun m2$ () A_list_list$)
(declare-fun uu$ () Nat_nat_fun$)
(declare-fun nil$ () A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ uu$ ?v0) zero$) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (=> (less$ i$ (fun_app$ (times$ (row_length$ nil$)) (row_length$ m2$))) false)) :named conjecture1))
(assert (! (= (row_length$ nil$) zero$) :named a2))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a3))
(assert (! (= uu$ (times$ zero$)) :named a4))
(check-sat)
(get-proof)
