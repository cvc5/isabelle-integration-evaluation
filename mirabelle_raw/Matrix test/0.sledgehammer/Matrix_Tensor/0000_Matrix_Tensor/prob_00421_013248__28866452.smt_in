(assert (! (not (forall ((?v0 A_list$)) (=> (member$ ?v0 (set$ m$)) (vec$ (row_length$ m$) ?v0)))) :named conjecture0))
(assert (! (=> (member$ x$ (set$ m$)) (vec$ (row_length$ m$) x$)) :named a1))
(assert (! (= (row_length$ m$) (size$ b$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$a ?v2) ?v1) (forall ((?v3 A_list_list$)) (=> (member$a ?v3 (set$a ?v2)) (vec$a ?v0 ?v3)))))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$a ?v0 ?v1 ?v2) (and (= (size$b ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list_list$)) (! (= (vec$b ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$b ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$ ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$a ?v0 ?v1) (= (size$b ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a7))
(assert (! (mat$a (row_length$ (cons$ a$ m$)) (size$b (cons$ a$ m$)) (cons$ a$ m$)) :named a8))
(assert (! (= (size$ a$) (size$ b$)) :named a9))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$) (?v2 A_list_list_set$)) (= (member$a ?v0 (insert$ ?v1 ?v2)) (or (= ?v0 ?v1) (member$a ?v0 ?v2)))) :named a10))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_set$)) (= (member$ ?v0 (insert$a ?v1 ?v2)) (or (= ?v0 ?v1) (member$ ?v0 ?v2)))) :named a11))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list_list$)) (member$a ?v0 (set$a (cons$a ?v0 ?v1)))) :named a12))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (member$ ?v0 (set$ (cons$ ?v0 ?v1)))) :named a13))
