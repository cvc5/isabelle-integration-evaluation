(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (=> (and (less$ zero$ j$) (less$ (nat$ (+ (of_nat$ j$) (- 1))) (size$ (cons$ b$ n$)))) (less$ (fun_app$ (plus$ (nat$ (+ (of_nat$ j$) (- 1)))) one$) (size$ (cons$ a$ (cons$ b$ n$)))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (=> (less$ zero$ ?v0) (= (fun_app$ (plus$ (nat$ (+ (of_nat$ ?v0) (- 1)))) one$) ?v0))) :named a1))
(assert (! (= ma$ (cons$ b$ n$)) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (nat$ (of_nat$ ?v0)) ?v0)) :named a3))
(assert (! (less$ zero$ (size$ (cons$ a$ ma$))) :named a4))
(assert (! (forall ((?v0 Int)) (=> (<= 0 ?v0) (= (fun_app$ suc$ (nat$ ?v0)) (nat$ (+ 1 ?v0))))) :named a5))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (+ ?v0 ?v1) ?v1) ?v0)) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (fun_app$ (plus$ ?v0) ?v1) ?v1) ?v0)) :named a7))
(assert (! (= one$ (nat$ 1)) :named a8))
(assert (! (forall ((?v0 Int)) (= (less$ zero$ (nat$ ?v0)) (< 0 ?v0))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v0) ?v2)) (less$ ?v1 ?v2))) :named a10))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ suc$ ?v0) (fun_app$ (plus$ ?v0) one$))) :named a11))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a12))
(assert (! (= (plus$ one$) suc$) :named a13))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int) (?v3 Int)) (=> (= ?v0 (+ ?v1 ?v2)) (= (+ ?v0 ?v3) (+ ?v1 (+ ?v2 ?v3))))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$) (?v3 Nat$)) (=> (= ?v0 (fun_app$ (plus$ ?v1) ?v2)) (= (fun_app$ (plus$ ?v0) ?v3) (fun_app$ (plus$ ?v1) (fun_app$ (plus$ ?v2) ?v3))))) :named a15))
(assert (! (= (size$ nil$) zero$) :named a16))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int) (?v3 Int)) (=> (= ?v0 (+ ?v1 ?v2)) (= (+ ?v3 ?v0) (+ ?v1 (+ ?v3 ?v2))))) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$) (?v3 Nat$)) (=> (= ?v0 (fun_app$ (plus$ ?v1) ?v2)) (= (fun_app$ (plus$ ?v3) ?v0) (fun_app$ (plus$ ?v1) (fun_app$ (plus$ ?v3) ?v2))))) :named a18))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ (plus$ (size$ ?v1)) (fun_app$ suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a19))
(check-sat)
(get-proof)
