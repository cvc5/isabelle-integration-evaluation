; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 229
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () B_list$)
(declare-fun z$ () C$)
(declare-fun uu$ () Nat_nat_fun$)
(declare-fun zs$ () C_list$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (C$ C_list$) C_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (C_list$) Nat$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ uu$ ?v0) ?v0) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (=> (less$ i$ (fun_app$ (times$ (size$ (cons$ z$ zs$))) (size$a y$))) (less$ i$ (plus$ (fun_app$ (times$ (size$ zs$)) (size$a y$)) (size$a y$))))) :named conjecture1))
(assert (! (=> (less$ i$ (fun_app$ (times$ (size$ (cons$ z$ zs$))) (size$a y$))) (less$ i$ (fun_app$ (times$ (plus$ (size$ zs$) one$)) (size$a y$)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$ (times$ (plus$ ?v0 ?v1)) ?v2) (plus$ (fun_app$ (times$ ?v0) ?v2) (fun_app$ (times$ ?v1) ?v2)))) :named a3))
(assert (! (= uu$ (times$ one$)) :named a4))
(check-sat)
(get-proof)
