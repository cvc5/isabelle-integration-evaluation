(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (forall ((?v0 Nat$)) (= (modulo$ (modulo$ ?v0 (row_length$ (tensor$ f$ m2$ m3$))) (row_length$ m3$)) (modulo$ ?v0 (row_length$ m3$))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (= (modulo$ (modulo$ ?v0 (size$ (tensor$ f$ m2$ m3$))) (size$ m3$)) (modulo$ ?v0 (size$ m3$)))) :named a1))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (row_length$ (tensor$ f$ ?v0 ?v1)) (times$ (row_length$ ?v0) (row_length$ ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (modulo$ ?v0 (times$ ?v1 ?v2)) ?v2) (modulo$ ?v0 ?v2))) :named a3))
(check-sat)
(get-proof)
