; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun y$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (or (= y$ zero$) (= y$ one$))) :named conjecture0))
(assert (! (less_eq$ y$ one$) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less_eq$ ?v0 ?v1) (less_eq$ ?v1 ?v0)) (= ?v0 ?v1))) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (less_eq$ one$ (of_nat$ ?v0)) (less_eq$ one$ ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$)) (= (less_eq$ (of_nat$ ?v0) zero$) (= ?v0 zero$))) :named a4))
(check-sat)
(get-proof)
