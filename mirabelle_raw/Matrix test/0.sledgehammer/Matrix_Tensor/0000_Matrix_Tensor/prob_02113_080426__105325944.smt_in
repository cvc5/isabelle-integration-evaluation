(declare-fun member$a (A_list$ A_list_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ n$) (size$ w1$))) :named conjecture0))
(assert (! (= n$ (cons$ w1$ n1$)) :named a1))
(assert (! (= (row_length$ (cons$ w$ n$)) (size$ w$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$a ?v2) ?v1) (forall ((?v3 A_list_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$a ?v0 ?v1 ?v2) (and (= (size$b ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$a ?v3 (set$a ?v2)) (vec$a ?v0 ?v3)))))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list_list$)) (! (= (vec$b ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$b ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$a ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$ ?v0 ?v1) (= (size$b ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (=> (mat$a (row_length$ (cons$ ?v0 ?v1)) (size$b (cons$ ?v0 ?v1)) (cons$ ?v0 ?v1)) (mat$a (row_length$ ?v1) (size$b ?v1) ?v1))) :named a8))
(assert (! (=> (mat$a nr$ (size$b (cons$ w$ n$)) (cons$ w$ n$)) (= nr$ (size$ w$))) :named a9))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_list$)) (! (=> (mat$a (row_length$ (cons$ ?v0 (cons$ ?v1 ?v2))) (size$b (cons$ ?v0 (cons$ ?v1 ?v2))) (cons$ ?v0 (cons$ ?v1 ?v2))) (= (row_length$ (cons$ ?v0 (cons$ ?v1 ?v2))) (row_length$ (cons$ ?v1 ?v2)))) :pattern ((cons$ ?v0 (cons$ ?v1 ?v2))))) :named a10))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list_list$)) (member$ ?v0 (set$ (cons$a ?v0 ?v1)))) :named a11))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (member$a ?v0 (set$a (cons$ ?v0 ?v1)))) :named a12))
