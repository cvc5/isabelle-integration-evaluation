; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun a1$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(assert (! (not (exists ((?v0 A$) (?v1 A_list$)) (and (= w2$ (cons$ ?v0 ?v1)) (= (size$ ?v1) k$)))) :named conjecture0))
(assert (! (= (size$ w2$) (suc$ k$)) :named a1))
(assert (! (and (= w1$ (cons$ a1$ u1$)) (= (size$ u1$) k$)) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 Nat$)) (= (= (size$ ?v0) (suc$ ?v1)) (exists ((?v2 A$) (?v3 A_list$)) (and (= ?v0 (cons$ ?v2 ?v3)) (= (size$ ?v3) ?v1))))) :named a3))
(check-sat)
(get-proof)
