(assert (! (not (=> (and (and (less$ i$ (times$ (row_length$ nil$) (row_length$ m2$))) (less$ j$ (times$ (size$ nil$a) (size$a m2$)))) (and (mat$ (row_length$ nil$) (size$b nil$b) nil$c) (mat$a (row_length$ m2$) (size$a m2$) m2$))) (= (nth$ (nth$a (tensor$ f$ nil$ m2$) j$) i$) (fun_app$ (fun_app$a f$ (nth$ (nth$a nil$ (divide$ j$ (size$c nil$d))) (divide$ i$ (row_length$ m2$)))) (nth$ (nth$a m2$ (modulo$ j$ (size$d nil$e))) (modulo$ i$ (row_length$ m2$))))))) :named conjecture0))
