; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 300
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ (cons$ a$ m1a$)) (size$ a$))) :named conjecture0))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list$) (?v2 A_list_list$)) (=> (= ?v0 (cons$ ?v1 ?v2)) (not (= ?v0 nil$)))) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$ (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (hd$ (cons$ ?v0 ?v1)) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(check-sat)
(get-proof)
