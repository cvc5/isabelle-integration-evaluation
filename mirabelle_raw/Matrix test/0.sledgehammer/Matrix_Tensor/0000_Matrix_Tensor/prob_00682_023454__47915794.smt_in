; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun x$ () A_list$)
(declare-fun n1$ () A_list_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(assert (! (not (=> (member$ x$ (set$ m1a$)) (vec$ (size$ a$) x$))) :named conjecture0))
(assert (! (=> (member$ x$ (set$ (cons$ a$ m1a$))) (vec$ (size$ a$) x$)) :named a1))
(assert (! (=> (member$ x$ (set$ (cons$ a$ m1a$))) (or (= x$ a$) (member$ x$ (set$ m1a$)))) :named a2))
(assert (! (= m1a$ (cons$ b$ n1$)) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list$)) (=> (member$ ?v0 (set$ ?v1)) (member$ ?v0 (set$ (cons$ ?v2 ?v1))))) :named a4))
(check-sat)
(get-proof)
