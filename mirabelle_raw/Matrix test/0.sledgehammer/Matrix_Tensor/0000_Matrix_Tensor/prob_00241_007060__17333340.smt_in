(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (hd$a (cons$ ?v0 ?v1)) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$a (cons$ ?v0 ?v1)) (plus$ (size$a ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$a ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$a ?v0 ?v1)))) :named a6))
