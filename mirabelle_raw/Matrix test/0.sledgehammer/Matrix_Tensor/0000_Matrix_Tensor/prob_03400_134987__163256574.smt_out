unsat
(assume conjecture3 (! (not (! (and (! (= w2$ (fun_app$e (cons$ a2$) u2$)) :named @p_3) (! (= (! (size$ u2$) :named @p_1) k$) :named @p_2)) :named @p_4)) :named @p_5))
(assume a4 @p_4)
(step t0 (cl @p_3) :rule and :premises (a4) :args (0))
(step t1 (cl @p_2) :rule and :premises (a4) :args (1))
(step t2 (cl (! (= k$ @p_1) :named @p_6)) :rule symm :premises (t1))
(step t3 (cl (! (and @p_3 @p_6) :named @p_7)) :rule and_intro :premises (t0 t2))
(step t4 (cl (not (! (= @p_5 (! (not @p_7) :named @p_8)) :named @p_9)) (not @p_5) @p_8) :rule equiv_pos2)
(step t5 (cl (= @p_2 @p_6)) :rule rare_rewrite :args ("eq-symm" @p_1 k$))
(step t6 (cl (= @p_4 @p_7)) :rule cong :premises (t5))
(step t7 (cl @p_9) :rule cong :premises (t6))
(step t8 (cl @p_8) :rule resolution :premises (t4 t7 conjecture3))
(step t9 (cl) :rule resolution :premises (t3 t8))
