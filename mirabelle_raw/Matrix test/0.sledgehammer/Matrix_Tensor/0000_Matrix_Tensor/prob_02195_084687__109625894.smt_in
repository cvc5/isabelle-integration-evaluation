(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (cons$ (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$a w$ n$))))) (nth$ w$ (modulo$ i$ (size$ w$)))) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ (cons$a w$ n$)))) (row$ n$ (modulo$ i$ (row_length$ n$))))) (cons$ (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (size$ w$)))) (nth$ w$ (modulo$ i$ (size$ w$)))) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ n$))) (row$ n$ (modulo$ i$ (row_length$ n$))))))) :named conjecture0))
(assert (! (= (times$ f$ (nth$ v$ (divide$ i$ (row_length$ (cons$a w$ n$)))) (cons$ (nth$ w$ (modulo$ i$ (size$ w$))) (row$ n$ (modulo$ i$ (row_length$ n$))))) (cons$ (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$a w$ n$))))) (nth$ w$ (modulo$ i$ (size$ w$)))) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ (cons$a w$ n$)))) (row$ n$ (modulo$ i$ (row_length$ n$)))))) :named a1))
(assert (! (= (row_length$ (cons$a w$ n$)) (size$ w$)) :named a2))
(assert (! (= (size$ w1$) (size$ w$)) :named a3))
(assert (! (= (row_length$ n$) (size$ w1$)) :named a4))
(check-sat)
(get-proof)
