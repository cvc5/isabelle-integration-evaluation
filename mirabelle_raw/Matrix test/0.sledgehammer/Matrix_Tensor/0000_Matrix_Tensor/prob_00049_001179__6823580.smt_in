; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 309
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A$)
(declare-fun id$ () A$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun mult$ (A$ A_a_a_fun_fun$) Bool)
(declare-fun times$ (A_a_a_fun_fun$ A$) A_list_a_list_fun$)
(declare-fun fun_app$ (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun fun_app$a (A_a_fun$ A$) A$)
(declare-fun fun_app$b (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (not (= (fun_app$ (times$ f$ v$) (cons$ id$ nil$)) (cons$ v$ nil$))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$)) (= (mult$ ?v0 ?v1) (and (and (forall ((?v2 A$) (?v3 A$)) (= (fun_app$a (fun_app$b ?v1 ?v2) ?v3) (fun_app$a (fun_app$b ?v1 ?v3) ?v2))) (forall ((?v2 A$) (?v3 A$) (?v4 A$)) (= (fun_app$a (fun_app$b ?v1 (fun_app$a (fun_app$b ?v1 ?v2) ?v3)) ?v4) (fun_app$a (fun_app$b ?v1 ?v2) (fun_app$a (fun_app$b ?v1 ?v3) ?v4))))) (and (forall ((?v2 A$)) (= (fun_app$a (fun_app$b ?v1 ?v0) ?v2) ?v2)) (forall ((?v2 A$)) (= (fun_app$a (fun_app$b ?v1 ?v2) ?v0) ?v2)))))) :named a1))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$ (times$ f$ ?v0) nil$) nil$) :pattern ((times$ f$ ?v0)))) :named a2))
(assert (! (mult$ id$ f$) :named a3))
(check-sat)
(get-proof)
