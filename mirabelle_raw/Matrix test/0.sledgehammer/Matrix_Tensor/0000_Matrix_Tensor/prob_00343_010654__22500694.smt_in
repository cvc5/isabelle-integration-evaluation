; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_set$ 0)
(declare-sort B_list$ 0)
(declare-sort B_option$ 0)
(declare-sort B_bool_fun$ 0)
(declare-sort B_b_option_fun$ 0)
(declare-fun a$ () B$)
(declare-fun m$ () B_list$)
(declare-fun x$ () B$)
(declare-fun hd$ (B_list$) B$)
(declare-fun bot$ () B_set$)
(declare-fun nil$ () B_list$)
(declare-fun set$ (B_list$) B_set$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun find$ (B_bool_fun$ B_list$) B_option$)
(declare-fun append$ (B_list$ B_list$) B_list$)
(declare-fun insert$ (B$ B_list$) B_list$)
(declare-fun member$ (B$ B_set$) Bool)
(declare-fun rotate$ (Nat$ B_list$) B_list$)
(declare-fun fun_app$ (B_bool_fun$ B$) Bool)
(declare-fun insert$a (B$ B_set$) B_set$)
(declare-fun listMem$ (B$ B_list$) Bool)
(declare-fun list_ex$ (B_bool_fun$ B_list$) Bool)
(declare-fun member$a (B_list$) B_bool_fun$)
(declare-fun rotate1$ (B_list$) B_list$)
(declare-fun map_filter$ (B_b_option_fun$ B_list$) B_list$)
(declare-fun image_filter$ (B_b_option_fun$ B_set$) B_set$)
(assert (! (not (or (= x$ a$) (member$ x$ (set$ m$)))) :named conjecture0))
(assert (! (member$ x$ (set$ (cons$ a$ m$))) :named a1))
(assert (! (forall ((?v0 B_list$) (?v1 B$)) (! (= (fun_app$ (member$a ?v0) ?v1) (member$ ?v1 (set$ ?v0))) :pattern ((fun_app$ (member$a ?v0) ?v1)))) :named a2))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (=> (member$ ?v0 (set$ ?v1)) (= (insert$ ?v0 ?v1) ?v1)) :pattern ((insert$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (listMem$ ?v0 ?v1) (member$ ?v0 (set$ ?v1))) :pattern ((listMem$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 B$) (?v3 B_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a5))
(assert (! (forall ((?v0 B_set$) (?v1 B_bool_fun$)) (= (forall ((?v2 B$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))) (forall ((?v2 B$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))))) :named a6))
(assert (! (forall ((?v0 B_list$)) (= (set$ (rotate1$ ?v0)) (set$ ?v0))) :named a7))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (= (member$ ?v0 (set$ ?v1)) (exists ((?v2 B_list$) (?v3 B_list$)) (= ?v1 (append$ ?v2 (cons$ ?v0 ?v3)))))) :named a8))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (set$ (cons$ ?v0 ?v1)) (insert$a ?v0 (set$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a9))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 B_bool_fun$) (?v3 B_bool_fun$)) (=> (and (= ?v0 ?v1) (forall ((?v4 B$)) (=> (member$ ?v4 (set$ ?v1)) (= (fun_app$ ?v2 ?v4) (fun_app$ ?v3 ?v4))))) (= (list_ex$ ?v2 ?v0) (list_ex$ ?v3 ?v1)))) :named a10))
(assert (! (forall ((?v0 B_list$)) (=> (not (= ?v0 nil$)) (member$ (hd$ ?v0) (set$ ?v0)))) :named a11))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (= (member$ ?v0 (set$ ?v1)) (exists ((?v2 B_list$) (?v3 B_list$)) (and (= ?v1 (append$ ?v2 (cons$ ?v0 ?v3))) (not (member$ ?v0 (set$ ?v3))))))) :named a12))
(assert (! (forall ((?v0 B_b_option_fun$) (?v1 B_list$)) (= (image_filter$ ?v0 (set$ ?v1)) (set$ (map_filter$ ?v0 ?v1)))) :named a13))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (=> (member$ ?v0 (set$ ?v1)) (exists ((?v2 B_list$) (?v3 B_list$)) (= ?v1 (append$ ?v2 (cons$ ?v0 ?v3)))))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 B_list$)) (= (set$ (rotate$ ?v0 ?v1)) (set$ ?v1))) :named a15))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 B_bool_fun$) (?v3 B_bool_fun$)) (=> (and (= ?v0 ?v1) (forall ((?v4 B$)) (=> (member$ ?v4 (set$ ?v1)) (= (fun_app$ ?v2 ?v4) (fun_app$ ?v3 ?v4))))) (= (find$ ?v2 ?v0) (find$ ?v3 ?v1)))) :named a16))
(assert (! (forall ((?v0 B$)) (= (member$ ?v0 bot$) false)) :named a17))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (=> (not (member$ ?v0 (set$ ?v1))) (= (insert$ ?v0 ?v1) (cons$ ?v0 ?v1))) :pattern ((insert$ ?v0 ?v1)))) :named a18))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (member$ ?v0 (set$ (cons$ ?v0 ?v1)))) :named a19))
(assert (! (forall ((?v0 B$) (?v1 B$) (?v2 B_set$)) (= (member$ ?v0 (insert$a ?v1 ?v2)) (or (= ?v0 ?v1) (member$ ?v0 ?v2)))) :named a20))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (insert$ ?v0 ?v1) (ite (member$ ?v0 (set$ ?v1)) ?v1 (cons$ ?v0 ?v1))) :pattern ((insert$ ?v0 ?v1)))) :named a21))
(assert (! (forall ((?v0 B$) (?v1 B$) (?v2 B_list$)) (=> (member$ ?v0 (set$ (cons$ ?v1 ?v2))) (or (= ?v0 ?v1) (member$ ?v0 (set$ ?v2))))) :named a22))
(check-sat)
(get-proof)
