unsat
(assume conjecture34 (! (not (! (= (! (fun_app$ac (append$ (fun_app$ad (! (fun_app$ae map$ uu$) :named @p_1) a$)) (fun_app$ad @p_1 b$)) :named @p_2) @p_2) :named @p_3)) :named @p_4))
(step t0 (cl (not (! (= @p_4 false) :named @p_5)) (not @p_4) false) :rule equiv_pos2)
(step t1 (cl (= @p_3 true)) :rule rare_rewrite :args ("eq-refl" @p_2))
(step t2 (cl (= @p_4 (! (not true) :named @p_6))) :rule cong :premises (t1))
(step t3 (cl (= @p_6 false)) :rule evaluate)
(step t4 (cl @p_5) :rule trans :premises (t2 t3))
(step t5 (cl false) :rule resolution :premises (t0 t4 conjecture34))
(step t6 (cl (not false)) :rule false)
(step t7 (cl) :rule resolution :premises (t5 t6))
