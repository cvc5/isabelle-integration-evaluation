; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun x$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (not (= (nth$ (times$ f$ a$ (cons$ x$ xs$)) i$) (fun_app$ (fun_app$a f$ a$) x$))) :named conjecture0))
(assert (! (= i$ zero$) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (! (= (times$ f$ ?v0 (cons$ ?v1 ?v2)) (cons$ (fun_app$ (fun_app$a f$ ?v0) ?v1) (times$ f$ ?v0 ?v2))) :pattern ((times$ f$ ?v0 (cons$ ?v1 ?v2))))) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (nth$ (cons$ ?v0 ?v1) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(check-sat)
(get-proof)
