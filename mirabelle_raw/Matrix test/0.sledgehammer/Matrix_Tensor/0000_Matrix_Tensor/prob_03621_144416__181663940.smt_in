; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 261
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_prod$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_a_prod_list$ 0)
(declare-sort A_a_a_a_fun_fun_fun$ 0)
(declare-sort A_a_prod_a_a_fun_fun$ 0)
(declare-fun f$ (A$ A$) A$)
(declare-fun g$ (A$) A_a_fun$)
(declare-fun a1$ () A$)
(declare-fun a2$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun u2$ () A_list$)
(declare-fun uu$ () A_a_a_a_fun_fun_fun$)
(declare-fun v1$ () A_list$)
(declare-fun v2$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun zip$ (A_list$ A_list$) A_a_prod_list$)
(declare-fun comp$ (A_a_fun$ A_a_fun$) A_a_fun$)
(declare-fun cons$ (A_a_prod$ A_a_prod_list$) A_a_prod_list$)
(declare-fun pair$ (A$ A$) A_a_prod$)
(declare-fun foldr$ (A_a_prod_a_a_fun_fun$ A_a_prod_list$) A_a_fun$)
(declare-fun fun_app$ (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun fun_app$a (A_a_a_a_fun_fun_fun$ A$) A_a_a_fun_fun$)
(declare-fun fun_app$b (A_a_fun$ A$) A$)
(declare-fun fun_app$c (A_a_prod_a_a_fun_fun$ A_a_prod$) A_a_fun$)
(declare-fun case_prod$ (A_a_a_a_fun_fun_fun$) A_a_prod_a_a_fun_fun$)
(assert (! (forall ((?v0 A$) (?v1 A$)) (! (= (fun_app$ (fun_app$a uu$ ?v0) ?v1) (g$ (f$ ?v0 ?v1))) :pattern ((fun_app$ (fun_app$a uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (= (fun_app$b (foldr$ (case_prod$ uu$) (zip$ v1$ v2$)) zer$) (fun_app$b (g$ (f$ a1$ a2$)) (fun_app$b (foldr$ (case_prod$ uu$) (zip$ u1$ u2$)) zer$)))) :named conjecture1))
(assert (! (= (zip$ v1$ v2$) (cons$ (pair$ a1$ a2$) (zip$ u1$ u2$))) :named a2))
(assert (! (forall ((?v0 A_a_a_a_fun_fun_fun$) (?v1 A$) (?v2 A$)) (! (= (fun_app$c (case_prod$ ?v0) (pair$ ?v1 ?v2)) (fun_app$ (fun_app$a ?v0 ?v1) ?v2)) :pattern ((fun_app$c (case_prod$ ?v0) (pair$ ?v1 ?v2))))) :named a3))
(assert (! (forall ((?v0 A_a_prod_a_a_fun_fun$) (?v1 A_a_prod$) (?v2 A_a_prod_list$)) (! (= (foldr$ ?v0 (cons$ ?v1 ?v2)) (comp$ (fun_app$c ?v0 ?v1) (foldr$ ?v0 ?v2))) :pattern ((foldr$ ?v0 (cons$ ?v1 ?v2))))) :named a4))
(check-sat)
(get-proof)
