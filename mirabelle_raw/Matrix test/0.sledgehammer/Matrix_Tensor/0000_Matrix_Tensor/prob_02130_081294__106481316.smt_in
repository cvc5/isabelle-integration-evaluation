; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 230
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun n1$ () A_list_list$)
(declare-fun nr$ () Nat$)
(declare-fun w1$ () A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ i$ (times$ (size$ v$) (row_length$ (cons$ w1$ n1$))))) :named conjecture0))
(assert (! (= n$ (cons$ w1$ n1$)) :named a1))
(assert (! (= (row_length$ n$) (size$ w1$)) :named a2))
(assert (! (and (less$ i$ (times$ (size$ v$) (row_length$ (cons$ w$ n$)))) (mat$ nr$ (size$a (cons$ w$ n$)) (cons$ w$ n$))) :named a3))
(assert (! (= (size$ w1$) (size$ w$)) :named a4))
(check-sat)
(get-proof)
