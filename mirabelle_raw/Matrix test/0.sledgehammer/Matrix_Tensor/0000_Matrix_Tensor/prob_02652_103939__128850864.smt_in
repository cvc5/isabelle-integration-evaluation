(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (forall ((?v0 Nat$)) (=> (less$ ?v0 (times$ (times$ (row_length$ m1$) (row_length$ m2$)) (row_length$ m3$))) (less$ (modulo$ ?v0 (row_length$ (tensor$ f$ m2$ m3$))) (row_length$ (tensor$ f$ m2$ m3$)))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (times$ (times$ (size$ m1$) (size$ m2$)) (size$ m3$))) (less$ (modulo$ ?v0 (size$ (tensor$ f$ m2$ m3$))) (size$ (tensor$ f$ m2$ m3$))))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (times$ ?v0 ?v1) ?v2) (times$ ?v0 (times$ ?v1 ?v2)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (less$ (modulo$ ?v1 ?v0) ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a5))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a6))
(assert (! (= (size$ nil$) zero$) :named a7))
(assert (! (forall ((?v0 Nat$)) (! (= (times$ zero$ ?v0) zero$) :pattern ((times$ zero$ ?v0)))) :named a8))
(check-sat)
(get-proof)
