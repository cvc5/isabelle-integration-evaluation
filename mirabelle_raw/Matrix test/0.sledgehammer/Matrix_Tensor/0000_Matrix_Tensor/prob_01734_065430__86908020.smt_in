(assert (! (not (=> (and (less$ i$ (times$ (row_length$ (cons$ v$ m$)) (row_length$ (cons$ w$ n$)))) (and (less$ j$ (times$ (size$ (cons$ v$ m$)) (size$ (cons$ w$ n$)))) (mat$ (row_length$ (cons$ w$ n$)) (size$ (cons$ w$ n$)) (cons$ w$ n$)))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) j$) i$) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$))))) (nth$ (nth$a (cons$ w$ n$) j$) (modulo$ i$ (row_length$ (cons$ w$ n$)))))))) :named conjecture0))
(assert (! (=> (and (and (less$ i$ (times$ (size$a v$) (row_length$ (cons$ w$ n$)))) (less$ j$ (size$ (cons$ w$ n$)))) (mat$ (row_length$ (cons$ w$ n$)) (size$ (cons$ w$ n$)) (cons$ w$ n$))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) j$) i$) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$))))) (nth$ (nth$a (cons$ w$ n$) j$) (modulo$ i$ (row_length$ (cons$ w$ n$))))))) :named a1))
(assert (! (= m$ nil$) :named a2))
(assert (! (= (less$ j$ (times$ (size$ (cons$ v$ nil$)) (size$ (cons$ w$ n$)))) (less$ j$ (size$ (cons$ w$ n$)))) :named a3))
