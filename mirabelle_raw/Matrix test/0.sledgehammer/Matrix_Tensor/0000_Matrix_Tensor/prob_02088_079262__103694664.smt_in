(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (fun_app$h (less_eq$ ?v0) ?v1) (exists ((?v2 Nat$)) (= ?v1 (fun_app$d (fun_app$e plus$ ?v0) ?v2))))) :named a259))
(check-sat)
(get-proof)
