; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 245
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ zero$ (size$ (cons$ a$ ma$)))) :named conjecture0))
(assert (! (= (row_length$ (cons$ a$ ma$)) (size$a a$)) :named a1))
(assert (! (not (less$ zero$ zero$)) :named a2))
(assert (! (not (= a$ nil$)) :named a3))
(assert (! (= (row_length$ nil$a) zero$) :named a4))
(check-sat)
(get-proof)
