unsat
(assume conjecture0 (! (not (! (= (nth$ (! (fun_app$ (! (fun_app$a (times$ f$) a$) :named @p_1) (cons$ x$ xs$)) :named @p_3) i$) (nth$ (! (cons$ (fun_app$b (fun_app$c f$ a$) x$) (fun_app$ @p_1 xs$)) :named @p_2) i$)) :named @p_4)) :named @p_5))
