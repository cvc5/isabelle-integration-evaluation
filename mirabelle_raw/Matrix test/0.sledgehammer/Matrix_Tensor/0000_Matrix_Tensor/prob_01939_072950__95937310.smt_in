; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun append$ (A_list_list$ A_list_list$) A_list_list$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (= (nth$ (tensor$ f$ (cons$ v$ m$) m2$) j$) (nth$ (vec_mat_Tensor$ f$ v$ m2$) j$))) :named conjecture0))
(assert (! (less$ j$ (size$ (vec_mat_Tensor$ f$ v$ m2$))) :named hypothesis1))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$) (?v2 A_list_list$)) (=> (less$ ?v0 (size$ ?v1)) (= (nth$ (append$ ?v1 ?v2) ?v0) (nth$ ?v1 ?v0)))) :named a2))
(assert (! (= (nth$ (tensor$ f$ (cons$ v$ m$) m2$) j$) (nth$ (append$ (vec_mat_Tensor$ f$ v$ m2$) (tensor$ f$ m$ m2$)) j$)) :named a3))
(check-sat)
(get-proof)
