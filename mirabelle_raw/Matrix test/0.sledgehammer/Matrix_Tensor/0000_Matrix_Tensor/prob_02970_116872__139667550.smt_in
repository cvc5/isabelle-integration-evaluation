; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 236
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-fun b$ () A_list_list$)
(declare-fun n$ () Nat$)
(declare-fun nc$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(assert (! (not (= (size$ b$) nc$)) :named conjecture0))
(assert (! (mat$ n$ nc$ b$) :named a1))
(check-sat)
(get-proof)
