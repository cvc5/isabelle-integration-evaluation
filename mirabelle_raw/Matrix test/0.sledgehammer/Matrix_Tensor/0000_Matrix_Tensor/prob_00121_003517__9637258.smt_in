; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 256
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun v$ () A_list$)
(declare-fun y$ () A_list$)
(declare-fun nr$ () Nat$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (size$ (vec_vec_Tensor$ f$ v$ y$)) (times$ nr$ k$))) :named conjecture0))
(assert (! (= (size$ y$) nr$) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (= (size$ (vec_vec_Tensor$ f$ ?v0 ?v1)) (times$ (size$ ?v0) (size$ ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a3))
(check-sat)
(get-proof)
