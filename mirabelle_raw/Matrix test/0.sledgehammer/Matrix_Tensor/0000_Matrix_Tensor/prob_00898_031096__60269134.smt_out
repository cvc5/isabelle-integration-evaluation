unsat
(assume conjecture1 (! (not (! (= (! (divide$ a$ b$) :named @p_4) (! (+ (! (divide$ (! (- a$ b$) :named @p_1) b$) :named @p_2) 1) :named @p_3)) :named @p_5)) :named @p_6))
