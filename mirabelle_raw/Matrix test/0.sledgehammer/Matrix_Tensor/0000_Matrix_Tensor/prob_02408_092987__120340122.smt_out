unsat
(assume conjecture2 (! (not (! (= c$ zero$) :named @p_1)) :named @p_2))
(assume a3 (! (not (! (= b$ zero$) :named @p_3)) :named @p_4))
(assume a6 (! (or @p_3 @p_1) :named @p_5))
(step t0 (cl (! (not @p_5) :named @p_6) @p_3 @p_1) :rule or_pos)
(step t1 (cl @p_6) :rule resolution :premises (t0 a3 conjecture2))
(step t2 (cl) :rule resolution :premises (a6 t1))
