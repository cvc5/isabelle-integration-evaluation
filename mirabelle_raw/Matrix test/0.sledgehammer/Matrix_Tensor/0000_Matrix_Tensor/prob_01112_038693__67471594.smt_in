; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 385
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(assert (! (not (=> (= i$ (size$ y$)) (= (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$ y$))) (less$ zero$ (times$ (size$ zs$) (size$ y$)))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ zero$ ?v0) (= (less$ (divide$ ?v1 ?v0) ?v2) (less$ ?v1 (times$ ?v2 ?v0))))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a3))
(assert (! (forall ((?v0 Nat$)) (= (not (less$ zero$ ?v0)) (= ?v0 zero$))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (not (= ?v0 ?v1)) (and (=> (less$ ?v0 ?v1) false) (=> (less$ ?v1 ?v0) false))) false)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less$ ?v0 ?v1)) (less$ ?v1 (suc$ ?v0)))) :named a6))
(assert (! (=> (= i$ (size$ y$)) (= (divide$ i$ (size$ y$)) one$)) :named a7))
(assert (! (less$ zero$ one$) :named a8))
(check-sat)
(get-proof)
