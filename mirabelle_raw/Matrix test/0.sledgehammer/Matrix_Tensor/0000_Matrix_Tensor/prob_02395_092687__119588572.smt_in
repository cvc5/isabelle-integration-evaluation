(declare-fun collect$ (Nat_bool_fun$) Nat_set$)
(declare-fun fun_app$ (Nat_bool_fun$ Nat$) Bool)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun fun_app$a (Nat_nat_fun$ Nat$) Nat$)
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (! (= (fun_app$ (uu$ ?v0 ?v1) ?v2) (less_eq$ (fun_app$a (times$ ?v2) ?v1) ?v0)) :pattern ((fun_app$ (uu$ ?v0 ?v1) ?v2)))) :named a0))
(assert (! (not (= (divide$ (modulo$ a$ (fun_app$a (times$ b$) c$)) c$) (modulo$ (divide$ a$ c$) b$))) :named conjecture1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (modulo$ ?v0 (fun_app$a (times$ ?v1) ?v2)) ?v2) (modulo$ ?v0 ?v2))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ ?v0 (fun_app$a (times$ ?v1) ?v2)) (plus$ (fun_app$a (times$ ?v1) (modulo$ (divide$ ?v0 ?v1) ?v2)) (modulo$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= ?v0 (plus$ (fun_app$a (times$ (divide$ ?v0 ?v1)) ?v1) (modulo$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (plus$ ?v0 ?v1) (plus$ ?v2 ?v1)) (= ?v0 ?v2))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$a (times$ ?v0) ?v1) (fun_app$a (times$ ?v1) ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$a (times$ ?v0) zero$) zero$) :pattern ((times$ ?v0)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (fun_app$a (times$ ?v0) ?v1) ?v0) zero$)) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ ?v0 (modulo$ ?v0 ?v1)) (fun_app$a (times$ (divide$ ?v0 ?v1)) ?v1))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ ?v0 ?v1) (ite (= ?v1 zero$) zero$ (max$ (collect$ (uu$ ?v0 ?v1)))))) :named a10))
(check-sat)
(get-proof)
