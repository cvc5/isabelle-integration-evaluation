; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (col$ (vec_mat_Tensor$ f$ v$ m2$) j$) (vec_vec_Tensor$ f$ v$ (col$ m2$ j$)))) :named conjecture0))
(assert (! (less$ j$ (size$ m2$)) :named hypothesis1))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$) (?v2 A_list$)) (=> (less$ ?v0 (size$ ?v1)) (= (col$ (vec_mat_Tensor$ f$ ?v2 ?v1) ?v0) (vec_vec_Tensor$ f$ ?v2 (col$ ?v1 ?v0))))) :named a2))
(assert (! (=> (less$ j$ (size$ m2$)) (= (col$ (tensor$ f$ (cons$ v$ m$) m2$) j$) (col$ (vec_mat_Tensor$ f$ v$ m2$) j$))) :named a3))
(check-sat)
(get-proof)
