(assert (! (= (nth$ (cons$ x$ xs$) i$) (nth$ xs$ j$)) :named a12))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (size$ xs$)) (= (nth$ (fun_app$ (fun_app$a (times$ f$) a$) xs$) ?v0) (fun_app$b (fun_app$c f$ a$) (nth$ xs$ ?v0))))) :named a13))
(assert (! (= (nth$ (cons$ (fun_app$b (fun_app$c f$ a$) x$) (fun_app$ (fun_app$a (times$ f$) a$) xs$)) i$) (nth$ (fun_app$ (fun_app$a (times$ f$) a$) xs$) j$)) :named a14))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A$) (?v3 A$) (?v4 A$)) (=> (mult$ ?v0 ?v1) (= (fun_app$b (fun_app$c ?v1 (fun_app$b (fun_app$c ?v1 ?v2) ?v3)) ?v4) (fun_app$b (fun_app$c ?v1 ?v2) (fun_app$b (fun_app$c ?v1 ?v3) ?v4))))) :named a15))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (= (size$ (fun_app$ (fun_app$a (times$ f$) ?v0) ?v1)) (size$ ?v1))) :named a16))
(assert (! (= i$ (suc$ j$)) :named a17))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (suc$ ?v2))))) :named a18))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$ (fun_app$a (times$ f$) ?v0) nil$) nil$) :pattern ((fun_app$a (times$ f$) ?v0)))) :named a19))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (nth$ (cons$ ?v0 ?v1) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a20))
(assert (! (forall ((?v0 A_a_a_fun_fun$)) (! (= (times$ ?v0) (times$ ?v0)) :pattern ((times$ ?v0)))) :named a21))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (=> (and (= (size$ ?v0) (size$ ?v1)) (forall ((?v2 Nat$)) (=> (less$ ?v2 (size$ ?v0)) (= (nth$ ?v0 ?v2) (nth$ ?v1 ?v2))))) (= ?v0 ?v1))) :named a22))
(assert (! (forall ((?v0 Nat$)) (= (nth$ (cons$ x$ xs$) (plus$ ?v0 one$)) (nth$ xs$ ?v0))) :named a23))
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ (fun_app$a (times$ f$) id$) ?v0) ?v0) :pattern ((fun_app$ (fun_app$a (times$ f$) id$) ?v0)))) :named a24))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (= (= ?v0 ?v1) (and (= (size$ ?v0) (size$ ?v1)) (forall ((?v2 Nat$)) (=> (less$ ?v2 (size$ ?v0)) (= (nth$ ?v0 ?v2) (nth$ ?v1 ?v2))))))) :named a25))
(assert (! (= one$ (suc$ zero$)) :named a26))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ (suc$ ?v0) (suc$ ?v1)) (less$ ?v0 ?v1))) :named a27))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A$) (?v3 A_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a28))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A$) (?v3 A$) (?v4 A_list$)) (=> (mult$ ?v0 ?v1) (= (fun_app$ (fun_app$a (times$ ?v1) ?v2) (cons$ ?v3 ?v4)) (cons$ (fun_app$b (fun_app$c ?v1 ?v2) ?v3) (fun_app$ (fun_app$a (times$ ?v1) ?v2) ?v4))))) :named a29))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$ (fun_app$a (times$ f$) ?v0) (cons$ id$ nil$)) (cons$ ?v0 nil$)) :pattern ((fun_app$a (times$ f$) ?v0)))) :named a30))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a31))
(assert (! (forall ((?v0 Nat$) (?v1 Nat_a_bool_fun_fun$)) (= (forall ((?v2 Nat$)) (=> (less$ ?v2 ?v0) (exists ((?v3 A$)) (fun_app$d (fun_app$e ?v1 ?v2) ?v3)))) (exists ((?v2 A_list$)) (and (= (size$ ?v2) ?v0) (forall ((?v3 Nat$)) (=> (less$ ?v3 ?v0) (fun_app$d (fun_app$e ?v1 ?v3) (nth$ ?v2 ?v3)))))))) :named a32))
