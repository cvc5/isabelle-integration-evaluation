(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A$) (?v3 A$)) (=> (mult$ ?v0 ?v1) (= (fun_app$b (fun_app$c ?v1 ?v2) ?v3) (fun_app$b (fun_app$c ?v1 ?v3) ?v2)))) :named a9))
