; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-fun f$ (A$ A$) A$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun z$ () Nat$)
(declare-fun id$ () A$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (less_eq$ (times$ (divide$ x$ z$) z$) z$)) :named conjecture0))
(assert (! (= (plus$ (times$ (divide$ x$ z$) z$) (modulo$ x$ z$)) z$) :named a1))
(assert (! (less_eq$ y$ (divide$ x$ z$)) :named a2))
(assert (! (less_eq$ (times$ y$ z$) (times$ (divide$ x$ z$) z$)) :named a3))
(assert (! (less$ x$ (times$ y$ z$)) :named a4))
(assert (! (not (less$ (divide$ x$ z$) y$)) :named a5))
(assert (! (forall ((?v0 A$)) (= (f$ id$ ?v0) ?v0)) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (less_eq$ (times$ (divide$ ?v0 ?v1) ?v1) ?v0)) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v2) ?v1))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (less_eq$ (times$ ?v0 (divide$ ?v1 ?v0)) ?v1)) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (less_eq$ (modulo$ ?v0 ?v1) ?v0)) :named a10))
(assert (! (forall ((?v0 Nat$)) (less_eq$ ?v0 ?v0)) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less$ ?v0 ?v1)) (less_eq$ ?v1 ?v0))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ (times$ (divide$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1)) ?v0)) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (divide$ ?v0 (times$ ?v1 ?v2)) (divide$ (divide$ ?v0 ?v1) ?v2))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (less_eq$ ?v2 (minus$ ?v1 ?v0)) (less_eq$ (plus$ ?v2 ?v0) ?v1)))) :named a15))
(assert (! (forall ((?v0 Nat$)) (less_eq$ ?v0 ?v0)) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (less_eq$ (divide$ ?v0 ?v2) (divide$ ?v1 ?v2)))) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ (plus$ ?v0 ?v1) ?v2) (less_eq$ ?v0 ?v2))) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a19))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (modulo$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1))) :named a20))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (=> (less$ ?v0 ?v1) (= (modulo$ ?v0 ?v1) ?v0)) :pattern ((modulo$ ?v0 ?v1)))) :named a21))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (plus$ ?v0 ?v1) ?v0) (modulo$ ?v1 ?v0))) :named a22))
(assert (! (forall ((?v0 Nat$)) (= (plus$ zero$ ?v0) ?v0)) :named a23))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a24))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (plus$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1))) :named a25))
(check-sat)
(get-proof)
