; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 283
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun vec$a (Nat$ A_list_list$) Bool)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ ma$) (size$ a$))) :named conjecture0))
(assert (! (= (size$ b$) (size$ a$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$ ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$a ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a3))
(assert (! (mat$ (row_length$ ma$) (size$a ma$) ma$) :named a4))
(assert (! (member$ b$ (set$ ma$)) :named a5))
(check-sat)
(get-proof)
