; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 221
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (col$ (tensor$ f$ (cons$ v$ m$) m2$) j$) (vec_vec_Tensor$ f$ (col$ (cons$ v$ m$) (divide$ j$ (size$ m2$))) (col$ m2$ (modulo$ j$ (size$ m2$)))))) :named conjecture0))
(assert (! (less_eq$ (size$ m2$) j$) :named hypothesis1))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (col$ (tensor$ f$ m$ m2$) (minus$ j$ (size$ m2$))) (vec_vec_Tensor$ f$ (col$ (cons$ v$ m$) (divide$ j$ (size$ m2$))) (col$ m2$ (modulo$ j$ (size$ m2$)))))) :named a2))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (col$ (tensor$ f$ (cons$ v$ m$) m2$) j$) (nth$ (tensor$ f$ m$ m2$) (minus$ j$ (size$ m2$))))) :named a3))
(check-sat)
(get-proof)
