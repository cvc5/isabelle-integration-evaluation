; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 235
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-fun x$ () B_list$)
(declare-fun nr1$ () Nat$)
(declare-fun nr2$ () Nat$)
(declare-fun vec$ (Nat$ B_list$) Bool)
(assert (! (not (=> (and (vec$ nr1$ x$) (vec$ nr2$ x$)) (= nr1$ nr2$))) :named conjecture0))
(check-sat)
(get-proof)
