(assert (! (not (= (plus$ (fun_app$ (divide$ (minus$ j$ (size$ m2$))) (size$ m2$)) one$) (fun_app$ (divide$ j$) (size$ m2$)))) :named conjecture0))
(assert (! (less_eq$ (size$ m2$) j$) :named hypothesis1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 ?v1) (plus$ ?v1 ?v0))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less_eq$ ?v0 ?v1) (not (= ?v0 ?v1))) (less$ ?v0 ?v1))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (= ?v0 zero$)) (= (fun_app$ (divide$ (plus$ ?v0 ?v1)) ?v0) (plus$ (fun_app$ (divide$ ?v1) ?v0) one$)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ zero$ ?v0) (less$ ?v0 ?v1)) (= (fun_app$ (divide$ ?v1) ?v0) (plus$ (fun_app$ (divide$ (minus$ ?v1 ?v0)) ?v0) one$)))) :named a5))
(assert (! (=> (less_eq$ (size$ m2$) j$) (less$ (minus$ j$ (size$ m2$)) (times$ (size$ m$) (size$ m2$)))) :named a6))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (col$ (tensor$ f$ m$ m2$) (minus$ j$ (size$ m2$))) (vec_vec_Tensor$ f$ (col$ m$ (fun_app$ (divide$ (minus$ j$ (size$ m2$))) (size$ m2$))) (col$ m2$ (modulo$ (minus$ j$ (size$ m2$)) (size$ m2$)))))) :named a7))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (plus$ ?v0 (minus$ ?v1 ?v0)) ?v1))) :named a9))
(assert (! (forall ((?v0 Nat$)) (! (=> (not (= ?v0 zero$)) (= (fun_app$ (divide$ ?v0) ?v0) one$)) :pattern ((divide$ ?v0)))) :named a10))
(assert (! (forall ((?v0 Nat$)) (! (= (times$ zero$ ?v0) zero$) :pattern ((times$ zero$ ?v0)))) :named a11))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (divide$ zero$) ?v0) zero$)) :named a12))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a13))
(assert (! (forall ((?v0 Nat$)) (= (less$ ?v0 zero$) false)) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (times$ ?v0 ?v1) (times$ ?v2 ?v1)) (or (= ?v0 ?v2) (= ?v1 zero$)))) :named a15))
