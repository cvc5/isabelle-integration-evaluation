(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (forall ((?v0 A_list$)) (=> (member$ ?v0 (set$ (tensor$ f$ (cons$ a$ m1a$) m2$))) (vec$ (times$ (size$ a$) (row_length$ m2$)) ?v0)))) :named conjecture0))
(assert (! (=> (member$ x$ (set$ (tensor$ f$ (cons$ a$ m1a$) m2$))) (or (member$ x$ (set$ (vec_mat_Tensor$ f$ a$ m2$))) (member$ x$ (set$ (tensor$ f$ m1a$ m2$))))) :named a1))
(assert (! (forall ((?v0 A_list$)) (=> (or (member$ ?v0 (set$ (vec_mat_Tensor$ f$ a$ m2$))) (member$ ?v0 (set$ (tensor$ f$ m1a$ m2$)))) (vec$ (times$ (size$ a$) (row_length$ m2$)) ?v0))) :named a2))
(assert (! (= (tensor$ f$ (cons$ a$ m1a$) m2$) (append$ (vec_mat_Tensor$ f$ a$ m2$) (tensor$ f$ m1a$ m2$))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_set$) (?v2 A_list_set$)) (= (member$ ?v0 (sup$ ?v1 ?v2)) (or (member$ ?v0 ?v1) (member$ ?v0 ?v2)))) :named a4))
(assert (! (forall ((?v0 A_list$)) (=> (member$ ?v0 (set$ (vec_mat_Tensor$ f$ a$ m2$))) (vec$ (times$ (size$ a$) (row_length$ m2$)) ?v0))) :named a5))
(assert (! (= m1a$ (cons$ b$ n1$)) :named a6))
(check-sat)
(get-proof)
