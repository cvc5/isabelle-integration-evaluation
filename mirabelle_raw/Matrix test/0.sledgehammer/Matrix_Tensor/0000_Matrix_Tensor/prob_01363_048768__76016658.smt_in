; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 295
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun x$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () A_list$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (size$ (cons$ a$ nil$)) one$)) :named conjecture0))
(assert (! (= a$ (cons$a x$ xs$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (not (= nil$a (cons$a ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 A_list_list$)) (=> (not (= ?v0 nil$)) (= (plus$ (size$ (reduct$ ?v0)) one$) (size$ ?v0)))) :named a4))
(assert (! (= (row_length$ nil$) zero$) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (plus$ ?v0 ?v1) ?v1) (= ?v0 zero$))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ ?v0 ?v1) (forall ((?v2 Nat$)) (=> (and (= ?v1 (plus$ ?v0 ?v2)) (not (= ?v2 zero$))) false))) false)) :named a7))
(assert (! (= (size$a nil$a) zero$) :named a8))
(assert (! (= (size$ nil$) zero$) :named a9))
(assert (! (less$ zero$ one$) :named a10))
(check-sat)
(get-proof)
