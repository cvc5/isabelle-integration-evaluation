; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (less$ (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) (size$ m$))) :named conjecture0))
(assert (! (less$ (minus$ j$ (size$ m2$)) (times$ (size$ m$) (size$ m2$))) :named a1))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (plus$ ?v0) zero$) ?v0)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) (fun_app$ suc$ ?v1)) (fun_app$ suc$ (fun_app$ (plus$ ?v0) ?v1)))) :named a3))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (fun_app$ (plus$ (divide$ (minus$ j$ (size$ m2$)) (size$ m2$))) one$) (divide$ j$ (size$ m2$)))) :named a4))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a5))
(assert (! (= (plus$ one$) suc$) :named a6))
(assert (! (= (size$ nil$) zero$) :named a7))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less_eq$ ?v0 ?v1)) (less$ ?v1 ?v0))) :named a9))
(assert (! (less_eq$ (size$ m2$) j$) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less_eq$ ?v0 ?v1) (or (less$ ?v0 ?v1) (= ?v0 ?v1)))) :named a11))
(assert (! (forall ((?v0 Nat$)) (= (divide$ ?v0 zero$) zero$)) :named a12))
(assert (! (not (less_eq$ one$ zero$)) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ zero$ ?v0) (= (less$ (divide$ ?v1 ?v0) ?v2) (less$ ?v1 (times$ ?v2 ?v0))))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (less$ ?v0 ?v1)) (= (fun_app$ (plus$ ?v1) (minus$ ?v0 ?v1)) ?v0))) :named a15))
(check-sat)
(get-proof)
