; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 284
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun m$ () A_list_list$)
(declare-fun tl$ (A_list_list$) A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (suc$ (size$ (reduct$ m$))) (size$ m$))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a1))
(assert (! (not (= m$ nil$)) :named a2))
(assert (! (= one$ (suc$ zero$)) :named a3))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (= (less_eq$ (suc$ ?v0) (size$ ?v1)) (exists ((?v2 A_list$) (?v3 A_list_list$)) (and (= ?v1 (cons$ ?v2 ?v3)) (less_eq$ ?v0 (size$ ?v3)))))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less_eq$ (suc$ ?v0) ?v1) (less$ ?v0 ?v1))) :named a6))
(assert (! (forall ((?v0 Nat$)) (=> (less$ zero$ ?v0) (= (suc$ (minus$ ?v0 (suc$ zero$))) ?v0))) :named a7))
(assert (! (forall ((?v0 A_list_list$)) (= (size$ (tl$ ?v0)) (minus$ (size$ ?v0) one$))) :named a8))
(check-sat)
(get-proof)
