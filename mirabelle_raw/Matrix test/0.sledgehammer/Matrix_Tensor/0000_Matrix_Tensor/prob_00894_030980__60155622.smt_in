; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-fun a$ () Int)
(declare-fun b$ () Int)
(declare-fun times$ (Int Int) Int)
(declare-fun divide$ (Int Int) Int)
(assert (! (not (= (divide$ (- a$ b$) b$) (+ (- 1) (divide$ a$ b$)))) :named conjecture0))
(assert (! (=> (not (= b$ 0)) (= (divide$ (+ a$ (* b$ (- 1))) b$) (+ (- 1) (divide$ a$ b$)))) :named a1))
(assert (! (< 0 b$) :named a2))
(assert (! (= (- a$ b$) (+ a$ (* (- 1) b$))) :named a3))
(assert (! (<= b$ a$) :named a4))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- ?v0 (- ?v1)) (+ ?v0 ?v1))) :named a5))
(assert (! (forall ((?v0 Int)) (= (divide$ ?v0 (- 1)) (- ?v0))) :named a6))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (+ (- ?v0) ?v1) (- ?v1 ?v0))) :named a7))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (and (< 0 ?v0) (<= ?v0 ?v1)) (= (divide$ ?v1 ?v0) (+ (divide$ (- ?v1 ?v0) ?v0) 1)))) :named a8))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (+ (- ?v0 ?v1) ?v1) ?v0)) :named a9))
(assert (! (forall ((?v0 Int)) (= (+ 0 ?v0) ?v0)) :named a10))
(assert (! (forall ((?v0 Int)) (= (* 1 ?v0) ?v0)) :named a11))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ ?v1 (times$ ?v0 ?v2)) ?v0) (+ ?v2 (divide$ ?v1 ?v0))))) :named a12))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (divide$ (- ?v0) (- ?v1)) (divide$ ?v0 ?v1))) :named a13))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ ?v1 ?v0) ?v0) (+ (divide$ ?v1 ?v0) 1)))) :named a14))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (- ?v0 ?v1)) (- ?v1 ?v0))) :named a15))
(assert (! (forall ((?v0 Int)) (= (divide$ ?v0 1) ?v0)) :named a16))
(assert (! (<= 0 (- a$ b$)) :named a17))
(assert (! (forall ((?v0 Int)) (= (+ ?v0 0) ?v0)) :named a18))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (times$ (- ?v0) ?v1) (- (times$ ?v0 ?v1)))) :named a19))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (<= (+ ?v0 ?v1) (+ ?v0 ?v2)) (<= ?v1 ?v2))) :named a20))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (+ ?v0 (+ (- ?v0) ?v1)) ?v1)) :named a21))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (+ ?v0 (- ?v1)) (- ?v0 ?v1))) :named a22))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (+ ?v0 ?v1) ?v1) ?v0)) :named a23))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (<= 0 (- ?v0 ?v1)) (<= ?v1 ?v0))) :named a24))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (+ (- ?v0) (+ ?v0 ?v1)) ?v1)) :named a25))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (+ ?v0 ?v1)) (+ (- ?v0) (- ?v1)))) :named a26))
(assert (! (forall ((?v0 Int)) (= (* 0 ?v0) 0)) :named a27))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (= (+ ?v0 ?v1) (+ ?v0 ?v2)) (= ?v1 ?v2))) :named a28))
(assert (! (forall ((?v0 Int)) (= (- ?v0 0) ?v0)) :named a29))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (= (+ ?v0 ?v1) (+ ?v2 ?v1)) (= ?v0 ?v2))) :named a30))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (+ ?v0 ?v1) ?v1) ?v0)) :named a31))
(assert (! (forall ((?v0 Int)) (= (* ?v0 0) 0)) :named a32))
(assert (! (forall ((?v0 Int)) (= (- (- ?v0)) ?v0)) :named a33))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (<= ?v0 (+ ?v1 ?v0)) (<= 0 ?v1))) :named a34))
(assert (! (forall ((?v0 Int)) (= (divide$ 0 ?v0) 0)) :named a35))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (= (- ?v0) (- ?v1)) (= ?v0 ?v1))) :named a36))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (< ?v0 ?v1) (<= (+ ?v0 1) ?v1))) :named a37))
(assert (! (forall ((?v0 Int)) (= (divide$ ?v0 0) 0)) :named a38))
(assert (! (forall ((?v0 Int)) (= ?v0 (+ ?v0 0))) :named a39))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int) (?v3 Int)) (=> (and (<= ?v0 ?v1) (= ?v2 ?v3)) (<= (+ ?v0 ?v2) (+ ?v1 ?v3)))) :named a40))
(assert (! (not (<= 1 0)) :named a41))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int) (?v3 Int)) (=> (= ?v0 (+ ?v1 ?v2)) (= (+ ?v3 ?v0) (+ ?v1 (+ ?v3 ?v2))))) :named a42))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (+ ?v0 ?v1) ?v0) ?v1)) :named a43))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (= (times$ ?v0 ?v1) (times$ ?v0 ?v2)) (or (= ?v0 0) (= ?v1 ?v2)))) :named a44))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (= (times$ ?v0 ?v1) 0) (or (= ?v0 0) (= ?v1 0)))) :named a45))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (< (+ ?v0 ?v1) (+ ?v0 ?v2)) (< ?v1 ?v2))) :named a46))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (<= (+ ?v0 ?v1) (+ ?v2 ?v1)) (<= ?v0 ?v2))) :named a47))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a48))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (not (<= ?v0 ?v1)) (< ?v1 ?v0))) :named a49))
(assert (! (forall ((?v0 Int) (?v1 Int)) (! (= (- ?v0 ?v1) (+ ?v0 (- ?v1))) :pattern ((- ?v0 ?v1)))) :named a50))
(check-sat)
(get-proof)
