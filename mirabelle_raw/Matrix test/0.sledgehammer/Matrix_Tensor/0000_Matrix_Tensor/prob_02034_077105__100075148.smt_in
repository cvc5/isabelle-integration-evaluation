; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 249
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_list_b_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun uu$ () B_list_b_fun$)
(declare-fun map$ (B_list_b_fun$ B_list_list$) B_list$)
(declare-fun nil$ () B_list_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun nil$a () B_list$)
(declare-fun size$ (B_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun fun_app$ (B_list_b_fun$ B_list$) B$)
(assert (! (forall ((?v0 B_list$)) (! (= (fun_app$ uu$ ?v0) (nth$ ?v0 i$)) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (= (map$ uu$ nil$) nil$a)) :named conjecture1))
(assert (! (forall ((?v0 B_list_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a2))
(assert (! (forall ((?v0 B_list$)) (= (= (size$a ?v0) zero$) (= ?v0 nil$a))) :named a3))
(check-sat)
(get-proof)
