; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 227
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-sort A_list_list_list_list_list$ 0)
(declare-fun m$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list_list_list_list$)
(declare-fun mat$a (Nat$ Nat$ A_list_list_list_list$) Bool)
(declare-fun mat$b (Nat$ Nat$ A_list_list_list$) Bool)
(declare-fun nil$a () A_list_list_list$)
(declare-fun nil$b () A_list_list$)
(declare-fun nil$c () A_list$)
(declare-fun nil$d () A_list_list_list_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list_list_list_list$) Nat$)
(declare-fun size$b (A_list$) Nat$)
(declare-fun size$c (A_list_list_list$) Nat$)
(declare-fun concat$ (A_list_list_list_list_list$) A_list_list_list_list$)
(declare-fun concat$a (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$b (A_list_list_list$) A_list_list$)
(declare-fun concat$c (A_list_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ (row_length$ m$) (size$ m$) m$)) :named conjecture0))
(assert (! (mat$a zero$ zero$ nil$) :named a1))
(assert (! (mat$b zero$ zero$ nil$a) :named a2))
(assert (! (mat$ zero$ zero$ nil$b) :named a3))
(assert (! (= (row_length$ nil$b) zero$) :named a4))
(assert (! (= (size$a nil$) zero$) :named a5))
(assert (! (= (size$b nil$c) zero$) :named a6))
(assert (! (= (size$c nil$a) zero$) :named a7))
(assert (! (= (size$ nil$b) zero$) :named a8))
(assert (! (= (concat$ nil$d) nil$) :named a9))
(assert (! (= (concat$a nil$) nil$a) :named a10))
(assert (! (= (concat$b nil$a) nil$b) :named a11))
(assert (! (= (concat$c nil$b) nil$c) :named a12))
(check-sat)
(get-proof)
