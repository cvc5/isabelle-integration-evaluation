; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun j$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (less$ j$ (size$ (cons$ w$ n$))) (= (nth$ (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) j$) (vec_vec_Tensor$ f$ v$ (nth$ (cons$ w$ n$) j$))))) :named conjecture0))
(assert (! (= (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) (cons$ (vec_vec_Tensor$ f$ v$ w$) (vec_mat_Tensor$ f$ v$ n$))) :named a1))
(assert (! (= (size$ nil$) zero$) :named a2))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (size$ n$)) (= (nth$ (vec_mat_Tensor$ f$ v$ n$) ?v0) (vec_vec_Tensor$ f$ v$ (nth$ n$ ?v0))))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (nth$ (cons$ ?v0 ?v1) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a5))
(assert (! (= one$ (suc$ zero$)) :named a6))
(assert (! (forall ((?v0 Nat$)) (= (less$ ?v0 (suc$ zero$)) (= ?v0 zero$))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less$ ?v0 ?v1)) (less_eq$ ?v1 ?v0))) :named a8))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) ?v2) (ite (= ?v2 zero$) ?v0 (nth$ ?v1 (minus$ ?v2 one$)))) :pattern ((nth$ (cons$ ?v0 ?v1) ?v2)))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (less$ (minus$ ?v1 ?v0) ?v2) (less$ ?v1 (plus$ ?v2 ?v0))))) :named a10))
(check-sat)
(get-proof)
