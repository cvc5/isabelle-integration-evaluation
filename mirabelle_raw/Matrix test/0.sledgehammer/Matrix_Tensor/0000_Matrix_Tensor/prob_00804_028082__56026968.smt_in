; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 234
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun x$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(assert (! (not (= (nth$ (cons$ x$ xs$) i$) (nth$ xs$ j$))) :named conjecture0))
(assert (! (= i$ (suc$ j$)) :named a1))
(check-sat)
(get-proof)
