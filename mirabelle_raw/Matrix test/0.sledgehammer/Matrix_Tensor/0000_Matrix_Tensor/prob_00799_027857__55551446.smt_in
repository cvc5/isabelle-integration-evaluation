; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 284
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun x$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(assert (! (not (=> (less$ i$ (size$ (cons$ x$ xs$))) (less$ j$ (size$ xs$)))) :named conjecture0))
(assert (! (=> (less$ i$ (size$ (cons$ x$ xs$))) (or (less$ i$ (size$ xs$)) (= i$ (size$ xs$)))) :named a1))
(assert (! (= i$ (suc$ j$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ (suc$ ?v0) ?v1) (exists ((?v2 Nat$)) (and (= ?v1 (suc$ ?v2)) (less$ ?v0 ?v2))))) :named a3))
(check-sat)
(get-proof)
