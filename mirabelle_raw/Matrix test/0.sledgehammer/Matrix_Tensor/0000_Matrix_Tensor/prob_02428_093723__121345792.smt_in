; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 268
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (exists ((?v0 Nat$)) (= (divide$ a$ c$) (plus$ (times$ ?v0 b$) (modulo$ (divide$ a$ c$) b$))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ (times$ ?v0 (divide$ ?v1 ?v0)) (modulo$ ?v1 ?v0)) ?v1)) :named a1))
(check-sat)
(get-proof)
