(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$) A_list_list_bool_fun$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_list_list_bool_fun$ A_list_list$) Bool)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) (size$ m$))) :named conjecture0))
(assert (! (less$ (minus$ j$ (size$ m2$)) (times$ (size$ m$) (size$ m2$))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v2) ?v1))) :named a2))
(assert (! (=> (less_eq$ (size$ m2$) j$) (less$ (minus$ j$ (size$ m2$)) (times$ (size$ m$) (size$ m2$)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v1) ?v2))) :named a4))
(assert (! (less_eq$ (size$ m2$) j$) :named a5))
(assert (! (forall ((?v0 A$) (?v1 A$)) (= (f$ ?v0 ?v1) (f$ ?v1 ?v0))) :named a6))
(assert (! (less$ j$ (plus$ (size$ m2$) (times$ (size$ m$) (size$ m2$)))) :named a7))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a8))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (modulo$ (minus$ j$ (size$ m2$)) (size$ m2$)) (modulo$ j$ (size$ m2$)))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (less$ ?v0 ?v1) (less$ ?v0 ?v2)) (less$ (minus$ ?v2 ?v1) (minus$ ?v2 ?v0)))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 ?v1) (less$ (minus$ ?v0 ?v2) ?v1))) :named a11))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (plus$ (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) one$) (divide$ j$ (size$ m2$)))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 ?v1) (plus$ ?v1 ?v0))) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v0) ?v1)) :named a15))
(assert (! (forall ((?v0 A_list_list_bool_fun$) (?v1 A_list_list$)) (=> (forall ((?v2 A_list_list$)) (=> (forall ((?v3 A_list_list$)) (=> (less$ (size$ ?v3) (size$ ?v2)) (fun_app$ ?v0 ?v3))) (fun_app$ ?v0 ?v2))) (fun_app$ ?v0 ?v1))) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v1) ?v0)) :named a17))
(assert (! (= one$ (suc$ zero$)) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (= ?v1 ?v2))) :named a19))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a20))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ zero$ ?v0) (less$ ?v0 ?v1)) (= (divide$ ?v1 ?v0) (plus$ (divide$ (minus$ ?v1 ?v0) ?v0) one$)))) :named a21))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (plus$ ?v0 ?v1) (plus$ ?v2 ?v1)) (= ?v0 ?v2))) :named a22))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (= (modulo$ ?v1 ?v0) (modulo$ (minus$ ?v1 ?v0) ?v0)))) :named a23))
(assert (! (and (less$ j$ (times$ (size$ (cons$ v$ m$)) (size$ m2$))) (and (fun_app$ (mat$ (row_length$ (cons$ v$ m$)) (size$ (cons$ v$ m$))) (cons$ v$ m$)) (fun_app$ (mat$ (row_length$ m2$) (size$ m2$)) m2$))) :named a24))
(check-sat)
(get-proof)
