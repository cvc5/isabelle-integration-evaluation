(declare-fun size$a (A_list$) Nat$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (mat$ (row_length$ (cons$ a$ (cons$ b$ n$))) (size$ (cons$ a$ (cons$ b$ n$))) (cons$ a$ (cons$ b$ n$))) (= (row_length$ (cons$ b$ n$)) (row_length$ (cons$ a$ (cons$ b$ n$)))))) :named conjecture0))
(assert (! (=> (mat$ (row_length$ (cons$ a$ (cons$ b$ n$))) (size$ (cons$ a$ (cons$ b$ n$))) (cons$ a$ (cons$ b$ n$))) (= (size$a b$) (row_length$ (cons$ a$ (cons$ b$ n$))))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (hd$ (cons$ ?v0 ?v1)) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$a (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a4))
(assert (! (= (reduct$ nil$) nil$) :named a5))
(assert (! (= (size$ nil$) zero$) :named a6))
(assert (! (= (size$a nil$a) zero$) :named a7))
