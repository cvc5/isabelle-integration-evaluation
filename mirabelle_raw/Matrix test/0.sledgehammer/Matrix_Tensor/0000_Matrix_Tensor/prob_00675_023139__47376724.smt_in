; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 234
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ (row_length$ (cons$ a$ m1a$)) (size$ (cons$ a$ m1a$)) (cons$ a$ m1a$))) :named conjecture0))
(assert (! (and (mat$ (row_length$ (cons$ a$ m1a$)) (size$ (cons$ a$ m1a$)) (cons$ a$ m1a$)) (mat$ (row_length$ m2$) (size$ m2$) m2$)) :named a1))
(check-sat)
(get-proof)
