; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun x$ () Nat$)
(declare-fun nat$ (Int) Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (= (plus$ (nat$ (+ (of_nat$ x$) (- 1))) one$) (plus$ (nat$ (+ (of_nat$ x$) (- 1))) (nat$ (of_nat$ one$))))) :named conjecture0))
(assert (! (= (- 1) (- (of_nat$ one$))) :named a1))
(assert (! (= (of_nat$a one$) one$) :named a2))
(assert (! (= (of_nat$ one$) 1) :named a3))
(assert (! (= one$ (suc$ zero$)) :named a4))
(assert (! (= one$ (nat$ 1)) :named a5))
(check-sat)
(get-proof)
