; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 232
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun x$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (member$ x$ (set$ (cons$ (vec_vec_Tensor$ f$ v$ a$) nil$))) (vec$ (size$ (vec_vec_Tensor$ f$ v$ a$)) x$))) :named conjecture0))
(assert (! (=> (member$ x$ (set$ (cons$ (vec_vec_Tensor$ f$ v$ a$) nil$))) (= x$ (vec_vec_Tensor$ f$ v$ a$))) :named a1))
(check-sat)
(get-proof)
