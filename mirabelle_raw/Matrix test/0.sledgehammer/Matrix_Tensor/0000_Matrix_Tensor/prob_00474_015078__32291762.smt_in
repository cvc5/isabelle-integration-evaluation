; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 277
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun x$ () A_list$)
(declare-fun id$ () A$)
(declare-fun bot$ () A_list_set$)
(declare-fun nil$ () A_list_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun mult$ (A$ A_a_a_fun_fun$) Bool)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (member$ x$ (set$ (cons$ (vec_vec_Tensor$ f$ v$ a$) nil$))) (= x$ (vec_vec_Tensor$ f$ v$ a$)))) :named conjecture0))
(assert (! (mult$ id$ f$) :named a1))
(assert (! (= (set$ nil$) bot$) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A_list$) (?v3 A_list$) (?v4 A_list_list$)) (=> (and (mult$ ?v0 ?v1) (member$ ?v2 (set$ (cons$ ?v3 ?v4)))) (or (= ?v2 ?v3) (member$ ?v2 (set$ ?v4))))) :named a3))
(check-sat)
(get-proof)
