(declare-fun fun_app$ (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun fun_app$a (A_a_fun$ A$) A$)
(declare-fun fun_app$b (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun plus_mult$ (A$ A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_a_fun$) Bool)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ xs$ ys$) zer$)) :named conjecture0))
(assert (! (= xs$ nil$) :named a1))
(assert (! (= ys$ nil$) :named a2))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$ (times$ f$ ?v0) nil$) nil$) :pattern ((times$ f$ ?v0)))) :named a3))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A$) (?v3 A_a_a_fun_fun$) (?v4 A_a_fun$) (?v5 Nat$) (?v6 A$) (?v7 A$)) (=> (plus_mult$ ?v0 ?v1 ?v2 ?v3 ?v4) (forall ((?v8 A_list$) (?v9 A_list$)) (=> (and (= (size$ ?v8) (size$ ?v9)) (= (size$ ?v8) ?v5)) (= (fun_app$a (fun_app$b ?v1 (fun_app$a (fun_app$b ?v1 ?v6) ?v7)) (scalar_product$ ?v1 ?v2 ?v3 ?v8 ?v9)) (scalar_product$ ?v1 ?v2 ?v3 (fun_app$ (times$ ?v1 ?v6) ?v8) (fun_app$ (times$ ?v1 ?v7) ?v9))))))) :named a4))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A$) (?v3 A_a_a_fun_fun$) (?v4 A_a_fun$) (?v5 A$)) (=> (plus_mult$ ?v0 ?v1 ?v2 ?v3 ?v4) (= (fun_app$a (fun_app$b ?v1 ?v2) ?v5) ?v2))) :named a5))
(check-sat)
(get-proof)
