; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort Integer$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun j$ () Nat$)
(declare-fun ma$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun one$a () Integer$)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun zero$ () Integer$)
(declare-fun zero$a () Nat$)
(declare-fun dbl_inc$ (Integer$) Integer$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun integer_of_nat$ (Nat$) Integer$)
(declare-fun nat_of_integer$ (Integer$) Nat$)
(assert (! (not (= (nth$ (cons$ a$ ma$) (fun_app$ (plus$ j$) one$)) (nth$ ma$ j$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (fun_app$ suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (fun_app$ suc$ ?v2))))) :named a2))
(assert (! (= (nat_of_integer$ one$a) one$) :named a3))
(assert (! (= (dbl_inc$ zero$) one$a) :named a4))
(assert (! (= (plus$ one$) suc$) :named a5))
(assert (! (= (integer_of_nat$ zero$a) zero$) :named a6))
(check-sat)
(get-proof)
