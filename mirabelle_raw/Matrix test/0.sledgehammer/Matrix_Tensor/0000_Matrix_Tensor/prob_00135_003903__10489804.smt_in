; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun m$ () B_list_list$)
(declare-fun v$ () C_list$)
(declare-fun x$ () B_list$)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ B_list_list$) Bool)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun cons$ (B_list$ B_list_list$) B_list_list$)
(declare-fun size$ (C_list$) Nat$)
(declare-fun append$ (B_list_list$ B_list_list$) B_list_list$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(assert (! (not (exists ((?v0 B_list_list$) (?v1 B_list_list$)) (= (append$ ?v0 (cons$ x$ ?v1)) m$))) :named conjecture0))
(assert (! (forall ((?v0 B_list$) (?v1 B_list_list$)) (= (member$ ?v0 (set$ ?v1)) (exists ((?v2 B_list_list$) (?v3 B_list_list$)) (= ?v1 (append$ ?v2 (cons$ ?v0 ?v3)))))) :named a1))
(assert (! (mat$ nr$ nc$ m$) :named a2))
(assert (! (member$ x$ (set$ m$)) :named a3))
(assert (! (= (size$ v$) k$) :named a4))
(check-sat)
(get-proof)
