; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(assert (! (not (=> (less$ (size$ y$) i$) (= (nth$ zs$ (divide$ (minus$ i$ (size$ y$)) (size$ y$))) (nth$ (cons$ z$ zs$) (divide$ i$ (size$ y$)))))) :named conjecture0))
(assert (! (=> (less$ (size$ y$) i$) (= (divide$ i$ (size$ y$)) (plus$ (divide$ (minus$ i$ (size$ y$)) (size$ y$)) one$))) :named a1))
(assert (! (= (nth$ zs$ (divide$ (minus$ i$ (size$ y$)) (size$ y$))) (nth$ (cons$ z$ zs$) (plus$ (divide$ (minus$ i$ (size$ y$)) (size$ y$)) one$))) :named a2))
(check-sat)
(get-proof)
