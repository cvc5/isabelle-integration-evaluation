; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun x$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(assert (! (not (=> (less$ i$ (size$ (cons$ x$ xs$))) (less$ j$ (size$ xs$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less$ ?v0 ?v1)) (less$ ?v1 (suc$ ?v0)))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (= i$ (suc$ j$)) :named a3))
(assert (! (= one$ (suc$ zero$)) :named a4))
(assert (! (forall ((?v0 Nat$)) (= (suc$ ?v0) (plus$ ?v0 one$))) :named a5))
(assert (! (=> (less$ i$ (size$ (cons$ x$ xs$))) (or (less$ i$ (size$ xs$)) (= i$ (size$ xs$)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ (suc$ ?v0) ?v1) (less$ ?v0 ?v1))) :named a7))
(check-sat)
(get-proof)
