; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 237
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_list_b_list_fun$ 0)
(declare-sort B_list_list_b_list_list_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun nil$ () B_list_list$)
(declare-fun row$ (B_list_list$ Nat$) B_list$)
(declare-fun nil$a () B_list$)
(declare-fun append$ (B_list_list$) B_list_list_b_list_list_fun$)
(declare-fun append$a (B_list$) B_list_b_list_fun$)
(declare-fun fun_app$ (B_list_list_b_list_list_fun$ B_list_list$) B_list_list$)
(declare-fun fun_app$a (B_list_b_list_fun$ B_list$) B_list$)
(assert (! (not (= (row$ nil$ i$) nil$a)) :named conjecture0))
(assert (! (forall ((?v0 B_list_list$)) (! (= (fun_app$ (append$ ?v0) nil$) ?v0) :pattern ((append$ ?v0)))) :named a1))
(assert (! (forall ((?v0 B_list$)) (! (= (fun_app$a (append$a ?v0) nil$a) ?v0) :pattern ((append$a ?v0)))) :named a2))
(assert (! (forall ((?v0 B_list_list$) (?v1 B_list_list$)) (= (= (fun_app$ (append$ ?v0) ?v1) ?v0) (= ?v1 nil$))) :named a3))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$)) (= (= (fun_app$a (append$a ?v0) ?v1) ?v0) (= ?v1 nil$a))) :named a4))
(check-sat)
(get-proof)
