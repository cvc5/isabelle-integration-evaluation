; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 242
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_a_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun w$ () A_list$)
(declare-fun uu$ () A_list_a_fun$)
(declare-fun map$ (A_list_a_fun$ A_list_list$) A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_list_a_fun$ A_list$) A$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ uu$ ?v0) (nth$ ?v0 (modulo$ i$ (row_length$ (cons$ w$ n$))))) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (= (map$ uu$ (cons$ w$ n$)) (cons$a (nth$ w$ (modulo$ i$ (row_length$ (cons$ w$ n$)))) (map$ uu$ n$)))) :named conjecture1))
(check-sat)
(get-proof)
