; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 289
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (divide$ a$ c$) (plus$ (divide$ (fun_app$ (times$ x$) (fun_app$ (times$ b$) c$)) c$) (divide$ (modulo$ a$ (fun_app$ (times$ b$) c$)) c$)))) :named conjecture0))
(assert (! (= a$ (plus$ (fun_app$ (times$ x$) (fun_app$ (times$ b$) c$)) (modulo$ a$ (fun_app$ (times$ b$) c$)))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (modulo$ ?v0 (fun_app$ (times$ ?v1) ?v2)) ?v2) (modulo$ ?v0 ?v2))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= ?v0 (plus$ (fun_app$ (times$ (divide$ ?v0 ?v1)) ?v1) (modulo$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (fun_app$ (times$ ?v0) ?v1) ?v0) zero$)) :named a4))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (times$ ?v0) ?v1) (fun_app$ (times$ ?v1) ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (times$ ?v0) zero$) zero$) :pattern ((times$ ?v0)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (plus$ (fun_app$ (times$ ?v0) ?v1) ?v2) ?v0) (plus$ ?v1 (divide$ ?v2 ?v0))))) :named a8))
(check-sat)
(get-proof)
