; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 229
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort B_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort Nat_bool_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort Nat_nat_bool_fun_fun$ 0)
(declare-fun a$ () A$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun uu$ () Nat_nat_bool_fun_fun$)
(declare-fun nil$ () B_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun less$ () Nat_nat_bool_fun_fun$)
(declare-fun nil$a () A_list$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (Nat_bool_fun$ Nat$) Bool)
(declare-fun tranclp$ (Nat_nat_bool_fun_fun$) Nat_nat_bool_fun_fun$)
(declare-fun fun_app$a (Nat_nat_bool_fun_fun$ Nat$) Nat_bool_fun$)
(declare-fun fun_app$b (A_a_fun$ A$) A$)
(declare-fun fun_app$c (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (fun_app$ (fun_app$a uu$ ?v0) ?v1) (= ?v1 (suc$ ?v0))) :pattern ((fun_app$ (fun_app$a uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (forall ((?v0 Nat$)) (=> (fun_app$ (fun_app$a less$ ?v0) (size$ nil$)) (= (nth$ (times$ f$ a$ nil$a) ?v0) (fun_app$b (fun_app$c f$ a$) (nth$ nil$a ?v0)))))) :named conjecture1))
(assert (! (=> (fun_app$ (fun_app$a less$ i$) (size$a nil$a)) (= (nth$ (times$ f$ a$ nil$a) i$) (fun_app$b (fun_app$c f$ a$) (nth$ nil$a i$)))) :named a2))
(assert (! (=> (fun_app$ (fun_app$a less$ i$) (size$ nil$)) (= (nth$ (times$ f$ a$ nil$a) i$) (fun_app$b (fun_app$c f$ a$) (nth$ nil$a i$)))) :named a3))
(assert (! (forall ((?v0 Nat$)) (not (fun_app$ (fun_app$a less$ ?v0) zero$))) :named a4))
(assert (! (= less$ (tranclp$ uu$)) :named a5))
(check-sat)
(get-proof)
