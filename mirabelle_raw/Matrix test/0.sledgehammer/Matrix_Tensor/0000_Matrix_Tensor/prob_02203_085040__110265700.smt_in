; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun nr$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun times$a (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (=> (and (less$ i$ (times$ (size$ v$) (row_length$ (cons$ w$ n$)))) (mat$ nr$ (size$a (cons$ w$ n$)) (cons$ w$ n$))) (= (row$ (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) i$) (times$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$)))) (row$ (cons$ w$ n$) (modulo$ i$ (row_length$ (cons$ w$ n$)))))))) :named conjecture0))
(assert (! (=> (and (less$ i$ (times$ (size$ v$) (row_length$ (cons$ w$ n$)))) (mat$ nr$ (size$a (cons$ w$ n$)) (cons$ w$ n$))) (= (row$ (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) i$) (times$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$)))) (row$ (cons$ w$ n$) (modulo$ i$ (row_length$ (cons$ w$ n$))))))) :named a1))
(check-sat)
(get-proof)
