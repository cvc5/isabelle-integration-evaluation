; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 220
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_bool_fun$ 0)
(declare-sort Nat_nat_bool_fun_fun$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun uu$ () Nat_nat_bool_fun_fun$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun less$ () Nat_nat_bool_fun_fun$)
(declare-fun fun_app$ (Nat_bool_fun$ Nat$) Bool)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun tranclp$ (Nat_nat_bool_fun_fun$) Nat_nat_bool_fun_fun$)
(declare-fun fun_app$a (Nat_nat_bool_fun_fun$ Nat$) Nat_bool_fun$)
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (fun_app$ (fun_app$a uu$ ?v0) ?v1) (= ?v1 (suc$ ?v0))) :pattern ((fun_app$ (fun_app$a uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (less_eq$ b$ a$)) :named conjecture1))
(assert (! (not (fun_app$ (fun_app$a less$ a$) b$)) :named hypothesis2))
(assert (! (= less$ (tranclp$ uu$)) :named a3))
(check-sat)
(get-proof)
