; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 218
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Int_nat_fun$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort Nat_nat_nat_fun_fun$ 0)
(declare-sort Int_nat_nat_prod_fun$ 0)
(declare-sort Nat_nat_prod_nat_fun$ 0)
(declare-fun id$ () Nat_nat_fun$)
(declare-fun nat$ () Int_nat_fun$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ () Nat_nat_nat_fun_fun$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun fun_app$ (Int_nat_fun$ Int) Nat$)
(declare-fun map_fun$ (Int_nat_nat_prod_fun$ Nat_nat_fun$ Nat_nat_prod_nat_fun$) Int_nat_fun$)
(declare-fun case_prod$ (Nat_nat_nat_fun_fun$) Nat_nat_prod_nat_fun$)
(declare-fun rep_Integ$ () Int_nat_nat_prod_fun$)
(assert (! (not (= one$ (fun_app$ nat$ (of_nat$ one$)))) :named conjecture0))
(assert (! (= one$ (suc$ zero$)) :named a1))
(assert (! (= one$ (fun_app$ nat$ 1)) :named a2))
(assert (! (= nat$ (map_fun$ rep_Integ$ id$ (case_prod$ minus$))) :named a3))
(check-sat)
(get-proof)
