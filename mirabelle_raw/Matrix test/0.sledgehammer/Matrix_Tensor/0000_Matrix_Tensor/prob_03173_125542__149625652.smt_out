unsat
(assume conjecture0 (! (not (! (less$ j$ (times$ (size$ (mat_multI$ zer$ g$ f$ (row_length$ a1$) a1$ a2$)) (size$ (mat_multI$ zer$ g$ f$ (row_length$ b1$) b1$ b2$)))) :named @p_1)) :named @p_2))
(assume a8 (! (= (! (less$ j$ (times$ (size$ a2$) (size$ b2$))) :named @p_3) @p_1) :named @p_4))
(assume a11 @p_3)
(step t0 (cl (= @p_1 @p_3)) :rule symm :premises (a8))
(step t1 (cl @p_1 (! (not @p_3) :named @p_5)) :rule equiv2 :premises (t0))
(step t2 (cl @p_5) :rule resolution :premises (t1 conjecture0))
(step t3 (cl) :rule resolution :premises (a11 t2))
