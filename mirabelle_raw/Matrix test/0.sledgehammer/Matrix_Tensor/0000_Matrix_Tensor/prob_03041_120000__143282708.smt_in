; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 227
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a1$ () A_list_list$)
(declare-fun a2$ () A_list_list$)
(declare-fun b1$ () A_list_list$)
(declare-fun b2$ () A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (times$ (size$ a1$) (size$ b1$)) (times$ (row_length$ a2$) (row_length$ b2$)))) :named conjecture0))
(assert (! (= (size$ a1$) (row_length$ a2$)) :named a1))
(check-sat)
(get-proof)
