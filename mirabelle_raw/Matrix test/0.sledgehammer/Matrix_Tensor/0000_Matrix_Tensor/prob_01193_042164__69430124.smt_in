; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun x$ () Nat$)
(declare-fun nat$ (Int) Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (=> (less$ zero$ x$) (= (fun_app$ (plus$ (nat$ (+ (of_nat$ x$) (- 1)))) (nat$ (of_nat$ one$))) (nat$ (+ (+ (of_nat$ x$) (- 1)) (of_nat$ one$)))))) :named conjecture0))
(assert (! (= (fun_app$ (plus$ (nat$ (+ (of_nat$ x$) (- 1)))) one$) (fun_app$ (plus$ (nat$ (+ (of_nat$ x$) (- 1)))) (nat$ (of_nat$ one$)))) :named a1))
(assert (! (= one$ (nat$ 1)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) (fun_app$ suc$ ?v1)) (fun_app$ suc$ (fun_app$ (plus$ ?v0) ?v1)))) :named a3))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (- (of_nat$ ?v0)) (of_nat$ ?v1)) (and (= ?v0 zero$) (= ?v1 zero$)))) :named a5))
(assert (! (forall ((?v0 Int)) (=> (<= 0 ?v0) (= (fun_app$ suc$ (nat$ ?v0)) (nat$ (+ 1 ?v0))))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (not (< (of_nat$ ?v0) (- (of_nat$ ?v1))))) :named a7))
(assert (! (= (plus$ one$) suc$) :named a8))
(assert (! (not (less$ zero$ zero$)) :named a9))
(assert (! (not (< 0 0)) :named a10))
(assert (! (forall ((?v0 Nat$)) (= ?v0 (fun_app$ (plus$ ?v0) zero$))) :named a11))
(assert (! (forall ((?v0 Int)) (= ?v0 (+ ?v0 0))) :named a12))
(assert (! (= (of_nat$ (nat$ 1)) 1) :named a13))
(check-sat)
(get-proof)
