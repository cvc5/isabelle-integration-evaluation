; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun m1$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (exists ((?v0 Nat$)) (= (modulo$ a$ (times$ b$ c$)) (plus$ (times$ ?v0 c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))))) :named conjecture0))
(assert (! (= (modulo$ a$ (times$ b$ c$)) (minus$ a$ (times$ m1$ (times$ b$ c$)))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (forall ((?v2 Nat$) (?v3 Nat$)) (=> (and (= ?v2 (divide$ ?v0 ?v1)) (and (= ?v3 (modulo$ ?v0 ?v1)) (= ?v0 (plus$ (times$ ?v2 ?v1) ?v3)))) false)) false)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= ?v0 (plus$ (times$ (divide$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1)))) :named a3))
(check-sat)
(get-proof)
