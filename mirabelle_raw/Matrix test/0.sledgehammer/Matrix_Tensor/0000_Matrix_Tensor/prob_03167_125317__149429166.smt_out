unsat
(assume conjecture2 (! (not (! (less$ i$ (fun_app$b (times$ (row_length$ (fun_app$c (fun_app$d (mat_multI$ zer$ g$ f$ (! (row_length$ a1$) :named @p_2)) a1$) a2$))) (row_length$ (fun_app$c (fun_app$d (mat_multI$ zer$ g$ f$ (! (row_length$ b1$) :named @p_1)) b1$) b2$)))) :named @p_3)) :named @p_4))
