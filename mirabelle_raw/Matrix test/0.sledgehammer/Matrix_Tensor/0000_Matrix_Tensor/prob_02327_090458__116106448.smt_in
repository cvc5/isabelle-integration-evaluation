; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 239
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (less_eq$ b$ a$)) :named conjecture0))
(assert (! (not (less$ a$ b$)) :named hypothesis1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less_eq$ ?v0 ?v1) (or (less$ ?v0 ?v1) (= ?v0 ?v1)))) :named a2))
(check-sat)
(get-proof)
