; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun uu$ () Nat_nat_fun$)
(declare-fun zs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun fun_app$a (A_a_fun$ A$) A$)
(declare-fun fun_app$b (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ uu$ ?v0) ?v0) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (=> (= i$ (size$ y$)) (= (=> (less$ zero$ (fun_app$ (times$ (size$ zs$)) (size$ y$))) (= (nth$ (vec_vec_Tensor$ f$ zs$ y$) zero$) (fun_app$a (fun_app$b f$ (nth$ zs$ zero$)) (nth$ y$ zero$)))) (=> (less$ i$ (fun_app$ (times$ (size$ zs$)) (size$ y$))) (= (nth$ (vec_vec_Tensor$ f$ zs$ y$) i$) (fun_app$a (fun_app$b f$ (nth$ zs$ (divide$ i$ (size$ y$)))) (nth$ y$ (modulo$ i$ (size$ y$))))))))) :named conjecture1))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (fun_app$ (times$ (size$ zs$)) (size$ y$))) (= (nth$ (vec_vec_Tensor$ f$ zs$ y$) ?v0) (fun_app$a (fun_app$b f$ (nth$ zs$ (divide$ ?v0 (size$ y$)))) (nth$ y$ (modulo$ ?v0 (size$ y$))))))) :named a2))
(assert (! (=> (= i$ (size$ y$)) (= (less$ i$ (fun_app$ (times$ (size$ (cons$ z$ zs$))) (size$ y$))) (less$ zero$ (fun_app$ (times$ (size$ zs$)) (size$ y$))))) :named a3))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a4))
(assert (! (= (size$ nil$) zero$) :named a5))
(assert (! (= (nth$ (cons$ z$ zs$) one$) (nth$ zs$ zero$)) :named a6))
(assert (! (= (plus$ one$) suc$) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (fun_app$ (plus$ ?v0) ?v1) ?v0) ?v1)) :named a8))
(assert (! (=> (= i$ (size$ y$)) (= (divide$ i$ (size$ y$)) one$)) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ ?v0 ?v1) (ite (or (less$ ?v0 ?v1) (= ?v1 zero$)) zero$ (fun_app$ suc$ (divide$ (minus$ ?v0 ?v1) ?v1))))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ ?v0 ?v1) (ite (less$ ?v0 ?v1) ?v0 (modulo$ (minus$ ?v0 ?v1) ?v1)))) :named a12))
(assert (! (=> (less$ i$ (size$ y$)) (= (divide$ i$ (size$ y$)) zero$)) :named a13))
(assert (! (=> (= i$ (size$ y$)) (= (modulo$ i$ (size$ y$)) zero$)) :named a14))
(assert (! (not (= zero$ one$)) :named a15))
(assert (! (= uu$ (times$ one$)) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (modulo$ ?v0 ?v1) (minus$ ?v0 (fun_app$ (times$ (divide$ ?v0 ?v1)) ?v1))) :pattern ((modulo$ ?v0 ?v1)))) :named a17))
(check-sat)
(get-proof)
