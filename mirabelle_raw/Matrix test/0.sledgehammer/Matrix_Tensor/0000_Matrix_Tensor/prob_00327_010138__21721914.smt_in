; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 273
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun aa$ () A_list$)
(declare-fun m2a$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (= (row_length$ (vec_mat_Tensor$ f$ a$ (cons$ aa$ m2a$))) (times$ (size$ a$) (row_length$ (cons$ aa$ m2a$))))) :named conjecture0))
(check-sat)
(get-proof)
