; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-fun a$ () Bool)
(declare-fun b$ () Bool)
(declare-fun f$ (A$ A$) A$)
(declare-fun of_int$ (Int) Int)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not b$) :named conjecture0))
(assert (! (=> (not a$) b$) :named a1))
(assert (! (=> a$ b$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (= (of_nat$ ?v0) (of_nat$ ?v1)) (= ?v0 ?v1))) :named a3))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A$)) (= (f$ (f$ ?v0 ?v1) ?v2) (f$ ?v0 (f$ ?v1 ?v2)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (of_nat$ ?v0) (of_nat$ ?v1)) (= ?v0 ?v1))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= ?v0 ?v1) (= (of_nat$ ?v0) (of_nat$ ?v1)))) :named a6))
(assert (! (forall ((?v0 Bool) (?v1 Nat$) (?v2 Nat$)) (= (of_nat$ (ite ?v0 ?v1 ?v2)) (ite ?v0 (of_nat$ ?v1) (of_nat$ ?v2)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (of_nat$ ?v0) (of_nat$ ?v1)) (= ?v0 ?v1))) :named a8))
(assert (! (forall ((?v0 Nat$)) (= (of_int$ (of_nat$ ?v0)) (of_nat$ ?v0))) :named a9))
(check-sat)
(get-proof)
