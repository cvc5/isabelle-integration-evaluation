; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 242
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_list_fun$ 0)
(declare-sort A_list_a_fun$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun b1$ () A_list_list$)
(declare-fun map$ (A_a_fun$) A_list_a_list_fun$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun map$a (A_list_a_fun$ A_list_list$) A_list$)
(declare-fun map$b (A_a_list_fun$ A_list$) A_list_list$)
(declare-fun map$c (A_list_a_list_fun$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (size$ (row$ b1$ (modulo$ i$ (row_length$ b1$)))) (size$a b1$))) :named conjecture0))
(assert (! (less$ (modulo$ i$ (row_length$ b1$)) (row_length$ b1$)) :named a1))
(assert (! (forall ((?v0 A_a_fun$) (?v1 A_list$)) (= (size$ (fun_app$ (map$ ?v0) ?v1)) (size$ ?v1))) :named a2))
(assert (! (forall ((?v0 A_list_a_fun$) (?v1 A_list_list$)) (= (size$ (map$a ?v0 ?v1)) (size$a ?v1))) :named a3))
(assert (! (forall ((?v0 A_a_list_fun$) (?v1 A_list$)) (= (size$a (map$b ?v0 ?v1)) (size$ ?v1))) :named a4))
(assert (! (forall ((?v0 A_list_a_list_fun$) (?v1 A_list_list$)) (= (size$a (map$c ?v0 ?v1)) (size$a ?v1))) :named a5))
(check-sat)
(get-proof)
