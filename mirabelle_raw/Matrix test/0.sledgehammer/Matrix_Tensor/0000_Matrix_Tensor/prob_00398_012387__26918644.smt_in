; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 246
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun m$ () A_list_list$)
(declare-fun x$ () A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (member$ x$ (set$ (cons$ a$ m$))) (or (= x$ a$) (member$ x$ (set$ m$))))) :named conjecture0))
(assert (! (mat$ (row_length$ (cons$ a$ m$)) (size$ (cons$ a$ m$)) (cons$ a$ m$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_list$)) (=> (member$ ?v0 (set$ (cons$ ?v1 ?v2))) (or (= ?v0 ?v1) (member$ ?v0 (set$ ?v2))))) :named a2))
(check-sat)
(get-proof)
