; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 295
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun v$ () B_list$)
(declare-fun hd$ (B_list_list$) B_list$)
(declare-fun ma$ () B_list_list$)
(declare-fun mat$ (Nat$ Nat$ B_list_list$) Bool)
(declare-fun nc1$ () Nat$)
(declare-fun nc2$ () Nat$)
(declare-fun nil$ () B_list_list$)
(declare-fun nr1$ () Nat$)
(declare-fun nr2$ () Nat$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun cons$ (B_list$ B_list_list$) B_list_list$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(assert (! (not (= (size$ v$) nr2$)) :named conjecture0))
(assert (! (= (size$ v$) nr1$) :named a1))
(assert (! (mat$ nr2$ nc2$ m$) :named a2))
(assert (! (= m$ (cons$ v$ ma$)) :named a3))
(assert (! (member$ v$ (set$ (cons$ v$ ma$))) :named a4))
(assert (! (mat$ nr1$ nc1$ m$) :named a5))
(assert (! (not (= m$ nil$)) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list$) (?v3 Nat$) (?v4 B_list$)) (=> (and (mat$ ?v0 ?v1 ?v2) (and (mat$ ?v3 ?v1 ?v2) (and (= ?v4 (hd$ ?v2)) (not (= ?v2 nil$))))) (forall ((?v5 B_list$)) (=> (member$ ?v5 (set$ ?v2)) (= ?v0 ?v3))))) :named a7))
(check-sat)
(get-proof)
