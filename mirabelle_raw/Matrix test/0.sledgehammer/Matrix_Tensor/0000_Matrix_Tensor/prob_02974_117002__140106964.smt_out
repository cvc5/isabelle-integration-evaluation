unsat
(assume conjecture0 (! (not (! (less$ zero$ (! (size$ (mat_multI$ zer$ g$ f$ (row_length$ a$) a$ b$)) :named @p_1)) :named @p_2)) :named @p_3))
(assume a1 (! (less$ zero$ nc$) :named @p_4))
(assume a5 (! (= @p_1 nc$) :named @p_5))
(step t0 (cl (not (! (= @p_4 @p_2) :named @p_6)) (not @p_4) @p_2) :rule equiv_pos2)
(step t1 (cl (= nc$ @p_1)) :rule symm :premises (a5))
(step t2 (cl @p_6) :rule cong :premises (t1))
(step t3 (cl @p_2) :rule resolution :premises (t0 t2 a1))
(step t4 (cl) :rule resolution :premises (t3 conjecture0))
