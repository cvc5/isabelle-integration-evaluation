; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 313
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun j$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun nat$ (Int) Nat$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not (=> (less$ zero$ j$) (= (less$ (nat$ (+ (of_nat$ j$) (- 1))) (size$ (cons$ b$ n$))) (less$ j$ (size$ (cons$ a$ (cons$ b$ n$))))))) :named conjecture0))
(assert (! (=> (and (less$ zero$ j$) (less$ (nat$ (+ (of_nat$ j$) (- 1))) (size$ (cons$ b$ n$)))) (less$ (plus$ (nat$ (+ (of_nat$ j$) (- 1))) one$) (size$ (cons$ a$ (cons$ b$ n$))))) :named a1))
(assert (! (forall ((?v0 Nat$)) (=> (less$ zero$ ?v0) (= (plus$ (nat$ (+ (of_nat$ ?v0) (- 1))) one$) ?v0))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(assert (! (= one$ (suc$ zero$)) :named a4))
(assert (! (= (size$ nil$) zero$) :named a5))
(check-sat)
(get-proof)
