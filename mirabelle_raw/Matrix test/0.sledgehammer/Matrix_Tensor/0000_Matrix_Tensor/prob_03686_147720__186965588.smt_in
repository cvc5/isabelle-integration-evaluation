; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 230
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_list_a_list_fun$ 0)
(declare-sort A_list_a_list_list_a_list_fun_fun$ 0)
(declare-fun a$ () A_list_list$)
(declare-fun b$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun uu$ () A_list_a_list_list_a_list_fun_fun$)
(declare-fun nil$ () A_list_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun fun_app$ (A_list_list_a_list_fun$ A_list_list$) A_list$)
(declare-fun fun_app$a (A_list_a_list_list_a_list_fun_fun$ A_list$) A_list_list_a_list_fun$)
(declare-fun case_list$ (A_list$ A_list_a_list_list_a_list_fun_fun$ A_list_list$) A_list$)
(declare-fun undefined$ () A_list$)
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (fun_app$ (fun_app$a uu$ ?v0) ?v1) ?v0) :pattern ((fun_app$ (fun_app$a uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (member$ (hd$ a$) (set$ a$))) :named conjecture1))
(assert (! (= a$ (cons$ v$ b$)) :named a2))
(assert (! (forall ((?v0 A_list_list$)) (= (hd$ ?v0) (case_list$ undefined$ uu$ ?v0))) :named a3))
(assert (! (forall ((?v0 A_list_list$)) (=> (not (= ?v0 nil$)) (member$ (hd$ ?v0) (set$ ?v0)))) :named a4))
(check-sat)
(get-proof)
