(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a8))
(assert (! (forall ((?v0 Nat$)) (= (less$ ?v0 zero$) false)) :named a9))
(assert (! (= (size$ nil$) zero$) :named a10))
