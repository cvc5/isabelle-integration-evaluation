; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () B_list$)
(declare-fun z$ () C$)
(declare-fun zs$ () C_list$)
(declare-fun cons$ (C$ C_list$) C_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (B_list$) Nat$)
(declare-fun cons$a (B$ B_list$) B_list$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun size$a (C_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(assert (! (not (=> (and (less$ (size$ y$) i$) (less$ i$ (times$ (size$a (cons$ z$ zs$)) (size$ y$)))) (less$ (minus$ i$ (size$ y$)) (times$ (size$a zs$) (size$ y$))))) :named conjecture0))
(assert (! (forall ((?v0 B_list$) (?v1 Nat$) (?v2 B$) (?v3 B_list$)) (=> (and (less$ (size$ ?v0) ?v1) (less$ ?v1 (times$ (size$ (cons$a ?v2 ?v3)) (size$ ?v0)))) (less$ (minus$ ?v1 (size$ ?v0)) (times$ (size$ ?v3) (size$ ?v0))))) :named a1))
(assert (! (forall ((?v0 B_list$) (?v1 Nat$) (?v2 C$) (?v3 C_list$)) (=> (and (less$ (size$ ?v0) ?v1) (less$ ?v1 (times$ (size$a (cons$ ?v2 ?v3)) (size$ ?v0)))) (less$ (minus$ ?v1 (size$ ?v0)) (times$ (size$a ?v3) (size$ ?v0))))) :named a2))
(assert (! (forall ((?v0 C_list$) (?v1 Nat$) (?v2 B$) (?v3 B_list$)) (=> (and (less$ (size$a ?v0) ?v1) (less$ ?v1 (times$ (size$ (cons$a ?v2 ?v3)) (size$a ?v0)))) (less$ (minus$ ?v1 (size$a ?v0)) (times$ (size$ ?v3) (size$a ?v0))))) :named a3))
(assert (! (forall ((?v0 C_list$) (?v1 Nat$) (?v2 C$) (?v3 C_list$)) (=> (and (less$ (size$a ?v0) ?v1) (less$ ?v1 (times$ (size$a (cons$ ?v2 ?v3)) (size$a ?v0)))) (less$ (minus$ ?v1 (size$a ?v0)) (times$ (size$a ?v3) (size$a ?v0))))) :named a4))
(check-sat)
(get-proof)
