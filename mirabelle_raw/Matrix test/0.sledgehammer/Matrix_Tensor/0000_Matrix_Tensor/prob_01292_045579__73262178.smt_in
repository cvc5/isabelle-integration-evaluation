; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 256
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ (cons$ nil$ ma$)) zero$)) :named conjecture0))
(assert (! (= (size$ nil$a) zero$) :named a1))
(assert (! (= (size$a nil$) zero$) :named a2))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$a) zero$ (size$a (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a3))
(check-sat)
(get-proof)
