; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 245
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun hd$ (A_list$) A$)
(declare-fun m2$ () A_list_list$)
(declare-fun hd$a (A_list_list$) A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ i$ (times$ (size$ v$) (row_length$ m2$)))) :named conjecture0))
(assert (! (and (less$ i$ (times$ (row_length$ (cons$ v$ m$)) (row_length$ m2$))) (and (mat$ (row_length$ (cons$ v$ m$)) (size$a (cons$ v$ m$)) (cons$ v$ m$)) (mat$ (row_length$ m2$) (size$a m2$) m2$))) :named a1))
(assert (! (= (size$ nil$) zero$) :named a2))
(assert (! (= (size$a nil$a) zero$) :named a3))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (hd$ (cons$a ?v0 ?v1)) ?v0) :pattern ((cons$a ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (hd$a (cons$ ?v0 ?v1)) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (not (= nil$ (cons$a ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$a (cons$ ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a8))
(check-sat)
(get-proof)
