; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 223
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list_list$)
(declare-fun b$ () A_list_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun nc$ () Nat$)
(declare-fun zer$ () A$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun mat_multI$ (A$ A_a_a_fun_fun$ A_a_a_fun_fun$ Nat$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ zero$ (size$ (mat_multI$ zer$ g$ f$ (row_length$ a$) a$ b$)))) :named conjecture0))
(assert (! (less$ zero$ nc$) :named a1))
(assert (! (= (size$ (mat_multI$ zer$ g$ f$ (row_length$ a$) a$ b$)) nc$) :named a2))
(check-sat)
(get-proof)
