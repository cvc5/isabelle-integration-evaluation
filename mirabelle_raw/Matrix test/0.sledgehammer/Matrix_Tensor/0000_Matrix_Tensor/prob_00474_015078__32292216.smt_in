; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 243
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-sort A_list_list_list_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun x$ () A_list$)
(declare-fun bot$ () A_list_set$)
(declare-fun nil$ () A_list_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list_list_list_list_list$)
(declare-fun nil$b () A_list_list_list_list$)
(declare-fun nil$c () A_list_list_list$)
(declare-fun nil$d () A_list$)
(declare-fun concat$ (A_list_list_list_list_list$) A_list_list_list_list$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun concat$a (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$b (A_list_list_list$) A_list_list$)
(declare-fun concat$c (A_list_list$) A_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (member$ x$ (set$ (cons$ (vec_vec_Tensor$ f$ v$ a$) nil$))) (= x$ (vec_vec_Tensor$ f$ v$ a$)))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_list$)) (=> (member$ ?v0 (set$ (cons$ ?v1 ?v2))) (or (= ?v0 ?v1) (member$ ?v0 (set$ ?v2))))) :named a1))
(assert (! (forall ((?v0 A_list$)) (= (member$ ?v0 bot$) false)) :named a2))
(assert (! (= (concat$ nil$a) nil$b) :named a3))
(assert (! (= (concat$a nil$b) nil$c) :named a4))
(assert (! (= (concat$b nil$c) nil$) :named a5))
(assert (! (= (concat$c nil$) nil$d) :named a6))
(check-sat)
(get-proof)
