unsat
(assume conjecture16 (! (not (! (= c$ zero$a) :named @p_1)) :named @p_2))
(assume a17 (! (not (! (= b$ zero$a) :named @p_3)) :named @p_4))
(assume a19 (! (or @p_3 @p_1) :named @p_5))
(step t0 (cl (! (not @p_5) :named @p_6) @p_3 @p_1) :rule or_pos)
(step t1 (cl @p_6) :rule resolution :premises (t0 a17 conjecture16))
(step t2 (cl) :rule resolution :premises (a19 t1))
