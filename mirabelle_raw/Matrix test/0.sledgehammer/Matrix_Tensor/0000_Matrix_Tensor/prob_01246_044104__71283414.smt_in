; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun n$ () A_list_list$)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun bot$ () A_list_set$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (mat$ (row_length$ (cons$ a$ (cons$ b$ n$))) (size$ (cons$ a$ (cons$ b$ n$))) (cons$ a$ (cons$ b$ n$))) (= (row_length$ (cons$ b$ n$)) (row_length$ (cons$ a$ (cons$ b$ n$)))))) :named conjecture0))
(assert (! (=> (mat$ (row_length$ (cons$ a$ (cons$ b$ n$))) (size$ (cons$ a$ (cons$ b$ n$))) (cons$ a$ (cons$ b$ n$))) (= (size$a b$) (row_length$ (cons$ a$ (cons$ b$ n$))))) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$a (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(assert (! (= (row_length$ nil$) zero$) :named a4))
(assert (! (= (reduct$ nil$) nil$) :named a5))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list$) (?v3 A_list_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a6))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (member$ ?v0 (set$ (cons$ ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (hd$ (cons$ ?v0 ?v1)) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a8))
(assert (! (forall ((?v0 A_list_list$)) (=> (and (=> (= ?v0 nil$) false) (forall ((?v1 A_list$) (?v2 A_list_list$)) (=> (= ?v0 (cons$ ?v1 ?v2)) false))) false)) :named a9))
(assert (! (forall ((?v0 A_list$)) (= (member$ ?v0 bot$) false)) :named a10))
(assert (! (= (set$ nil$) bot$) :named a11))
(check-sat)
(get-proof)
