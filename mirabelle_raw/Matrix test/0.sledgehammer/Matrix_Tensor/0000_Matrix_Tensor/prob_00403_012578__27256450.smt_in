; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 277
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun m$ () A_list_list$)
(declare-fun x$ () A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun vec$a (Nat$ A_list_list$) Bool)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (member$ x$ (set$ (cons$ a$ m$))) (vec$ (size$ a$) x$))) :named conjecture0))
(assert (! (=> (member$ x$ (set$ (cons$ a$ m$))) (vec$ (row_length$ (cons$ a$ m$)) x$)) :named a1))
(assert (! (mat$ (row_length$ (cons$ a$ m$)) (size$a (cons$ a$ m$)) (cons$ a$ m$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$ ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$a ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (member$ ?v0 (set$ (cons$ ?v0 ?v1)))) :named a5))
(check-sat)
(get-proof)
