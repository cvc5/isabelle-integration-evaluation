; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (times$ (minus$ y$ x$) b$) (minus$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$)))) :named conjecture0))
(assert (! (= (minus$ (times$ y$ b$) (times$ x$ b$)) (minus$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (minus$ ?v0 ?v1) ?v2) (minus$ (times$ ?v0 ?v2) (times$ ?v1 ?v2)))) :named a2))
(check-sat)
(get-proof)
