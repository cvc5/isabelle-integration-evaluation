; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 277
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun x$ () B_list$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun cons$ (B_list$ B_list_list$) B_list_list$)
(declare-fun append$ (B_list_list$ B_list_list$) B_list_list$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(assert (! (not (exists ((?v0 B_list_list$) (?v1 B_list_list$)) (= (append$ ?v0 (cons$ x$ ?v1)) m$))) :named conjecture0))
(assert (! (member$ x$ (set$ m$)) :named a1))
(check-sat)
(get-proof)
