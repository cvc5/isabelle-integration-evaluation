; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 235
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun j$ () Nat$)
(declare-fun a2$ () A_list_list$)
(declare-fun b2$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (size$ (col$ a2$ (divide$ j$ (size$a b2$)))) (row_length$ a2$))) :named conjecture0))
(assert (! (less$ (divide$ j$ (size$a b2$)) (size$a a2$)) :named a1))
(assert (! (forall ((?v0 A_list_list$) (?v1 Nat$)) (! (= (col$ ?v0 ?v1) (nth$ ?v0 ?v1)) :pattern ((col$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$) (?v3 Nat$)) (=> (and (mat$ ?v0 ?v1 ?v2) (less$ ?v3 (size$a ?v2))) (= (size$ (nth$ ?v2 ?v3)) (row_length$ ?v2)))) :named a3))
(check-sat)
(get-proof)
