(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (= (row$ (vec_mat_Tensor$ f$ v$ m2$) i$) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ m2$))) (row$ m2$ (modulo$ i$ (row_length$ m2$)))))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 Nat$) (?v3 Nat$)) (=> (and (less$ ?v3 (times$a (size$ ?v0) (row_length$ ?v1))) (mat$ ?v2 (size$a ?v1) ?v1)) (= (row$ (vec_mat_Tensor$ f$ ?v0 ?v1) ?v3) (times$ f$ (nth$ ?v0 (divide$ ?v3 (row_length$ ?v1))) (row$ ?v1 (modulo$ ?v3 (row_length$ ?v1))))))) :named a1))
(assert (! (less$ i$ (times$a (size$ v$) (row_length$ m2$))) :named a2))
(check-sat)
(get-proof)
