(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (= (size$ (vec_mat_Tensor$ f$ ?v0 ?v1)) (size$ ?v1))) :named a2))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (= ?v0 (append$ ?v0 ?v1)) (= ?v1 nil$))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list_list$)) (! (= (tensor$ f$ (cons$ ?v0 ?v1) ?v2) (append$ (vec_mat_Tensor$ f$ ?v0 ?v2) (tensor$ f$ ?v1 ?v2))) :pattern ((tensor$ f$ (cons$ ?v0 ?v1) ?v2)))) :named a4))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (size$ (tensor$ f$ ?v0 ?v1)) (times$ (size$ ?v0) (size$ ?v1)))) :named a5))
(assert (! (forall ((?v0 A_list_list$)) (! (= (tensor$ f$ nil$ ?v0) nil$) :pattern ((tensor$ f$ nil$ ?v0)))) :named a6))
