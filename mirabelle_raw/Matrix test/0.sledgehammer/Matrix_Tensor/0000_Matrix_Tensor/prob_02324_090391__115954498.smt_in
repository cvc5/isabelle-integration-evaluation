; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun f$ (A$ A$) A$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun z$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (fun_app$ (divide$ (fun_app$ (divide$ x$) y$)) z$) (fun_app$ (divide$ x$) (times$ y$ z$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$ (divide$ ?v0) (times$ ?v1 ?v2)) (fun_app$ (divide$ (fun_app$ (divide$ ?v0) ?v1)) ?v2))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (fun_app$ (divide$ ?v0) ?v2) ?v1))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (fun_app$ (divide$ ?v0) ?v2) ?v1))) :named a3))
(assert (! (forall ((?v0 A$) (?v1 A$)) (= (f$ ?v0 ?v1) (f$ ?v1 ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ zero$ ?v0) (= (less$ (fun_app$ (divide$ ?v1) ?v0) ?v2) (less$ ?v1 (times$ ?v2 ?v0))))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (less$ ?v0 ?v1) (less$ ?v1 ?v0)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ zero$ (times$ ?v0 ?v1)) (and (less$ zero$ ?v0) (less$ zero$ ?v1)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (fun_app$ (divide$ ?v0) ?v1) ?v2))) :named a9))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (fun_app$ (divide$ ?v0) ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ ?v0 (times$ ?v1 ?v2)) (times$ ?v1 (times$ ?v0 ?v2)))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (times$ ?v0 ?v1) ?v2) (times$ ?v0 (times$ ?v1 ?v2)))) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (= (fun_app$ (divide$ (times$ ?v1 ?v0)) ?v0) ?v1))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (times$ ?v0 ?v1) ?v2) (times$ ?v0 (times$ ?v1 ?v2)))) :named a15))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (= (fun_app$ (divide$ (times$ ?v0 ?v1)) ?v0) ?v1))) :named a16))
(assert (! (forall ((?v0 Nat$)) (! (=> (not (= ?v0 zero$)) (= (fun_app$ (divide$ ?v0) ?v0) one$)) :pattern ((divide$ ?v0)))) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (less_eq$ ?v0 ?v1) (less_eq$ ?v1 ?v2)) (less_eq$ ?v0 ?v2))) :named a18))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a19))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a20))
(check-sat)
(get-proof)
