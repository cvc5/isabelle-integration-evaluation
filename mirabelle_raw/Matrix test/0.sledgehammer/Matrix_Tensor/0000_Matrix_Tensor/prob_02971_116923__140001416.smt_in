; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 250
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-fun b$ () A_list_list$)
(declare-fun nc$ () Nat$)
(declare-fun nil$ () A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () A_list_list_list$)
(declare-fun nil$b () A_list_list$)
(declare-fun nil$c () A_list_list_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun size$b (A_list_list_list$) Nat$)
(declare-fun concat$ (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$a (A_list_list_list$) A_list_list$)
(declare-fun concat$b (A_list_list$) A_list$)
(assert (! (not (less$ zero$ nc$)) :named conjecture0))
(assert (! (= (size$ b$) nc$) :named a1))
(assert (! (forall ((?v0 A_list$)) (= (less$ zero$ (size$a ?v0)) (not (= ?v0 nil$)))) :named a2))
(assert (! (forall ((?v0 A_list_list_list$)) (= (less$ zero$ (size$b ?v0)) (not (= ?v0 nil$a)))) :named a3))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$b)))) :named a4))
(assert (! (= (size$a nil$) zero$) :named a5))
(assert (! (= (size$b nil$a) zero$) :named a6))
(assert (! (= (size$ nil$b) zero$) :named a7))
(assert (! (= (concat$ nil$c) nil$a) :named a8))
(assert (! (= (concat$a nil$a) nil$b) :named a9))
(assert (! (= (concat$b nil$b) nil$) :named a10))
(check-sat)
(get-proof)
