(assert (! (less$ (modulo$ (divide$ a$ c$) b$) b$) :named a8))
(assert (! (less$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) (divide$ (times$ b$ c$) c$)) :named a9))
(assert (! (exists ((?v0 Nat$)) (= (divide$ a$ c$) (plus$ (times$ ?v0 b$) (modulo$ (divide$ a$ c$) b$)))) :named a10))
(assert (! (= (divide$ a$ c$) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a11))
(assert (! (= (times$ (minus$ y$ x$) b$) (minus$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$))) :named a12))
(assert (! (=> (forall ((?v0 Nat$)) (=> (= (divide$ a$ c$) (plus$ (times$ ?v0 b$) (modulo$ (divide$ a$ c$) b$))) false)) false) :named a13))
(assert (! (= (divide$ a$ c$) (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (dvd$ ?v0 (times$ ?v1 ?v0))) :named a15))
(assert (! (exists ((?v0 Nat$)) (= a$ (plus$ (times$ ?v0 (times$ b$ c$)) (modulo$ a$ (times$ b$ c$))))) :named a16))
(assert (! (and (less$ zero$ b$) (less$ zero$ c$)) :named a17))
(assert (! (= (times$ (minus$ x$ y$) b$) (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a18))
(assert (! (=> (forall ((?v0 Nat$)) (=> (= a$ (plus$ (times$ ?v0 (times$ b$ c$)) (modulo$ a$ (times$ b$ c$)))) false)) false) :named a19))
(assert (! (forall ((?v0 Nat$)) (= (modulo$ ?v0 zero$) ?v0)) :named a20))
(assert (! (= (minus$ (times$ x$ b$) (times$ y$ b$)) (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a21))
(assert (! (= a$ (plus$ (times$ x$ (times$ b$ c$)) (modulo$ a$ (times$ b$ c$)))) :named a22))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v2) ?v1))) :named a23))
(assert (! (= (minus$ (times$ y$ b$) (times$ x$ b$)) (minus$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$))) :named a24))
(assert (! (dvd$ b$ (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a25))
(assert (! (= (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a26))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v1) ?v2))) :named a27))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ (times$ ?v0 ?v1) ?v2) ?v1) (modulo$ ?v2 ?v1))) :named a28))
