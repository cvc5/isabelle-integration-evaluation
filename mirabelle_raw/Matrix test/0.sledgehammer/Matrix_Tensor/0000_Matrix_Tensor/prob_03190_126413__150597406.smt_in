(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (not (= ?v0 ?v1)) (and (=> (fun_app$ (less$ ?v0) ?v1) false) (=> (fun_app$ (less$ ?v1) ?v0) false))) false)) :named a19))
