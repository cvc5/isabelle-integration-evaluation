(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$) (?v2 Nat$) (?v3 Nat$)) (=> (and (and (fun_app$ (less$ ?v2) (times$ (row_length$ ?v0) (row_length$ ?v1))) (fun_app$ (less$ ?v3) (times$ (size$ ?v0) (size$ ?v1)))) (and (mat$ (row_length$ ?v0) (size$ ?v0) ?v0) (mat$ (row_length$ ?v1) (size$ ?v1) ?v1))) (= (nth$ (nth$a (tensor$ f$ ?v0 ?v1) ?v3) ?v2) (fun_app$a (fun_app$b f$ (nth$ (nth$a ?v0 (divide$ ?v3 (size$ ?v1))) (divide$ ?v2 (row_length$ ?v1)))) (nth$ (nth$a ?v1 (modulo$ ?v3 (size$ ?v1))) (modulo$ ?v2 (row_length$ ?v1))))))) :named a17))
