unsat
(assume conjecture26 (! (not b$) :named @p_1))
(assume a31 (! (=> a$ b$) :named @p_2))
(assume a32 (! (=> (! (not a$) :named @p_3) b$) :named @p_4))
(step t0 (cl (not (! (not @p_3) :named @p_5)) a$) :rule not_not)
(step t1 (cl @p_5 b$) :rule implies :premises (a32))
(step t2 (cl @p_5) :rule resolution :premises (t1 conjecture26))
(step t3 (cl a$) :rule resolution :premises (t0 t2))
(step t4 (cl @p_3 b$) :rule implies :premises (a31))
(step t5 (cl @p_3) :rule resolution :premises (t4 conjecture26))
(step t6 (cl) :rule resolution :premises (t3 t5))
