; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 245
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun w$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (less_eq$ one$ (fun_app$ (divide$ j$) (size$ (cons$ w$ n$)))))) :named conjecture0))
(assert (! (forall ((?v0 A_list_list$)) (= (not (= ?v0 nil$)) (exists ((?v1 A_list$) (?v2 A_list_list$)) (= ?v0 (cons$ ?v1 ?v2))))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (less_eq$ (fun_app$ (divide$ ?v0) ?v2) (fun_app$ (divide$ ?v1) ?v2)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (! (=> (not (= ?v0 zero$)) (= (fun_app$ (divide$ ?v0) ?v0) one$)) :pattern ((divide$ ?v0)))) :named a3))
(assert (! (forall ((?v0 A_list_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a4))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a5))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a6))
(assert (! (= (size$ nil$) zero$) :named a7))
(assert (! (= (plus$ one$) suc$) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ zero$ ?v0) (less_eq$ ?v0 ?v1)) (= (fun_app$ (divide$ ?v1) ?v0) (fun_app$ suc$ (fun_app$ (divide$ (minus$ ?v1 ?v0)) ?v0))))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (less_eq$ ?v0 (fun_app$ (plus$ ?v0) ?v1))) :named a10))
(check-sat)
(get-proof)
