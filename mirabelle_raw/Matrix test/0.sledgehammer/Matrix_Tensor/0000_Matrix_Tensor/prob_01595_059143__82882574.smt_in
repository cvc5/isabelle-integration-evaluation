(declare-fun minus$ (Nat$) Nat_nat_fun$)
(declare-fun divide$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ m2$) j$) (= (fun_app$ (divide$ (fun_app$ (minus$ j$) (size$ m2$))) (size$ m2$)) (fun_app$ (minus$ (fun_app$ (divide$ j$) (size$ m2$))) one$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a1))
(assert (! (forall ((?v0 Nat$)) (! (=> (not (= ?v0 zero$)) (= (fun_app$ (divide$ ?v0) ?v0) one$)) :pattern ((divide$ ?v0)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (divide$ ?v0) zero$) zero$)) :named a3))
(assert (! (= (size$ nil$) zero$) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (minus$ (plus$ ?v0 ?v1)) ?v1) ?v0)) :named a5))
(assert (! (forall ((?v0 Nat$)) (= (not (less$ zero$ ?v0)) (= ?v0 zero$))) :named a6))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (minus$ zero$) ?v0) zero$)) :named a7))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (divide$ zero$) ?v0) zero$)) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less_eq$ ?v0 ?v1) (or (less$ ?v0 ?v1) (= ?v0 ?v1)))) :named a9))
