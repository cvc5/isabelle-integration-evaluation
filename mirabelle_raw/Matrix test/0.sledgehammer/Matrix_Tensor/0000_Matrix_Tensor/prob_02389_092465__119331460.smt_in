; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 236
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun m1$ () Nat$)
(declare-fun dvd$ (Nat$ Nat$) Bool)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)) zero$)) :named conjecture0))
(assert (! (dvd$ c$ (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))) :named a1))
(assert (! (less$ (modulo$ a$ c$) c$) :named a2))
(assert (! (less$ (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)) c$) :named a3))
(assert (! (less$ (modulo$ (modulo$ a$ (times$ b$ c$)) c$) c$) :named a4))
(assert (! (= a$ (plus$ (times$ m1$ (times$ b$ c$)) (modulo$ a$ (times$ b$ c$)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ (times$ ?v0 ?v1) ?v2) ?v1) (modulo$ ?v2 ?v1))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (times$ ?v0 ?v1) ?v2) (times$ ?v0 (times$ ?v1 ?v2)))) :named a7))
(check-sat)
(get-proof)
