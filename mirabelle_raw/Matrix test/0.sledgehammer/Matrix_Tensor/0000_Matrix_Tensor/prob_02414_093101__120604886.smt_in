(declare-fun fun_app$a (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (and (fun_app$ (less$ zero$) b$) (fun_app$ (less$ zero$) c$))) :named conjecture0))
(assert (! (not (= (fun_app$a (times$ b$) c$) zero$)) :named a1))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (fun_app$ (less$ zero$) ?v0))) :named a2))
(assert (! (forall ((?v0 Nat$)) (=> (=> (= ?v0 zero$) false) (fun_app$ (less$ zero$) ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (fun_app$ (less$ zero$) ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (fun_app$a (times$ ?v0) ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a5))
(assert (! (forall ((?v0 A$) (?v1 A$)) (= (f$ ?v0 ?v1) (f$ ?v1 ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (less$ ?v0) zero$) false)) :named a7))
(assert (! (forall ((?v0 Nat$)) (= (not (fun_app$ (less$ zero$) ?v0)) (= ?v0 zero$))) :named a8))
(assert (! (forall ((?v0 Nat$)) (= (not (fun_app$ (less$ zero$) ?v0)) (= ?v0 zero$))) :named a9))
(assert (! (forall ((?v0 Nat$)) (not (fun_app$ (less$ ?v0) zero$))) :named a10))
(assert (! (forall ((?v0 Nat$)) (not (fun_app$ (less$ ?v0) zero$))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$a (times$ (fun_app$a (times$ ?v0) ?v1)) ?v2) (fun_app$a (times$ ?v0) (fun_app$a (times$ ?v1) ?v2)))) :named a12))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$a (times$ ?v0) zero$) zero$) :pattern ((times$ ?v0)))) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$a (times$ ?v0) ?v1) (fun_app$a (times$ ?v1) ?v0))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (fun_app$a (times$ ?v0) ?v1) (fun_app$a (times$ ?v0) ?v2)) (or (= ?v1 ?v2) (= ?v0 zero$)))) :named a15))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$a (times$ zero$) ?v0) zero$) :pattern ((fun_app$a (times$ zero$) ?v0)))) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (fun_app$ (less$ zero$) ?v0) (fun_app$ (less$ (modulo$ ?v1 ?v0)) ?v0))) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (fun_app$ (less$ ?v0) ?v1) (fun_app$ (less$ (fun_app$a (minus$ ?v0) ?v2)) ?v1))) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (fun_app$ (less$ ?v0) ?v1) (= ?v1 zero$)))) :named a19))
(assert (! (forall ((?v0 Nat$)) (=> (fun_app$ (less$ ?v0) zero$) false)) :named a20))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (less$ zero$) (fun_app$a (times$ ?v0) ?v1)) (and (fun_app$ (less$ zero$) ?v0) (fun_app$ (less$ zero$) ?v1)))) :named a21))
(assert (! (forall ((?v0 Nat_bool_fun$) (?v1 Nat$)) (=> (and (fun_app$ ?v0 zero$) (forall ((?v2 Nat$)) (=> (and (fun_app$ (less$ zero$) ?v2) (not (fun_app$ ?v0 ?v2))) (exists ((?v3 Nat$)) (and (fun_app$ (less$ ?v3) ?v2) (not (fun_app$ ?v0 ?v3))))))) (fun_app$ ?v0 ?v1))) :named a22))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$a (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a23))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (fun_app$ (less$ ?v0) ?v1) (not (= ?v1 zero$)))) :named a24))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$a (times$ (fun_app$a (times$ ?v0) ?v1)) ?v2) (fun_app$a (times$ ?v0) (fun_app$a (times$ ?v1) ?v2)))) :named a25))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (fun_app$ (less$ ?v0) ?v1) (fun_app$ (less$ ?v1) ?v0)))) :named a26))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$ (less$ (fun_app$a (times$ ?v0) ?v1)) (fun_app$a (times$ ?v2) ?v1)) (and (fun_app$ (less$ zero$) ?v1) (fun_app$ (less$ ?v0) ?v2)))) :named a27))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a28))
(check-sat)
(get-proof)
