(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (=> (= j$ (plus$ k$ one$)) (= (nat$ (+ (of_nat$ j$) (- 1))) k$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (= (less$ zero$ (of_nat$a ?v0)) (less$ zero$ ?v0))) :named a1))
(assert (! (forall ((?v0 Nat$)) (= (< 0 (of_nat$ ?v0)) (less$ zero$ ?v0))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (plus$ ?v0 ?v1) zero$) (and (= ?v0 zero$) (= ?v1 zero$)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (plus$ ?v0 ?v1) (plus$ ?v2 ?v1)) (= ?v0 ?v2))) :named a4))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (= (+ ?v0 ?v1) (+ ?v2 ?v1)) (= ?v0 ?v2))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (- (of_nat$ ?v0)) (of_nat$ ?v1)) (and (= ?v0 zero$) (= ?v1 zero$)))) :named a6))
(assert (! (not (= 0 1)) :named a7))
(assert (! (not (= zero$ one$)) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (not (< (of_nat$ ?v0) (- (of_nat$ ?v1))))) :named a9))
