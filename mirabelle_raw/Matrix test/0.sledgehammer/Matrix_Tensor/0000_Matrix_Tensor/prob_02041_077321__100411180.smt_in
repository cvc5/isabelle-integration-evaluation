; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 231
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-sort A_list_list_a_list_list_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list_list$)
(declare-fun fun_app$ (A_list_list_a_list_list_fun$ A_list_list$) A_list_list$)
(declare-fun fun_app$a (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$) A_list_list_a_list_list_fun$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$) A_list_a_list_fun$)
(assert (! (not (= (fun_app$ (vec_mat_Tensor$ f$ v$) (cons$ nil$ nil$a)) (cons$ nil$ nil$a))) :named conjecture0))
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ (vec_mat_Tensor$ f$ ?v0) nil$a) nil$a) :pattern ((vec_mat_Tensor$ f$ ?v0)))) :named a1))
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$a (vec_vec_Tensor$ f$ ?v0) nil$) nil$) :pattern ((vec_vec_Tensor$ f$ ?v0)))) :named a2))
(check-sat)
(get-proof)
