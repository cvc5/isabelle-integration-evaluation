; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun a1$ () A_list_list$)
(declare-fun a2$ () A_list_list$)
(declare-fun b1$ () A_list_list$)
(declare-fun b2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun zer$ () A$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun mat_multI$ (A$ A_a_a_fun_fun$ A_a_a_fun_fun$ Nat$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (not (= (tensor$ f$ (mat_multI$ zer$ g$ f$ (row_length$ a1$) a1$ a2$) (mat_multI$ zer$ g$ f$ (row_length$ b1$) b1$ b2$)) nil$))) :named conjecture0))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (=> (and (not (= ?v0 nil$)) (not (= ?v1 nil$))) (not (= (tensor$ f$ ?v0 ?v1) nil$)))) :named a1))
(assert (! (not (= (mat_multI$ zer$ g$ f$ (row_length$ a1$) a1$ a2$) nil$)) :named a2))
(assert (! (not (= (mat_multI$ zer$ g$ f$ (row_length$ b1$) b1$ b2$) nil$)) :named a3))
(check-sat)
(get-proof)
