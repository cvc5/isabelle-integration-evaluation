; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 308
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun x$ () Nat$)
(declare-fun nat$ (Int) Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not (=> (less$ zero$ x$) (= (plus$ (nat$ (+ (of_nat$ x$) (- 1))) one$) x$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (= (nat$ (of_nat$ ?v0)) ?v0)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (- (of_nat$ ?v0)) (of_nat$ ?v1)) (and (= ?v0 zero$) (= ?v1 zero$)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$)) (= ?v0 (plus$ ?v0 zero$))) :named a4))
(assert (! (forall ((?v0 Int)) (= ?v0 (+ ?v0 0))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (not (< (of_nat$ ?v0) (- (of_nat$ ?v1))))) :named a6))
(assert (! (forall ((?v0 Int)) (=> (<= 0 ?v0) (= (suc$ (nat$ ?v0)) (nat$ (+ 1 ?v0))))) :named a7))
(assert (! (not (less$ zero$ zero$)) :named a8))
(assert (! (not (< 0 0)) :named a9))
(check-sat)
(get-proof)
