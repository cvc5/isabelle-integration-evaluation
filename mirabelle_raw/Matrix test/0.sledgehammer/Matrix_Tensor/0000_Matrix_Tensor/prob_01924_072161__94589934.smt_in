(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (less$ (fun_app$ (plus$ ?v0) one$) (fun_app$ (plus$ ?v1) one$)))) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ ?v0 (fun_app$ (plus$ ?v1) ?v2)) (fun_app$ (plus$ (times$ ?v0 ?v1)) (times$ ?v0 ?v2)))) :named a19))
