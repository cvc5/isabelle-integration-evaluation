(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ zero$ ?v0) (less$ ?v0 ?v1)) (= (divide$ ?v1 ?v0) (fun_app$ (plus$ (divide$ (minus$ ?v1 ?v0) ?v0)) one$)))) :named a26))
