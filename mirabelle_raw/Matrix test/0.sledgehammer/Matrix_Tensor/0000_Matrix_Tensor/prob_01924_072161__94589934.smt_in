(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (=> (mat$ (row_length$ (cons$ ?v0 ?v1)) (size$ (cons$ ?v0 ?v1)) (cons$ ?v0 ?v1)) (mat$ (row_length$ ?v1) (size$ ?v1) ?v1))) :named a23))
