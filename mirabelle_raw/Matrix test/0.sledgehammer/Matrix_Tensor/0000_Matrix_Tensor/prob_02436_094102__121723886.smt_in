; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 338
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$) Nat_nat_fun$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (times$ (fun_app$ (minus$ x$) y$) b$) (fun_app$ (minus$ (modulo$ (divide$ a$ c$) b$)) (divide$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (fun_app$ (minus$ (times$ x$ b$)) (times$ y$ b$)) (fun_app$ (minus$ (modulo$ (divide$ a$ c$) b$)) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a1))
(assert (! (= (divide$ a$ c$) (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ (modulo$ ?v0 ?v1) ?v1) zero$)) :named a4))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (divide$ ?v0 (times$ ?v1 ?v2)) (divide$ (divide$ ?v0 ?v1) ?v2))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= ?v0 (plus$ (times$ (divide$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1)))) :named a7))
(assert (! (exists ((?v0 Nat$)) (= (divide$ a$ c$) (plus$ (times$ ?v0 b$) (modulo$ (divide$ a$ c$) b$)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (minus$ (plus$ ?v0 ?v1)) ?v1) ?v0)) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ (times$ ?v0 ?v1) ?v2) ?v1) (modulo$ ?v2 ?v1))) :named a10))
(assert (! (and (less$ zero$ b$) (less$ zero$ c$)) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (= (divide$ (times$ ?v1 ?v0) ?v0) ?v1))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a13))
(check-sat)
(get-proof)
