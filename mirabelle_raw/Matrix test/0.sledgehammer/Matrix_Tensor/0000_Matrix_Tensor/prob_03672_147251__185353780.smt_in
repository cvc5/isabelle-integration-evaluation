; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 242
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_set$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list_list$)
(declare-fun j$ () Nat$)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nth$a (A_list$ Nat$) A$)
(declare-fun set$a (A_list$) A_set$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun member$a (A$ A_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (size$ (nth$ a$ j$)) (row_length$ a$))) :named conjecture0))
(assert (! (less$ j$ (size$a a$)) :named a1))
(assert (! (mat$ nr$ nc$ a$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (=> (mat$ ?v0 ?v1 ?v2) (mat$ (row_length$ ?v2) (size$a ?v2) ?v2))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$a ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (=> (less$ ?v0 (size$ ?v1)) (member$a (nth$a ?v1 ?v0) (set$a ?v1)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (=> (less$ ?v0 (size$a ?v1)) (member$ (nth$ ?v1 ?v0) (set$ ?v1)))) :named a6))
(check-sat)
(get-proof)
