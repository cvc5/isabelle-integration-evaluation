; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun l$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun x$ () A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (member$ x$ (set$ (vec_mat_Tensor$ f$ v$ (cons$ a$ ma$)))) (or (= x$ (vec_vec_Tensor$ f$ v$ a$)) (member$ x$ (set$ (vec_mat_Tensor$ f$ v$ ma$)))))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_list$)) (=> (member$ ?v0 (set$ (cons$ ?v1 ?v2))) (or (= ?v0 ?v1) (member$ ?v0 (set$ ?v2))))) :named a1))
(assert (! (= (vec_mat_Tensor$ f$ v$ (cons$ a$ ma$)) (cons$ (vec_vec_Tensor$ f$ v$ a$) (vec_mat_Tensor$ f$ v$ ma$))) :named a2))
(assert (! (= ma$ (cons$ b$ l$)) :named a3))
(check-sat)
(get-proof)
