; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B_set$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_list_list_set$ 0)
(declare-sort B_list_list_list$ 0)
(declare-sort B_list_list_list_set$ 0)
(declare-sort B_list_list_list_list$ 0)
(declare-sort B_list_list_list_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun bot$ () B_list_set$)
(declare-fun nil$ () B_list_list$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun bot$a () B_list_list_list_set$)
(declare-fun bot$b () B_set$)
(declare-fun bot$c () B_list_list_set$)
(declare-fun nil$a () B_list_list_list_list$)
(declare-fun nil$b () B_list$)
(declare-fun nil$c () B_list_list_list$)
(declare-fun nil$d () B_list_list_list_list_list$)
(declare-fun set$a (B_list_list_list_list$) B_list_list_list_set$)
(declare-fun set$b (B_list$) B_set$)
(declare-fun set$c (B_list_list_list$) B_list_list_set$)
(declare-fun concat$ (B_list_list_list_list_list$) B_list_list_list_list$)
(declare-fun concat$a (B_list_list_list_list$) B_list_list_list$)
(declare-fun concat$b (B_list_list_list$) B_list_list$)
(declare-fun concat$c (B_list_list$) B_list$)
(assert (! (not (= (set$ m$) bot$)) :named conjecture0))
(assert (! (= m$ nil$) :named a1))
(assert (! (= bot$a (set$a nil$a)) :named a2))
(assert (! (= bot$b (set$b nil$b)) :named a3))
(assert (! (= bot$c (set$c nil$c)) :named a4))
(assert (! (= bot$ (set$ nil$)) :named a5))
(assert (! (= (concat$ nil$d) nil$a) :named a6))
(assert (! (= (concat$a nil$a) nil$c) :named a7))
(assert (! (= (concat$b nil$c) nil$) :named a8))
(assert (! (= (concat$c nil$) nil$b) :named a9))
(check-sat)
(get-proof)
