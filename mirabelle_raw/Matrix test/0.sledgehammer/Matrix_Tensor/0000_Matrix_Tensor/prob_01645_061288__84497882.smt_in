; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 275
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (= (nth$ m$ (divide$ (minus$ j$ (size$ (cons$ w$ n$))) (size$ (cons$ w$ n$)))) (nth$ (cons$ v$ m$) (divide$ j$ (size$ (cons$ w$ n$))))))) :named conjecture0))
(assert (! (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (= (nth$ m$ (minus$ (divide$ j$ (size$ (cons$ w$ n$))) one$)) (nth$ (cons$ v$ m$) (divide$ j$ (size$ (cons$ w$ n$)))))) :named a1))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) (minus$ (divide$ j$ (size$ m2$)) one$))) :named a2))
(assert (! (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (less_eq$ one$ (divide$ j$ (size$ (cons$ w$ n$))))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (fun_app$ (plus$ ?v0) ?v1) ?v0) ?v1)) :named a4))
(assert (! (= (plus$ one$) suc$) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ ?v0 ?v1) (ite (or (less$ ?v0 ?v1) (= ?v1 zero$)) zero$ (fun_app$ suc$ (divide$ (minus$ ?v0 ?v1) ?v1))))) :named a6))
(check-sat)
(get-proof)
