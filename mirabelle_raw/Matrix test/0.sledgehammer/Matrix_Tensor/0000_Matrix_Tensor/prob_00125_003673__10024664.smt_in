; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 252
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun x$ () A_list$)
(declare-fun nr$ () Nat$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(assert (! (not (vec$ (times$ nr$ k$) x$)) :named conjecture0))
(assert (! (= (size$ x$) (times$ nr$ k$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$ ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a2))
(check-sat)
(get-proof)
