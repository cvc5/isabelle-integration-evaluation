(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a23))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (less$ zero$) (fun_app$a (divide$ ?v0) ?v1)) (and (fun_app$ (less_eq$ ?v1) ?v0) (fun_app$ (less$ zero$) ?v1)))) :named a24))
