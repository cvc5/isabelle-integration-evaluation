(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (fun_app$ (less_eq$ ?v0) ?v1) (fun_app$ (less_eq$ ?v1) ?v0)) (= ?v0 ?v1))) :named a15))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (or (fun_app$ (less_eq$ ?v0) ?v1) (fun_app$ (less_eq$ ?v1) ?v0))) :named a16))
