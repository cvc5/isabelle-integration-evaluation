(assert (! (forall ((?v0 Nat_bool_fun$) (?v1 Nat$) (?v2 Nat$)) (=> (and (fun_app$ ?v0 ?v1) (forall ((?v3 Nat$)) (=> (fun_app$ ?v0 ?v3) (fun_app$ (less_eq$ ?v3) ?v2)))) (exists ((?v3 Nat$)) (and (fun_app$ ?v0 ?v3) (forall ((?v4 Nat$)) (=> (fun_app$ ?v0 ?v4) (fun_app$ (less_eq$ ?v4) ?v3))))))) :named a18))
