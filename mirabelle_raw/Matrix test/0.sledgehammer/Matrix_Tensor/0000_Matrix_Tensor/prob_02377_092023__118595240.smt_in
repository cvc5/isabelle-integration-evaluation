; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 269
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun m$ () Nat$)
(declare-fun n$ () Nat$)
(declare-fun m1$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (minus$ (times$ (plus$ (times$ m1$ b$) m$) c$) (times$ n$ c$)) (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (plus$ (times$ (plus$ (times$ m1$ b$) m$) c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)) (plus$ (times$ n$ c$) (modulo$ a$ c$))) :named a1))
(assert (! (= a$ (plus$ (times$ m1$ (times$ b$ c$)) (modulo$ a$ (times$ b$ c$)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ (times$ ?v0 ?v1) ?v2) ?v1) (modulo$ ?v2 ?v1))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (times$ ?v0 ?v1) ?v2) (times$ ?v0 (times$ ?v1 ?v2)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (= (plus$ ?v0 ?v1) (plus$ ?v2 ?v1)) (= ?v0 ?v2))) :named a5))
(check-sat)
(get-proof)
