(declare-fun times$a (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (not (=> (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$a y$))) (less$ i$ (times$ (plus$ (size$ zs$) one$) (size$a y$))))) :named conjecture0))
(assert (! (= (size$ (cons$ z$ zs$)) (plus$ (size$ zs$) one$)) :named a1))
(assert (! (less$ (size$a y$) i$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= one$ (times$ ?v0 ?v1)) (and (= ?v0 one$) (= ?v1 one$)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) one$) (and (= ?v0 one$) (= ?v1 one$)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (less$ ?v1 ?v2))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (less$ ?v1 ?v2))) :named a6))
(assert (! (forall ((?v0 Nat$)) (= (times$ ?v0 one$) ?v0)) :named a7))
(assert (! (forall ((?v0 Nat$)) (= (times$ one$ ?v0) ?v0)) :named a8))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$b (cons$a ?v0 ?v1)) (plus$ (size$b ?v1) (suc$ zero$))) :pattern ((cons$a ?v0 ?v1)))) :named a9))
(assert (! (forall ((?v0 C$) (?v1 C_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a10))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (size$a (cons$b ?v0 ?v1)) (plus$ (size$a ?v1) (suc$ zero$))) :pattern ((cons$b ?v0 ?v1)))) :named a11))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$c (cons$c ?v0 ?v1)) (plus$ (size$c ?v1) (suc$ zero$))) :pattern ((cons$c ?v0 ?v1)))) :named a12))
(assert (! (= one$ (suc$ zero$)) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (times$ (suc$ ?v0) ?v1) (plus$ ?v1 (times$ ?v0 ?v1))) :pattern ((times$ (suc$ ?v0) ?v1)))) :named a14))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a15))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$a ?v0 ?v1)) ?v1) :pattern ((cons$a ?v0 ?v1)))) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a17))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A$) (?v3 A_list$)) (= (= (cons$c ?v0 ?v1) (cons$c ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a18))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 B$) (?v3 B_list$)) (= (= (cons$b ?v0 ?v1) (cons$b ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a19))
(assert (! (forall ((?v0 C$) (?v1 C_list$) (?v2 C$) (?v3 C_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a20))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list$) (?v3 A_list_list$)) (= (= (cons$a ?v0 ?v1) (cons$a ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a21))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 ?v1) (plus$ ?v1 ?v0))) :named a22))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (plus$ ?v0 ?v1) (plus$ ?v2 ?v1)) (less$ ?v0 ?v2))) :named a23))
(assert (! (forall ((?v0 Nat$)) (less$ ?v0 (plus$ ?v0 one$))) :named a24))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$b ?v0)) (not (= ?v0 nil$)))) :named a25))
(assert (! (forall ((?v0 C_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$a)))) :named a26))
(assert (! (forall ((?v0 B_list$)) (= (less$ zero$ (size$a ?v0)) (not (= ?v0 nil$b)))) :named a27))
(assert (! (forall ((?v0 A_list$)) (= (less$ zero$ (size$c ?v0)) (not (= ?v0 nil$c)))) :named a28))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$b (cons$a ?v0 ?v1)) (suc$ (size$b ?v1))) :pattern ((cons$a ?v0 ?v1)))) :named a29))
(assert (! (forall ((?v0 C$) (?v1 C_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a30))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (size$a (cons$b ?v0 ?v1)) (suc$ (size$a ?v1))) :pattern ((cons$b ?v0 ?v1)))) :named a31))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$c (cons$c ?v0 ?v1)) (suc$ (size$c ?v1))) :pattern ((cons$c ?v0 ?v1)))) :named a32))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (less$ (plus$ ?v0 one$) (plus$ ?v1 one$)))) :named a33))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ one$ ?v0) (less$ one$ ?v1)) (less$ one$ (times$ ?v0 ?v1)))) :named a34))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a35))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (= ?v1 ?v2))) :named a36))
(assert (! (forall ((?v0 A_list$) (?v1 A$) (?v2 Nat$)) (=> (less$ ?v2 (size$c ?v0)) (= (nth$ (times$a f$ ?v1 ?v0) ?v2) (fun_app$ (fun_app$a f$ ?v1) (nth$ ?v0 ?v2))))) :named a37))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$ ?v0 ?v1) (= (size$b ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a38))
(assert (! (forall ((?v0 Nat$) (?v1 C_list$)) (! (= (vec$a ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a39))
(assert (! (forall ((?v0 Nat$) (?v1 B_list$)) (! (= (vec$b ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$b ?v0 ?v1)))) :named a40))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$c ?v0 ?v1) (= (size$c ?v1) ?v0)) :pattern ((vec$c ?v0 ?v1)))) :named a41))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (plus$ ?v0 ?v1) (plus$ ?v2 ?v1)) (= ?v0 ?v2))) :named a42))
(assert (! (forall ((?v0 Nat$)) (= (times$ ?v0 zero$) zero$)) :named a43))
(check-sat)
(get-proof)
