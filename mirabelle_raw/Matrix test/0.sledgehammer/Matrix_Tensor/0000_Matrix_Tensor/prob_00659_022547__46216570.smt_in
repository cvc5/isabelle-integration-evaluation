; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 269
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(assert (! (not (= (times$ (size$ (cons$ a$ m1a$)) (size$ m2$)) (size$ m2$))) :named conjecture0))
(assert (! (= m1a$ nil$) :named a1))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (times$ (suc$ ?v0) ?v1) (plus$ ?v1 (times$ ?v0 ?v1))) :pattern ((times$ (suc$ ?v0) ?v1)))) :named a5))
(check-sat)
(get-proof)
