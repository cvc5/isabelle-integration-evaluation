(assert (! (not (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (= (modulo$ (minus$ j$ (size$ (cons$ w$ n$))) (size$ (cons$ w$ n$))) (modulo$ j$ (size$ (cons$ w$ n$)))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less$ ?v0 ?v1)) (less_eq$ ?v1 ?v0))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ ?v0 ?v1) (ite (less$ ?v0 ?v1) ?v0 (modulo$ (minus$ ?v0 ?v1) ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (= (modulo$ ?v1 ?v0) (modulo$ (minus$ ?v1 ?v0) ?v0)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (modulo$ ?v1 ?v0) (modulo$ (minus$ ?v1 ?v0) ?v0)))) :named a4))
(assert (! (= m2$ (cons$ w$ n$)) :named a5))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (minus$ ?v1 (minus$ ?v1 ?v0)) ?v0))) :named a7))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) (minus$ (divide$ j$ (size$ m2$)) one$))) :named a8))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$) (?v2 A_list$)) (=> (less_eq$ (size$ ?v0) (size$ ?v1)) (= (= ?v0 (cons$ ?v2 ?v1)) false))) :named a9))
(assert (! (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (= (nth$ m$ (minus$ (divide$ j$ (size$ (cons$ w$ n$))) one$)) (nth$ (cons$ v$ m$) (divide$ j$ (size$ (cons$ w$ n$)))))) :named a10))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a11))
(assert (! (=> (less$ j$ (size$ m2$)) (= (modulo$ j$ (size$ m2$)) j$)) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (modulo$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1))) :named a13))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list$) (?v3 A_list_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (=> (less$ ?v0 ?v1) (= (modulo$ ?v0 ?v1) ?v0)) :pattern ((modulo$ ?v0 ?v1)))) :named a15))
(assert (! (forall ((?v0 Nat$)) (less_eq$ ?v0 ?v0)) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a17))
(assert (! (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (less_eq$ one$ (divide$ j$ (size$ (cons$ w$ n$))))) :named a18))
(assert (! (forall ((?v0 Nat$)) (less_eq$ ?v0 ?v0)) :named a19))
(assert (! (= one$ (suc$ zero$)) :named a20))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a21))
(assert (! (forall ((?v0 Nat$)) (less_eq$ zero$ ?v0)) :named a22))
(assert (! (forall ((?v0 A_list_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a23))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (less_eq$ (modulo$ ?v0 ?v1) ?v0)) :named a24))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (less_eq$ ?v0 ?v1) (less_eq$ ?v0 ?v2)) (= (= (minus$ ?v1 ?v0) (minus$ ?v2 ?v0)) (= ?v1 ?v2)))) :named a25))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v0) ?v1)) :named a26))
