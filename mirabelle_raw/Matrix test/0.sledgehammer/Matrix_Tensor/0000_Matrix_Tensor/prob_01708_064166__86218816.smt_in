; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 235
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (less$ j$ (size$ (cons$ w$ n$))) (= (divide$ j$ (size$ (cons$ w$ n$))) zero$))) :named conjecture0))
(assert (! (= (less$ i$ (times$ (row_length$ (cons$ v$ m$)) (row_length$ (cons$ w$ n$)))) (less$ i$ (times$ (size$a v$) (row_length$ (cons$ w$ n$))))) :named a1))
(assert (! (=> (less$ j$ (size$ m2$)) (= (divide$ j$ (size$ m2$)) zero$)) :named a2))
(assert (! (= (row_length$ nil$) zero$) :named a3))
(check-sat)
(get-proof)
