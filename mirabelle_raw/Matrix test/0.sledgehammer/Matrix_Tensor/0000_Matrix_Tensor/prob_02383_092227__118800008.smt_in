; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 255
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (less$ (modulo$ a$ c$) c$)) :named conjecture0))
(assert (! (not (= c$ zero$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (less$ ?v0 ?v1) (less$ ?v1 ?v0)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (less$ (modulo$ ?v1 ?v0) ?v0))) :named a3))
(check-sat)
(get-proof)
