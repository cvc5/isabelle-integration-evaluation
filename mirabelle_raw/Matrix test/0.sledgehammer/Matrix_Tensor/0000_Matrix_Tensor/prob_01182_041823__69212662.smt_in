(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$a (plus$ ?v0) (fun_app$a suc$ ?v1)) (fun_app$a suc$ (fun_app$a (plus$ ?v0) ?v1)))) :named a4))
(assert (! (forall ((?v0 Int)) (= (of_nat$ (nat$ ?v0)) (ite (<= 0 ?v0) ?v0 0))) :named a5))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (and (<= 0 ?v0) (<= 0 ?v1)) (= (nat$ (+ ?v0 ?v1)) (fun_app$a (plus$ (nat$ ?v0)) (nat$ ?v1))))) :named a6))
(assert (! (forall ((?v0 Nat$)) (= ?v0 (fun_app$a (plus$ ?v0) zero$))) :named a7))
(assert (! (forall ((?v0 Int)) (= ?v0 (+ ?v0 0))) :named a8))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (or (< 0 ?v0) (<= 0 ?v1)) (= (fun_app$ (less_eq$ (nat$ ?v0)) (nat$ ?v1)) (<= ?v0 ?v1)))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (fun_app$ (less$ ?v0) ?v1) (fun_app$ (less_eq$ (fun_app$a suc$ ?v0)) ?v1))) :named a10))
