(assert (! (not (fun_app$ (less_eq$ one$) zero$)) :named a12))
(assert (! (= (of_nat$a zero$) zero$) :named a13))
(assert (! (= (of_nat$ zero$) 0) :named a14))
(assert (! (= (of_nat$a one$) one$) :named a15))
(assert (! (= (of_nat$ one$) 1) :named a16))
(assert (! (forall ((?v0 Nat_bool_fun$) (?v1 Int)) (= (fun_app$ ?v0 (nat$ ?v1)) (and (forall ((?v2 Nat$)) (=> (= ?v1 (of_nat$ ?v2)) (fun_app$ ?v0 ?v2))) (=> (< ?v1 0) (fun_app$ ?v0 zero$))))) :named a17))
(assert (! (= (plus$ one$) suc$) :named a18))
(assert (! (= one$ (nat$ 1)) :named a19))
