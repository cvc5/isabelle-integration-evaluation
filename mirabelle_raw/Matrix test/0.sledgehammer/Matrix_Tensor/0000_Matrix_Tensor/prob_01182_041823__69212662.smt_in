(assert (! (not (=> (fun_app$ (less$ zero$) x$) (= (fun_app$a (plus$ (nat$ (+ (of_nat$ x$) (- 1)))) one$) x$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$a (plus$ ?v0) ?v1) (nat$ (+ (of_nat$ ?v0) (of_nat$ ?v1))))) :named a1))
(assert (! (= one$ (fun_app$a suc$ zero$)) :named a2))
