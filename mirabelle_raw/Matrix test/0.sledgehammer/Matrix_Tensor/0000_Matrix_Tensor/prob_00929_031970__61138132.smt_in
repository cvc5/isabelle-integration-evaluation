; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun x$ () Nat$)
(declare-fun nat$ (Int) Nat$)
(declare-fun one$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (= (+ (of_nat$ x$) 1) (of_nat$ (plus$ x$ one$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (of_nat$a (plus$ ?v0 ?v1)) (plus$ (of_nat$a ?v0) (of_nat$a ?v1)))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (of_nat$ (plus$ ?v0 ?v1)) (+ (of_nat$ ?v0) (of_nat$ ?v1)))) :named a2))
(assert (! (= (of_nat$ (nat$ 1)) 1) :named a3))
(assert (! (= one$ (nat$ 1)) :named a4))
(check-sat)
(get-proof)
