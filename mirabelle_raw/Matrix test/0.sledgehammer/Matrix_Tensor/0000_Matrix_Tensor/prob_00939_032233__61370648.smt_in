; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-fun m$ () Int)
(declare-fun n$ () Int)
(declare-fun times$ (Int Int) Int)
(declare-fun divide$ (Int Int) Int)
(declare-fun modulo$ (Int Int) Int)
(assert (! (not (= (modulo$ m$ n$) (modulo$ (+ m$ (* (- 1) n$)) n$))) :named conjecture0))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (modulo$ (+ ?v0 (times$ ?v1 ?v2)) ?v2) (modulo$ ?v0 ?v2))) :named a1))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (modulo$ (+ ?v0 (times$ ?v1 ?v2)) ?v1) (modulo$ ?v0 ?v1))) :named a2))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (modulo$ (+ (times$ ?v0 ?v1) ?v2) ?v0) (modulo$ ?v2 ?v0))) :named a3))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (modulo$ (+ (times$ ?v0 ?v1) ?v2) ?v1) (modulo$ ?v2 ?v1))) :named a4))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (modulo$ (+ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1))) :named a5))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (modulo$ (+ ?v0 ?v1) ?v0) (modulo$ ?v1 ?v0))) :named a6))
(assert (! (forall ((?v0 Int)) (= (* (- 1) ?v0) (- ?v0))) :named a7))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ ?v1 (times$ ?v0 ?v2)) ?v0) (+ ?v2 (divide$ ?v1 ?v0))))) :named a8))
(assert (! (forall ((?v0 Int)) (= (* ?v0 (- 1)) (- ?v0))) :named a9))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (modulo$ (- ?v0) (- ?v1)) (- (modulo$ ?v0 ?v1)))) :named a10))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a11))
(assert (! (forall ((?v0 Int)) (= (* 1 ?v0) ?v0)) :named a12))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (times$ (- ?v0) ?v1) (- (times$ ?v0 ?v1)))) :named a13))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ ?v1 ?v0) ?v0) (+ (divide$ ?v1 ?v0) 1)))) :named a14))
(assert (! (forall ((?v0 Int)) (= (* ?v0 1) ?v0)) :named a15))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (+ ?v0 ?v1)) (+ (- ?v0) (- ?v1)))) :named a16))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (= (+ ?v0 ?v1) (+ ?v0 ?v2)) (= ?v1 ?v2))) :named a17))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (+ ?v0 (+ (- ?v0) ?v1)) ?v1)) :named a18))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (+ ?v0 ?v1) (+ ?v1 ?v0))) :named a19))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (+ (- ?v0) (+ ?v0 ?v1)) ?v1)) :named a20))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (= (+ ?v0 ?v1) (+ ?v2 ?v1)) (= ?v0 ?v2))) :named a21))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (modulo$ (modulo$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1))) :named a22))
(assert (! (forall ((?v0 Int)) (= (- (- ?v0)) ?v0)) :named a23))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (= (- ?v0) (- ?v1)) (= ?v0 ?v1))) :named a24))
(assert (! (forall ((?v0 Int)) (= (+ 0 ?v0) ?v0)) :named a25))
(check-sat)
(get-proof)
