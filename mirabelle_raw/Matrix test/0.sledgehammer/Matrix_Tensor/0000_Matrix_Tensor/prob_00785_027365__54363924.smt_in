(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a9))
(assert (! (less$ zero$ one$) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ zero$ ?v0) (less$ zero$ ?v1)) (less$ (minus$ ?v1 ?v0) ?v1))) :named a11))
(assert (! (= (concat$ nil$b) nil$c) :named a12))
(assert (! (= (concat$a nil$c) nil$d) :named a13))
(assert (! (= (concat$b nil$d) nil$a) :named a14))
(assert (! (= (concat$c nil$a) nil$) :named a15))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) ?v2) (ite (= ?v2 zero$) ?v0 (nth$ ?v1 (minus$ ?v2 one$)))) :pattern ((nth$ (cons$ ?v0 ?v1) ?v2)))) :named a16))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 Nat$)) (! (= (nth$a (cons$a ?v0 ?v1) ?v2) (ite (= ?v2 zero$) ?v0 (nth$a ?v1 (minus$ ?v2 one$)))) :pattern ((nth$a (cons$a ?v0 ?v1) ?v2)))) :named a17))
