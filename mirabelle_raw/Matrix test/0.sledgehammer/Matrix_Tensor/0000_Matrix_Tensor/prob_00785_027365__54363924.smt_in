(assert (! (not (=> (less$ i$ (size$ (cons$ x$ xs$))) (= (nth$ (times$ f$ a$ (cons$ x$ xs$)) i$) (fun_app$ (fun_app$a f$ a$) (nth$ (cons$ x$ xs$) i$))))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (! (= (times$ f$ ?v0 (cons$ ?v1 ?v2)) (cons$ (fun_app$ (fun_app$a f$ ?v0) ?v1) (times$ f$ ?v0 ?v2))) :pattern ((times$ f$ ?v0 (cons$ ?v1 ?v2))))) :named a1))
(assert (! (=> (less$ i$ (size$ (cons$ x$ xs$))) (or (less$ i$ (size$ xs$)) (= i$ (size$ xs$)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (not (= ?v0 ?v1)) (and (=> (less$ ?v0 ?v1) false) (=> (less$ ?v1 ?v0) false))) false)) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ (plus$ ?v0 ?v1) ?v2) (less$ ?v0 ?v2))) :named a4))
