; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 244
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (= i$ (size$ y$)) (= (divide$ i$ (size$ y$)) one$))) :named conjecture0))
(assert (! (not (= y$ nil$)) :named a1))
(assert (! (=> (not (= y$ nil$)) (less$ zero$ (size$ y$))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ ?v0 ?v1) (and (less_eq$ ?v0 ?v1) (not (= ?v0 ?v1))))) :named a3))
(check-sat)
(get-proof)
