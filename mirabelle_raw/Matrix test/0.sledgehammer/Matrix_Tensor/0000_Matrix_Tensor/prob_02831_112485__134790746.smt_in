(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ (times$ (times$ (row_length$ m1$) (row_length$ m2$)) (row_length$ m3$)) (times$ (times$ (size$ m1$) (size$ m2$)) (size$ m3$)) (tensor$ f$ (tensor$ f$ m1$ m2$) m3$))) :named conjecture0))
(assert (! (and (mat$ (row_length$ m1$) (size$ m1$) m1$) (and (mat$ (row_length$ m2$) (size$ m2$) m2$) (mat$ (row_length$ m3$) (size$ m3$) m3$))) :named a1))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (row_length$ (tensor$ f$ ?v0 ?v1)) (times$ (row_length$ ?v0) (row_length$ ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$ ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a3))
(check-sat)
(get-proof)
