; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ (row_length$ m$) (size$ m$) m$)) :named conjecture0))
(assert (! (and (less$ i$ (times$ (row_length$ (cons$ v$ m$)) (row_length$ m2$))) (and (mat$ (row_length$ (cons$ v$ m$)) (size$ (cons$ v$ m$)) (cons$ v$ m$)) (mat$ (row_length$ m2$) (size$ m2$) m2$))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (=> (mat$ (row_length$ (cons$ ?v0 ?v1)) (size$ (cons$ ?v0 ?v1)) (cons$ ?v0 ?v1)) (mat$ (row_length$ ?v1) (size$ ?v1) ?v1))) :named a2))
(assert (! (mat$ (row_length$ m$) (size$ m$) m$) :named a3))
(check-sat)
(get-proof)
