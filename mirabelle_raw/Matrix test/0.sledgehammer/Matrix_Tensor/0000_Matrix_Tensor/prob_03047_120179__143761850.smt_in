(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (not (= (tensor$ f$ a$ b$) nil$))) :named conjecture0))
(assert (! (not (= b$ nil$)) :named a1))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (size$ (tensor$ f$ ?v0 ?v1)) (times$ (size$ ?v0) (size$ ?v1)))) :named a2))
(assert (! (= (row_length$ (cons$ nil$a nil$)) zero$) :named a3))
(assert (! (forall ((?v0 A_list$)) (= (= (size$a ?v0) zero$) (= ?v0 nil$a))) :named a4))
(assert (! (forall ((?v0 A_list_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a5))
(assert (! (= (size$a nil$a) zero$) :named a6))
(assert (! (= (size$ nil$) zero$) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a8))
(check-sat)
(get-proof)
