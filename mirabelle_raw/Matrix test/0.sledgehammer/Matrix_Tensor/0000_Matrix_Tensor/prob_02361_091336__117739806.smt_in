; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun m$ () Nat$)
(declare-fun m1$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (minus$ a$ (times$ m1$ (times$ b$ c$))) (plus$ (times$ m$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (modulo$ a$ (times$ b$ c$)) (plus$ (times$ m$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))) :named a1))
(assert (! (= (modulo$ a$ (times$ b$ c$)) (minus$ a$ (times$ m1$ (times$ b$ c$)))) :named a2))
(check-sat)
(get-proof)
