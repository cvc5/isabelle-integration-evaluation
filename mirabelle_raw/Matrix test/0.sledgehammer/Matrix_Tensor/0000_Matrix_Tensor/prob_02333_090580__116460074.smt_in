; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun id$ () Nat_nat_fun$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun euclidean_size$ () Nat_nat_fun$)
(assert (! (not (less$ (modulo$ x$ y$) y$)) :named conjecture0))
(assert (! (not (= y$ zero$)) :named hypothesis1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (less$ (modulo$ ?v1 ?v0) ?v0))) :named a2))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ id$ ?v0) ?v0) :pattern ((fun_app$ id$ ?v0)))) :named a3))
(assert (! (= euclidean_size$ id$) :named a4))
(assert (! (forall ((?v0 Nat$)) (= (less$ zero$ (fun_app$ euclidean_size$ ?v0)) (not (= ?v0 zero$)))) :named a5))
(check-sat)
(get-proof)
