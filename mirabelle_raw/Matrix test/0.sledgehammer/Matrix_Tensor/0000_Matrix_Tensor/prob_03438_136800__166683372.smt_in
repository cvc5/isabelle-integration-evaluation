; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun x$ () A$)
(declare-fun y$ () A$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ x$) y$)) (scalar_product$ f$ zer$ g$ w1$ w2$)) (scalar_product$ f$ zer$ g$ (times$ f$ x$ w1$) (times$ f$ y$ w2$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 A$) (?v2 A$) (?v3 A_list$) (?v4 A_list$)) (=> (and (= (size$ ?v3) (size$ ?v4)) (= (size$ ?v3) ?v0)) (= (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ ?v1) ?v2)) (scalar_product$ f$ zer$ g$ ?v3 ?v4)) (scalar_product$ f$ zer$ g$ (times$ f$ ?v1 ?v3) (times$ f$ ?v2 ?v4))))) :named a1))
(assert (! (= (size$ w1$) (size$ w2$)) :named a2))
(check-sat)
(get-proof)
