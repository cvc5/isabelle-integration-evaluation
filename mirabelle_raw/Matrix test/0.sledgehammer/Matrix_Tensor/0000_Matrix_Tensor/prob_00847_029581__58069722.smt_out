unsat
(assume conjecture1 (! (not (! (=> (! (less$ i$ (fun_app$ (times$ (size$ (cons$ z$ zs$))) (! (size$a y$) :named @p_1))) :named @p_3) (! (less$ (minus$ i$ @p_1) (fun_app$ (times$ (size$ zs$)) @p_1)) :named @p_2)) :named @p_4)) :named @p_5))
(assume a2 @p_4)
(step t0 (cl (! (not @p_3) :named @p_6) @p_2) :rule implies :premises (a2))
(step t1 (cl @p_2 @p_6) :rule reordering :premises (t0))
(step t2 (cl (not @p_2)) :rule not_implies2 :premises (conjecture1))
(step t3 (cl @p_3) :rule not_implies1 :premises (conjecture1))
