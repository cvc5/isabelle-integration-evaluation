; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun f$ (A$ A$) A$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun z$ () Nat$)
(declare-fun id$ () A$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$) Nat_nat_fun$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (less_eq$ y$ one$)) :named conjecture0))
(assert (! (less_eq$ (fun_app$ (divide$ (times$ y$ z$)) z$) one$) :named a1))
(assert (! (= (plus$ (times$ (fun_app$ (divide$ x$) z$) z$) (modulo$ x$ z$)) z$) :named a2))
(assert (! (less$ x$ (times$ y$ z$)) :named a3))
(assert (! (less_eq$ y$ (fun_app$ (divide$ x$) z$)) :named a4))
(assert (! (less_eq$ (fun_app$ (divide$ (times$ y$ z$)) z$) (fun_app$ (divide$ z$) z$)) :named a5))
(assert (! (not (less$ (fun_app$ (divide$ x$) z$) y$)) :named a6))
(assert (! (forall ((?v0 A$)) (= (f$ id$ ?v0) ?v0)) :named a7))
(assert (! (less_eq$ (times$ y$ z$) (times$ (fun_app$ (divide$ x$) z$) z$)) :named a8))
(assert (! (less_eq$ (times$ y$ z$) z$) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (fun_app$ (divide$ ?v0) ?v2) ?v1))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ (times$ (fun_app$ (divide$ ?v0) ?v1) ?v1) (modulo$ ?v0 ?v1)) ?v0)) :named a11))
(assert (! (forall ((?v0 Nat$)) (less_eq$ ?v0 ?v0)) :named a12))
(assert (! (forall ((?v0 Nat$)) (= (plus$ zero$ ?v0) ?v0)) :named a13))
(assert (! (less_eq$ one$ one$) :named a14))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a15))
(assert (! (forall ((?v0 Nat$)) (less_eq$ ?v0 ?v0)) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ (modulo$ ?v0 ?v1) (times$ (fun_app$ (divide$ ?v0) ?v1) ?v1)) ?v0)) :named a18))
(assert (! (less_eq$ (times$ (fun_app$ (divide$ x$) z$) z$) z$) :named a19))
(assert (! (not (less_eq$ one$ zero$)) :named a20))
(assert (! (less_eq$ zero$ one$) :named a21))
(assert (! (forall ((?v0 Nat$)) (! (=> (not (= ?v0 zero$)) (= (fun_app$ (divide$ ?v0) ?v0) one$)) :pattern ((divide$ ?v0)))) :named a22))
(assert (! (forall ((?v0 Nat$)) (= (times$ one$ ?v0) ?v0)) :named a23))
(check-sat)
(get-proof)
