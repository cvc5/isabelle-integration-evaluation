; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun id$ () Nat_nat_fun$)
(declare-fun dvd$ (Nat$ Nat$) Bool)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun of_nat$ () Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun euclidean_size$ () Nat_nat_fun$)
(assert (! (not (= (modulo$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ a$ c$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (dvd$ ?v0 ?v1) (= (modulo$ (modulo$ ?v2 ?v1) ?v0) (modulo$ ?v2 ?v0)))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (times$ ?v0 ?v1) ?v1) zero$)) :named a2))
(assert (! (= euclidean_size$ id$) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ zero$ (modulo$ ?v0 ?v1)) (not (dvd$ ?v1 ?v0)))) :named a4))
(assert (! (= of_nat$ id$) :named a5))
(assert (! (= (fun_app$ of_nat$ zero$) zero$) :named a6))
(check-sat)
(get-proof)
