; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort B_list_bool_fun$ 0)
(declare-sort C_list_bool_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () B_list$)
(declare-fun z$ () C$)
(declare-fun zs$ () C_list$)
(declare-fun cons$ (C$ C_list$) C_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (C_list$) Nat$)
(declare-fun cons$a (A_list$ A_list_list$) A_list_list$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun fun_app$ (C_list_bool_fun$ C_list$) Bool)
(declare-fun fun_app$a (B_list_bool_fun$ B_list$) Bool)
(assert (! (not (=> (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$a y$))) (less$ (minus$ i$ (size$a y$)) (times$ (size$ zs$) (size$a y$))))) :named conjecture0))
(assert (! (less$ (size$a y$) i$) :named a1))
(assert (! (forall ((?v0 C$) (?v1 C_list$) (?v2 C$) (?v3 C_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list$) (?v3 A_list_list$)) (= (= (cons$a ?v0 ?v1) (cons$a ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (minus$ ?v0 ?v1) ?v2) (minus$ (times$ ?v0 ?v2) (times$ ?v1 ?v2)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ ?v0 (minus$ ?v1 ?v2)) (minus$ (times$ ?v0 ?v1) (times$ ?v0 ?v2)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (less$ ?v0 ?v1) (less$ ?v0 ?v2)) (less$ (minus$ ?v2 ?v1) (minus$ ?v2 ?v0)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 ?v1) (less$ (minus$ ?v0 ?v2) ?v1))) :named a7))
(assert (! (forall ((?v0 C_list_bool_fun$) (?v1 C_list$)) (=> (forall ((?v2 C_list$)) (=> (forall ((?v3 C_list$)) (=> (less$ (size$ ?v3) (size$ ?v2)) (fun_app$ ?v0 ?v3))) (fun_app$ ?v0 ?v2))) (fun_app$ ?v0 ?v1))) :named a8))
(assert (! (forall ((?v0 B_list_bool_fun$) (?v1 B_list$)) (=> (forall ((?v2 B_list$)) (=> (forall ((?v3 B_list$)) (=> (less$ (size$a ?v3) (size$a ?v2)) (fun_app$a ?v0 ?v3))) (fun_app$a ?v0 ?v2))) (fun_app$a ?v0 ?v1))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (minus$ ?v0 ?v1) ?v2) (minus$ (times$ ?v0 ?v2) (times$ ?v1 ?v2)))) :named a10))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$a ?v0 ?v1)) ?v1) :pattern ((cons$a ?v0 ?v1)))) :named a11))
(check-sat)
(get-proof)
