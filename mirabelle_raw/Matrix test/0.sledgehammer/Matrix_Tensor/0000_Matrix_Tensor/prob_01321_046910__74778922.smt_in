; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 280
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun i$ () Nat$)
(declare-fun v$ () A_list$)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (less$ i$ (times$ (row_length$ (cons$ a$ ma$)) (size$ v$))) (less$ i$ (times$ (size$ a$) (size$ v$))))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$ (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a3))
(check-sat)
(get-proof)
