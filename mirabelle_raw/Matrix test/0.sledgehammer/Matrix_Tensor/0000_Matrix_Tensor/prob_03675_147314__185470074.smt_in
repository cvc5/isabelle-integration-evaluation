; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 238
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list_list$)
(declare-fun j$ () Nat$)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(assert (! (not (= (size$ (nth$ a$ j$)) zero$)) :named conjecture0))
(assert (! (= a$ nil$) :named a1))
(assert (! (less$ j$ (size$a a$)) :named a2))
(assert (! (= (size$ nil$a) zero$) :named a3))
(assert (! (= (size$a nil$) zero$) :named a4))
(check-sat)
(get-proof)
