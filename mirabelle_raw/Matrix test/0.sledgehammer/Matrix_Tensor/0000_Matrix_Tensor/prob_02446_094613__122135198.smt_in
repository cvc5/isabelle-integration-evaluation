; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (less$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) b$)) :named conjecture0))
(assert (! (less$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) (divide$ (times$ b$ c$) c$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v2) ?v1))) :named a2))
(assert (! (less$ (modulo$ a$ (times$ b$ c$)) (times$ b$ c$)) :named a3))
(check-sat)
(get-proof)
