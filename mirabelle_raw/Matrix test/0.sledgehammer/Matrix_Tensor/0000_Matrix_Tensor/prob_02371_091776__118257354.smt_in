; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 308
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun m$ () Nat$)
(declare-fun m1$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (exists ((?v0 Nat$)) (= a$ (plus$ (times$ ?v0 c$) (modulo$ a$ c$))))) :named conjecture0))
(assert (! (= a$ (plus$ (times$ m1$ (times$ b$ c$)) (modulo$ a$ (times$ b$ c$)))) :named a1))
(assert (! (= a$ (plus$ (times$ (plus$ (times$ m1$ b$) m$) c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (times$ ?v0 ?v1) ?v2) (times$ ?v0 (times$ ?v1 ?v2)))) :named a3))
(check-sat)
(get-proof)
