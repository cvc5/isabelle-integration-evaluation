; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 231
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (= (row$ (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) i$) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$)))) (row$ (cons$ w$ n$) (modulo$ i$ (row_length$ (cons$ w$ n$))))))) :named conjecture0))
(assert (! (= (row$ (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) i$) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$)))) (row$ (cons$ w$ n$) (modulo$ i$ (size$ w$))))) :named a1))
(assert (! (= (row_length$ (cons$ w$ n$)) (size$ w$)) :named a2))
(check-sat)
(get-proof)
