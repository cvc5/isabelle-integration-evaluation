; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 321
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-sort A_list_list_list_list_list$ 0)
(declare-sort A_list_list_a_list_list_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list_list_list_list_list$)
(declare-fun nil$b () A_list_list_list_list$)
(declare-fun nil$c () A_list_list_list$)
(declare-fun nil$d () A_list$)
(declare-fun concat$ (A_list_list_list_list_list$) A_list_list_list_list$)
(declare-fun concat$a (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$b (A_list_list_list$) A_list_list$)
(declare-fun concat$c (A_list_list$) A_list$)
(declare-fun fun_app$ (A_list_list_a_list_list_fun$ A_list_list$) A_list_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$) A_list_list_a_list_list_fun$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (fun_app$ (vec_mat_Tensor$ f$ v$) (cons$ a$ ma$)) (cons$ (vec_vec_Tensor$ f$ v$ a$) nil$))) :named conjecture0))
(assert (! (= ma$ nil$) :named a1))
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ (vec_mat_Tensor$ f$ ?v0) nil$) nil$) :pattern ((vec_mat_Tensor$ f$ ?v0)))) :named a2))
(assert (! (= (concat$ nil$a) nil$b) :named a3))
(assert (! (= (concat$a nil$b) nil$c) :named a4))
(assert (! (= (concat$b nil$c) nil$) :named a5))
(assert (! (= (concat$c nil$) nil$d) :named a6))
(check-sat)
(get-proof)
