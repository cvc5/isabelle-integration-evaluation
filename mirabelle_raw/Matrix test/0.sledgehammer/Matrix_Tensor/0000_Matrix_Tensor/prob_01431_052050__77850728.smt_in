(assert (! (not (=> (and (less$ zero$ j$) (and (and (less$ i$ (times$ (row_length$ (cons$ b$ n$)) (size$ v$))) (less$ j$ (size$a (cons$ a$ (cons$ b$ n$))))) (mat$ (row_length$ (cons$ b$ n$)) (size$a (cons$ b$ n$)) (cons$ b$ n$)))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ a$ (cons$ b$ n$))) j$) i$) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ b$ n$))))) (nth$ (nth$a (cons$ a$ (cons$ b$ n$)) j$) (modulo$ i$ (row_length$ (cons$ b$ n$)))))))) :named conjecture0))
(assert (! (=> (and (less$ zero$ j$) (and (and (less$ i$ (times$ (row_length$ (cons$ b$ n$)) (size$ v$))) (less$ j$ (size$a (cons$ a$ (cons$ b$ n$))))) (mat$ (row_length$ (cons$ b$ n$)) (size$a (cons$ b$ n$)) (cons$ b$ n$)))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ a$ (cons$ b$ n$))) j$) i$) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ b$ n$))))) (nth$ (nth$a (cons$ b$ n$) (nat$ (+ (of_nat$ j$) (- 1)))) (modulo$ i$ (row_length$ (cons$ b$ n$))))))) :named a1))
(assert (! (forall ((?v0 Nat$)) (=> (less$ zero$ ?v0) (= (plus$ (nat$ (+ (of_nat$ ?v0) (- 1))) one$) ?v0))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 A$) (?v2 A_list$)) (! (=> (less$ zero$ ?v0) (= (nth$ (cons$a ?v1 ?v2) ?v0) (nth$ ?v2 (minus$ ?v0 one$)))) :pattern ((nth$ (cons$a ?v1 ?v2) ?v0)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$) (?v2 A_list_list$)) (! (=> (less$ zero$ ?v0) (= (nth$a (cons$ ?v1 ?v2) ?v0) (nth$a ?v2 (minus$ ?v0 one$)))) :pattern ((nth$a (cons$ ?v1 ?v2) ?v0)))) :named a4))
