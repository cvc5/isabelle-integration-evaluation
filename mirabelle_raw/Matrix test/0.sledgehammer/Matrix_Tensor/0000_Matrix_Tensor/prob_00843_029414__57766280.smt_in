; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () B_list$)
(declare-fun z$ () C$)
(declare-fun zs$ () C_list$)
(declare-fun nth$ (C_list$ Nat$) C$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (C$ C_list$) C_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nth$a (B_list$ Nat$) B$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (C_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (B$ B_list$) B_list$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun append$ (C_list$ C_list$) C_list$)
(declare-fun append$a (B_list$ B_list$) B_list$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (less$ i$ (plus$ (times$ (size$ zs$) (size$a y$)) (size$a y$))) (less$ (minus$ i$ (size$a y$)) (times$ (size$ zs$) (size$a y$))))) :named conjecture0))
(assert (! (less$ (size$a y$) i$) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (minus$ (minus$ ?v0 ?v1) ?v2) (minus$ ?v0 (plus$ ?v1 ?v2)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (less$ ?v1 ?v2))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v0) ?v1)) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a5))
(assert (! (=> (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$a y$))) (less$ i$ (plus$ (times$ (size$ zs$) (size$a y$)) (size$a y$)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (minus$ (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (minus$ ?v1 ?v2))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (less$ ?v1 ?v2))) :named a8))
(assert (! (=> (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$a y$))) (less$ i$ (times$ (plus$ (size$ zs$) one$) (size$a y$)))) :named a9))
(assert (! (= one$ (suc$ zero$)) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 ?v1) (plus$ ?v1 ?v0))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (minus$ (plus$ ?v0 ?v1) (plus$ ?v2 ?v1)) (minus$ ?v0 ?v2))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v1) ?v0)) :named a13))
(assert (! (= (size$ (cons$ z$ zs$)) (plus$ (size$ zs$) one$)) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (times$ (suc$ ?v0) ?v1) (plus$ ?v1 (times$ ?v0 ?v1))) :pattern ((times$ (suc$ ?v0) ?v1)))) :named a15))
(assert (! (forall ((?v0 C_list$) (?v1 Nat$) (?v2 C_list$)) (=> (less_eq$ (size$ ?v0) ?v1) (= (nth$ (append$ ?v0 ?v2) ?v1) (nth$ ?v2 (minus$ ?v1 (size$ ?v0)))))) :named a16))
(assert (! (forall ((?v0 B_list$) (?v1 Nat$) (?v2 B_list$)) (=> (less_eq$ (size$a ?v0) ?v1) (= (nth$a (append$a ?v0 ?v2) ?v1) (nth$a ?v2 (minus$ ?v1 (size$a ?v0)))))) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (plus$ ?v0 ?v1) (plus$ ?v2 ?v1)) (less$ ?v0 ?v2))) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a19))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (= ?v1 ?v2))) :named a20))
(assert (! (forall ((?v0 C$) (?v1 C_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a21))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (size$a (cons$a ?v0 ?v1)) (suc$ (size$a ?v1))) :pattern ((cons$a ?v0 ?v1)))) :named a22))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (plus$ ?v0 ?v1) (plus$ ?v2 ?v1)) (= ?v0 ?v2))) :named a23))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (plus$ ?v0 ?v1) ?v2) (plus$ (times$ ?v0 ?v2) (times$ ?v1 ?v2)))) :named a24))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a25))
(assert (! (forall ((?v0 C$) (?v1 C_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a26))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (size$a (cons$a ?v0 ?v1)) (plus$ (size$a ?v1) (suc$ zero$))) :pattern ((cons$a ?v0 ?v1)))) :named a27))
(assert (! (forall ((?v0 C_list$) (?v1 C_list$) (?v2 Nat$)) (= (nth$ (append$ ?v0 ?v1) ?v2) (ite (less$ ?v2 (size$ ?v0)) (nth$ ?v0 ?v2) (nth$ ?v1 (minus$ ?v2 (size$ ?v0)))))) :named a28))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 Nat$)) (= (nth$a (append$a ?v0 ?v1) ?v2) (ite (less$ ?v2 (size$a ?v0)) (nth$a ?v0 ?v2) (nth$a ?v1 (minus$ ?v2 (size$a ?v0)))))) :named a29))
(check-sat)
(get-proof)
