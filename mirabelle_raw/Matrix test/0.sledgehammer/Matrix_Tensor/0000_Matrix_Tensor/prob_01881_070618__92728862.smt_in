; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 233
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun j$ () Nat$)
(declare-fun k$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun w$ () A_list$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(assert (! (not (less$ k$ (size$ n$))) :named conjecture0))
(assert (! (less$ j$ (size$ (cons$ w$ n$))) :named hypothesis1))
(assert (! (= j$ (suc$ k$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ (suc$ ?v0) (suc$ ?v1)) (less$ ?v0 ?v1))) :named a3))
(check-sat)
(get-proof)
