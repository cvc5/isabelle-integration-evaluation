unsat
(assume conjecture2 (! (not (! (=> (! (and (= (! (size$ w1$) :named @p_2) (size$ w2$)) (= @p_2 (suc$ k$))) :named @p_3) (! (= (fun_app$e (fun_app$c f$ (fun_app$e (fun_app$c f$ x$) y$)) (scalar_product$ f$ zer$ g$ w1$ w2$)) (scalar_product$ f$ zer$ g$ (fun_app$b (times$ f$ x$) w1$) (fun_app$b (times$ f$ y$) w2$))) :named @p_1)) :named @p_4)) :named @p_5))
(assume a5 (! (=> (! (and @p_3 @p_3) :named @p_6) @p_1) :named @p_7))
(step t0 (cl (not (! (= @p_7 @p_4) :named @p_9)) (not @p_7) @p_4) :rule equiv_pos2)
(step t1 (cl (= @p_6 @p_3)) :rule aci_simp)
(step t2 (cl (= @p_1 @p_1)) :rule refl)
(step t3 (cl @p_9) :rule cong :premises (t1 t2))
(step t4 (cl @p_4) :rule resolution :premises (t0 t3 a5))
(step t5 (cl (! (not @p_3) :named @p_8) @p_1) :rule implies :premises (t4))
