; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 374
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (and (less$ k$ (size$ m$)) (less_eq$ one$ k$)) (= (nth$ m$ (minus$ k$ one$)) (nth$ (cons$ v$ m$) k$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (minus$ ?v1 (minus$ ?v1 ?v0)) ?v0))) :named a1))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (minus$ zero$ ?v0) zero$)) :named a3))
(assert (! (forall ((?v0 Nat$)) (= (times$ ?v0 one$) ?v0)) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (not (= ?v0 ?v1)) (and (=> (less$ ?v0 ?v1) false) (=> (less$ ?v1 ?v0) false))) false)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$) (?v2 A_list_list$)) (! (=> (less$ zero$ ?v0) (= (nth$ (cons$ ?v1 ?v2) ?v0) (nth$ ?v2 (minus$ ?v0 one$)))) :pattern ((nth$ (cons$ ?v1 ?v2) ?v0)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (less$ ?v0 ?v1) (less$ ?v1 ?v0)))) :named a7))
(check-sat)
(get-proof)
