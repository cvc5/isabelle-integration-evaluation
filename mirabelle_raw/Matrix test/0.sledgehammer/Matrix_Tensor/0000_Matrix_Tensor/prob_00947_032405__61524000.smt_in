(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun modulo$a (Int Int) Int)
(assert (! (not (= (modulo$ m$ n$) (modulo$ (minus$ m$ n$) n$))) :named conjecture0))
(assert (! (less$ n$ m$) :named a1))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (modulo$a (- ?v0 ?v1) ?v1) (modulo$a ?v0 ?v1))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (modulo$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1))) :named a3))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (modulo$a (modulo$a ?v0 ?v1) ?v1) (modulo$a ?v0 ?v1))) :named a4))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (modulo$a (- (modulo$a ?v0 ?v1) (modulo$a ?v2 ?v1)) ?v1) (modulo$a (- ?v0 ?v2) ?v1))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (of_nat$ (modulo$ ?v0 ?v1)) (modulo$a (of_nat$ ?v0) (of_nat$ ?v1)))) :named a6))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int) (?v3 Int) (?v4 Int)) (=> (and (= (modulo$a ?v0 ?v1) (modulo$a ?v2 ?v1)) (= (modulo$a ?v3 ?v1) (modulo$a ?v4 ?v1))) (= (modulo$a (- ?v0 ?v3) ?v1) (modulo$a (- ?v2 ?v4) ?v1)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (modulo$ ?v1 ?v0) (modulo$ (minus$ ?v1 ?v0) ?v0)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (=> (less$ ?v0 ?v1) (= (modulo$ ?v0 ?v1) ?v0)) :pattern ((modulo$ ?v0 ?v1)))) :named a9))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (modulo$a (- (modulo$a ?v0 ?v1) ?v2) ?v1) (modulo$a (- ?v0 ?v2) ?v1))) :named a10))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (modulo$a (- ?v0 (modulo$a ?v1 ?v2)) ?v2) (modulo$a (- ?v0 ?v1) ?v2))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ ?v0 ?v1) (ite (less$ ?v0 ?v1) ?v0 (modulo$ (minus$ ?v0 ?v1) ?v1)))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (plus$ ?v0 ?v1) ?v0) (modulo$ ?v1 ?v0))) :named a13))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (modulo$a (+ ?v0 ?v1) ?v0) (modulo$a ?v1 ?v0))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (plus$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1))) :named a15))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (modulo$a (+ ?v0 ?v1) ?v1) (modulo$a ?v0 ?v1))) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (minus$ (minus$ ?v0 ?v1) ?v2) (minus$ (minus$ ?v0 ?v2) ?v1))) :named a17))
(assert (! (forall ((?v0 Int)) (= (+ 0 ?v0) ?v0)) :named a18))
(assert (! (forall ((?v0 Nat$)) (= (plus$ zero$ ?v0) ?v0)) :named a19))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ (suc$ ?v0) ?v1) (suc$ (plus$ ?v0 ?v1)))) :named a20))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (=> (= (- ?v0 ?v1) (- ?v0 ?v2)) (= ?v1 ?v2))) :named a21))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (- (- ?v0 ?v1) ?v2) (- (- ?v0 ?v2) ?v1))) :named a22))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (minus$ (minus$ ?v0 ?v1) ?v2) (minus$ (minus$ ?v0 ?v2) ?v1))) :named a23))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int) (?v3 Int)) (=> (= (- ?v0 ?v1) (- ?v2 ?v3)) (= (= ?v0 ?v1) (= ?v2 ?v3)))) :named a24))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (- (+ ?v0 ?v1) ?v0) ?v1)) :named a25))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v0) ?v1)) :named a26))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ ?v0 (times$ ?v1 ?v2)) ?v2) (modulo$ ?v0 ?v2))) :named a27))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (modulo$a (+ ?v0 (times$a ?v1 ?v2)) ?v2) (modulo$a ?v0 ?v2))) :named a28))
(assert (! (forall ((?v0 Int)) (= ?v0 (+ ?v0 0))) :named a29))
(assert (! (forall ((?v0 Nat$)) (= ?v0 (plus$ ?v0 zero$))) :named a30))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (less$ ?v0 ?v1) (less$ ?v1 ?v0)))) :named a31))
(assert (! (forall ((?v0 Int)) (= (+ ?v0 0) ?v0)) :named a32))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a33))
(assert (! (forall ((?v0 Nat$)) (not (= (suc$ ?v0) zero$))) :named a34))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 ?v0))) :named a35))
(check-sat)
(get-proof)
