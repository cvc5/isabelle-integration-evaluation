; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_list_bool_fun$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun x$ () B_list$)
(declare-fun z$ () B_list$)
(declare-fun hd$ (B_list_list$) B_list$)
(declare-fun nc$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ B_list_list$) Bool)
(declare-fun nil$ () B_list_list$)
(declare-fun nr1$ () Nat$)
(declare-fun nr2$ () Nat$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun vec$ (Nat$) B_list_bool_fun$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(declare-fun fun_app$ (B_list_bool_fun$ B_list$) Bool)
(assert (! (not (=> (member$ x$ (set$ m$)) (fun_app$ (vec$ nr1$) x$))) :named conjecture0))
(assert (! (forall ((?v0 B_list$)) (=> (member$ ?v0 (set$ m$)) (fun_app$ (vec$ nr1$) ?v0))) :named a1))
(assert (! (not (= m$ nil$)) :named a2))
(assert (! (= z$ (hd$ m$)) :named a3))
(assert (! (mat$ nr2$ nc$ m$) :named a4))
(assert (! (mat$ nr1$ nc$ m$) :named a5))
(assert (! (forall ((?v0 B_list_set$) (?v1 B_list_bool_fun$)) (= (forall ((?v2 B_list$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))) (forall ((?v2 B_list$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))))) :named a6))
(check-sat)
(get-proof)
