; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort B_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort B_list_list$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort B_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-sort B_list_list_list_list$ 0)
(declare-sort A_list_list_list_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun v$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () B_list$)
(declare-fun nil$b () A_list_list_list_list_list$)
(declare-fun nil$c () A_list_list_list_list$)
(declare-fun nil$d () B_list_list_list_list$)
(declare-fun nil$e () B_list_list_list$)
(declare-fun nil$f () B_list_list$)
(declare-fun nil$g () A_list_list_list$)
(declare-fun nil$h () A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun concat$ (A_list_list_list_list_list$) A_list_list_list_list$)
(declare-fun concat$a (B_list_list_list_list$) B_list_list_list$)
(declare-fun concat$b (B_list_list_list$) B_list_list$)
(declare-fun concat$c (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$d (A_list_list_list$) A_list_list$)
(declare-fun concat$e (B_list_list$) B_list$)
(declare-fun concat$f (A_list_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (and (less$ i$ (times$ (size$ v$) (row_length$ nil$))) (less$ j$ (size$a nil$a))) false)) :named conjecture0))
(assert (! (= (times$ (size$ v$) (row_length$ nil$)) zero$) :named a1))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a2))
(assert (! (= (concat$ nil$b) nil$c) :named a3))
(assert (! (= (concat$a nil$d) nil$e) :named a4))
(assert (! (= (concat$b nil$e) nil$f) :named a5))
(assert (! (= (concat$c nil$c) nil$g) :named a6))
(assert (! (= (concat$d nil$g) nil$) :named a7))
(assert (! (= (concat$e nil$f) nil$a) :named a8))
(assert (! (= (concat$f nil$) nil$h) :named a9))
(check-sat)
(get-proof)
