(assert (! (not (less$ i$ (times$ (size$ v$) (row_length$ m2$)))) :named conjecture0))
(assert (! (and (less$ i$ (times$ (row_length$ (cons$ v$ m$)) (row_length$ m2$))) (and (mat$ (row_length$ (cons$ v$ m$)) (size$a (cons$ v$ m$)) (cons$ v$ m$)) (mat$ (row_length$ m2$) (size$a m2$) m2$))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list_list$)) (= (mat$a ?v0 ?v1 ?v2) (and (= (size$b ?v2) ?v1) (forall ((?v3 A_list_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$a ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$a ?v3 (set$a ?v2)) (vec$a ?v0 ?v3)))))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list_list$)) (! (= (vec$b ?v0 ?v1) (= (size$b ?v1) ?v0)) :pattern ((vec$b ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$a ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$ ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a6))
