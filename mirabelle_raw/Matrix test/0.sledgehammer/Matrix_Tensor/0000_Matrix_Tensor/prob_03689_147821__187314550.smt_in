; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 224
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list_list$)
(declare-fun b$ () A_list_list$)
(declare-fun j$ () Nat$)
(declare-fun v$ () A_list$)
(declare-fun nr$ () Nat$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (size$ (nth$ a$ j$)) (row_length$ a$))) :named conjecture0))
(assert (! (= (row_length$ a$) nr$) :named a1))
(assert (! (= a$ (cons$ v$ b$)) :named a2))
(check-sat)
(get-proof)
