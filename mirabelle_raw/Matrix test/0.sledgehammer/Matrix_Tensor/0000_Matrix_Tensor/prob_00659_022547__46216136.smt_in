; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 307
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (times$ (size$ (cons$ a$ m1a$)) (size$ m2$)) (size$ m2$))) :named conjecture0))
(assert (! (= m1a$ nil$) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a2))
(assert (! (= (plus$ one$) suc$) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (times$ (fun_app$ suc$ ?v0) ?v1) (fun_app$ (plus$ ?v1) (times$ ?v0 ?v1))) :pattern ((times$ (fun_app$ suc$ ?v0) ?v1)))) :named a6))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a7))
(assert (! (forall ((?v0 A_list_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (times$ ?v0 ?v1) (times$ ?v0 ?v2)) (or (= ?v0 zero$) (= ?v1 ?v2)))) :named a9))
(check-sat)
(get-proof)
