; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 244
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun n1$ () A_list_list$)
(declare-fun nr$ () Nat$)
(declare-fun w1$ () A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ nr$ (size$ (cons$ w1$ n1$)) (cons$ w1$ n1$))) :named conjecture0))
(assert (! (= (size$a w1$) (size$a w$)) :named a1))
(assert (! (and (less$ i$ (times$ (size$a v$) (row_length$ (cons$ w$ n$)))) (mat$ nr$ (size$ (cons$ w$ n$)) (cons$ w$ n$))) :named a2))
(assert (! (= n$ (cons$ w1$ n1$)) :named a3))
(assert (! (=> (mat$ nr$ (size$ (cons$ w$ n$)) (cons$ w$ n$)) (= nr$ (size$a w$))) :named a4))
(assert (! (= (row_length$ n$) (size$a w1$)) :named a5))
(check-sat)
(get-proof)
