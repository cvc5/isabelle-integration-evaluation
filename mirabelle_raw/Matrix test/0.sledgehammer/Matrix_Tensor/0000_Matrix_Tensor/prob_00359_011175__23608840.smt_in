(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (=> (and (mat$ ?v0 ?v1 ?v2) (= ?v2 nil$)) (mat$ zero$ ?v1 ?v2))) :named a4))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$a (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$ ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a6))
(assert (! (= m$ nil$) :named a7))
(check-sat)
