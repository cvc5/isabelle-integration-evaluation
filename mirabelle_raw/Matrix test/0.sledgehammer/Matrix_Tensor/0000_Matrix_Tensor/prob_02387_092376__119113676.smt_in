; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 247
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (less$ (minus$ (modulo$ a$ c$) (modulo$ (modulo$ a$ (times$ b$ c$)) c$)) c$)) :named conjecture0))
(assert (! (less$ (modulo$ a$ c$) c$) :named a1))
(check-sat)
(get-proof)
