; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 228
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun y$ () A$)
(declare-fun a2$ () A$)
(declare-fun u2$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (not (= (times$ f$ y$ w2$) (cons$ (fun_app$ (fun_app$a f$ y$) a2$) (times$ f$ y$ u2$)))) :named conjecture0))
(assert (! (and (= w2$ (cons$ a2$ u2$)) (= (size$ u2$) k$)) :named a1))
(check-sat)
(get-proof)
