; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 230
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-fun ws$ () A_list$)
(declare-fun xs$ () A_list$)
(declare-fun ys$ () A_list$)
(declare-fun zs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun nil$a () A_list_list_list_list$)
(declare-fun nil$b () A_list_list_list$)
(declare-fun nil$c () A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun concat$ (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$a (A_list_list_list$) A_list_list$)
(declare-fun concat$b (A_list_list$) A_list$)
(assert (! (not (= ys$ nil$)) :named conjecture0))
(assert (! (and (= (size$ zs$) (size$ ws$)) (and (= (size$ xs$) (size$ ys$)) (= (size$ xs$) zero$))) :named a1))
(assert (! (= (concat$ nil$a) nil$b) :named a2))
(assert (! (= (concat$a nil$b) nil$c) :named a3))
(assert (! (= (concat$b nil$c) nil$) :named a4))
(check-sat)
(get-proof)
