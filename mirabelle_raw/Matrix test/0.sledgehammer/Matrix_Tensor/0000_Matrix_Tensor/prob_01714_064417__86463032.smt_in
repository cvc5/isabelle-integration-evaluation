; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 233
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (=> (less$ j$ (size$ (cons$ w$ n$))) (= (modulo$ j$ (size$ (cons$ w$ n$))) j$))) :named conjecture0))
(assert (! (=> (less$ j$ (size$ (cons$ w$ n$))) (= (nth$ (cons$ v$ m$) (divide$ j$ (size$ (cons$ w$ n$)))) v$)) :named a1))
(assert (! (=> (less$ j$ (size$ m2$)) (= (modulo$ j$ (size$ m2$)) j$)) :named a2))
(check-sat)
(get-proof)
