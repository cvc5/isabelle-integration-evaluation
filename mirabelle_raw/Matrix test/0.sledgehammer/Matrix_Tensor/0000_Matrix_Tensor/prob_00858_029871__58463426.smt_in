; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun uu$ () Nat_nat_fun$)
(declare-fun zs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun times$a (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ uu$ ?v0) ?v0) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (=> (less$ i$ (size$ y$)) (= (nth$ (vec_vec_Tensor$ f$ (cons$ z$ zs$) y$) i$) (nth$ (times$ f$ z$ y$) i$)))) :named conjecture1))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A_list$)) (! (= (vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2) (append$ (times$ f$ ?v0 ?v2) (vec_vec_Tensor$ f$ ?v1 ?v2))) :pattern ((vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2)))) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (= (size$ (times$ f$ ?v0 ?v1)) (size$ ?v1))) :named a3))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$) (?v2 A_list$)) (=> (less$ ?v0 (size$ ?v1)) (= (nth$ (append$ ?v1 ?v2) ?v0) (nth$ ?v1 ?v0)))) :named a5))
(assert (! (= one$ (suc$ zero$)) :named a6))
(assert (! (= (size$ nil$) zero$) :named a7))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a8))
(assert (! (= uu$ (times$a one$)) :named a9))
(check-sat)
(get-proof)
