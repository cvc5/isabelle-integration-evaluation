; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 324
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_list$ 0)
(declare-sort Nat_bool_fun$ 0)
(declare-sort Nat_nat_bool_fun_fun$ 0)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun uu$ () Nat_nat_bool_fun_fun$)
(declare-fun mat$ (Nat$ Nat$ B_list_list$) Bool)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun less$ () Nat_nat_bool_fun_fun$)
(declare-fun nth$a (B_list_list$ Nat$) B_list$)
(declare-fun fun_app$ (Nat_bool_fun$ Nat$) Bool)
(declare-fun tranclp$ (Nat_nat_bool_fun_fun$) Nat_nat_bool_fun_fun$)
(declare-fun fun_app$a (Nat_nat_bool_fun_fun$ Nat$) Nat_bool_fun$)
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (fun_app$ (fun_app$a uu$ ?v0) ?v1) (= ?v1 (suc$ ?v0))) :pattern ((fun_app$ (fun_app$a uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (forall ((?v0 B_list_list$) (?v1 B_list_list$)) (=> (and (mat$ nr$ nc$ ?v0) (and (mat$ nr$ nc$ ?v1) (forall ((?v2 Nat$)) (=> (fun_app$ (fun_app$a less$ ?v2) nc$) (forall ((?v3 Nat$)) (=> (fun_app$ (fun_app$a less$ ?v3) nr$) (= (nth$ (nth$a ?v0 ?v2) ?v3) (nth$ (nth$a ?v1 ?v2) ?v3)))))))) (= ?v0 ?v1)))) :named conjecture1))
(assert (! (= less$ (tranclp$ uu$)) :named a2))
(check-sat)
(get-proof)
