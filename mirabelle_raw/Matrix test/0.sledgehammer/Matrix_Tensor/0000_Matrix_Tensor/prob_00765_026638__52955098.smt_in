; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 234
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-fun nil$ () B_list$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun zero$ () Nat$)
(assert (! (not (= (size$ nil$) zero$)) :named conjecture0))
(check-sat)
(get-proof)
