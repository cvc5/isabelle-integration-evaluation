; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 463
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ B_list_list$) Bool)
(declare-fun nil$ () B_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (B_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun sub_mat$ (Nat$ Nat$ B_list_list$) B_list_list$)
(assert (! (not (mat$ zero$ nc$ m$)) :named conjecture0))
(assert (! (mat$ nr$ nc$ m$) :named a1))
(assert (! (= (size$ nil$) zero$) :named a2))
(assert (! (= m$ nil$) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list$)) (=> (and (mat$ ?v0 ?v1 ?v2) (= ?v2 nil$)) (= ?v1 zero$))) :named a4))
(assert (! (forall ((?v0 Nat$)) (less_eq$ zero$ ?v0)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list$) (?v3 Nat$) (?v4 Nat$)) (=> (and (mat$ ?v0 ?v1 ?v2) (and (less_eq$ ?v3 ?v0) (less_eq$ ?v4 ?v1))) (mat$ ?v3 ?v4 (sub_mat$ ?v3 ?v4 ?v2)))) :named a6))
(assert (! (forall ((?v0 B_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a7))
(check-sat)
(get-proof)
