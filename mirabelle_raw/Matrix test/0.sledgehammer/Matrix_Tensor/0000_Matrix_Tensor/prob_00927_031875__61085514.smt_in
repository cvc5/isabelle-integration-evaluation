; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 335
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Int Int) Int)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun divide$a (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (divide$ (- (of_nat$ a$) (of_nat$ b$)) (of_nat$ b$)) (of_nat$ (divide$a (minus$ a$ b$) b$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ (of_nat$ ?v0) (of_nat$ ?v1)) (of_nat$ (divide$a ?v0 ?v1)))) :named a1))
(assert (! (less$ b$ a$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (less_eq$ ?v0 ?v1))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less_eq$ ?v0 ?v1)) (less$ ?v1 ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (less$ ?v0 ?v1)) (= (plus$ ?v1 (minus$ ?v0 ?v1)) ?v0))) :named a5))
(check-sat)
(get-proof)
