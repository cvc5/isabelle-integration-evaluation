(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ i$ (times$ (size$ v$) (row_length$ m2$)))) :named conjecture0))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$ (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a1))
(assert (! (and (less$ i$ (times$ (row_length$ (cons$ v$ m$)) (row_length$ m2$))) (and (mat$ (row_length$ (cons$ v$ m$)) (size$a (cons$ v$ m$)) (cons$ v$ m$)) (mat$ (row_length$ m2$) (size$a m2$) m2$))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$ ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$a ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (member$ ?v0 (set$ (cons$ ?v0 ?v1)))) :named a5))
