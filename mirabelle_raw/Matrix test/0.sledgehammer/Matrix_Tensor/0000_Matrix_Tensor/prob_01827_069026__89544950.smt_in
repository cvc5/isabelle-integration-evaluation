; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun z$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$) Nat_nat_fun$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (less_eq$ y$ one$)) :named conjecture0))
(assert (! (less_eq$ (fun_app$ (divide$ (times$ y$ z$)) z$) one$) :named a1))
(assert (! (= (plus$ (times$ (fun_app$ (divide$ x$) z$) z$) (modulo$ x$ z$)) z$) :named a2))
(assert (! (less$ x$ (times$ y$ z$)) :named a3))
(assert (! (less_eq$ y$ (fun_app$ (divide$ x$) z$)) :named a4))
(assert (! (less_eq$ (fun_app$ (divide$ (times$ y$ z$)) z$) (fun_app$ (divide$ z$) z$)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ (modulo$ ?v0 ?v1) (times$ (fun_app$ (divide$ ?v0) ?v1) ?v1)) ?v0)) :named a7))
(assert (! (forall ((?v0 Nat$)) (! (=> (not (= ?v0 zero$)) (= (fun_app$ (divide$ ?v0) ?v0) one$)) :pattern ((divide$ ?v0)))) :named a8))
(assert (! (forall ((?v0 Nat$)) (= (times$ zero$ ?v0) zero$)) :named a9))
(assert (! (not (less$ (fun_app$ (divide$ x$) z$) y$)) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (fun_app$ (divide$ ?v0) ?v2) ?v1))) :named a11))
(check-sat)
(get-proof)
