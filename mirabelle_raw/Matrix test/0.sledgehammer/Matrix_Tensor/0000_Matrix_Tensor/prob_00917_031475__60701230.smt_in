; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun b$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun divide$ (Int Int) Int)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (< 0 (of_nat$ b$))) :named conjecture0))
(assert (! (less$ zero$ b$) :named a1))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (and (< 0 ?v0) (<= ?v0 ?v1)) (= (divide$ ?v1 ?v0) (+ (divide$ (- ?v1 ?v0) ?v0) 1)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (less$ zero$ (of_nat$a ?v0)) (less$ zero$ ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$)) (= (< 0 (of_nat$ ?v0)) (less$ zero$ ?v0))) :named a4))
(check-sat)
(get-proof)
