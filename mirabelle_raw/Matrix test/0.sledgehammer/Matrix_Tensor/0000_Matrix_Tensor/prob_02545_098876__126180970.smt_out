unsat
(assume conjecture20 (! (not (! (and (! (mat$ (row_length$ m1$) (size$ m1$) m1$) :named @p_2) (! (mat$ (row_length$ m2$) (size$ m2$) m2$) :named @p_1)) :named @p_3)) :named @p_4))
(assume a26 (! (and @p_2 (! (and @p_1 (mat$ (row_length$ m3$) (size$ m3$) m3$)) :named @p_5)) :named @p_6))
