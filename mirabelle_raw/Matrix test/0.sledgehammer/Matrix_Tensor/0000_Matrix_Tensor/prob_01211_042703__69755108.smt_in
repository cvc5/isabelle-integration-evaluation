; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 300
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun k$ () Nat$)
(declare-fun nat$ (Int) Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (=> (= j$ (fun_app$ (plus$ k$) one$)) (= (nat$ (+ (of_nat$ j$) (- 1))) k$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (= (nat$ (of_nat$ ?v0)) ?v0)) :named a1))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ suc$ ?v0) (fun_app$ (plus$ ?v0) one$))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v0) ?v2)) (= ?v1 ?v2))) :named a3))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (= (+ ?v0 ?v1) (+ ?v0 ?v2)) (= ?v1 ?v2))) :named a4))
(assert (! (forall ((?v0 Nat$)) (= (less$ zero$ (of_nat$a ?v0)) (less$ zero$ ?v0))) :named a5))
(assert (! (forall ((?v0 Nat$)) (= (< 0 (of_nat$ ?v0)) (less$ zero$ ?v0))) :named a6))
(assert (! (= (plus$ one$) suc$) :named a7))
(assert (! (forall ((?v0 Int)) (=> (<= 0 ?v0) (= (fun_app$ suc$ (nat$ ?v0)) (nat$ (+ 1 ?v0))))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ zero$ (fun_app$ (plus$ ?v0) ?v1)) (or (less$ zero$ ?v0) (less$ zero$ ?v1)))) :named a9))
(check-sat)
(get-proof)
