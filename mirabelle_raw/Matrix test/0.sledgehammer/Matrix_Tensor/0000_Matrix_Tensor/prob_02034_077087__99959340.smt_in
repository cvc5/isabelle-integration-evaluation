(assert (! (forall ((?v0 B_list_list$) (?v1 B_list_list$) (?v2 Nat$)) (= (row$ (append$b ?v0 ?v1) ?v2) (append$c (row$ ?v0 ?v2) (row$ ?v1 ?v2)))) :named a3))
(assert (! (forall ((?v0 B_list_list_list$) (?v1 B_list_list_list$)) (= (= (append$a ?v0 ?v1) ?v0) (= ?v1 nil$b))) :named a4))
(assert (! (forall ((?v0 B_list_list$) (?v1 B_list_list$)) (= (= (append$b ?v0 ?v1) ?v0) (= ?v1 nil$))) :named a5))
(assert (! (forall ((?v0 B_list$) (?v1 B_list$)) (= (= (append$c ?v0 ?v1) ?v0) (= ?v1 nil$a))) :named a6))
