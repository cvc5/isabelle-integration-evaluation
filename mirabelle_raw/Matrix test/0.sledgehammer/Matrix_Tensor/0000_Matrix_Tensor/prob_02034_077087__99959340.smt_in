(declare-fun append$b (B_list_list$ B_list_list$) B_list_list$)
(declare-fun append$c (B_list$ B_list$) B_list$)
(assert (! (not (= (row$ nil$ i$) nil$a)) :named conjecture0))
(assert (! (forall ((?v0 B_list_list_list_list$) (?v1 B_list_list_list_list$) (?v2 Nat$)) (= (row$a (append$ ?v0 ?v1) ?v2) (append$a (row$a ?v0 ?v2) (row$a ?v1 ?v2)))) :named a1))
