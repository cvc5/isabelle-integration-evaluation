; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 309
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun m1$ () A_list_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nth$a (A_list_list$ Nat$) A_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (nth$ (nth$a (tensor$ f$ m1$ m2$) j$) i$) (fun_app$ (fun_app$a f$ (nth$ (nth$a m1$ (divide$ j$ (size$ m2$))) (divide$ i$ (row_length$ m2$)))) (nth$ (nth$a m2$ (modulo$ j$ (size$ m2$))) (modulo$ i$ (row_length$ m2$)))))) :named conjecture0))
(assert (! (mat$ (row_length$ m2$) (size$ m2$) m2$) :named a1))
(assert (! (mat$ (row_length$ m1$) (size$ m1$) m1$) :named a2))
(assert (! (less$ j$ (times$ (size$ m1$) (size$ m2$))) :named a3))
(assert (! (less$ i$ (times$ (row_length$ m1$) (row_length$ m2$))) :named a4))
(check-sat)
(get-proof)
