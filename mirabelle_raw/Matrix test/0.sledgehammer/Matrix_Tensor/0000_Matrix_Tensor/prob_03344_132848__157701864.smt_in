; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 246
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun x$ () A$)
(declare-fun id$ () A$)
(declare-fun zer$ () A$)
(declare-fun inver$ () A_a_fun$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun plus_mult$ (A$ A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_a_fun$) Bool)
(assert (! (not (= (fun_app$ (fun_app$a f$ zer$) x$) zer$)) :named conjecture0))
(assert (! (= zer$ (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ zer$) x$)) zer$)) :named a1))
(assert (! (plus_mult$ id$ f$ zer$ g$ inver$) :named a2))
(check-sat)
(get-proof)
