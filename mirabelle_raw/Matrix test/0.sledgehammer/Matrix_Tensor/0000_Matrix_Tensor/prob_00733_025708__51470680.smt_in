; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 242
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun m2$ () A_list_list$)
(declare-fun n1$ () A_list_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(assert (! (not (= (size$ (tensor$ f$ (cons$ a$ m1a$) m2$)) (times$ (size$ (cons$ a$ m1a$)) (size$ m2$)))) :named conjecture0))
(assert (! (= m1a$ (cons$ b$ n1$)) :named a1))
(check-sat)
(get-proof)
