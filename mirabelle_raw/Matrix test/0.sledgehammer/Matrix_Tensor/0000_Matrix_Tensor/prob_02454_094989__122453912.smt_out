unsat
(assume conjecture1 (! (not (! (= (! (fun_app$a (times$ (fun_app$a (minus$ y$) x$)) b$) :named @p_2) (! (fun_app$a (minus$ (fun_app$a (divide$ (fun_app$a (modulo$ a$) (fun_app$a (times$ b$) c$))) c$)) (fun_app$a (modulo$ (fun_app$a (divide$ a$) c$)) b$)) :named @p_1)) :named @p_3)) :named @p_4))
