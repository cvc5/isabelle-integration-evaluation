; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun x$ () Nat$)
(declare-fun nat$ (Int) Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (=> (less$ zero$ x$) (= (fun_app$ (plus$ (nat$ (+ (of_nat$ x$) (- 1)))) one$) x$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (= (less$ zero$ (of_nat$a ?v0)) (less$ zero$ ?v0))) :named a1))
(assert (! (forall ((?v0 Nat$)) (= (< 0 (of_nat$ ?v0)) (less$ zero$ ?v0))) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (nat$ (of_nat$ ?v0)) ?v0)) :named a3))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a5))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (+ ?v0 ?v1) (+ ?v1 ?v0))) :named a6))
(assert (! (= (plus$ one$) suc$) :named a7))
(assert (! (forall ((?v0 Int)) (=> (<= 0 ?v0) (= (fun_app$ suc$ (nat$ ?v0)) (nat$ (+ 1 ?v0))))) :named a8))
(check-sat)
(get-proof)
