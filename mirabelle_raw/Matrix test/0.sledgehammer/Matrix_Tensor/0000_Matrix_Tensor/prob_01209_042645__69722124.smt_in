; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 244
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun k$ () Nat$)
(declare-fun x$ () B$)
(declare-fun xs$ () B_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (nth$ (cons$ x$ xs$) (fun_app$ (plus$ k$) one$)) (nth$ xs$ k$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a1))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (fun_app$ suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (fun_app$ suc$ ?v2))))) :named a2))
(assert (! (= (plus$ one$) suc$) :named a3))
(check-sat)
(get-proof)
