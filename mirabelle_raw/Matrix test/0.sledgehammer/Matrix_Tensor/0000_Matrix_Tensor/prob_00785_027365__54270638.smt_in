; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 435
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun x$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (not (=> (less$ i$ (size$ (cons$ x$ xs$))) (= (nth$ (times$ f$ a$ (cons$ x$ xs$)) i$) (fun_app$ (fun_app$a f$ a$) (nth$ (cons$ x$ xs$) i$))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (size$ xs$)) (= (nth$ (times$ f$ a$ xs$) ?v0) (fun_app$ (fun_app$a f$ a$) (nth$ xs$ ?v0))))) :named a1))
(assert (! (= one$ (suc$ zero$)) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (! (= (times$ f$ ?v0 (cons$ ?v1 ?v2)) (cons$ (fun_app$ (fun_app$a f$ ?v0) ?v1) (times$ f$ ?v0 ?v2))) :pattern ((times$ f$ ?v0 (cons$ ?v1 ?v2))))) :named a3))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ (suc$ ?v0) (suc$ ?v1)) (less$ ?v0 ?v1))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ ?v0 (suc$ ?v1)) (or (= ?v0 zero$) (exists ((?v2 Nat$)) (and (= ?v0 (suc$ ?v2)) (less$ ?v2 ?v1)))))) :named a6))
(assert (! (forall ((?v0 Nat$)) (=> (less$ zero$ ?v0) (= (suc$ (minus$ ?v0 (suc$ zero$))) ?v0))) :named a7))
(check-sat)
(get-proof)
