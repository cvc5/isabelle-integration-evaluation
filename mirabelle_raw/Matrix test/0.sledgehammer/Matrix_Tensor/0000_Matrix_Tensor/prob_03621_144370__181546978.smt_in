(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ v1$ v2$) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ a1$) a2$)) (scalar_product$ f$ zer$ g$ u1$ u2$)))) :named conjecture0))
(assert (! (= (zip$ v1$ v2$) (cons$ (pair$ a1$ a2$) (zip$ u1$ u2$))) :named a1))
(assert (! (and (= v1$ (cons$a a1$ u1$)) (= (size$ u1$) k$)) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (! (= (scalar_product$ f$ zer$ g$ ?v0 ?v1) (scalar_prodI$ zer$ g$ f$ ?v0 ?v1)) :pattern ((scalar_product$ f$ zer$ g$ ?v0 ?v1)))) :named a3))
(assert (! (and (= v2$ (cons$a a2$ u2$)) (= (size$ u2$) k$)) :named a4))
(check-sat)
(get-proof)
