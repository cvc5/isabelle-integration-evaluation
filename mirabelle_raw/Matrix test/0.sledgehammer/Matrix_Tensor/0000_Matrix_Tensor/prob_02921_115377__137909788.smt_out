unsat
(assume conjecture1 (! (not (! (= nr1$ nr2$) :named @p_1)) :named @p_2))
(assume a2 (! (= (! (size$ v$) :named @p_3) nr1$) :named @p_4))
(assume a3 (! (= @p_3 nr2$) :named @p_5))
(step t0 (cl (not (! (= @p_2 false) :named @p_6)) (not @p_2) false) :rule equiv_pos2)
(step t1 (cl (= nr1$ @p_3)) :rule symm :premises (a2))
(step t2 (cl (= nr2$ @p_3)) :rule symm :premises (a3))
(step t3 (cl (= @p_1 (! (= @p_3 @p_3) :named @p_7))) :rule cong :premises (t1 t2))
(step t4 (cl (= @p_2 (! (not @p_7) :named @p_8))) :rule cong :premises (t3))
(step t5 (cl (= @p_7 true)) :rule rare_rewrite :args ("eq-refl" @p_3))
(step t6 (cl (= @p_8 (! (not true) :named @p_9))) :rule cong :premises (t5))
(step t7 (cl (= @p_9 false)) :rule evaluate)
(step t8 (cl (= @p_8 false)) :rule trans :premises (t6 t7))
(step t9 (cl @p_6) :rule trans :premises (t4 t8))
(step t10 (cl false) :rule resolution :premises (t0 t9 conjecture1))
(step t11 (cl (not false)) :rule false)
(step t12 (cl) :rule resolution :premises (t10 t11))
