; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 272
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun k$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (and (less$ k$ (size$ m$)) (less_eq$ one$ k$)) (= (nth$ m$ (minus$ k$ one$)) (nth$ (cons$ v$ m$) k$)))) :named conjecture0))
(assert (! (= one$ (suc$ zero$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (times$ ?v0) zero$) zero$) :pattern ((times$ ?v0)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (times$ ?v0) ?v1) (fun_app$ (times$ ?v1) ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (= (minus$ ?v1 ?v0) ?v2) (= ?v1 (plus$ ?v2 ?v0))))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (fun_app$ (times$ (suc$ ?v0)) ?v1) (plus$ ?v1 (fun_app$ (times$ ?v0) ?v1))) :pattern ((fun_app$ (times$ (suc$ ?v0)) ?v1)))) :named a6))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) ?v2) (ite (= ?v2 zero$) ?v0 (nth$ ?v1 (minus$ ?v2 one$)))) :pattern ((nth$ (cons$ ?v0 ?v1) ?v2)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$) (?v2 A_list_list$)) (! (=> (less$ zero$ ?v0) (= (nth$ (cons$ ?v1 ?v2) ?v0) (nth$ ?v2 (minus$ ?v0 one$)))) :pattern ((nth$ (cons$ ?v1 ?v2) ?v0)))) :named a8))
(check-sat)
(get-proof)
