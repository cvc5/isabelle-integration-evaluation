; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 307
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(assert (! (not (= (size$ (cons$ a$ nil$)) one$)) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a1))
(assert (! (= ma$ nil$) :named a2))
(assert (! (= (size$ nil$) zero$) :named a3))
(assert (! (forall ((?v0 A_list_list$)) (=> (not (= ?v0 nil$)) (= (plus$ (size$ (reduct$ ?v0)) one$) (size$ ?v0)))) :named a4))
(assert (! (less$ zero$ (size$ (cons$ a$ ma$))) :named a5))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a6))
(assert (! (forall ((?v0 Nat$)) (= (suc$ ?v0) (plus$ ?v0 one$))) :named a7))
(check-sat)
(get-proof)
