; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun a1$ () A$)
(declare-fun a2$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun u2$ () A_list$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ a1$) a2$)) (scalar_product$ f$ zer$ g$ w1$ w2$))) (fun_app$ (fun_app$a f$ (scalar_product$ f$ zer$ g$ u1$ u2$)) (scalar_product$ f$ zer$ g$ w1$ w2$))) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ a1$) a2$)) (scalar_product$ f$ zer$ g$ w1$ w2$))) (scalar_product$ f$ zer$ g$ (vec_vec_Tensor$ f$ u1$ w1$) (vec_vec_Tensor$ f$ u2$ w2$))))) :named conjecture0))
(assert (! (= (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ a1$) a2$)) (scalar_product$ f$ zer$ g$ u1$ u2$))) (scalar_product$ f$ zer$ g$ w1$ w2$)) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ a1$) a2$)) (scalar_product$ f$ zer$ g$ w1$ w2$))) (fun_app$ (fun_app$a f$ (scalar_product$ f$ zer$ g$ u1$ u2$)) (scalar_product$ f$ zer$ g$ w1$ w2$)))) :named a1))
(assert (! (= (fun_app$ (fun_app$a f$ (scalar_product$ f$ zer$ g$ u1$ u2$)) (scalar_product$ f$ zer$ g$ w1$ w2$)) (scalar_product$ f$ zer$ g$ (vec_vec_Tensor$ f$ u1$ w1$) (vec_vec_Tensor$ f$ u2$ w2$))) :named a2))
(check-sat)
(get-proof)
