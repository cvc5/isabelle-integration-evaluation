(assert (! (not (member$ z$ (set$ m$))) :named conjecture0))
(assert (! (= z$ (hd$ m$)) :named a1))
(assert (! (forall ((?v0 B_list$)) (=> (not (= ?v0 nil$)) (member$a (hd$a ?v0) (set$a ?v0)))) :named a2))
(assert (! (forall ((?v0 B_list_list_list$)) (=> (not (= ?v0 nil$a)) (member$b (hd$b ?v0) (set$b ?v0)))) :named a3))
(assert (! (forall ((?v0 B_list_list$)) (=> (not (= ?v0 nil$b)) (member$ (hd$ ?v0) (set$ ?v0)))) :named a4))
