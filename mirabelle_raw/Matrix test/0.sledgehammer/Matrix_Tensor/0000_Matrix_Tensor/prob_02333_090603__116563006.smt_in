; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 239
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (less$ (modulo$ x$ y$) y$)) :named conjecture0))
(assert (! (not (= y$ zero$)) :named hypothesis1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (less$ (modulo$ ?v1 ?v0) ?v0))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a3))
(check-sat)
(get-proof)
