; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-fun a$ () Int)
(declare-fun b$ () Int)
(declare-fun times$ (Int Int) Int)
(declare-fun divide$ (Int Int) Int)
(assert (! (not (=> (not (= b$ 0)) (= (divide$ (+ a$ (* b$ (- 1))) b$) (+ (- 1) (divide$ a$ b$))))) :named conjecture0))
(assert (! (< 0 b$) :named a1))
(assert (! (<= b$ a$) :named a2))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ ?v1 (times$ ?v2 ?v0)) ?v0) (+ ?v2 (divide$ ?v1 ?v0))))) :named a3))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ ?v1 (times$ ?v0 ?v2)) ?v0) (+ ?v2 (divide$ ?v1 ?v0))))) :named a4))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ (times$ ?v0 ?v1) ?v2) ?v0) (+ ?v1 (divide$ ?v2 ?v0))))) :named a5))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ (times$ ?v1 ?v0) ?v2) ?v0) (+ ?v1 (divide$ ?v2 ?v0))))) :named a6))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (and (< 0 ?v0) (<= ?v0 ?v1)) (= (divide$ ?v1 ?v0) (+ (divide$ (- ?v1 ?v0) ?v0) 1)))) :named a7))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ ?v1 ?v0) ?v0) (+ (divide$ ?v1 ?v0) 1)))) :named a8))
(assert (! (= (+ (- 1) 1) 0) :named a9))
(assert (! (= (+ 1 (- 1)) 0) :named a10))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (times$ (- ?v0) ?v1) (- (times$ ?v0 ?v1)))) :named a11))
(assert (! (forall ((?v0 Int)) (= (divide$ ?v0 (- 1)) (- ?v0))) :named a12))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a13))
(assert (! (forall ((?v0 Int)) (= (* (- 1) ?v0) (- ?v0))) :named a14))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (divide$ (times$ ?v0 ?v1) (times$ ?v0 ?v2)) (ite (= ?v0 0) 0 (divide$ ?v1 ?v2)))) :named a15))
(assert (! (forall ((?v0 Int)) (= (* ?v0 (- 1)) (- ?v0))) :named a16))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (divide$ (- ?v0) (- ?v1)) (divide$ ?v0 ?v1))) :named a17))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (=> (not (= ?v0 0)) (= (divide$ (times$ ?v0 ?v1) (times$ ?v0 ?v2)) (divide$ ?v1 ?v2)))) :named a18))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (=> (not (= ?v0 0)) (= (divide$ (times$ ?v1 ?v0) (times$ ?v2 ?v0)) (divide$ ?v1 ?v2)))) :named a19))
(check-sat)
(get-proof)
