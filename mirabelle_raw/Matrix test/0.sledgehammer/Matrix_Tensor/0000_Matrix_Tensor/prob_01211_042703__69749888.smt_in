; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun k$ () Nat$)
(declare-fun nat$ (Int) Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (=> (= j$ (fun_app$ (plus$ k$) one$)) (= (nat$ (+ (of_nat$ j$) (- 1))) k$))) :named conjecture0))
(assert (! (= one$ (nat$ 1)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v2) ?v1)) (= ?v0 ?v2))) :named a2))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (= (+ ?v0 ?v1) (+ ?v2 ?v1)) (= ?v0 ?v2))) :named a3))
(assert (! (forall ((?v0 Nat$)) (=> (less$ zero$ ?v0) (= (fun_app$ (plus$ (nat$ (+ (of_nat$ ?v0) (- 1)))) one$) ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (fun_app$ (plus$ ?v0) ?v1) zero$) (and (= ?v0 zero$) (= ?v1 zero$)))) :named a5))
(assert (! (forall ((?v0 Nat$)) (= (= (of_nat$a ?v0) zero$) (= ?v0 zero$))) :named a6))
(assert (! (forall ((?v0 Nat$)) (= (= (of_nat$ ?v0) 0) (= ?v0 zero$))) :named a7))
(assert (! (= (nat$ 1) (fun_app$ suc$ zero$)) :named a8))
(assert (! (forall ((?v0 Nat$)) (= (less$ zero$ (of_nat$a ?v0)) (less$ zero$ ?v0))) :named a9))
(assert (! (forall ((?v0 Nat$)) (= (< 0 (of_nat$ ?v0)) (less$ zero$ ?v0))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ ?v0 (fun_app$ suc$ ?v1)) (or (= ?v0 zero$) (exists ((?v2 Nat$)) (and (= ?v0 (fun_app$ suc$ ?v2)) (less$ ?v2 ?v1)))))) :named a11))
(assert (! (forall ((?v0 Nat$)) (not (less$ (of_nat$a ?v0) zero$))) :named a12))
(assert (! (forall ((?v0 Nat$)) (not (< (of_nat$ ?v0) 0))) :named a13))
(assert (! (not (< 1 1)) :named a14))
(assert (! (not (less$ one$ one$)) :named a15))
(assert (! (= (plus$ one$) suc$) :named a16))
(check-sat)
(get-proof)
