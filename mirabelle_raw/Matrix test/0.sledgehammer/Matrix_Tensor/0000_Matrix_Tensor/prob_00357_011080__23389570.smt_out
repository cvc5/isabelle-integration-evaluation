unsat
(assume conjecture0 (! (not (! (mat$ zero$ zero$ m$) :named @p_1)) :named @p_2))
(assume a1 (! (mat$ zero$ zero$ nil$) :named @p_3))
(assume a2 (! (= m$ nil$) :named @p_4))
(step t0 (cl (not (! (= @p_2 (! (not @p_3) :named @p_5)) :named @p_6)) (not @p_2) @p_5) :rule equiv_pos2)
(step t1 (cl (= @p_1 @p_3)) :rule cong :premises (a2))
(step t2 (cl @p_6) :rule cong :premises (t1))
(step t3 (cl @p_5) :rule resolution :premises (t0 t2 conjecture0))
(step t4 (cl) :rule resolution :premises (a1 t3))
