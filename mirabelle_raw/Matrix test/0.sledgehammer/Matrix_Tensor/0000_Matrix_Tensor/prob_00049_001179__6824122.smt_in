; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A$)
(declare-fun id$ () A$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun last$ (A_list_list_list$) A_list_list$)
(declare-fun nil$a () A_list_list_list$)
(declare-fun nil$b () A_list_list$)
(declare-fun nil$c () A_list_list_list_list$)
(declare-fun cons$a (A_list_list$ A_list_list_list$) A_list_list_list$)
(declare-fun cons$b (A_list$ A_list_list$) A_list_list$)
(declare-fun last$a (A_list_list$) A_list$)
(declare-fun last$b (A_list$) A$)
(declare-fun times$ (A_a_a_fun_fun$ A$) A_list_a_list_fun$)
(declare-fun concat$ (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$a (A_list_list_list$) A_list_list$)
(declare-fun concat$b (A_list_list$) A_list$)
(declare-fun fun_app$ (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun fun_app$a (A_a_fun$ A$) A$)
(declare-fun fun_app$b (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (not (= (fun_app$ (times$ f$ v$) (cons$ id$ nil$)) (cons$ v$ nil$))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (! (= (fun_app$ (times$ f$ ?v0) (cons$ ?v1 ?v2)) (cons$ (fun_app$a (fun_app$b f$ ?v0) ?v1) (fun_app$ (times$ f$ ?v0) ?v2))) :pattern ((fun_app$ (times$ f$ ?v0) (cons$ ?v1 ?v2))))) :named a1))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$ (times$ f$ ?v0) nil$) nil$) :pattern ((times$ f$ ?v0)))) :named a2))
(assert (! (forall ((?v0 A$)) (= (fun_app$a (fun_app$b f$ ?v0) id$) ?v0)) :named a3))
(assert (! (forall ((?v0 A_list_list_list$) (?v1 A_list_list$)) (! (=> (= ?v0 nil$a) (= (last$ (cons$a ?v1 ?v0)) ?v1)) :pattern ((cons$a ?v1 ?v0)))) :named a4))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list$)) (! (=> (= ?v0 nil$b) (= (last$a (cons$b ?v1 ?v0)) ?v1)) :pattern ((cons$b ?v1 ?v0)))) :named a5))
(assert (! (forall ((?v0 A_list$) (?v1 A$)) (! (=> (= ?v0 nil$) (= (last$b (cons$ ?v1 ?v0)) ?v1)) :pattern ((cons$ ?v1 ?v0)))) :named a6))
(assert (! (= (concat$ nil$c) nil$a) :named a7))
(assert (! (= (concat$a nil$a) nil$b) :named a8))
(assert (! (= (concat$b nil$b) nil$) :named a9))
(check-sat)
(get-proof)
