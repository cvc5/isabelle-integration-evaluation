; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 261
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (less$ i$ (size$ y$)) (= (nth$ (vec_vec_Tensor$ f$ (cons$ z$ zs$) y$) i$) (nth$ (times$ f$ z$ y$) i$)))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A_list$)) (! (= (vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2) (append$ (times$ f$ ?v0 ?v2) (vec_vec_Tensor$ f$ ?v1 ?v2))) :pattern ((vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2)))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (= (size$ (times$ f$ ?v0 ?v1)) (size$ ?v1))) :named a2))
(check-sat)
(get-proof)
