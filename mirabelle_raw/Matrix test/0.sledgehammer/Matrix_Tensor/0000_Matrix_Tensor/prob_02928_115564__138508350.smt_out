unsat
(assume conjecture0 (! (not (! (= nc1$ nc2$) :named @p_1)) :named @p_2))
(assume a1 (! (= (! (size$ m$) :named @p_3) nc1$) :named @p_4))
(assume a2 (! (= @p_3 nc2$) :named @p_5))
(step t0 (cl (not (! (= (! (= false true) :named @p_6) false) :named @p_10)) (not @p_6) false) :rule equiv_pos2)
(step t1 (cl @p_10) :rule evaluate)
(step t2 (cl (= (! (= @p_1 false) :named @p_8) @p_2)) :rule equiv_simplify)
(step t3 (cl @p_8 (! (not @p_2) :named @p_9)) :rule equiv2 :premises (t2))
(step t4 (cl (not @p_9) @p_1) :rule not_not)
(step t5 (cl @p_8 @p_1) :rule resolution :premises (t3 t4))
(step t6 (cl @p_8) :rule resolution :premises (t5 conjecture0))
(step t7 (cl (= false @p_1)) :rule symm :premises (t6))
(step t8 (cl (= (! (= @p_1 true) :named @p_7) @p_1)) :rule equiv_simplify)
(step t9 (cl @p_7 @p_2) :rule equiv2 :premises (t8))
(step t10 (cl (= nc1$ @p_3)) :rule symm :premises (a1))
(step t11 (cl @p_1) :rule trans :premises (t10 a2))
(step t12 (cl @p_7) :rule resolution :premises (t9 t11))
(step t13 (cl @p_6) :rule trans :premises (t7 t12))
(step t14 (cl false) :rule resolution :premises (t0 t1 t13))
(step t15 (cl (not false)) :rule false)
(step t16 (cl) :rule resolution :premises (t14 t15))
