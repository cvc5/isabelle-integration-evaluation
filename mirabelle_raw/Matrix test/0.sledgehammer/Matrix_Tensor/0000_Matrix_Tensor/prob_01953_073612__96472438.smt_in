(assert (! (not (= (col$ (vec_mat_Tensor$ f$ v$ m2$) j$) (vec_vec_Tensor$ f$ (nth$ (cons$ v$ m$) (divide$ j$ (size$ m2$))) (col$ m2$ (modulo$ j$ (size$ m2$)))))) :named conjecture0))
(assert (! (less$ j$ (size$ m2$)) :named hypothesis1))
(assert (! (=> (less$ j$ (size$ m2$)) (= (col$ (vec_mat_Tensor$ f$ v$ m2$) j$) (vec_vec_Tensor$ f$ v$ (col$ m2$ j$)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (=> (less$ ?v0 ?v1) (= (modulo$ ?v0 ?v1) ?v0)) :pattern ((modulo$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (nth$ (cons$ ?v0 ?v1) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a4))
