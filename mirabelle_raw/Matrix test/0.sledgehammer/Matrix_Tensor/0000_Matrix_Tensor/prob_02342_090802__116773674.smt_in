; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (modulo$ a$ (times$ b$ c$)) a$)) :named conjecture0))
(assert (! (= (times$ b$ c$) zero$) :named a1))
(assert (! (= c$ zero$) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (modulo$ ?v0 zero$) ?v0)) :named a3))
(check-sat)
(get-proof)
