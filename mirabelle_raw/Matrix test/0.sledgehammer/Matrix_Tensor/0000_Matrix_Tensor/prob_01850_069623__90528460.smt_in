(declare-fun fun_app$ (Nat_bool_fun$ Nat$) Bool)
(declare-fun less_eq$ (Nat$) Nat_bool_fun$)
(assert (! (not (fun_app$ (less$ (divide$ x$ y$)) z$)) :named conjecture0))
(assert (! (fun_app$ (less$ x$) (times$ y$ z$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (fun_app$ (less$ ?v0) (times$ ?v1 ?v2)) (fun_app$ (less$ (divide$ ?v0 ?v2)) ?v1))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (fun_app$ (less$ ?v0) ?v1) (fun_app$ (less$ ?v1) ?v0)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (fun_app$ (less$ ?v0) (times$ ?v1 ?v2)) (fun_app$ (less$ (divide$ ?v0 ?v2)) ?v1))) :named a4))
(assert (! (forall ((?v0 Nat$)) (not (fun_app$ (less$ ?v0) ?v0))) :named a5))
(assert (! (forall ((?v0 A$)) (= (f$ id$ ?v0) ?v0)) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (fun_app$ (less$ ?v0) ?v1) (not (= ?v1 ?v0)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (fun_app$ (less$ ?v0) ?v1) (not (= ?v0 ?v1)))) :named a8))
(assert (! (forall ((?v0 Nat$)) (=> (fun_app$ (less$ ?v0) ?v0) false)) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (=> (fun_app$ (less$ ?v0) ?v1) (= (divide$ ?v0 ?v1) zero$)) :pattern ((divide$ ?v0 ?v1)))) :named a10))
(assert (! (= one$ (suc$ zero$)) :named a11))
(assert (! (forall ((?v0 Nat_bool_fun$) (?v1 Nat$)) (=> (forall ((?v2 Nat$)) (=> (forall ((?v3 Nat$)) (=> (fun_app$ (less$ ?v3) ?v2) (fun_app$ ?v0 ?v3))) (fun_app$ ?v0 ?v2))) (fun_app$ ?v0 ?v1))) :named a12))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (not (= ?v0 ?v1)) (and (=> (fun_app$ (less$ ?v0) ?v1) false) (=> (fun_app$ (less$ ?v1) ?v0) false))) false)) :named a14))
(assert (! (forall ((?v0 Nat$)) (! (= (times$ zero$ ?v0) zero$) :pattern ((times$ zero$ ?v0)))) :named a15))
(assert (! (forall ((?v0 Nat_bool_fun$) (?v1 Nat$)) (=> (forall ((?v2 Nat$)) (=> (not (fun_app$ ?v0 ?v2)) (exists ((?v3 Nat$)) (and (fun_app$ (less$ ?v3) ?v2) (not (fun_app$ ?v0 ?v3)))))) (fun_app$ ?v0 ?v1))) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (fun_app$ (less$ zero$) ?v0) (= (fun_app$ (less$ (divide$ ?v1 ?v0)) ?v2) (fun_app$ (less$ ?v1) (times$ ?v2 ?v0))))) :named a17))
(assert (! (fun_app$ (less$ zero$) one$) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a19))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a20))
(assert (! (forall ((?v0 Nat$)) (not (fun_app$ (less$ ?v0) zero$))) :named a21))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (fun_app$ (less$ zero$) ?v0))) :named a22))
(assert (! (not (fun_app$ (less_eq$ one$) zero$)) :named a23))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (times$ (suc$ ?v0) ?v1) (plus$ ?v1 (times$ ?v0 ?v1))) :pattern ((times$ (suc$ ?v0) ?v1)))) :named a24))
(assert (! (forall ((?v0 Nat$)) (fun_app$ (less$ ?v0) (suc$ ?v0))) :named a25))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (less$ zero$) (times$ ?v0 ?v1)) (and (fun_app$ (less$ zero$) ?v0) (fun_app$ (less$ zero$) ?v1)))) :named a26))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$ (less$ (times$ ?v0 ?v1)) (times$ ?v2 ?v1)) (and (fun_app$ (less$ zero$) ?v1) (fun_app$ (less$ ?v0) ?v2)))) :named a27))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a28))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (fun_app$ (less$ ?v0) ?v1)) (fun_app$ (less_eq$ ?v1) ?v0))) :named a29))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (divide$ ?v0 (times$ ?v1 ?v2)) (divide$ (divide$ ?v0 ?v1) ?v2))) :named a30))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (fun_app$ (less_eq$ (times$ (divide$ ?v0 ?v1) ?v1)) ?v0)) :named a31))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (fun_app$ (less$ one$) ?v0) (fun_app$ (less$ zero$) ?v1)) (fun_app$ (less$ (divide$ ?v1 ?v0)) ?v1))) :named a32))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (fun_app$ (less$ ?v0) ?v1) (= ?v1 zero$)))) :named a33))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (fun_app$ (less$ zero$) ?v0) (= (divide$ (times$ ?v1 ?v0) ?v0) ?v1))) :named a34))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$ (less$ (times$ ?v0 ?v1)) (times$ ?v0 ?v2)) (and (fun_app$ (less$ zero$) ?v0) (fun_app$ (less$ ?v1) ?v2)))) :named a35))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (less$ zero$) (divide$ ?v0 ?v1)) (and (fun_app$ (less_eq$ ?v1) ?v0) (fun_app$ (less$ zero$) ?v1)))) :named a36))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (fun_app$ (less_eq$ (modulo$ ?v0 ?v1)) ?v0)) :named a37))
(assert (! (forall ((?v0 Nat$)) (= (times$ one$ ?v0) ?v0)) :named a38))
(check-sat)
(get-proof)
