unsat
(assume conjecture1 (! (not (! (and (! (mat$ (row_length$ m2$) (size$ m2$) m2$) :named @p_2) (! (mat$ (row_length$ m3$) (size$ m3$) m3$) :named @p_1)) :named @p_3)) :named @p_4))
(assume a13 (! (and (mat$ (row_length$ m1$) (size$ m1$) m1$) @p_3) :named @p_5))
(step t0 (cl @p_3) :rule and :premises (a13) :args (1))
(step t1 (cl @p_1) :rule and :premises (t0) :args (1))
(step t2 (cl (not @p_2) (! (not @p_1) :named @p_6)) :rule not_and :premises (conjecture1))
(step t3 (cl @p_2) :rule and :premises (t0) :args (0))
(step t4 (cl @p_6) :rule resolution :premises (t2 t3))
(step t5 (cl) :rule resolution :premises (t1 t4))
