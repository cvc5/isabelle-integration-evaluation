; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 218
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun a1$ () A_list_list$)
(declare-fun b1$ () A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ (divide$ i$ (row_length$ b1$)) (row_length$ a1$))) :named conjecture0))
(assert (! (less$ i$ (times$ (row_length$ a1$) (row_length$ b1$))) :named a1))
(check-sat)
(get-proof)
