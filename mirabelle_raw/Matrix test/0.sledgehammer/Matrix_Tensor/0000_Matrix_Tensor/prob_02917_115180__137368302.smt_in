; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 237
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun v$ () B_list$)
(declare-fun ma$ () B_list_list$)
(declare-fun mat$ (Nat$ Nat$ B_list_list$) Bool)
(declare-fun nc1$ () Nat$)
(declare-fun nr1$ () Nat$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun vec$ (Nat$ B_list$) Bool)
(declare-fun cons$ (B_list$ B_list_list$) B_list_list$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(assert (! (not (= (size$ v$) nr1$)) :named conjecture0))
(assert (! (member$ v$ (set$ (cons$ v$ ma$))) :named a1))
(assert (! (= m$ (cons$ v$ ma$)) :named a2))
(assert (! (mat$ nr1$ nc1$ m$) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 B_list$)) (! (= (vec$ ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a4))
(check-sat)
(get-proof)
