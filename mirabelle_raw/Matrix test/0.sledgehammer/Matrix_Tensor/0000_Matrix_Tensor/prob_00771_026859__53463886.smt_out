unsat
(assume conjecture3 (! (not (=> (! (less$ i$ (size$a nil$)) :named @p_1) (= (nth$b (fun_app$d (fun_app$e (times$ f$) a$) nil$a) i$) (fun_app$f (fun_app$g f$ a$) (nth$b nil$a i$))))) :named @p_2))
(assume a4 (! (=> @p_1 false) :named @p_3))
(step t0 (cl @p_1) :rule not_implies1 :premises (conjecture3))
(step t1 (cl (not (! (= @p_3 (! (not @p_1) :named @p_4)) :named @p_5)) (not @p_3) @p_4) :rule equiv_pos2)
