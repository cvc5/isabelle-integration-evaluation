; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun f$ (A$ A$) A$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun dvd$ (Nat$ Nat$) Bool)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)) zero$)) :named conjecture0))
(assert (! (less$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) b$) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (modulo$ ?v0 (times$ ?v1 ?v2)) ?v2) (modulo$ ?v0 ?v2))) :named a2))
(assert (! (not (= (times$ b$ c$) zero$)) :named a3))
(assert (! (less$ (modulo$ (divide$ a$ c$) b$) b$) :named a4))
(assert (! (dvd$ b$ (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a5))
(assert (! (forall ((?v0 A$) (?v1 A$)) (= (f$ ?v0 ?v1) (f$ ?v1 ?v0))) :named a6))
(assert (! (and (less$ zero$ b$) (less$ zero$ c$)) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v2) ?v1))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (= (modulo$ ?v1 ?v0) (modulo$ (minus$ ?v1 ?v0) ?v0)))) :named a9))
(assert (! (= (times$ (minus$ x$ y$) b$) (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ (modulo$ ?v0 ?v1) ?v1) zero$)) :named a11))
(assert (! (forall ((?v0 Nat$)) (= (modulo$ ?v0 zero$) ?v0)) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (dvd$ ?v0 (times$ ?v1 ?v0))) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v1) ?v2))) :named a14))
(assert (! (less$ (modulo$ a$ (times$ b$ c$)) (times$ b$ c$)) :named a15))
(assert (! (= (minus$ (times$ x$ b$) (times$ y$ b$)) (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a16))
(assert (! (less$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) (divide$ (times$ b$ c$) c$)) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (times$ ?v0 ?v1) ?v0) zero$)) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (times$ ?v0 ?v1) ?v1) zero$)) :named a19))
(assert (! (= (divide$ a$ c$) (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a20))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ (modulo$ ?v0 ?v1) ?v1) zero$)) :named a21))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (times$ ?v1 ?v0) ?v0) ?v1))) :named a22))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (times$ ?v0 ?v1) ?v0) ?v1))) :named a23))
(assert (! (= (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a24))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a25))
(assert (! (= (divide$ a$ c$) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a26))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (minus$ ?v0 ?v1) ?v2) (minus$ (times$ ?v0 ?v2) (times$ ?v1 ?v2)))) :named a27))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (= (divide$ (times$ ?v1 ?v0) ?v0) ?v1))) :named a28))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a29))
(check-sat)
(get-proof)
