; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 270
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun divide$a (Int Int) Int)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (= (of_nat$ (divide$ a$ b$)) (of_nat$ (plus$ (divide$ (minus$ a$ b$) b$) one$)))) :named conjecture0))
(assert (! (= (+ (of_nat$ x$) 1) (of_nat$ (plus$ x$ one$))) :named a1))
(assert (! (= (divide$a (of_nat$ a$) (of_nat$ b$)) (of_nat$ (divide$ a$ b$))) :named a2))
(assert (! (= (divide$a (- (of_nat$ a$) (of_nat$ b$)) (of_nat$ b$)) (of_nat$ (divide$ (minus$ a$ b$) b$))) :named a3))
(assert (! (= (divide$a (of_nat$ a$) (of_nat$ b$)) (+ (divide$a (- (of_nat$ a$) (of_nat$ b$)) (of_nat$ b$)) 1)) :named a4))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (not (< ?v0 ?v1)) (= (+ ?v1 (- ?v0 ?v1)) ?v0))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (less$ ?v0 ?v1)) (= (plus$ ?v1 (minus$ ?v0 ?v1)) ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (=> (less$ ?v0 ?v1) (= (divide$ ?v0 ?v1) zero$)) :pattern ((divide$ ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (plus$ ?v0 ?v1) ?v0) (plus$ (divide$ ?v1 ?v0) one$)))) :named a8))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (not (= ?v0 0)) (= (divide$a (+ ?v0 ?v1) ?v0) (+ (divide$a ?v1 ?v0) 1)))) :named a9))
(assert (! (forall ((?v0 Nat$)) (= (less_eq$ (of_nat$a ?v0) zero$) (= ?v0 zero$))) :named a10))
(assert (! (forall ((?v0 Nat$)) (= (<= (of_nat$ ?v0) 0) (= ?v0 zero$))) :named a11))
(check-sat)
(get-proof)
