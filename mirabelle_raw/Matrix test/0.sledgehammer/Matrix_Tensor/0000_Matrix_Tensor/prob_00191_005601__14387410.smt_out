unsat
(assume conjecture0 (! (not (= (! (fun_app$ set$ m$) :named @p_1) bot$)) :named @p_2))
(assume a8 (! (= bot$ (! (fun_app$ set$ nil$e) :named @p_3)) :named @p_4))
