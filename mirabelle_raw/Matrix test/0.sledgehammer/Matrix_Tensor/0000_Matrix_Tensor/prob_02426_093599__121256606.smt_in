; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 233
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun nil$ () A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (divide$ a$ c$) (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (divide$ a$ c$) (plus$ (divide$ (times$ (times$ x$ b$) c$) c$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a1))
(assert (! (and (less$ zero$ b$) (less$ zero$ c$)) :named a2))
(assert (! (= (row_length$ nil$) zero$) :named a3))
(check-sat)
(get-proof)
