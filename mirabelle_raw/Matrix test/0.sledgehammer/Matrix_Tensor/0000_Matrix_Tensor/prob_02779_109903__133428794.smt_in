(declare-fun nth$a (A_list_list$ Nat$) A_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ ?v0 (times$ (times$ (row_length$ m1$) (row_length$ m2$)) (row_length$ m3$))) (less$ ?v1 (times$ (times$ (size$ m1$) (size$ m2$)) (size$ m3$)))) (= (nth$ (nth$a (tensor$ f$ m1$ (tensor$ f$ m2$ m3$)) ?v1) ?v0) (fun_app$ (fun_app$a f$ (nth$ (nth$a m1$ (divide$ ?v1 (times$ (size$ m2$) (size$ m3$)))) (divide$ ?v0 (times$ (row_length$ m2$) (row_length$ m3$))))) (fun_app$ (fun_app$a f$ (nth$ (nth$a m2$ (modulo$ (divide$ ?v1 (size$ m3$)) (size$ m2$))) (modulo$ (divide$ ?v0 (row_length$ m3$)) (row_length$ m2$)))) (nth$ (nth$a m3$ (modulo$ ?v1 (size$ m3$))) (modulo$ ?v0 (row_length$ m3$))))))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ ?v0 (times$ (times$ (row_length$ m1$) (row_length$ m2$)) (row_length$ m3$))) (less$ ?v1 (times$ (times$ (size$ m1$) (size$ m2$)) (size$ m3$)))) (= (nth$ (nth$a (tensor$ f$ m2$ m3$) (modulo$ ?v1 (size$ (tensor$ f$ m2$ m3$)))) (modulo$ ?v0 (row_length$ (tensor$ f$ m2$ m3$)))) (fun_app$ (fun_app$a f$ (nth$ (nth$a m2$ (modulo$ (divide$ ?v1 (size$ m3$)) (size$ m2$))) (modulo$ (divide$ ?v0 (row_length$ m3$)) (row_length$ m2$)))) (nth$ (nth$a m3$ (modulo$ ?v1 (size$ m3$))) (modulo$ ?v0 (row_length$ m3$))))))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ ?v0 (times$ (times$ (row_length$ m1$) (row_length$ m2$)) (row_length$ m3$))) (less$ ?v1 (times$ (times$ (size$ m1$) (size$ m2$)) (size$ m3$)))) (= (nth$ (nth$a (tensor$ f$ m1$ (tensor$ f$ m2$ m3$)) ?v1) ?v0) (fun_app$ (fun_app$a f$ (nth$ (nth$a m1$ (divide$ ?v1 (size$ (tensor$ f$ m2$ m3$)))) (divide$ ?v0 (row_length$ (tensor$ f$ m2$ m3$))))) (nth$ (nth$a (tensor$ f$ m2$ m3$) (modulo$ ?v1 (size$ (tensor$ f$ m2$ m3$)))) (modulo$ ?v0 (row_length$ (tensor$ f$ m2$ m3$)))))))) :named a2))
(check-sat)
(get-proof)
