; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun x$ () A_list$)
(declare-fun y$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (less$ i$ (size$ (vec_vec_Tensor$ f$ nil$ y$))) (= (nth$ (vec_vec_Tensor$ f$ x$ y$) i$) (fun_app$ (fun_app$a f$ (nth$ x$ (divide$ i$ (size$ y$)))) (nth$ y$ (modulo$ i$ (size$ y$))))))) :named conjecture0))
(assert (! (=> (less$ i$ (size$ (vec_vec_Tensor$ f$ nil$ y$))) false) :named a1))
(check-sat)
(get-proof)
