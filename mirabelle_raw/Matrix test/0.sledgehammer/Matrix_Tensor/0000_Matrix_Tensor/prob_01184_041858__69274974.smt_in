; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 240
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun nat$ (Int) Nat$)
(declare-fun one$ () Nat$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (= one$ (nat$ (of_nat$ one$)))) :named conjecture0))
(assert (! (= (of_nat$a one$) one$) :named a1))
(assert (! (= (of_nat$ one$) 1) :named a2))
(assert (! (= one$ (nat$ 1)) :named a3))
(assert (! (= zero$ (nat$ 0)) :named a4))
(check-sat)
(get-proof)
