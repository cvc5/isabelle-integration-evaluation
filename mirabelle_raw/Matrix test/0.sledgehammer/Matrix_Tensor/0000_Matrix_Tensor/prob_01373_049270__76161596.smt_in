(assert (! (not (=> (and (and (less$ i$ (times$ (row_length$ (cons$ a$ nil$)) (size$ v$))) (less$ j$ (size$a (cons$ a$ nil$)))) (mat$ (row_length$ (cons$ a$ nil$)) (size$a (cons$ a$ nil$)) (cons$ a$ nil$))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ a$ nil$)) j$) i$) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ a$ nil$))))) (nth$ (nth$a (cons$ a$ nil$) j$) (modulo$ i$ (row_length$ (cons$ a$ nil$)))))))) :named conjecture0))
(assert (! (= (less$ j$ (size$a (cons$ a$ nil$))) (= j$ zero$)) :named a1))
(assert (! (=> (and (= j$ zero$) (and (and (less$ i$ (times$ (row_length$ (cons$ a$ ma$)) (size$ v$))) (less$ j$ (size$a (cons$ a$ ma$)))) (mat$ (row_length$ (cons$ a$ ma$)) (size$a (cons$ a$ ma$)) (cons$ a$ ma$)))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ a$ ma$)) j$) i$) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ a$ ma$))))) (nth$ (nth$a (cons$ a$ ma$) j$) (modulo$ i$ (row_length$ (cons$ a$ ma$))))))) :named a2))
