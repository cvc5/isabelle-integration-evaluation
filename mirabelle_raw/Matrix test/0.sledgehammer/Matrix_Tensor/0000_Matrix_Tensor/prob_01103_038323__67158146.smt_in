; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 300
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (= i$ (size$ y$)) (= (nth$ (vec_vec_Tensor$ f$ (cons$ z$ zs$) y$) i$) (nth$ (vec_vec_Tensor$ f$ zs$ y$) zero$)))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 Nat$) (?v2 A$) (?v3 A_list$)) (=> (less_eq$ (size$ ?v0) ?v1) (= (nth$ (vec_vec_Tensor$ f$ (cons$ ?v2 ?v3) ?v0) ?v1) (nth$ (vec_vec_Tensor$ f$ ?v3 ?v0) (fun_app$ (minus$ ?v1) (size$ ?v0)))))) :named a1))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (fun_app$ (minus$ ?v0) ?v1) zero$) (less_eq$ ?v0 ?v1))) :named a3))
(check-sat)
(get-proof)
