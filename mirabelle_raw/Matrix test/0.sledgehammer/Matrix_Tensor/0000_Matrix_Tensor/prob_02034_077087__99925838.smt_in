; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 251
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_b_fun$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_b_list_fun$ 0)
(declare-sort B_list_b_fun$ 0)
(declare-sort B_list_b_list_fun$ 0)
(declare-sort B_list_b_list_list_fun$ 0)
(declare-sort B_list_list_b_list_fun$ 0)
(declare-sort B_list_list_b_list_list_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun uu$ (Nat$) B_list_b_fun$)
(declare-fun map$ (B_list_b_fun$) B_list_list_b_list_fun$)
(declare-fun nil$ () B_list_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun row$ (B_list_list$ Nat$) B_list$)
(declare-fun map$a (B_list_b_list_fun$) B_list_list_b_list_list_fun$)
