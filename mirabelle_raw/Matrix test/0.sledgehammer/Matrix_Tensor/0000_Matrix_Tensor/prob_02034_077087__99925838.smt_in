(declare-fun map$c (B_b_fun$) B_list_b_list_fun$)
(declare-fun nil$a () B_list$)
(declare-fun fun_app$ (B_list_b_fun$ B_list$) B$)
(declare-fun fun_app$a (B_list_list_b_list_fun$ B_list_list$) B_list$)
(declare-fun fun_app$b (B_list_list_b_list_list_fun$ B_list_list$) B_list_list$)
(declare-fun fun_app$c (B_list_b_list_list_fun$ B_list$) B_list_list$)
(declare-fun fun_app$d (B_list_b_list_fun$ B_list$) B_list$)
(assert (! (forall ((?v0 Nat$) (?v1 B_list$)) (! (= (fun_app$ (uu$ ?v0) ?v1) (nth$ ?v1 ?v0)) :pattern ((fun_app$ (uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (= (row$ nil$ i$) nil$a)) :named conjecture1))
(assert (! (forall ((?v0 B_list_list$) (?v1 Nat$)) (= (row$ ?v0 ?v1) (fun_app$a (map$ (uu$ ?v1)) ?v0))) :named a2))
(assert (! (forall ((?v0 B_list_b_list_fun$)) (! (= (fun_app$b (map$a ?v0) nil$) nil$) :pattern ((map$a ?v0)))) :named a3))
(assert (! (forall ((?v0 B_list_b_fun$)) (! (= (fun_app$a (map$ ?v0) nil$) nil$a) :pattern ((map$ ?v0)))) :named a4))
(assert (! (forall ((?v0 B_b_list_fun$)) (! (= (fun_app$c (map$b ?v0) nil$a) nil$) :pattern ((map$b ?v0)))) :named a5))
(assert (! (forall ((?v0 B_b_fun$)) (! (= (fun_app$d (map$c ?v0) nil$a) nil$a) :pattern ((map$c ?v0)))) :named a6))
(check-sat)
(get-proof)
