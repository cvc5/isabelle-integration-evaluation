; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun x$ () B$)
(declare-fun xs$ () B_list$)
(declare-fun nat$ (Int) Nat$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not (=> (less$ zero$ k$) (= (nth$ (cons$ x$ xs$) k$) (nth$ xs$ (nat$ (+ (of_nat$ k$) (- 1))))))) :named conjecture0))
(assert (! (=> (less$ zero$ k$) (= (nth$ (cons$ x$ xs$) k$) (nth$ xs$ (nat$ (+ (of_nat$ k$) (- 1)))))) :named a1))
(check-sat)
(get-proof)
