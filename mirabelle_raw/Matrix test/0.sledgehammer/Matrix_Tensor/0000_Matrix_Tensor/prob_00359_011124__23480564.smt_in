; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-sort A_list_list_list_list_list$ 0)
(declare-fun m$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list_list$)
(declare-fun nil$a () A_list_list_list_list_list$)
(declare-fun nil$b () A_list_list_list_list$)
(declare-fun nil$c () A_list_list_list$)
(declare-fun nil$d () A_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun concat$ (A_list_list_list_list_list$) A_list_list_list_list$)
(declare-fun concat$a (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$b (A_list_list_list$) A_list_list$)
(declare-fun concat$c (A_list_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ (row_length$ m$) (size$ m$) m$)) :named conjecture0))
(assert (! (= (row_length$ m$) zero$) :named a1))
(assert (! (= (size$ m$) zero$) :named a2))
(assert (! (mat$ zero$ zero$ m$) :named a3))
(assert (! (= m$ nil$) :named a4))
(assert (! (= (concat$ nil$a) nil$b) :named a5))
(assert (! (= (concat$a nil$b) nil$c) :named a6))
(assert (! (= (concat$b nil$c) nil$) :named a7))
(assert (! (= (concat$c nil$) nil$d) :named a8))
(check-sat)
(get-proof)
