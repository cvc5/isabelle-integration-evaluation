; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 238
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun m$ () Nat$)
(declare-fun n$ () Nat$)
(declare-fun x$ () A_list$)
(declare-fun y$ () A_list$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(assert (! (not (= (times$ (size$ x$) (size$ y$)) (times$ m$ n$))) :named conjecture0))
(assert (! (vec$ n$ y$) :named a1))
(assert (! (vec$ m$ x$) :named a2))
(check-sat)
(get-proof)
