; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 620
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun a1$ () A_list_list$)
(declare-fun a2$ () A_list_list$)
(declare-fun b1$ () A_list_list$)
(declare-fun b2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () A_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ (fun_app$ (modulo$ j$) (size$ b2$)) (size$ b2$))) :named conjecture0))
(assert (! (less$ j$ (times$ (size$ a2$) (size$ b2$))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (=> (less$ ?v0 ?v1) (= (fun_app$ (modulo$ ?v0) ?v1) ?v0)) :pattern ((fun_app$ (modulo$ ?v0) ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (modulo$ (fun_app$ (modulo$ ?v0) ?v1)) ?v1) (fun_app$ (modulo$ ?v0) ?v1))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 ?v1) (less$ (minus$ ?v0 ?v2) ?v1))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (less$ ?v0 ?v1) (less$ ?v0 ?v2)) (less$ (minus$ ?v2 ?v1) (minus$ ?v2 ?v0)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (modulo$ ?v0) ?v1) (ite (less$ ?v0 ?v1) ?v0 (fun_app$ (modulo$ (minus$ ?v0 ?v1)) ?v1)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (not (= ?v0 ?v1)) (and (=> (less$ ?v0 ?v1) false) (=> (less$ ?v1 ?v0) false))) false)) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ ?v0 (times$ ?v1 (divide$ ?v0 ?v1))) (fun_app$ (modulo$ ?v0) ?v1))) :named a8))
(assert (! (and (not (= a1$ nil$)) (and (not (= a2$ nil$)) (and (not (= b1$ nil$)) (not (= b2$ nil$))))) :named a9))
(assert (! (= (row_length$ (cons$ nil$a nil$)) zero$) :named a10))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (modulo$ ?v0) ?v0) zero$) :pattern ((modulo$ ?v0)))) :named a11))
(assert (! (forall ((?v0 Nat$)) (= (less$ ?v0 zero$) false)) :named a12))
(assert (! (forall ((?v0 A_list$)) (= (= (size$a ?v0) zero$) (= ?v0 nil$a))) :named a13))
(assert (! (forall ((?v0 A_list_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a14))
(check-sat)
(get-proof)
