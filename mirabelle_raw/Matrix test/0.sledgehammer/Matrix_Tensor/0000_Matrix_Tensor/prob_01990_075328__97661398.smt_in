; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 242
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun k$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (nth$ m$ k$) (nth$ (cons$ v$ m$) (fun_app$ (plus$ k$) one$)))) :named conjecture0))
(assert (! (less$ k$ (size$ m$)) :named hypothesis1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (fun_app$ suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (fun_app$ suc$ ?v2))))) :named a3))
(assert (! (= (plus$ one$) suc$) :named a4))
(assert (! (= (size$ nil$) zero$) :named a5))
(check-sat)
(get-proof)
