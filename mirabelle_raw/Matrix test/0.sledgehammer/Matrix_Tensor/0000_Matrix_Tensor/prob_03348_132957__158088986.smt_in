; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-sort B_b_prod$ 0)
(declare-sort B_c_prod$ 0)
(declare-sort C_b_prod$ 0)
(declare-sort C_c_prod$ 0)
(declare-sort B_b_prod_list$ 0)
(declare-sort B_c_prod_list$ 0)
(declare-sort C_b_prod_list$ 0)
(declare-sort C_c_prod_list$ 0)
(declare-sort B_b_c_prod_prod$ 0)
(declare-sort B_c_c_prod_prod$ 0)
(declare-sort B_c_prod_b_prod$ 0)
(declare-sort B_c_prod_c_prod$ 0)
(declare-sort C_b_c_prod_prod$ 0)
(declare-sort B_b_c_prod_prod_list$ 0)
(declare-sort B_c_c_prod_prod_list$ 0)
(declare-sort B_c_prod_b_prod_list$ 0)
(declare-sort B_c_prod_c_prod_list$ 0)
(declare-sort C_b_c_prod_prod_list$ 0)
(declare-sort B_c_prod_b_c_prod_prod$ 0)
(declare-sort B_c_prod_b_c_prod_prod_list$ 0)
(declare-fun a$ () B$)
(declare-fun b$ () C$)
(declare-fun v$ () B_list$)
(declare-fun w$ () C_list$)
(declare-fun zip$ (B_list$ C_list$) B_c_prod_list$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun pair$ (B$ C$) B_c_prod$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun zip$a (B_list$ B_list$) B_b_prod_list$)
(declare-fun zip$b (C_list$ B_list$) C_b_prod_list$)
(declare-fun zip$c (C_list$ C_list$) C_c_prod_list$)
(declare-fun zip$d (B_list$ B_c_prod_list$) B_b_c_prod_prod_list$)
(declare-fun zip$e (C_list$ B_c_prod_list$) C_b_c_prod_prod_list$)
(declare-fun zip$f (B_c_prod_list$ B_list$) B_c_prod_b_prod_list$)
(declare-fun zip$g (B_c_prod_list$ C_list$) B_c_prod_c_prod_list$)
(declare-fun zip$h (B_c_prod_list$ B_c_prod_list$) B_c_prod_b_c_prod_prod_list$)
(declare-fun zip$i (B_list$ C_c_prod_list$) B_c_c_prod_prod_list$)
(declare-fun cons$a (C$ C_list$) C_list$)
(declare-fun cons$b (B_c_prod$ B_c_prod_list$) B_c_prod_list$)
(declare-fun cons$c (B_b_prod$ B_b_prod_list$) B_b_prod_list$)
(declare-fun cons$d (C_b_prod$ C_b_prod_list$) C_b_prod_list$)
(declare-fun cons$e (C_c_prod$ C_c_prod_list$) C_c_prod_list$)
(declare-fun cons$f (B_b_c_prod_prod$ B_b_c_prod_prod_list$) B_b_c_prod_prod_list$)
(declare-fun cons$g (C_b_c_prod_prod$ C_b_c_prod_prod_list$) C_b_c_prod_prod_list$)
(declare-fun cons$h (B_c_prod_b_prod$ B_c_prod_b_prod_list$) B_c_prod_b_prod_list$)
(declare-fun cons$i (B_c_prod_c_prod$ B_c_prod_c_prod_list$) B_c_prod_c_prod_list$)
(declare-fun cons$j (B_c_prod_b_c_prod_prod$ B_c_prod_b_c_prod_prod_list$) B_c_prod_b_c_prod_prod_list$)
(declare-fun cons$k (B_c_c_prod_prod$ B_c_c_prod_prod_list$) B_c_c_prod_prod_list$)
(declare-fun pair$a (B$ B$) B_b_prod$)
(declare-fun pair$b (C$ B$) C_b_prod$)
(declare-fun pair$c (C$ C$) C_c_prod$)
(declare-fun pair$d (B$ B_c_prod$) B_b_c_prod_prod$)
(declare-fun pair$e (C$ B_c_prod$) C_b_c_prod_prod$)
(declare-fun pair$f (B_c_prod$ B$) B_c_prod_b_prod$)
(declare-fun pair$g (B_c_prod$ C$) B_c_prod_c_prod$)
(declare-fun pair$h (B_c_prod$ B_c_prod$) B_c_prod_b_c_prod_prod$)
(declare-fun pair$i (B$ C_c_prod$) B_c_c_prod_prod$)
(declare-fun size$a (C_list$) Nat$)
(assert (! (not (= (zip$ (cons$ a$ v$) (cons$a b$ w$)) (cons$b (pair$ a$ b$) (zip$ v$ w$)))) :named conjecture0))
(assert (! (= (size$ v$) (size$a w$)) :named hypothesis1))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 B$) (?v3 B_list$)) (! (= (zip$a (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (cons$c (pair$a ?v0 ?v2) (zip$a ?v1 ?v3))) :pattern ((zip$a (cons$ ?v0 ?v1) (cons$ ?v2 ?v3))))) :named a2))
(assert (! (forall ((?v0 C$) (?v1 C_list$) (?v2 B$) (?v3 B_list$)) (! (= (zip$b (cons$a ?v0 ?v1) (cons$ ?v2 ?v3)) (cons$d (pair$b ?v0 ?v2) (zip$b ?v1 ?v3))) :pattern ((zip$b (cons$a ?v0 ?v1) (cons$ ?v2 ?v3))))) :named a3))
(assert (! (forall ((?v0 C$) (?v1 C_list$) (?v2 C$) (?v3 C_list$)) (! (= (zip$c (cons$a ?v0 ?v1) (cons$a ?v2 ?v3)) (cons$e (pair$c ?v0 ?v2) (zip$c ?v1 ?v3))) :pattern ((zip$c (cons$a ?v0 ?v1) (cons$a ?v2 ?v3))))) :named a4))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 C$) (?v3 C_list$)) (! (= (zip$ (cons$ ?v0 ?v1) (cons$a ?v2 ?v3)) (cons$b (pair$ ?v0 ?v2) (zip$ ?v1 ?v3))) :pattern ((zip$ (cons$ ?v0 ?v1) (cons$a ?v2 ?v3))))) :named a5))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 B_c_prod$) (?v3 B_c_prod_list$)) (! (= (zip$d (cons$ ?v0 ?v1) (cons$b ?v2 ?v3)) (cons$f (pair$d ?v0 ?v2) (zip$d ?v1 ?v3))) :pattern ((zip$d (cons$ ?v0 ?v1) (cons$b ?v2 ?v3))))) :named a6))
(assert (! (forall ((?v0 C$) (?v1 C_list$) (?v2 B_c_prod$) (?v3 B_c_prod_list$)) (! (= (zip$e (cons$a ?v0 ?v1) (cons$b ?v2 ?v3)) (cons$g (pair$e ?v0 ?v2) (zip$e ?v1 ?v3))) :pattern ((zip$e (cons$a ?v0 ?v1) (cons$b ?v2 ?v3))))) :named a7))
(assert (! (forall ((?v0 B_c_prod$) (?v1 B_c_prod_list$) (?v2 B$) (?v3 B_list$)) (! (= (zip$f (cons$b ?v0 ?v1) (cons$ ?v2 ?v3)) (cons$h (pair$f ?v0 ?v2) (zip$f ?v1 ?v3))) :pattern ((zip$f (cons$b ?v0 ?v1) (cons$ ?v2 ?v3))))) :named a8))
(assert (! (forall ((?v0 B_c_prod$) (?v1 B_c_prod_list$) (?v2 C$) (?v3 C_list$)) (! (= (zip$g (cons$b ?v0 ?v1) (cons$a ?v2 ?v3)) (cons$i (pair$g ?v0 ?v2) (zip$g ?v1 ?v3))) :pattern ((zip$g (cons$b ?v0 ?v1) (cons$a ?v2 ?v3))))) :named a9))
(assert (! (forall ((?v0 B_c_prod$) (?v1 B_c_prod_list$) (?v2 B_c_prod$) (?v3 B_c_prod_list$)) (! (= (zip$h (cons$b ?v0 ?v1) (cons$b ?v2 ?v3)) (cons$j (pair$h ?v0 ?v2) (zip$h ?v1 ?v3))) :pattern ((zip$h (cons$b ?v0 ?v1) (cons$b ?v2 ?v3))))) :named a10))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 C_c_prod$) (?v3 C_c_prod_list$)) (! (= (zip$i (cons$ ?v0 ?v1) (cons$e ?v2 ?v3)) (cons$k (pair$i ?v0 ?v2) (zip$i ?v1 ?v3))) :pattern ((zip$i (cons$ ?v0 ?v1) (cons$e ?v2 ?v3))))) :named a11))
(check-sat)
(get-proof)
