; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 245
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_a_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun b1$ () A_list_list$)
(declare-fun b2$ () A_list_list$)
(declare-fun uu$ (Nat$) A_list_a_fun$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun map$ (A_list_a_fun$ A_list_list$) A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_list_a_fun$ A_list$) A$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (fun_app$ (uu$ ?v0) ?v1) (nth$ ?v1 ?v0)) :pattern ((fun_app$ (uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (= (size$ (row$ b1$ (modulo$ i$ (row_length$ b1$)))) (size$ (col$ b2$ (modulo$ j$ (size$a b2$)))))) :named conjecture1))
(assert (! (= (size$ (col$ b2$ (modulo$ j$ (size$a b2$)))) (row_length$ b2$)) :named a2))
(assert (! (= (size$a b1$) (row_length$ b2$)) :named a3))
(assert (! (forall ((?v0 A_list_list$) (?v1 Nat$)) (= (row$ ?v0 ?v1) (map$ (uu$ ?v1) ?v0))) :named a4))
(check-sat)
(get-proof)
