(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (=> (mat$ ?v0 ?v1 ?v2) (mat$ ?v1 ?v0 (transpose$a ?v0 ?v2)))) :named a7))
(assert (! (forall ((?v0 A_list_list$) (?v1 Nat$)) (! (= (col$ ?v0 ?v1) (nth$ ?v0 ?v1)) :pattern ((col$ ?v0 ?v1)))) :named a8))
