(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$) (?v3 Nat$)) (=> (and (mat$ ?v0 ?v1 ?v2) (less$ ?v3 ?v0)) (vec$ ?v1 (row$a ?v2 ?v3)))) :named a10))
