; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (less$ i$ (size$ (times$ f$ z$ y$))) (= (nth$ (append$ (times$ f$ z$ y$) (vec_vec_Tensor$ f$ zs$ y$)) i$) (nth$ (times$ f$ z$ y$) i$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$) (?v2 A_list$)) (=> (less$ ?v0 (size$ ?v1)) (= (nth$ (append$ ?v1 ?v2) ?v0) (nth$ ?v1 ?v0)))) :named a1))
(check-sat)
(get-proof)
