; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A$)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun nr$ () Nat$)
(declare-fun w1$ () A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun cons$a (A_list$ A_list_list$) A_list_list$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ i$ (times$ (size$ v$) (size$ w$)))) :named conjecture0))
(assert (! (not (= w$ nil$)) :named a1))
(assert (! (= w$ (cons$ a$ w1$)) :named a2))
(assert (! (= (row_length$ (cons$a w$ n$)) (size$ w$)) :named a3))
(assert (! (and (less$ i$ (times$ (size$ v$) (row_length$ (cons$a w$ n$)))) (mat$ nr$ (size$a (cons$a w$ n$)) (cons$a w$ n$))) :named a4))
(assert (! (= n$ nil$a) :named a5))
(check-sat)
(get-proof)
