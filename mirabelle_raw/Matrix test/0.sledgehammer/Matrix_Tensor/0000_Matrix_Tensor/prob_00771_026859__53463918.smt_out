unsat
(assume conjecture71 (! (not (=> (! (fun_app$j (fun_app$m less$ i$) (fun_app$s size$g nil$)) :named @p_1) (= (fun_app$ad (nth$d (fun_app$bc (fun_app$bd (times$ f$) a$) nil$a)) i$) (fun_app$be (fun_app$bf f$ a$) (fun_app$ad (nth$d nil$a) i$))))) :named @p_2))
(assume a72 (! (=> @p_1 false) :named @p_3))
