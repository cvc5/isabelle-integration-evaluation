(declare-sort A_a_prod_a_a_prod_a_a_prod_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun a1$ () A$)
(declare-fun a2$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun u2$ () A_list$)
(declare-fun v1$ () A_list$)
(declare-fun v2$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun zip$ (A_list$ A_list$) A_a_prod_list$)
(declare-fun cons$ (A_a_prod$ A_a_prod_list$) A_a_prod_list$)
(declare-fun pair$ (A$ A$) A_a_prod$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun fun_app$b (A_a_prod_a_a_prod_fun$ A_a_prod$) A_a_prod$)
(declare-fun fun_app$c (A_a_prod_a_a_prod_a_a_prod_fun_fun$ A_a_prod$) A_a_prod_a_a_prod_fun$)
(declare-fun scalar_prodI$ (A$ A_a_a_fun_fun$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(declare-fun scalar_prodI$a (A_a_prod$ A_a_prod_a_a_prod_a_a_prod_fun_fun$ A_a_prod_a_a_prod_a_a_prod_fun_fun$ A_a_prod_list$ A_a_prod_list$) A_a_prod$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ v1$ v2$) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ a1$) a2$)) (scalar_product$ f$ zer$ g$ u1$ u2$)))) :named conjecture0))
(assert (! (= (zip$ v1$ v2$) (cons$ (pair$ a1$ a2$) (zip$ u1$ u2$))) :named a1))
(assert (! (and (= v1$ (cons$a a1$ u1$)) (= (size$ u1$) k$)) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (! (= (scalar_product$ f$ zer$ g$ ?v0 ?v1) (scalar_prodI$ zer$ g$ f$ ?v0 ?v1)) :pattern ((scalar_product$ f$ zer$ g$ ?v0 ?v1)))) :named a3))
(assert (! (and (= v2$ (cons$a a2$ u2$)) (= (size$ u2$) k$)) :named a4))
(assert (! (forall ((?v0 A_a_prod$) (?v1 A_a_prod_a_a_prod_a_a_prod_fun_fun$) (?v2 A_a_prod_a_a_prod_a_a_prod_fun_fun$) (?v3 A_a_prod$) (?v4 A_a_prod_list$) (?v5 A_a_prod$) (?v6 A_a_prod_list$)) (! (= (scalar_prodI$a ?v0 ?v1 ?v2 (cons$ ?v3 ?v4) (cons$ ?v5 ?v6)) (fun_app$b (fun_app$c ?v1 (fun_app$b (fun_app$c ?v2 ?v3) ?v5)) (scalar_prodI$a ?v0 ?v1 ?v2 ?v4 ?v6))) :pattern ((scalar_prodI$a ?v0 ?v1 ?v2 (cons$ ?v3 ?v4) (cons$ ?v5 ?v6))))) :named a5))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A_a_a_fun_fun$) (?v3 A$) (?v4 A_list$) (?v5 A$) (?v6 A_list$)) (! (= (scalar_prodI$ ?v0 ?v1 ?v2 (cons$a ?v3 ?v4) (cons$a ?v5 ?v6)) (fun_app$ (fun_app$a ?v1 (fun_app$ (fun_app$a ?v2 ?v3) ?v5)) (scalar_prodI$ ?v0 ?v1 ?v2 ?v4 ?v6))) :pattern ((scalar_prodI$ ?v0 ?v1 ?v2 (cons$a ?v3 ?v4) (cons$a ?v5 ?v6))))) :named a6))
(check-sat)
(get-proof)
