unsat
(assume conjecture4 (! (not (! (= (! (fun_app$h size$ v1$) :named @p_1) (fun_app$i suc$ k$)) :named @p_2)) :named @p_3))
(assume a5 (! (and (= @p_1 (fun_app$h size$ v2$)) (! (and @p_2 (= (fun_app$h size$ w1$) (fun_app$h size$ w2$))) :named @p_4)) :named @p_5))
(step t0 (cl @p_4) :rule and :premises (a5) :args (1))
(step t1 (cl @p_2) :rule and :premises (t0) :args (0))
(step t2 (cl) :rule resolution :premises (t1 conjecture4))
