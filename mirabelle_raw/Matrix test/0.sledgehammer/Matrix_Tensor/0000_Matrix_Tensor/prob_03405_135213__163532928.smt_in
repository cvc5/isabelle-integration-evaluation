; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun x$ () A$)
(declare-fun y$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun u2$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ x$) y$)) (scalar_product$ f$ zer$ g$ u1$ u2$)) (scalar_product$ f$ zer$ g$ (times$ f$ x$ u1$) (times$ f$ y$ u2$)))) :named conjecture0))
(assert (! (and (= (size$ u1$) (size$ u2$)) (= (size$ u1$) k$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (=> (and (= (size$ ?v0) (size$ ?v1)) (= (size$ ?v0) k$)) (= (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ x$) y$)) (scalar_product$ f$ zer$ g$ ?v0 ?v1)) (scalar_product$ f$ zer$ g$ (times$ f$ x$ ?v0) (times$ f$ y$ ?v1))))) :named a2))
(check-sat)
(get-proof)
