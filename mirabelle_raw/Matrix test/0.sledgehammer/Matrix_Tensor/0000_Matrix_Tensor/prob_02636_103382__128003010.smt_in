; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 286
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun m1$ () A_list_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun m3$ () A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (forall ((?v0 Nat$)) (=> (less$ ?v0 (times$ (times$ (size$ m1$) (size$ m2$)) (size$ m3$))) (less$ (modulo$ ?v0 (size$ (tensor$ f$ m2$ m3$))) (size$ (tensor$ f$ m2$ m3$)))))) :named conjecture0))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (size$ (tensor$ f$ ?v0 ?v1)) (times$ (size$ ?v0) (size$ ?v1)))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (less_eq$ ?v0 ?v1)) (less$ ?v1 ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ ?v0 ?v1) (ite (less$ ?v0 ?v1) ?v0 (modulo$ (minus$ ?v0 ?v1) ?v1)))) :named a5))
(check-sat)
(get-proof)
