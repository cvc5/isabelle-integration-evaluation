; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 272
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_list_a_list_list_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun fun_app$ (A_list_list_a_list_list_fun$ A_list_list$) A_list_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$) A_list_list_a_list_list_fun$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (fun_app$ (vec_mat_Tensor$ f$ v$) (cons$ a$ ma$)) (cons$ (vec_vec_Tensor$ f$ v$ a$) nil$))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_list$)) (! (= (fun_app$ (vec_mat_Tensor$ f$ ?v0) (cons$ ?v1 ?v2)) (cons$ (vec_vec_Tensor$ f$ ?v0 ?v1) (fun_app$ (vec_mat_Tensor$ f$ ?v0) ?v2))) :pattern ((fun_app$ (vec_mat_Tensor$ f$ ?v0) (cons$ ?v1 ?v2))))) :named a1))
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ (vec_mat_Tensor$ f$ ?v0) nil$) nil$) :pattern ((vec_mat_Tensor$ f$ ?v0)))) :named a2))
(check-sat)
(get-proof)
