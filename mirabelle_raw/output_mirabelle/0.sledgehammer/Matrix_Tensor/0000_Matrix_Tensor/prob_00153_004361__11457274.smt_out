unsat
(assume conjecture1 (! (not (! (= nc$ zero$) :named @p_1)) :named @p_2))
(assume a2 (! (= (! (size$ m$) :named @p_3) nc$) :named @p_4))
(assume a7 (! (= m$ nil$) :named @p_5))
(assume a11 (! (= (! (size$ nil$) :named @p_6) zero$) :named @p_7))
(step t0 (cl (not (! (= @p_2 false) :named @p_8)) (not @p_2) false) :rule equiv_pos2)
(step t1 (cl (= nc$ @p_3)) :rule symm :premises (a2))
(step t2 (cl (= @p_3 @p_6)) :rule cong :premises (a7))
(step t3 (cl (= nc$ @p_6)) :rule trans :premises (t1 t2))
(step t4 (cl (= zero$ @p_6)) :rule symm :premises (a11))
(step t5 (cl (= @p_1 (! (= @p_6 @p_6) :named @p_9))) :rule cong :premises (t3 t4))
(step t6 (cl (= @p_2 (! (not @p_9) :named @p_10))) :rule cong :premises (t5))
(step t7 (cl (= @p_9 true)) :rule rare_rewrite :args ("eq-refl" @p_6))
(step t8 (cl (= @p_10 (! (not true) :named @p_11))) :rule cong :premises (t7))
(step t9 (cl (= @p_11 false)) :rule evaluate)
(step t10 (cl (= @p_10 false)) :rule trans :premises (t8 t9))
(step t11 (cl @p_8) :rule trans :premises (t6 t10))
(step t12 (cl false) :rule resolution :premises (t0 t11 conjecture1))
(step t13 (cl (not false)) :rule false)
(step t14 (cl) :rule resolution :premises (t12 t13))
