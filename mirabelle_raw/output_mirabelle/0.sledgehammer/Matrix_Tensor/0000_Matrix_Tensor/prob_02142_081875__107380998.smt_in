; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 225
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun n1$ () A_list_list$)
(declare-fun w1$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (times$ (size$ v$) (row_length$ (cons$ w$ n$))) zero$)) :named conjecture0))
(assert (! (= w$ nil$) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$a) zero$ (size$ (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a3))
(assert (! (= n$ (cons$ w1$ n1$)) :named a4))
(assert (! (= (size$a nil$a) zero$) :named a5))
(assert (! (= (size$ nil$) zero$) :named a6))
(check-sat)
(get-proof)
