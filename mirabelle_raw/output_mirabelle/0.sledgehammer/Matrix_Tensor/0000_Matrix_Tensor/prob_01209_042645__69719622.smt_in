; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 240
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun x$ () B$)
(declare-fun xs$ () B_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(assert (! (not (= (nth$ (cons$ x$ xs$) (plus$ k$ one$)) (nth$ xs$ k$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (= (suc$ ?v0) (plus$ ?v0 one$))) :named a1))
(assert (! (= one$ (suc$ zero$)) :named a2))
(check-sat)
(get-proof)
