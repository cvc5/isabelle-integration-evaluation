; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun v$ () A_list$)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun hd$a (A_list$) A$)
(declare-fun nil$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ (cons$ v$ nil$)) (size$ v$))) :named conjecture0))
(assert (! (= (size$a nil$) zero$) :named a1))
(assert (! (= (size$ nil$a) zero$) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A$) (?v3 A_list$)) (= (= (cons$a ?v0 ?v1) (cons$a ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list$) (?v3 A_list_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a4))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$ (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a5))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (hd$a (cons$a ?v0 ?v1)) ?v0) :pattern ((cons$a ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (hd$ (cons$ ?v0 ?v1)) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (not (= (cons$a ?v0 ?v1) ?v1))) :named a8))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= (cons$ ?v0 ?v1) ?v1))) :named a9))
(assert (! (forall ((?v0 A_list$)) (= (not (= ?v0 nil$a)) (exists ((?v1 A$) (?v2 A_list$)) (= ?v0 (cons$a ?v1 ?v2))))) :named a10))
(assert (! (forall ((?v0 A_list_list$)) (= (not (= ?v0 nil$)) (exists ((?v1 A_list$) (?v2 A_list_list$)) (= ?v0 (cons$ ?v1 ?v2))))) :named a11))
(check-sat)
(get-proof)
