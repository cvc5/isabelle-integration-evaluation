unsat
(assume conjecture0 (! (not (! (= c$ zero$) :named @p_1)) :named @p_2))
(assume a1 (! (or (! (= b$ zero$) :named @p_3) @p_1) :named @p_4))
(assume a2 (! (not @p_3) :named @p_5))
(step t0 (cl @p_3 @p_1) :rule or :premises (a1))
(step t1 (cl @p_3) :rule resolution :premises (t0 conjecture0))
(step t2 (cl) :rule resolution :premises (t1 a2))
