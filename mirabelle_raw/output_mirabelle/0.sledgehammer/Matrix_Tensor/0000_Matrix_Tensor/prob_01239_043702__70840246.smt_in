; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 225
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun n$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$ A_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (and (mat$ (row_length$ (cons$ a$ (cons$ b$ n$))) (size$ (cons$ a$ (cons$ b$ n$))) (cons$ a$ (cons$ b$ n$))) (member$ b$ (set$ (cons$ a$ (cons$ b$ n$))))) (vec$ (row_length$ (cons$ a$ (cons$ b$ n$))) b$))) :named conjecture0))
