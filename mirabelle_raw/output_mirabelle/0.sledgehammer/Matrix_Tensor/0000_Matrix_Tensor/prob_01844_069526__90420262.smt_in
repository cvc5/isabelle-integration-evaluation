; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 216
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun y$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun zero$ () Nat$)
(assert (! (not false) :named conjecture0))
(assert (! (=> (= y$ one$) false) :named a1))
(assert (! (or (= y$ zero$) (= y$ one$)) :named a2))
(check-sat)
(get-proof)
