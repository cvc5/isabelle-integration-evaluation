; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun divide$ (Int Int) Int)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun divide$a (Nat$ Nat$) Nat$)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (= (divide$ (of_nat$ a$) (of_nat$ b$)) (+ (divide$ (- (of_nat$ a$) (of_nat$ b$)) (of_nat$ b$)) 1))) :named conjecture0))
(assert (! (< (of_nat$ b$) (of_nat$ a$)) :named a1))
(assert (! (< 0 (of_nat$ b$)) :named a2))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (and (< 0 ?v0) (<= ?v0 ?v1)) (= (divide$ ?v1 ?v0) (+ (divide$ (- ?v1 ?v0) ?v0) 1)))) :named a3))
(assert (! (less$ zero$ b$) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$a (plus$ ?v0 ?v1) ?v0) (plus$ (divide$a ?v1 ?v0) one$)))) :named a5))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (not (= ?v0 0)) (= (divide$ (+ ?v0 ?v1) ?v0) (+ (divide$ ?v1 ?v0) 1)))) :named a6))
(assert (! (forall ((?v0 Nat$)) (= (not (less$ zero$ ?v0)) (= ?v0 zero$))) :named a7))
(assert (! (forall ((?v0 Nat$)) (= (= (of_nat$a ?v0) zero$) (= ?v0 zero$))) :named a8))
(assert (! (forall ((?v0 Nat$)) (= (= (of_nat$ ?v0) 0) (= ?v0 zero$))) :named a9))
(check-sat)
(get-proof)
