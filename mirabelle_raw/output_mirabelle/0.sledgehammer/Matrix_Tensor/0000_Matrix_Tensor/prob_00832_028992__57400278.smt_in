; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 361
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () B_list$)
(declare-fun z$ () C$)
(declare-fun zs$ () C_list$)
(declare-fun nil$ () C_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (C$ C_list$) C_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () B_list$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (C_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (B$ B_list$) B_list$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(assert (! (not (=> (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$a y$))) (less$ (minus$ i$ (size$a y$)) (times$ (size$ zs$) (size$a y$))))) :named conjecture0))
(assert (! (less$ (size$a y$) i$) :named a1))
(assert (! (forall ((?v0 C$) (?v1 C_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (size$a (cons$a ?v0 ?v1)) (plus$ (size$a ?v1) (suc$ zero$))) :pattern ((cons$a ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ ?v0 ?v1) (=> (not false) (less$ ?v1 ?v0))) false)) :named a4))
(assert (! (= one$ (suc$ zero$)) :named a5))
(assert (! (forall ((?v0 C_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a6))
(assert (! (forall ((?v0 B_list$)) (= (= (size$a ?v0) zero$) (= ?v0 nil$a))) :named a7))
(assert (! (forall ((?v0 C_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a8))
(assert (! (forall ((?v0 B_list$)) (= (less$ zero$ (size$a ?v0)) (not (= ?v0 nil$a)))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ (suc$ ?v0) (suc$ ?v1)) (less$ ?v0 ?v1))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (less$ ?v0 ?v1) (less$ ?v1 ?v2)) (less$ ?v0 ?v2))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ zero$ ?v0) (= (less$ (divide$ ?v1 ?v0) ?v2) (less$ ?v1 (times$ ?v2 ?v0))))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 (times$ ?v1 ?v2)) (less$ (divide$ ?v0 ?v2) ?v1))) :named a13))
(assert (! (forall ((?v0 Nat$)) (= (suc$ ?v0) (plus$ ?v0 one$))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ ?v0 ?v1) (ite (or (less$ ?v0 ?v1) (= ?v1 zero$)) zero$ (suc$ (divide$ (minus$ ?v0 ?v1) ?v1))))) :named a15))
(check-sat)
(get-proof)
