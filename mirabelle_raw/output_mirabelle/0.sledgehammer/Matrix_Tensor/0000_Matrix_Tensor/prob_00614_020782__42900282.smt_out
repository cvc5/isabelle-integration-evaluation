unsat
(assume conjecture1 (! (not (! (fun_app$a (mat$ (row_length$ m2$) (size$ m2$)) m2$) :named @p_1)) :named @p_2))
(assume a2 (! (fun_app$a (mat$ (row_length$ (! (fun_app$b (fun_app$c append$ m1a$) m2$) :named @p_3)) (size$ @p_3)) @p_3) :named @p_4))
(assume a15 (! (=> @p_4 @p_1) :named @p_5))
(step t0 (cl (! (not @p_4) :named @p_6) @p_1) :rule implies :premises (a15))
(step t1 (cl @p_1 @p_6) :rule reordering :premises (t0))
(step t2 (cl) :rule resolution :premises (t1 a2 conjecture1))
