; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 252
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_prod$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_a_prod_list$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun a1$ () A$)
(declare-fun a2$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun u2$ () A_list$)
(declare-fun v1$ () A_list$)
(declare-fun v2$ () A_list$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun zip$ (A_list$ A_list$) A_a_prod_list$)
(declare-fun cons$ (A_a_prod$ A_a_prod_list$) A_a_prod_list$)
(declare-fun pair$ (A$ A$) A_a_prod$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (zip$ v1$ v2$) (cons$ (pair$ a1$ a2$) (zip$ u1$ u2$)))) :named conjecture0))
(assert (! (= (fun_app$ (fun_app$a f$ (scalar_product$ f$ zer$ g$ u1$ u2$)) (scalar_product$ f$ zer$ g$ w1$ w2$)) (scalar_product$ f$ zer$ g$ (vec_vec_Tensor$ f$ u1$ w1$) (vec_vec_Tensor$ f$ u2$ w2$))) :named a1))
(assert (! (and (= v1$ (cons$a a1$ u1$)) (= (size$ u1$) k$)) :named a2))
(assert (! (and (= v2$ (cons$a a2$ u2$)) (= (size$ u2$) k$)) :named a3))
(check-sat)
(get-proof)
