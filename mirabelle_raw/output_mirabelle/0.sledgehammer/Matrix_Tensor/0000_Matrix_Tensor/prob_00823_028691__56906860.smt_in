; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 246
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun xs$ () B_list$)
(declare-fun ys$ () B_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (B_list$) Nat$)
(declare-fun append$ (B_list$ B_list$) B_list$)
(assert (! (not (=> (less$ i$ (size$ xs$)) (= (nth$ (append$ xs$ ys$) i$) (nth$ xs$ i$)))) :named conjecture0))
(check-sat)
(get-proof)
