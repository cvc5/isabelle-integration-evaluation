; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 404
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (minus$ (times$ x$ b$) (times$ y$ b$)) (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ (times$ ?v0 ?v1) ?v2) ?v1) (modulo$ ?v2 ?v1))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ ?v0 (modulo$ ?v0 ?v1)) (times$ (divide$ ?v0 ?v1) ?v1))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (modulo$ ?v0 ?v1) (minus$ ?v0 (times$ (divide$ ?v0 ?v1) ?v1))) :pattern ((modulo$ ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= ?v0 (plus$ (times$ (divide$ ?v0 ?v1) ?v1) (modulo$ ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ (times$ ?v0 ?v1) ?v1) zero$)) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (= (divide$ (times$ ?v1 ?v0) ?v0) ?v1))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (modulo$ ?v0 ?v1) ?v0) (= (divide$ ?v0 ?v1) zero$))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (plus$ (times$ ?v1 ?v0) ?v2) ?v0) (plus$ ?v1 (divide$ ?v2 ?v0))))) :named a10))
(assert (! (and (less$ zero$ b$) (less$ zero$ c$)) :named a11))
(check-sat)
(get-proof)
