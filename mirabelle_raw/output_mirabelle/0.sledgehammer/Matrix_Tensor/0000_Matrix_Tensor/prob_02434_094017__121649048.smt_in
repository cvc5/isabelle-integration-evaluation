; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 309
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$) Nat_nat_fun$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (= (fun_app$ (minus$ (times$ x$ b$)) (times$ y$ b$)) (fun_app$ (minus$ (modulo$ (divide$ a$ c$) b$)) (divide$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (plus$ (times$ x$ b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a1))
(assert (! (= (divide$ a$ c$) (plus$ (times$ y$ b$) (modulo$ (divide$ a$ c$) b$))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a3))
(assert (! (= a$ (plus$ (times$ x$ (times$ b$ c$)) (modulo$ a$ (times$ b$ c$)))) :named a4))
(assert (! (and (less$ zero$ b$) (less$ zero$ c$)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ zero$ ?v0) (= (divide$ (times$ ?v1 ?v0) ?v0) ?v1))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (divide$ ?v0 (times$ ?v1 ?v2)) (divide$ (divide$ ?v0 ?v1) ?v2))) :named a7))
(assert (! (not (= (times$ b$ c$) zero$)) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (minus$ (plus$ ?v0 ?v1)) ?v0) ?v1)) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (minus$ (plus$ ?v0 ?v1)) ?v1) ?v0)) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (times$ ?v1 ?v0) ?v0) ?v1))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (minus$ ?v0) (modulo$ ?v0 ?v1)) (times$ (divide$ ?v0 ?v1) ?v1))) :named a12))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a13))
(check-sat)
(get-proof)
