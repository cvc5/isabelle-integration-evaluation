unsat
(assume conjecture2 (! (not (! (= (fun_app$b (! (fun_app$c f$ zer$) :named @p_3) x$) (fun_app$b (! (fun_app$c f$ (! (fun_app$b (fun_app$c g$ zer$) zer$) :named @p_1)) :named @p_2) x$)) :named @p_4)) :named @p_5))
(assume a3 (! (= @p_1 zer$) :named @p_6))
(step t0 (cl (! (=> (! (= zer$ @p_1) :named @p_7) @p_4) :named @p_9) @p_7) :rule implies_neg1)
(anchor :step t1)
(assume t1.a0 @p_7)
(step t1.t0 (cl @p_7) :rule symm :premises (a3))
(step t1.t1 (cl (= @p_3 @p_2)) :rule cong :premises (t1.t0))
(step t1.t2 (cl (= x$ x$)) :rule refl)
(step t1.t3 (cl @p_4) :rule cong :premises (t1.t1 t1.t2))
(step t1 (cl (! (not @p_7) :named @p_8) @p_4) :rule subproof :discharge (t1.a0))
(step t2 (cl @p_9 @p_4) :rule resolution :premises (t0 t1))
(step t3 (cl @p_9 @p_5) :rule implies_neg2)
(step t4 (cl @p_9 @p_9) :rule resolution :premises (t2 t3))
(step t5 (cl @p_9) :rule contraction :premises (t4))
(step t6 (cl @p_8 @p_4) :rule implies :premises (t5))
(step t7 (cl @p_4 @p_8) :rule reordering :premises (t6))
(step t8 (cl @p_7) :rule symm :premises (a3))
(step t9 (cl) :rule resolution :premises (t7 t8 conjecture2))
