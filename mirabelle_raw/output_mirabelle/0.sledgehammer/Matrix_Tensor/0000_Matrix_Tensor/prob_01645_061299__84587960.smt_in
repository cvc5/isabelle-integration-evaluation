; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 223
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun j$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (= (nth$ m$ (divide$ (minus$ j$ (size$ (cons$ w$ n$))) (size$ (cons$ w$ n$)))) (nth$ (cons$ v$ m$) (divide$ j$ (size$ (cons$ w$ n$))))))) :named conjecture0))
(assert (! (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (= (nth$ m$ (minus$ (divide$ j$ (size$ (cons$ w$ n$))) one$)) (nth$ (cons$ v$ m$) (divide$ j$ (size$ (cons$ w$ n$)))))) :named a1))
(assert (! (= m2$ (cons$ w$ n$)) :named a2))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) (minus$ (divide$ j$ (size$ m2$)) one$))) :named a3))
(assert (! (= one$ (suc$ zero$)) :named a4))
(assert (! (= (size$ nil$) zero$) :named a5))
(check-sat)
(get-proof)
