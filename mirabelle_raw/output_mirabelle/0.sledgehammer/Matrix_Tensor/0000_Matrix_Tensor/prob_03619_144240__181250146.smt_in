(assert (! (not (= (zip$ v1$ v2$) (cons$ (pair$ a1$ a2$) (zip$ u1$ u2$)))) :named conjecture0))
(assert (! (= (fun_app$ (fun_app$a f$ (scalar_product$ f$ zer$ g$ u1$ u2$)) (scalar_product$ f$ zer$ g$ w1$ w2$)) (scalar_product$ f$ zer$ g$ (vec_vec_Tensor$ f$ u1$ w1$) (vec_vec_Tensor$ f$ u2$ w2$))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A$) (?v3 A_list$)) (! (= (zip$ (cons$a ?v0 ?v1) (cons$a ?v2 ?v3)) (cons$ (pair$ ?v0 ?v2) (zip$ ?v1 ?v3))) :pattern ((zip$ (cons$a ?v0 ?v1) (cons$a ?v2 ?v3))))) :named a2))
(assert (! (forall ((?v0 A_a_prod$) (?v1 A_a_prod_list$) (?v2 A$) (?v3 A_list$)) (! (= (zip$a (cons$ ?v0 ?v1) (cons$a ?v2 ?v3)) (cons$b (pair$a ?v0 ?v2) (zip$a ?v1 ?v3))) :pattern ((zip$a (cons$ ?v0 ?v1) (cons$a ?v2 ?v3))))) :named a3))
