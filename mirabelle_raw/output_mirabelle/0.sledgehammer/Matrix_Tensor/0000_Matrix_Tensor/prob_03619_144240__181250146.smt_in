(assert (! (forall ((?v0 A_a_prod$) (?v1 A_a_prod_list$) (?v2 A_a_prod$) (?v3 A_a_prod_list$)) (! (= (zip$c (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (cons$d (pair$c ?v0 ?v2) (zip$c ?v1 ?v3))) :pattern ((zip$c (cons$ ?v0 ?v1) (cons$ ?v2 ?v3))))) :named a5))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A_a_a_prod_prod$) (?v3 A_a_a_prod_prod_list$)) (! (= (zip$d (cons$a ?v0 ?v1) (cons$c ?v2 ?v3)) (cons$e (pair$d ?v0 ?v2) (zip$d ?v1 ?v3))) :pattern ((zip$d (cons$a ?v0 ?v1) (cons$c ?v2 ?v3))))) :named a6))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A_a_prod_a_prod$) (?v3 A_a_prod_a_prod_list$)) (! (= (zip$e (cons$a ?v0 ?v1) (cons$b ?v2 ?v3)) (cons$f (pair$e ?v0 ?v2) (zip$e ?v1 ?v3))) :pattern ((zip$e (cons$a ?v0 ?v1) (cons$b ?v2 ?v3))))) :named a7))
(assert (! (forall ((?v0 A_a_a_prod_prod$) (?v1 A_a_a_prod_prod_list$) (?v2 A$) (?v3 A_list$)) (! (= (zip$f (cons$c ?v0 ?v1) (cons$a ?v2 ?v3)) (cons$g (pair$f ?v0 ?v2) (zip$f ?v1 ?v3))) :pattern ((zip$f (cons$c ?v0 ?v1) (cons$a ?v2 ?v3))))) :named a8))
(assert (! (forall ((?v0 A_a_prod_a_prod$) (?v1 A_a_prod_a_prod_list$) (?v2 A$) (?v3 A_list$)) (! (= (zip$g (cons$b ?v0 ?v1) (cons$a ?v2 ?v3)) (cons$h (pair$g ?v0 ?v2) (zip$g ?v1 ?v3))) :pattern ((zip$g (cons$b ?v0 ?v1) (cons$a ?v2 ?v3))))) :named a9))
(assert (! (forall ((?v0 A_a_prod$) (?v1 A_a_prod_list$) (?v2 A_a_a_prod_prod$) (?v3 A_a_a_prod_prod_list$)) (! (= (zip$h (cons$ ?v0 ?v1) (cons$c ?v2 ?v3)) (cons$i (pair$h ?v0 ?v2) (zip$h ?v1 ?v3))) :pattern ((zip$h (cons$ ?v0 ?v1) (cons$c ?v2 ?v3))))) :named a10))
(assert (! (forall ((?v0 A_a_prod$) (?v1 A_a_prod_list$) (?v2 A_a_prod_a_prod$) (?v3 A_a_prod_a_prod_list$)) (! (= (zip$i (cons$ ?v0 ?v1) (cons$b ?v2 ?v3)) (cons$j (pair$i ?v0 ?v2) (zip$i ?v1 ?v3))) :pattern ((zip$i (cons$ ?v0 ?v1) (cons$b ?v2 ?v3))))) :named a11))
(assert (! (and (= v2$ (cons$a a2$ u2$)) (= (size$ u2$) k$)) :named a12))
(assert (! (and (= v1$ (cons$a a1$ u1$)) (= (size$ u1$) k$)) :named a13))
