; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 246
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun uu$ () Nat_nat_fun$)
(declare-fun m1a$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ uu$ ?v0) ?v0) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (= (fun_app$ (times$ (size$ (cons$ a$ m1a$))) (size$ m2$)) (size$ m2$))) :named conjecture1))
(assert (! (= (size$ nil$) zero$) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(assert (! (= one$ (suc$ zero$)) :named a4))
(assert (! (= uu$ (times$ one$)) :named a5))
(assert (! (= m1a$ nil$) :named a6))
(check-sat)
(get-proof)
