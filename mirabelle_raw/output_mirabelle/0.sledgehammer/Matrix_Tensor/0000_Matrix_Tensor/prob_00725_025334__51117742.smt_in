(assert (! (not (=> (member$ x$ (set$ (tensor$ f$ (cons$ a$ m1a$) m2$))) (or (member$ x$ (set$ (vec_mat_Tensor$ f$ a$ m2$))) (member$ x$ (set$ (tensor$ f$ m1a$ m2$)))))) :named conjecture0))
(assert (! (= (tensor$ f$ (cons$ a$ m1a$) m2$) (append$ (vec_mat_Tensor$ f$ a$ m2$) (tensor$ f$ m1a$ m2$))) :named a1))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (set$ (append$ ?v0 ?v1)) (sup$ (set$ ?v0) (set$ ?v1)))) :named a2))
(check-sat)
(get-proof)
