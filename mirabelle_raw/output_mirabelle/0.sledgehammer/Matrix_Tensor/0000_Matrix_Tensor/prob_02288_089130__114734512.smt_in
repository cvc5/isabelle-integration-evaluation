; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun cons$a (A_list$ A_list_list$) A_list_list$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (append$ (times$ f$ (nth$ v$ (divide$ i$ (row_length$ m2$))) (row$ m2$ (modulo$ i$ (row_length$ m2$)))) (vec_vec_Tensor$ f$ (row$ m$ (divide$ i$ (row_length$ m2$))) (row$ m2$ (modulo$ i$ (row_length$ m2$))))) (vec_vec_Tensor$ f$ (cons$ (nth$ v$ (divide$ i$ (row_length$ m2$))) (row$ m$ (divide$ i$ (row_length$ m2$)))) (row$ m2$ (modulo$ i$ (row_length$ m2$)))))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A_list$)) (! (= (vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2) (append$ (times$ f$ ?v0 ?v2) (vec_vec_Tensor$ f$ ?v1 ?v2))) :pattern ((vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2)))) :named a1))
(assert (! (= m$ (cons$a w$ n$)) :named a2))
(check-sat)
(get-proof)
