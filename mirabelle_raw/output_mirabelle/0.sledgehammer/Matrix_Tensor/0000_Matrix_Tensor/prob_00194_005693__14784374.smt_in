; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 252
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ B_list_list$) Bool)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun vec$ (Nat$ B_list$) Bool)
(declare-fun size$ (B_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(assert (! (not (mat$ zero$ nc$ m$)) :named conjecture0))
(assert (! (forall ((?v0 B_list$)) (=> (member$ ?v0 (set$ m$)) (vec$ zero$ ?v0))) :named a1))
(assert (! (mat$ nr$ nc$ m$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$ ?v2) ?v1) (forall ((?v3 B_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a3))
(check-sat)
(get-proof)
