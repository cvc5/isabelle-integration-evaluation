; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 234
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-fun m$ () Int)
(declare-fun n$ () Int)
(declare-fun times$ (Int Int) Int)
(declare-fun modulo$ (Int Int) Int)
(assert (! (not (= (modulo$ m$ n$) (modulo$ (+ m$ (* (- 1) n$)) n$))) :named conjecture0))
(assert (! (forall ((?v0 Int) (?v1 Int) (?v2 Int)) (= (modulo$ (+ ?v0 (times$ ?v1 ?v2)) ?v2) (modulo$ ?v0 ?v2))) :named a1))
(check-sat)
(get-proof)
