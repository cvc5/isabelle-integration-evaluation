unsat
(assume conjecture0 (! (not b$) :named @p_1))
(assume a1 (! (=> a$ b$) :named @p_2))
(assume a2 (! (=> (! (not a$) :named @p_3) b$) :named @p_4))
(step t0 (cl (not (! (not @p_3) :named @p_5)) a$) :rule not_not)
(step t1 (cl @p_5 b$) :rule implies :premises (a2))
(step t2 (cl @p_5) :rule resolution :premises (t1 conjecture0))
(step t3 (cl a$) :rule resolution :premises (t0 t2))
(step t4 (cl @p_3 b$) :rule implies :premises (a1))
(step t5 (cl @p_3) :rule resolution :premises (t4 conjecture0))
(step t6 (cl) :rule resolution :premises (t3 t5))
