; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 252
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun m$ () Nat$)
(declare-fun n$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (modulo$ m$ n$) (modulo$ (minus$ m$ n$) n$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (modulo$ ?v1 ?v0) (modulo$ (minus$ ?v1 ?v0) ?v0)))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (less_eq$ ?v0 ?v1))) :named a2))
(check-sat)
(get-proof)
