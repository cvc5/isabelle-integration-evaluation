; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 349
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (divide$ ?v0 (times$ ?v1 ?v2)) (divide$ (divide$ ?v0 ?v1) ?v2))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ ?v0 (times$ ?v1 ?v2)) (plus$ (times$ ?v1 (modulo$ (divide$ ?v0 ?v1) ?v2)) (modulo$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (divide$ (modulo$ ?v0 ?v1) ?v1) zero$)) :named a4))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (plus$ (times$ ?v0 ?v1) ?v2) ?v0) (plus$ ?v1 (divide$ ?v2 ?v0))))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (modulo$ ?v0 ?v1) ?v0) (= (divide$ ?v0 ?v1) zero$))) :named a8))
(check-sat)
(get-proof)
