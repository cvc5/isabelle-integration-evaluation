; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 255
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_list_set$ 0)
(declare-sort A_list_list_list$ 0)
(declare-fun y$ () A_list$)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun ys$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun set$ (A_list_list_list$) A_list_list_set$)
(declare-fun vec$ (Nat$ A_list_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun mat$a (Nat$ Nat$ A_list_list_list$) Bool)
(declare-fun set$a (A_list_list$) A_list_set$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun vec$a (Nat$ A_list$) Bool)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun size$b (A_list_list_list$) Nat$)
(declare-fun member$ (A_list_list$ A_list_list_set$) Bool)
(declare-fun member$a (A_list$ A_list_set$) Bool)
(assert (! (not (= (size$ y$) nr$)) :named conjecture0))
(assert (! (mat$ nr$ nc$ (cons$ y$ ys$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$ ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$a ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list_list$)) (= (mat$a ?v0 ?v1 ?v2) (and (= (size$b ?v2) ?v1) (forall ((?v3 A_list_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$a ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$a ?v3 (set$a ?v2)) (vec$a ?v0 ?v3)))))) :named a5))
(check-sat)
(get-proof)
