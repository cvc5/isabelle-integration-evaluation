; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 254
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun u1$ () A_list$)
(declare-fun u2$ () A_list$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (size$ (vec_vec_Tensor$ f$ u2$ w2$)) (size$ (vec_vec_Tensor$ f$ u1$ w1$)))) :named conjecture0))
(assert (! (= (size$ u1$) (size$ u2$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (= (size$ (vec_vec_Tensor$ f$ ?v0 ?v1)) (times$ (size$ ?v0) (size$ ?v1)))) :named a2))
(check-sat)
(get-proof)
