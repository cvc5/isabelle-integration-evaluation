; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 227
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-fun m$ () B_list_list$)
(declare-fun bot$ () B_list_set$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun vec$ (Nat$ B_list$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(assert (! (not (forall ((?v0 B_list$)) (=> (member$ ?v0 (set$ m$)) (vec$ zero$ ?v0)))) :named conjecture0))
(assert (! (= (set$ m$) bot$) :named a1))
(assert (! (forall ((?v0 B_list$)) (= (member$ ?v0 bot$) false)) :named a2))
(check-sat)
(get-proof)
