; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 222
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun m2$ () A_list_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun append$ (A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ (row_length$ (append$ m1a$ m2$)) (size$ (append$ m1a$ m2$)) (append$ m1a$ m2$))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (=> (mat$ (row_length$ (cons$ ?v0 ?v1)) (size$ (cons$ ?v0 ?v1)) (cons$ ?v0 ?v1)) (mat$ (row_length$ ?v1) (size$ ?v1) ?v1))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list_list$)) (! (= (append$ (cons$ ?v0 ?v1) ?v2) (cons$ ?v0 (append$ ?v1 ?v2))) :pattern ((append$ (cons$ ?v0 ?v1) ?v2)))) :named a2))
(check-sat)
(get-proof)
