(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nth$a (A_list_list$ Nat$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun fun_app$a (A_a_fun$ A$) A$)
(declare-fun fun_app$b (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (=> (and (and (less$ i$ (fun_app$ (times$ (size$ v$)) (row_length$ (cons$ a$ ma$)))) (less$ j$ (size$a (cons$ a$ ma$)))) (mat$ (row_length$ (cons$ a$ ma$)) (size$a (cons$ a$ ma$)) (cons$ a$ ma$))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ a$ ma$)) j$) i$) (fun_app$a (fun_app$b f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ a$ ma$))))) (nth$ (nth$a (cons$ a$ ma$) j$) (modulo$ i$ (row_length$ (cons$ a$ ma$)))))))) :named conjecture0))
(assert (! (=> (and (and (less$ i$ (fun_app$ (times$ (row_length$ (cons$ a$ ma$))) (size$ v$))) (less$ j$ (size$a (cons$ a$ ma$)))) (mat$ (row_length$ (cons$ a$ ma$)) (size$a (cons$ a$ ma$)) (cons$ a$ ma$))) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ (cons$ a$ ma$)) j$) i$) (fun_app$a (fun_app$b f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ a$ ma$))))) (nth$ (nth$a (cons$ a$ ma$) j$) (modulo$ i$ (row_length$ (cons$ a$ ma$))))))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (fun_app$ (times$ ?v0) ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a2))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (times$ ?v0) zero$) zero$) :pattern ((times$ ?v0)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (divide$ ?v0 (fun_app$ (times$ ?v1) ?v2)) (divide$ (divide$ ?v0 ?v1) ?v2))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ zero$ ?v0) (= (less$ (divide$ ?v1 ?v0) ?v2) (less$ ?v1 (fun_app$ (times$ ?v2) ?v0))))) :named a6))
(check-sat)
(get-proof)
