; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 249
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun a1$ () A_list_list$)
(declare-fun b1$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ (times$ (row_length$ a1$) (row_length$ b1$)) (times$ (size$ a1$) (size$ b1$)) (tensor$ f$ a1$ b1$))) :named conjecture0))
(assert (! (mat$ (row_length$ a1$) (size$ a1$) a1$) :named a1))
(assert (! (mat$ (row_length$ b1$) (size$ b1$) b1$) :named a2))
(check-sat)
(get-proof)
