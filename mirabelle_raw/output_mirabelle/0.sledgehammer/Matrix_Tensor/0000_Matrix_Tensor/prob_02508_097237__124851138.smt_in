(assert (! (not (= (row_length$ (tensor$ f$ m1$ (tensor$ f$ m2$ m3$))) (times$ (times$ (row_length$ m1$) (row_length$ m2$)) (row_length$ m3$)))) :named conjecture0))
(assert (! (= (row_length$ (tensor$ f$ m2$ m3$)) (times$ (row_length$ m2$) (row_length$ m3$))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A$)) (= (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ ?v0) ?v1)) ?v2) (fun_app$ (fun_app$a f$ ?v0) (fun_app$ (fun_app$a f$ ?v1) ?v2)))) :named a2))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (row_length$ (tensor$ f$ ?v0 ?v1)) (times$ (row_length$ ?v0) (row_length$ ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (times$ ?v0 ?v1) ?v2) (times$ ?v0 (times$ ?v1 ?v2)))) :named a4))
