; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () B_list$)
(declare-fun z$ () C$)
(declare-fun zs$ () C_list$)
(declare-fun nil$ () C_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (C$ C_list$) C_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () B_list$)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (C_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (B$ B_list$) B_list$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$a y$))) (less$ (minus$ i$ (size$a y$)) (times$ (size$ zs$) (size$a y$))))) :named conjecture0))
(assert (! (= (size$ nil$) zero$) :named a1))
(assert (! (= (size$a nil$a) zero$) :named a2))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (times$ (fun_app$ suc$ ?v0) ?v1) (fun_app$ (plus$ ?v1) (times$ ?v0 ?v1))) :pattern ((times$ (fun_app$ suc$ ?v0) ?v1)))) :named a4))
(assert (! (less$ (size$a y$) i$) :named a5))
(assert (! (forall ((?v0 C$) (?v1 C_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (size$a (cons$a ?v0 ?v1)) (fun_app$ suc$ (size$a ?v1))) :pattern ((cons$a ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a8))
(assert (! (= (plus$ one$) suc$) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (exists ((?v2 Nat$)) (= ?v1 (fun_app$ suc$ (fun_app$ (plus$ ?v0) ?v2)))))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (less$ (minus$ ?v1 ?v0) ?v2) (less$ ?v1 (fun_app$ (plus$ ?v2) ?v0))))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (less_eq$ ?v0 ?v1))) :named a12))
(check-sat)
(get-proof)
