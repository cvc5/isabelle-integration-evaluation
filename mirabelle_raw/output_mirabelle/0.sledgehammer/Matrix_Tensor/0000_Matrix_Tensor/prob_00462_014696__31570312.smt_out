unsat
(assume conjecture3 (! (not (! (fun_app$ (mat$ (fun_app$g (fun_app$h times$ (! (row_length$ ma$) :named @p_2)) (fun_app$f size$b v$)) (! (size$ ma$) :named @p_1)) (fun_app$i (fun_app$j (vec_mat_Tensor$ f$) v$) ma$)) :named @p_3)) :named @p_4))
(assume a6 (! (fun_app$ (mat$ @p_2 @p_1) ma$) :named @p_5))
(assume a9 (! (=> @p_5 @p_3) :named @p_6))
(step t0 (cl (! (not @p_6) :named @p_7) (not @p_5) @p_3) :rule implies_pos)
(step t1 (cl @p_7) :rule resolution :premises (t0 a6 conjecture3))
(step t2 (cl) :rule resolution :premises (a9 t1))
