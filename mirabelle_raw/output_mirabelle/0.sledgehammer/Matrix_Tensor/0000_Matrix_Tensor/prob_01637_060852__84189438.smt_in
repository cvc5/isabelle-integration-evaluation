; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun w$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$) Nat_nat_fun$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (less_eq$ zero$ (minus$ (fun_app$ (divide$ j$) (size$ (cons$ w$ n$))) one$)))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a1))
(assert (! (=> (less_eq$ (size$ (cons$ w$ n$)) j$) (less_eq$ one$ (fun_app$ (divide$ j$) (size$ (cons$ w$ n$))))) :named a2))
(assert (! (forall ((?v0 Nat$)) (! (=> (not (= ?v0 zero$)) (= (fun_app$ (divide$ ?v0) ?v0) one$)) :pattern ((divide$ ?v0)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (minus$ ?v0 ?v1) zero$) (less_eq$ ?v0 ?v1))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (minus$ ?v0 ?v1) zero$))) :named a5))
(assert (! (forall ((?v0 A_list_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a6))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (fun_app$ (divide$ (minus$ j$ (size$ m2$))) (size$ m2$)) (minus$ (fun_app$ (divide$ j$) (size$ m2$)) one$))) :named a7))
(assert (! (= one$ (suc$ zero$)) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (less_eq$ (fun_app$ (divide$ ?v0) ?v2) (fun_app$ (divide$ ?v1) ?v2)))) :named a9))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (divide$ ?v0) zero$) zero$)) :named a10))
(assert (! (forall ((?v0 Nat$)) (less_eq$ zero$ ?v0)) :named a11))
(assert (! (forall ((?v0 A_list_list$)) (= (not (= ?v0 nil$)) (exists ((?v1 A_list$) (?v2 A_list_list$)) (= ?v0 (cons$ ?v1 ?v2))))) :named a12))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a13))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a14))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (divide$ zero$) ?v0) zero$)) :named a15))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ (divide$ ?v0) one$) ?v0)) :named a16))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ zero$ (fun_app$ (divide$ ?v0) ?v1)) (and (less_eq$ ?v1 ?v0) (less$ zero$ ?v1)))) :named a17))
(assert (! (forall ((?v0 Nat$)) (less_eq$ zero$ ?v0)) :named a18))
(assert (! (forall ((?v0 Nat$)) (= (minus$ zero$ ?v0) zero$)) :named a19))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v0) ?v1)) :named a20))
(check-sat)
(get-proof)
