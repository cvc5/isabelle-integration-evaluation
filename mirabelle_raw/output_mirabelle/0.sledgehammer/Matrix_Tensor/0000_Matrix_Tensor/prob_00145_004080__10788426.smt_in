; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 362
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun m$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (fun_app$ (plus$ (size$ (reduct$ m$))) one$) (size$ m$))) :named conjecture0))
(assert (! (not (= m$ nil$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v1) ?v0))) :named a3))
(assert (! (= (plus$ one$) suc$) :named a4))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$ suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a5))
(assert (! (= (size$ nil$) zero$) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (= (less_eq$ (fun_app$ suc$ ?v0) (size$ ?v1)) (exists ((?v2 A_list$) (?v3 A_list_list$)) (and (= ?v1 (cons$ ?v2 ?v3)) (less_eq$ ?v0 (size$ ?v3)))))) :named a7))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less_eq$ (fun_app$ suc$ ?v0) ?v1) (less$ ?v0 ?v1))) :named a9))
(check-sat)
(get-proof)
