; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_bool_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun n$ () A_list_list$)
(declare-fun x$ () A_list$)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$) A_list_bool_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun fun_app$ (A_list_bool_fun$ A_list$) Bool)
(assert (! (not (fun_app$ (vec$ nr$) a$)) :named conjecture0))
(assert (! (=> (member$ x$ (set$ (cons$ a$ n$))) (or (= x$ a$) (member$ x$ (set$ n$)))) :named a1))
(assert (! (mat$ nr$ nc$ (cons$ a$ n$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$ ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$ ?v3 (set$ ?v2)) (fun_app$ (vec$ ?v0) ?v3)))))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (member$ ?v0 (set$ (cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A_list_set$) (?v1 A_list_bool_fun$) (?v2 A_list$)) (=> (and (forall ((?v3 A_list$)) (=> (member$ ?v3 ?v0) (fun_app$ ?v1 ?v3))) (and (=> (fun_app$ ?v1 ?v2) false) (=> (not (member$ ?v2 ?v0)) false))) false)) :named a5))
(check-sat)
(get-proof)
