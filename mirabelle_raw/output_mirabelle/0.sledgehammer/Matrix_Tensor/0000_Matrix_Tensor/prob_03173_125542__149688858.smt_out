unsat
(assume conjecture2 (! (not (! (fun_app$b (! (less$ j$) :named @p_1) (fun_app$c (times$ (size$ (fun_app$d (fun_app$e (mat_multI$ zer$ g$ f$ (row_length$ a1$)) a1$) a2$))) (size$ (fun_app$d (fun_app$e (mat_multI$ zer$ g$ f$ (row_length$ b1$)) b1$) b2$)))) :named @p_2)) :named @p_3))
(assume a20 (! (= (! (fun_app$b @p_1 (fun_app$c (times$ (size$ a2$)) (size$ b2$))) :named @p_4) @p_2) :named @p_5))
(assume a25 @p_4)
(step t0 (cl (= @p_2 @p_4)) :rule symm :premises (a20))
(step t1 (cl @p_2 (! (not @p_4) :named @p_6)) :rule equiv2 :premises (t0))
