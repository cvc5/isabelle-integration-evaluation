; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 274
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun m2$ () A_list_list$)
(declare-fun uu$ () Nat_nat_fun$)
(declare-fun m1a$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun append$ (A_list_list$ A_list_list$) A_list_list$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ uu$ ?v0) ?v0) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (= (size$ (append$ (vec_mat_Tensor$ f$ a$ m2$) (tensor$ f$ m1a$ m2$))) (fun_app$ (times$ (plus$ one$ (size$ m1a$))) (size$ m2$)))) :named conjecture1))
(assert (! (= (size$ (append$ (vec_mat_Tensor$ f$ a$ m2$) (tensor$ f$ m1a$ m2$))) (plus$ (size$ m2$) (fun_app$ (times$ (size$ m1a$)) (size$ m2$)))) :named a2))
(assert (! (= uu$ (times$ one$)) :named a3))
(check-sat)
(get-proof)
