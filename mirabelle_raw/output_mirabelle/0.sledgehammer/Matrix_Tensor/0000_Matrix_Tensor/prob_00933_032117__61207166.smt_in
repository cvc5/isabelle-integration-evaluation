; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not (= (divide$ a$ b$) (plus$ (divide$ (minus$ a$ b$) b$) one$))) :named conjecture0))
(assert (! (= (of_nat$ (divide$ a$ b$)) (of_nat$ (plus$ (divide$ (minus$ a$ b$) b$) one$))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (= (of_nat$ ?v0) (of_nat$ ?v1)) (= ?v0 ?v1))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (of_nat$ ?v0) (of_nat$ ?v1)) (= ?v0 ?v1))) :named a3))
(assert (! (= one$ (suc$ zero$)) :named a4))
(check-sat)
(get-proof)
