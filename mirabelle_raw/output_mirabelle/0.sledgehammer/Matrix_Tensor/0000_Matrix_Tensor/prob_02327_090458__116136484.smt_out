unsat
(assume conjecture0 (! (not (! (less_eq$ b$ a$) :named @p_1)) :named @p_2))
(assume hypothesis1 (! (not (! (less$ a$ b$) :named @p_3)) :named @p_4))
(assume a2 (forall ((?v0 Nat$) (?v1 Nat$)) (or (less_eq$ ?v0 ?v1) (less$ ?v1 ?v0))))
(step t0 (cl (! (=> (forall ((?v0 Nat$) (?v1 Nat$)) (or (less_eq$ ?v0 ?v1) (less$ ?v1 ?v0))) (! (or @p_1 @p_3) :named @p_5)) :named @p_8) (forall ((?v0 Nat$) (?v1 Nat$)) (or (less_eq$ ?v0 ?v1) (less$ ?v1 ?v0)))) :rule implies_neg1)
(anchor :step t1)
(assume t1.a0 (forall ((?v0 Nat$) (?v1 Nat$)) (or (less_eq$ ?v0 ?v1) (less$ ?v1 ?v0))))
(step t1.t0 (cl (or (! (not (forall ((?v0 Nat$) (?v1 Nat$)) (or (less_eq$ ?v0 ?v1) (less$ ?v1 ?v0)))) :named @p_7) @p_5)) :rule forall_inst :args (b$ a$))
(step t1.t1 (cl @p_7 @p_5) :rule or :premises (t1.t0))
(step t1.t2 (cl @p_5) :rule resolution :premises (t1.t1 t1.a0))
(step t1 (cl @p_7 @p_5) :rule subproof :discharge (t1.a0))
(step t2 (cl @p_8 @p_5) :rule resolution :premises (t0 t1))
(step t3 (cl @p_8 (! (not @p_5) :named @p_6)) :rule implies_neg2)
(step t4 (cl @p_8 @p_8) :rule resolution :premises (t2 t3))
(step t5 (cl @p_8) :rule contraction :premises (t4))
(step t6 (cl @p_7 @p_5) :rule implies :premises (t5))
(step t7 (cl @p_6 @p_1 @p_3) :rule or_pos)
(step t8 (cl @p_1 @p_3 @p_6) :rule reordering :premises (t7))
(step t9 (cl @p_6) :rule resolution :premises (t8 conjecture0 hypothesis1))
(step t10 (cl) :rule resolution :premises (t6 t9 a2))
