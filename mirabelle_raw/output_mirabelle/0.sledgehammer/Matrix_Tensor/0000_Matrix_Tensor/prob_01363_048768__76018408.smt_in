; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 244
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(assert (! (not (= (size$ (cons$ a$ nil$)) one$)) :named conjecture0))
(assert (! (= (size$ nil$) zero$) :named a1))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(assert (! (= one$ (suc$ zero$)) :named a4))
(check-sat)
(get-proof)
