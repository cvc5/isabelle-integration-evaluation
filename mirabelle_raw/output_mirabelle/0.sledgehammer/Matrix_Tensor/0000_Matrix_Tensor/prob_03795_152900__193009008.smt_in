; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 268
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_list_list_list$ 0)
(declare-sort B_list_list_list_list$ 0)
(declare-sort B_list_list_list_list_list$ 0)
(declare-fun nc$ () Nat$)
(declare-fun nr$ () Nat$)
(declare-fun mat$ (Nat$ Nat$ B_list_list$) Bool)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun mat$a (Nat$ Nat$ B_list_list_list_list_list$) Bool)
(declare-fun mat$b (Nat$ Nat$ B_list_list_list_list$) Bool)
(declare-fun mat$c (Nat$ Nat$ B_list_list_list$) Bool)
(declare-fun nth$a (B_list_list$ Nat$) B_list$)
(declare-fun nth$b (B_list_list_list_list$ Nat$) B_list_list_list$)
(declare-fun nth$c (B_list_list_list_list_list$ Nat$) B_list_list_list_list$)
(declare-fun nth$d (B_list_list_list$ Nat$) B_list_list$)
(assert (! (not (forall ((?v0 B_list_list$) (?v1 B_list_list$)) (=> (and (mat$ nr$ nc$ ?v0) (and (mat$ nr$ nc$ ?v1) (forall ((?v2 Nat$)) (=> (less$ ?v2 nc$) (forall ((?v3 Nat$)) (=> (less$ ?v3 nr$) (= (nth$ (nth$a ?v0 ?v2) ?v3) (nth$ (nth$a ?v1 ?v2) ?v3)))))))) (= ?v0 ?v1)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list_list_list_list$) (?v3 B_list_list_list_list_list$)) (=> (and (mat$a ?v0 ?v1 ?v2) (mat$a ?v0 ?v1 ?v3)) (= (= ?v2 ?v3) (forall ((?v4 Nat$)) (=> (less$ ?v4 ?v1) (forall ((?v5 Nat$)) (=> (less$ ?v5 ?v0) (= (nth$b (nth$c ?v2 ?v4) ?v5) (nth$b (nth$c ?v3 ?v4) ?v5))))))))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list_list_list$) (?v3 B_list_list_list_list$)) (=> (and (mat$b ?v0 ?v1 ?v2) (mat$b ?v0 ?v1 ?v3)) (= (= ?v2 ?v3) (forall ((?v4 Nat$)) (=> (less$ ?v4 ?v1) (forall ((?v5 Nat$)) (=> (less$ ?v5 ?v0) (= (nth$d (nth$b ?v2 ?v4) ?v5) (nth$d (nth$b ?v3 ?v4) ?v5))))))))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list_list$) (?v3 B_list_list_list$)) (=> (and (mat$c ?v0 ?v1 ?v2) (mat$c ?v0 ?v1 ?v3)) (= (= ?v2 ?v3) (forall ((?v4 Nat$)) (=> (less$ ?v4 ?v1) (forall ((?v5 Nat$)) (=> (less$ ?v5 ?v0) (= (nth$a (nth$d ?v2 ?v4) ?v5) (nth$a (nth$d ?v3 ?v4) ?v5))))))))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 B_list_list$) (?v3 B_list_list$)) (=> (and (mat$ ?v0 ?v1 ?v2) (mat$ ?v0 ?v1 ?v3)) (= (= ?v2 ?v3) (forall ((?v4 Nat$)) (=> (less$ ?v4 ?v1) (forall ((?v5 Nat$)) (=> (less$ ?v5 ?v0) (= (nth$ (nth$a ?v2 ?v4) ?v5) (nth$ (nth$a ?v3 ?v4) ?v5))))))))) :named a4))
(check-sat)
(get-proof)
