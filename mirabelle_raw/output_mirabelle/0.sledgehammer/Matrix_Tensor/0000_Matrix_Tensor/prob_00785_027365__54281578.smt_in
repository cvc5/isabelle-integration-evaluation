; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 353
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun x$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun fun_app$b (Nat_nat_fun$ Nat$) Nat$)
(assert (! (not (=> (less$ i$ (size$ (cons$ x$ xs$))) (= (nth$ (times$ f$ a$ (cons$ x$ xs$)) i$) (fun_app$ (fun_app$a f$ a$) (nth$ (cons$ x$ xs$) i$))))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (! (= (times$ f$ ?v0 (cons$ ?v1 ?v2)) (cons$ (fun_app$ (fun_app$a f$ ?v0) ?v1) (times$ f$ ?v0 ?v2))) :pattern ((times$ f$ ?v0 (cons$ ?v1 ?v2))))) :named a1))
(assert (! (forall ((?v0 Nat$)) (=> (less$ ?v0 (size$ xs$)) (= (nth$ (times$ f$ a$ xs$) ?v0) (fun_app$ (fun_app$a f$ a$) (nth$ xs$ ?v0))))) :named a2))
(assert (! (= (plus$ one$) suc$) :named a3))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$b suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) ?v2) (ite (= ?v2 zero$) ?v0 (nth$ ?v1 (minus$ ?v2 one$)))) :pattern ((nth$ (cons$ ?v0 ?v1) ?v2)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (fun_app$b (plus$ ?v0) ?v1) (fun_app$b (plus$ ?v0) ?v2)) (less$ ?v1 ?v2))) :named a6))
(assert (! (forall ((?v0 Nat$)) (= (less$ ?v0 one$) (= ?v0 zero$))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (less$ ?v0 ?v1)) (= (fun_app$b (plus$ ?v1) (minus$ ?v0 ?v1)) ?v0))) :named a8))
(check-sat)
(get-proof)
