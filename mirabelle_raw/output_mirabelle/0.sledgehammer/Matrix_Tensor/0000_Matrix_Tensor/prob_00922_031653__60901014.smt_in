; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 261
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun divide$ (Int Int) Int)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not (= (divide$ (of_nat$ a$) (of_nat$ b$)) (+ (divide$ (- (of_nat$ a$) (of_nat$ b$)) (of_nat$ b$)) 1))) :named conjecture0))
(assert (! (< (of_nat$ b$) (of_nat$ a$)) :named a1))
(assert (! (< 0 (of_nat$ b$)) :named a2))
(check-sat)
(get-proof)
