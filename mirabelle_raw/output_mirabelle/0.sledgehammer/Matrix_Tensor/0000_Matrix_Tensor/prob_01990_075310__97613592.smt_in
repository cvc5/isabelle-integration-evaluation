; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(assert (! (not (= (col$ m$ k$) (col$ (cons$ v$ m$) (plus$ k$ one$)))) :named conjecture0))
(assert (! (less$ k$ (size$ m$)) :named hypothesis1))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a3))
(assert (! (= (size$ nil$) zero$) :named a4))
(assert (! (= one$ (suc$ zero$)) :named a5))
(assert (! (forall ((?v0 A_list_list$) (?v1 Nat$)) (! (= (col$ ?v0 ?v1) (nth$ ?v0 ?v1)) :pattern ((col$ ?v0 ?v1)))) :named a6))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (suc$ ?v2))))) :named a7))
(check-sat)
(get-proof)
