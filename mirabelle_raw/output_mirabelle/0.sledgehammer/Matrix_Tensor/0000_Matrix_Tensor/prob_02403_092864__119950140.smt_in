; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 226
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun uu$ () Nat_nat_fun$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ uu$ ?v0) zero$) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (= (modulo$ a$ (fun_app$ (times$ b$) c$)) a$)) :named conjecture1))
(assert (! (= b$ zero$) :named a2))
(assert (! (= uu$ (times$ zero$)) :named a3))
(check-sat)
(get-proof)
