(step t8 (cl @p_4) :rule resolution :premises (t0 t6 t7))
(step t9 (cl (not (! (= @p_6 (! (not @p_4) :named @p_10)) :named @p_11)) (not @p_6) @p_10) :rule equiv_pos2)
(step t10 (cl (= @p_2 @p_12)) :rule rare_rewrite :args ("eq-symm" @p_1 k$))
(step t11 (cl (= @p_5 (! (and @p_4 @p_12) :named @p_13))) :rule cong :premises (t10))
(step t12 (cl (= @p_6 (! (not @p_13) :named @p_14))) :rule cong :premises (t11))
(step t13 (cl (! (= @p_1 @p_1) :named @p_15)) :rule refl)
(step t14 (cl (= @p_12 @p_15)) :rule cong :premises (t3 t13))
(step t15 (cl (= @p_13 (! (and @p_4 @p_15) :named @p_16))) :rule cong :premises (t14))
(step t16 (cl (= @p_14 (! (not @p_16) :named @p_17))) :rule cong :premises (t15))
(step t17 (cl (= @p_15 true)) :rule rare_rewrite :args ("eq-refl" @p_1))
(step t18 (cl (= @p_16 (! (and @p_4 true) :named @p_18))) :rule cong :premises (t17))
(step t19 (cl (= @p_18 @p_4)) :rule aci_simp)
(step t20 (cl (= @p_16 @p_4)) :rule trans :premises (t18 t19))
(step t21 (cl (= @p_17 @p_10)) :rule cong :premises (t20))
(step t22 (cl (= @p_14 @p_10)) :rule trans :premises (t16 t21))
(step t23 (cl @p_11) :rule trans :premises (t12 t22))
(step t24 (cl @p_10) :rule resolution :premises (t9 t23 conjecture4))
(step t25 (cl) :rule resolution :premises (t8 t24))
