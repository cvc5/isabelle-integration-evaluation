(assume a6 (! (and (= w2$ (cons$ a2$ u2$)) (! (= @p_3 k$) :named @p_8)) :named @p_9))
(step t0 (cl (not (! (= @p_8 @p_4) :named @p_19)) (not @p_8) @p_4) :rule equiv_pos2)
(step t1 (cl (= @p_8 (! (= k$ @p_3) :named @p_20))) :rule rare_rewrite :args ("eq-symm" @p_3 k$))
