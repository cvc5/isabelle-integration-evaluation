unsat
(assume conjecture4 (! (not (! (and (! (= (! (fun_app$d size$ u1$) :named @p_1) (! (fun_app$d size$ u2$) :named @p_3)) :named @p_4) (! (= @p_1 k$) :named @p_2)) :named @p_5)) :named @p_6))
