; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 254
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun x$ () B$)
(declare-fun xs$ () B_list$)
(declare-fun nat$ (Int) Nat$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(assert (! (not (=> (less$ zero$ k$) (= (nth$ (cons$ x$ xs$) k$) (nth$ xs$ (nat$ (+ (of_nat$ k$) (- 1))))))) :named conjecture0))
(assert (! (forall ((?v0 Nat$)) (= (nat$ (of_nat$ ?v0)) ?v0)) :named a1))
(assert (! (forall ((?v0 Int)) (=> (<= 0 ?v0) (= (suc$ (nat$ ?v0)) (nat$ (+ 1 ?v0))))) :named a2))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (suc$ ?v2))))) :named a3))
(check-sat)
(get-proof)
