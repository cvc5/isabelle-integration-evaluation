; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 231
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun id$ () A$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list_list$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun fun_app$ (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$) A_list_a_list_fun$)
(assert (! (not (= (vec_mat_Tensor$ f$ v$ (cons$ (cons$a id$ nil$) nil$a)) (cons$ v$ nil$a))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_list$)) (! (= (vec_mat_Tensor$ f$ ?v0 (cons$ ?v1 ?v2)) (cons$ (fun_app$ (vec_vec_Tensor$ f$ ?v0) ?v1) (vec_mat_Tensor$ f$ ?v0 ?v2))) :pattern ((vec_mat_Tensor$ f$ ?v0 (cons$ ?v1 ?v2))))) :named a1))
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ (vec_vec_Tensor$ f$ ?v0) (cons$a id$ nil$)) ?v0) :pattern ((vec_vec_Tensor$ f$ ?v0)))) :named a2))
(check-sat)
(get-proof)
