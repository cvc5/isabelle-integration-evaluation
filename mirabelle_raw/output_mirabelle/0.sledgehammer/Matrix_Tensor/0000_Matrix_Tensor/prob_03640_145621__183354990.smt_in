; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 236
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun a2$ () A$)
(declare-fun u2$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (vec_vec_Tensor$ f$ (cons$ a2$ u2$) w2$) (append$ (times$ f$ a2$ w2$) (vec_vec_Tensor$ f$ u2$ w2$)))) :named conjecture0))
(check-sat)
(get-proof)
