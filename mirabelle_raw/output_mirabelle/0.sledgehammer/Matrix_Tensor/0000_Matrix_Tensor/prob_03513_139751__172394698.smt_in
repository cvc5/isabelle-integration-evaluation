; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun x$ () A$)
(declare-fun y$ () A$)
(declare-fun ws$ () A_list$)
(declare-fun zs$ () A_list$)
(declare-fun xss$ () A_list$)
(declare-fun yss$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_prodI$ (A$ A_a_a_fun_fun$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ (cons$ x$ (append$ xss$ zs$)) (cons$ y$ (append$ yss$ ws$))) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ x$) y$)) (scalar_product$ f$ zer$ g$ (append$ xss$ zs$) (append$ yss$ ws$))))) :named conjecture0))
(assert (! (= (scalar_product$ f$ zer$ g$ (append$ (cons$ x$ xss$) zs$) (append$ (cons$ y$ yss$) ws$)) (scalar_product$ f$ zer$ g$ (cons$ x$ (append$ xss$ zs$)) (cons$ y$ (append$ yss$ ws$)))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (! (= (scalar_product$ f$ zer$ g$ ?v0 ?v1) (scalar_prodI$ zer$ g$ f$ ?v0 ?v1)) :pattern ((scalar_product$ f$ zer$ g$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A_a_a_fun_fun$) (?v3 A$) (?v4 A_list$) (?v5 A$) (?v6 A_list$)) (! (= (scalar_prodI$ ?v0 ?v1 ?v2 (cons$ ?v3 ?v4) (cons$ ?v5 ?v6)) (fun_app$ (fun_app$a ?v1 (fun_app$ (fun_app$a ?v2 ?v3) ?v5)) (scalar_prodI$ ?v0 ?v1 ?v2 ?v4 ?v6))) :pattern ((scalar_prodI$ ?v0 ?v1 ?v2 (cons$ ?v3 ?v4) (cons$ ?v5 ?v6))))) :named a3))
(check-sat)
(get-proof)
