; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 229
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B_list$ 0)
(declare-sort B_list_set$ 0)
(declare-sort B_list_list$ 0)
(declare-fun v$ () B_list$)
(declare-fun ma$ () B_list_list$)
(declare-fun set$ (B_list_list$) B_list_set$)
(declare-fun cons$ (B_list$ B_list_list$) B_list_list$)
(declare-fun member$ (B_list$ B_list_set$) Bool)
(assert (! (not (member$ v$ (set$ (cons$ v$ ma$)))) :named conjecture0))
(check-sat)
(get-proof)
