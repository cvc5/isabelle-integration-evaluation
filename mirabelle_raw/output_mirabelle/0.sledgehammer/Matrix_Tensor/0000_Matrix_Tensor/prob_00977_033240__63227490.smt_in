; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 228
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun x$ () A_list$)
(declare-fun y$ () A_list$)
(declare-fun uu$ () Nat_nat_fun$)
(declare-fun nil$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$) Nat_nat_fun$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun fun_app$a (A_a_fun$ A$) A$)
(declare-fun fun_app$b (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ uu$ ?v0) zero$) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (=> (less$ i$ (fun_app$ (times$ (size$ nil$)) (size$ y$))) (= (nth$ (vec_vec_Tensor$ f$ nil$ y$) i$) (fun_app$a (fun_app$b f$ (nth$ nil$ (divide$ i$ (size$ y$)))) (nth$ y$ (modulo$ i$ (size$ y$))))))) :named conjecture1))
(assert (! (=> (less$ i$ (size$ (vec_vec_Tensor$ f$ nil$ y$))) (= (nth$ (vec_vec_Tensor$ f$ x$ y$) i$) (fun_app$a (fun_app$b f$ (nth$ x$ (divide$ i$ (size$ y$)))) (nth$ y$ (modulo$ i$ (size$ y$)))))) :named a2))
(assert (! (=> (less$ i$ (size$ (vec_vec_Tensor$ f$ nil$ y$))) false) :named a3))
(assert (! (= (size$ nil$) zero$) :named a4))
(assert (! (= uu$ (times$ zero$)) :named a5))
(check-sat)
(get-proof)
