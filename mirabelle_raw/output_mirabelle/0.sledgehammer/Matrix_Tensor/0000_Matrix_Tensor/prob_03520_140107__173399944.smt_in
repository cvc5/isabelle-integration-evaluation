; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun x$ () A$)
(declare-fun y$ () A$)
(declare-fun xs$ () A_list$)
(declare-fun ys$ () A_list$)
(declare-fun xss$ () A_list$)
(declare-fun yss$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_prodI$ (A$ A_a_a_fun_fun$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ xs$ ys$) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ x$) y$)) (scalar_product$ f$ zer$ g$ xss$ yss$)))) :named conjecture0))
(assert (! (and (= ys$ (cons$ y$ yss$)) (= (size$ yss$) k$)) :named a1))
(assert (! (and (= xs$ (cons$ x$ xss$)) (= (size$ xss$) k$)) :named a2))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A_a_a_fun_fun$) (?v3 A$) (?v4 A_list$) (?v5 A$) (?v6 A_list$)) (! (= (scalar_prodI$ ?v0 ?v1 ?v2 (cons$ ?v3 ?v4) (cons$ ?v5 ?v6)) (fun_app$ (fun_app$a ?v1 (fun_app$ (fun_app$a ?v2 ?v3) ?v5)) (scalar_prodI$ ?v0 ?v1 ?v2 ?v4 ?v6))) :pattern ((scalar_prodI$ ?v0 ?v1 ?v2 (cons$ ?v3 ?v4) (cons$ ?v5 ?v6))))) :named a3))
(check-sat)
(get-proof)
