(declare-fun member$b (A$ A_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (size$ (nth$ a$ j$)) (row_length$ a$))) :named conjecture0))
(assert (! (less$ j$ (size$a a$)) :named a1))
(assert (! (mat$ nr$ nc$ a$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (=> (mat$ ?v0 ?v1 ?v2) (mat$ (row_length$ ?v2) (size$a ?v2) ?v2))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list_list$)) (= (mat$a ?v0 ?v1 ?v2) (and (= (size$b ?v2) ?v1) (forall ((?v3 A_list_list$)) (=> (member$ ?v3 (set$ ?v2)) (vec$ ?v0 ?v3)))))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$a ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$a ?v3 (set$a ?v2)) (vec$a ?v0 ?v3)))))) :named a5))
(assert (! (= (size$b nil$) zero$) :named a6))
(assert (! (= (size$ nil$a) zero$) :named a7))
(assert (! (= (size$a nil$b) zero$) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list_list$)) (! (= (vec$b ?v0 ?v1) (= (size$b ?v1) ?v0)) :pattern ((vec$b ?v0 ?v1)))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (vec$a ?v0 ?v1) (= (size$ ?v1) ?v0)) :pattern ((vec$a ?v0 ?v1)))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (! (= (vec$ ?v0 ?v1) (= (size$a ?v1) ?v0)) :pattern ((vec$ ?v0 ?v1)))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list_list$)) (=> (less$ ?v0 (size$b ?v1)) (member$ (nth$a ?v1 ?v0) (set$ ?v1)))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (=> (less$ ?v0 (size$ ?v1)) (member$b (nth$b ?v1 ?v0) (set$b ?v1)))) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 A_list_list$)) (=> (less$ ?v0 (size$a ?v1)) (member$a (nth$ ?v1 ?v0) (set$a ?v1)))) :named a14))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a15))
(check-sat)
(get-proof)
