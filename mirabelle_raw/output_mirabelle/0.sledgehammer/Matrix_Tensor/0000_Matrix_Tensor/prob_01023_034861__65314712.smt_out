unsat
(assume conjecture22 (! (not (! (fun_app$b (fun_app$c less$ zero$a) (fun_app$g size$b y$)) :named @p_1)) :named @p_2))
(assume a23 (! (not (= y$ nil$)) :named @p_3))
(assume a25 (! (=> @p_3 @p_1) :named @p_4))
(step t0 (cl (! (not @p_4) :named @p_5) (not @p_3) @p_1) :rule implies_pos)
(step t1 (cl @p_5) :rule resolution :premises (t0 a23 conjecture22))
(step t2 (cl) :rule resolution :premises (a25 t1))
