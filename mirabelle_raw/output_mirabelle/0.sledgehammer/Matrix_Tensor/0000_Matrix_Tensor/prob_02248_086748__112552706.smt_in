; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 247
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_list_a_list_list_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun append$ (A_list_list$) A_list_list_a_list_list_fun$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun fun_app$ (A_list_list_a_list_list_fun$ A_list_list$) A_list_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (= (row$ (tensor$ f$ (cons$ v$ m$) m2$) i$) (row$ (vec_mat_Tensor$ f$ v$ m2$) i$))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list_list$)) (! (= (tensor$ f$ (cons$ ?v0 ?v1) ?v2) (fun_app$ (append$ (vec_mat_Tensor$ f$ ?v0 ?v2)) (tensor$ f$ ?v1 ?v2))) :pattern ((tensor$ f$ (cons$ ?v0 ?v1) ?v2)))) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (! (= (tensor$ f$ nil$ ?v0) nil$) :pattern ((tensor$ f$ nil$ ?v0)))) :named a2))
(assert (! (forall ((?v0 A_list_list$)) (! (= (fun_app$ (append$ ?v0) nil$) ?v0) :pattern ((append$ ?v0)))) :named a3))
(check-sat)
(get-proof)
