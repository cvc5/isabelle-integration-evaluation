; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 283
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list_list$)
(declare-fun j$ () Nat$)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun nr$ () Nat$)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ a$) nr$)) :named conjecture0))
(assert (! (member$ (hd$ a$) (set$ a$)) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$ (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a2))
(assert (! (forall ((?v0 A_list$)) (! (=> (member$ ?v0 (set$ a$)) (= (size$ ?v0) nr$)) :pattern ((size$ ?v0)))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a4))
(assert (! (= (row_length$ nil$) zero$) :named a5))
(assert (! (= (size$ (nth$ a$ j$)) nr$) :named a6))
(check-sat)
(get-proof)
