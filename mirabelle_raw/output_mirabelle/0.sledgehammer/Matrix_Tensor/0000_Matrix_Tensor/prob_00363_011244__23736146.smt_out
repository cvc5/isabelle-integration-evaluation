unsat
(assume conjecture3 (! (not (! (fun_app$d (! (mat$ nr$ nc$) :named @p_2) (! (fun_app$e (cons$ a$) n$) :named @p_1)) :named @p_3)) :named @p_4))
(assume a6 (! (= m$ @p_1) :named @p_5))
(assume a8 (! (fun_app$d @p_2 m$) :named @p_6))
(step t0 (cl (not (! (= @p_6 @p_3) :named @p_7)) (not @p_6) @p_3) :rule equiv_pos2)
(step t1 (cl @p_7) :rule cong :premises (a6))
(step t2 (cl @p_3) :rule resolution :premises (t0 t1 a8))
(step t3 (cl) :rule resolution :premises (t2 conjecture3))
