(assert (! (forall ((?v0 B_list$) (?v1 B_list$) (?v2 Nat$)) (= (nth$ (append$ ?v0 ?v1) ?v2) (ite (less$ ?v2 (size$ ?v0)) (nth$ ?v0 ?v2) (nth$ ?v1 (minus$ ?v2 (size$ ?v0)))))) :named a22))
(assert (! (forall ((?v0 B_list$) (?v1 B$)) (not (= ?v0 (cons$ ?v1 ?v0)))) :named a23))
(assert (! (= (set$ nil$) bot$) :named a24))
(assert (! (forall ((?v0 B_set$) (?v1 B_bool_fun$) (?v2 B$)) (=> (and (forall ((?v3 B$)) (=> (member$ ?v3 ?v0) (fun_app$ ?v1 ?v3))) (member$ ?v2 ?v0)) (fun_app$ ?v1 ?v2))) :named a25))
(assert (! (forall ((?v0 Nat$)) (= (plus$ zero$ ?v0) ?v0)) :named a26))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a27))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 Nat$)) (! (= (nth$ (cons$ ?v0 ?v1) (suc$ ?v2)) (nth$ ?v1 ?v2)) :pattern ((nth$ (cons$ ?v0 ?v1) (suc$ ?v2))))) :named a28))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 B$) (?v3 B_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a29))
