(assert (! (forall ((?v0 B_b_bool_fun_fun$) (?v1 B_list$)) (= (sorted_wrt$ ?v0 ?v1) (forall ((?v2 Nat$) (?v3 Nat$)) (=> (and (less$ ?v2 ?v3) (less$ ?v3 (size$ ?v1))) (fun_app$ (fun_app$a ?v0 (nth$ ?v1 ?v2)) (nth$ ?v1 ?v3)))))) :named a11))
(assert (! (forall ((?v0 B$) (?v1 B_list$) (?v2 B_list$)) (! (= (append$ (cons$ ?v0 ?v1) ?v2) (cons$ ?v0 (append$ ?v1 ?v2))) :pattern ((append$ (cons$ ?v0 ?v1) ?v2)))) :named a12))
(assert (! (forall ((?v0 B_set$) (?v1 B_bool_fun$)) (= (forall ((?v2 B$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))) (forall ((?v2 B$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))))) :named a13))
(assert (! (= one$ (suc$ zero$)) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 B_list$)) (=> (less$ ?v0 (size$ ?v1)) (member$ (nth$ ?v1 ?v0) (set$ ?v1)))) :named a15))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a16))
(assert (! (forall ((?v0 Nat$)) (less$ zero$ (suc$ ?v0))) :named a17))
(assert (! (forall ((?v0 B$) (?v1 B$) (?v2 B_set$)) (= (member$ ?v0 (insert$ ?v1 ?v2)) (or (= ?v0 ?v1) (member$ ?v0 ?v2)))) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ (suc$ ?v0) (suc$ ?v1)) (less$ ?v0 ?v1))) :named a19))
(assert (! (forall ((?v0 B$) (?v1 B_list$)) (! (= (set$ (cons$ ?v0 ?v1)) (insert$ ?v0 (set$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a20))
