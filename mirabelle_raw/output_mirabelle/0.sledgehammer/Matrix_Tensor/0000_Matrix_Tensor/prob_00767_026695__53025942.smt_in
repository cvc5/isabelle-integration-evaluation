(assert (! (forall ((?v0 B_list$) (?v1 B$)) (! (= (fun_app$ (uu$ ?v0) ?v1) (exists ((?v2 Nat$)) (and (= ?v1 (nth$ ?v0 ?v2)) (less$ ?v2 (size$ ?v0))))) :pattern ((fun_app$ (uu$ ?v0) ?v1)))) :named a0))
(assert (! (not false) :named conjecture1))
(assert (! (less$ i$ (size$ nil$)) :named hypothesis2))
