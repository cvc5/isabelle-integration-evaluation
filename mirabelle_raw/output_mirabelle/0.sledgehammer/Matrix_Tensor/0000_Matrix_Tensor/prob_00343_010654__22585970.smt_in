; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort B_set$ 0)
(declare-sort B_list$ 0)
(declare-fun a$ () B$)
(declare-fun m$ () B_list$)
(declare-fun x$ () B$)
(declare-fun set$ (B_list$) B_set$)
(declare-fun cons$ (B$ B_list$) B_list$)
(declare-fun member$ (B$ B_set$) Bool)
(assert (! (not (or (= x$ a$) (member$ x$ (set$ m$)))) :named conjecture0))
(assert (! (member$ x$ (set$ (cons$ a$ m$))) :named a1))
(assert (! (forall ((?v0 B$) (?v1 B$) (?v2 B_list$)) (=> (member$ ?v0 (set$ (cons$ ?v1 ?v2))) (or (= ?v0 ?v1) (member$ ?v0 (set$ ?v2))))) :named a2))
(check-sat)
(get-proof)
