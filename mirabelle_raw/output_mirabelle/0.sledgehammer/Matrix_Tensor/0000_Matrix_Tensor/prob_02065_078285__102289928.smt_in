(declare-fun size$a (A_list_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= nr$ (size$ w$))) :named conjecture0))
(assert (! (mat$ nr$ (size$a (cons$ w$ n$)) (cons$ w$ n$)) :named hypothesis1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$) (?v3 Nat$) (?v4 A_list$)) (=> (and (mat$ ?v0 ?v1 ?v2) (and (mat$ ?v3 ?v1 ?v2) (and (= ?v4 (hd$ ?v2)) (not (= ?v2 nil$))))) (forall ((?v5 A_list$)) (=> (member$ ?v5 (set$ ?v2)) (= ?v0 ?v3))))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (=> (mat$ ?v0 ?v1 ?v2) (mat$ (row_length$ ?v2) (size$a ?v2) ?v2))) :named a4))
(assert (! (= (row_length$ (cons$ w$ n$)) (size$ w$)) :named a5))
(assert (! (forall ((?v0 A_list_list$)) (=> (not (= ?v0 nil$)) (member$ (hd$ ?v0) (set$ ?v0)))) :named a6))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (member$ ?v0 (set$ (cons$ ?v0 ?v1)))) :named a7))
(check-sat)
(get-proof)
