; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_list_fun$ 0)
(declare-sort A_list_a_fun$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-fun a$ () A$)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun w$ () A_list$)
(declare-fun uu$ () A_list_a_fun$)
(declare-fun w2$ () A_list$)
(declare-fun map$ (A_list_a_fun$ A_list_list$) A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun map$a (A_list_a_list_fun$ A_list_list$) A_list_list$)
(declare-fun map$b (A_a_list_fun$ A_list$) A_list_list$)
(declare-fun map$c (A_a_fun$) A_list_a_list_fun$)
(declare-fun cons$a (A$) A_list_a_list_fun$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_list_a_fun$ A_list$) A$)
(declare-fun fun_app$a (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun fun_app$b (A_a_list_fun$ A$) A_list$)
(declare-fun fun_app$c (A_a_fun$ A$) A$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ uu$ ?v0) (nth$ ?v0 (modulo$ i$ (row_length$ (cons$ w$ n$))))) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (= (map$ uu$ (cons$ w$ n$)) (fun_app$a (cons$a (nth$ w$ (modulo$ i$ (row_length$ (cons$ w$ n$))))) (map$ uu$ n$)))) :named conjecture1))
(assert (! (= w$ (fun_app$a (cons$a a$) w2$)) :named a2))
(assert (! (forall ((?v0 A_list_a_list_fun$) (?v1 A_list$) (?v2 A_list_list$)) (! (= (map$a ?v0 (cons$ ?v1 ?v2)) (cons$ (fun_app$a ?v0 ?v1) (map$a ?v0 ?v2))) :pattern ((map$a ?v0 (cons$ ?v1 ?v2))))) :named a3))
(assert (! (forall ((?v0 A_list_a_fun$) (?v1 A_list$) (?v2 A_list_list$)) (! (= (map$ ?v0 (cons$ ?v1 ?v2)) (fun_app$a (cons$a (fun_app$ ?v0 ?v1)) (map$ ?v0 ?v2))) :pattern ((map$ ?v0 (cons$ ?v1 ?v2))))) :named a4))
(assert (! (forall ((?v0 A_a_list_fun$) (?v1 A$) (?v2 A_list$)) (! (= (map$b ?v0 (fun_app$a (cons$a ?v1) ?v2)) (cons$ (fun_app$b ?v0 ?v1) (map$b ?v0 ?v2))) :pattern ((map$b ?v0 (fun_app$a (cons$a ?v1) ?v2))))) :named a5))
(assert (! (forall ((?v0 A_a_fun$) (?v1 A$) (?v2 A_list$)) (! (= (fun_app$a (map$c ?v0) (fun_app$a (cons$a ?v1) ?v2)) (fun_app$a (cons$a (fun_app$c ?v0 ?v1)) (fun_app$a (map$c ?v0) ?v2))) :pattern ((fun_app$a (map$c ?v0) (fun_app$a (cons$a ?v1) ?v2))))) :named a6))
(check-sat)
(get-proof)
