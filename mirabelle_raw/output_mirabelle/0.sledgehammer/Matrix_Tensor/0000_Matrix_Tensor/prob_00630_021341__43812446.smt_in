; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () B_list$)
(declare-fun nil$a () A_list_list$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(assert (! (not (= (times$ (size$ nil$) (size$a m2$)) zero$)) :named conjecture0))
(assert (! (= (size$ nil$) zero$) :named a1))
(assert (! (= (size$a nil$a) zero$) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (times$ zero$ ?v0) zero$)) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a4))
(check-sat)
(get-proof)
