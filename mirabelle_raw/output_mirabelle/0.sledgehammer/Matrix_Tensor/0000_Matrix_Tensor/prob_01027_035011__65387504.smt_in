; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 245
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun one$ () Nat$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(assert (! (not (=> (less$ (size$ y$) i$) (= (divide$ i$ (size$ y$)) (plus$ (divide$ (minus$ i$ (size$ y$)) (size$ y$)) one$)))) :named conjecture0))
(assert (! (less$ zero$ (size$ y$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ zero$ ?v0) (less$ ?v0 ?v1)) (= (divide$ ?v1 ?v0) (plus$ (divide$ (minus$ ?v1 ?v0) ?v0) one$)))) :named a2))
(check-sat)
(get-proof)
