; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 5000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Int_int_fun$ 0)
(declare-fun a$ () Int)
(declare-fun b$ () Int)
(declare-fun uu$ (Int) Int_int_fun$)
(declare-fun divide$ (Int Int) Int)
(declare-fun fun_app$ (Int_int_fun$ Int) Int)
(assert (! (forall ((?v0 Int) (?v1 Int)) (! (= (fun_app$ (uu$ ?v0) ?v1) (- ?v0 ?v1)) :pattern ((fun_app$ (uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (<= 0 (- a$ b$))) :named conjecture1))
(assert (! (<= b$ a$) :named a2))
(assert (! (< 0 b$) :named a3))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (<= 0 (- ?v0 ?v1)) (<= ?v1 ?v0))) :named a4))
(assert (! (forall ((?v0 Int)) (= (- ?v0 0) ?v0)) :named a5))
(assert (! (forall ((?v0 Int)) (! (= (- ?v0 ?v0) 0) :pattern ((uu$ ?v0)))) :named a6))
(assert (! (forall ((?v0 Int)) (<= ?v0 ?v0)) :named a7))
(assert (! (forall ((?v0 Int)) (= (- ?v0 0) ?v0)) :named a8))
(assert (! (forall ((?v0 Int)) (! (= (- ?v0 ?v0) 0) :pattern ((uu$ ?v0)))) :named a9))
(assert (! (forall ((?v0 Int) (?v1 Int)) (=> (and (< 0 ?v0) (<= ?v0 ?v1)) (= (divide$ ?v1 ?v0) (+ (divide$ (- ?v1 ?v0) ?v0) 1)))) :named a10))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (<= ?v0 ?v1) (<= (- ?v0 ?v1) 0))) :named a11))
(assert (! (forall ((?v0 Int)) (not (< ?v0 ?v0))) :named a12))
(assert (! (forall ((?v0 Int)) (= (+ 0 ?v0) ?v0)) :named a13))
(assert (! (forall ((?v0 Int)) (<= ?v0 ?v0)) :named a14))
(assert (! (forall ((?v0 Int)) (= (+ ?v0 0) ?v0)) :named a15))
(assert (! (forall ((?v0 Int)) (= (+ 0 ?v0) ?v0)) :named a16))
(assert (! (forall ((?v0 Int)) (= (* 0 ?v0) 0)) :named a17))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (not (<= ?v0 ?v1)) (< ?v1 ?v0))) :named a18))
(assert (! (forall ((?v0 Int) (?v1 Int)) (= (< 0 (- ?v0 ?v1)) (< ?v1 ?v0))) :named a19))
(assert (! (forall ((?v0 Int)) (exists ((?v1 Int)) (< ?v1 ?v0))) :named a20))
(check-sat)
(get-proof)
