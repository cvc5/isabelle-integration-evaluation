; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun dvd$ (Nat$ Nat$) Bool)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$))) :named conjecture0))
(assert (! (= (minus$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$)) zero$) :named a1))
(assert (! (= (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)) zero$) :named a2))
(assert (! (less$ (modulo$ (divide$ a$ c$) b$) b$) :named a3))
(assert (! (less$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) b$) :named a4))
(assert (! (dvd$ b$ (minus$ (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (modulo$ ?v0 ?v1) (ite (less$ ?v0 ?v1) ?v0 (modulo$ (minus$ ?v0 ?v1) ?v1)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (minus$ ?v0 ?v1) zero$) (less_eq$ ?v0 ?v1))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (= (modulo$ ?v1 ?v2) (modulo$ ?v0 ?v2)) (dvd$ ?v2 (minus$ ?v1 ?v0))))) :named a8))
(check-sat)
(get-proof)
