; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun v1$ () A_list$)
(declare-fun v2$ () A_list$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun euclidean_size$ (Nat$) Nat$)
(assert (! (not (=> (and (= (size$ v1$) (size$ v2$)) (and (= (size$ v1$) zero$) (= (size$ w1$) (size$ w2$)))) (= (size$ v2$) zero$))) :named conjecture0))
(assert (! (=> (and (= (size$ v1$) (size$ v2$)) (and (= (size$ v1$) zero$) (= (size$ w1$) (size$ w2$)))) (= v1$ nil$)) :named a1))
(assert (! (= (euclidean_size$ zero$) zero$) :named a2))
(check-sat)
(get-proof)
