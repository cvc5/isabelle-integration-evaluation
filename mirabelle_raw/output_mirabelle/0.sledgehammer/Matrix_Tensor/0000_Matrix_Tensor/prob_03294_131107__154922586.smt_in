(assert (! (not (= (col$ (tensor$ f$ a2$ b2$) j$) (vec_vec_Tensor$ f$ (col$ a2$ (divide$ j$ (size$ b2$))) (col$ b2$ (modulo$ j$ (size$ b2$)))))) :named conjecture0))
(assert (! (less$ j$ (times$ (size$ a2$) (size$ b2$))) :named a1))
(assert (! (mat$ (row_length$ b2$) (size$ b2$) b2$) :named a2))
(assert (! (mat$ (row_length$ a2$) (size$ a2$) a2$) :named a3))
(check-sat)
(get-proof)
