; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun x$ () A$)
(declare-fun ma$ () A_list_list$)
(declare-fun xs$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () A_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (less$ zero$ (size$ (cons$ a$ ma$)))) :named conjecture0))
(assert (! (= (size$ nil$) zero$) :named a1))
(assert (! (= (size$a nil$a) zero$) :named a2))
(assert (! (forall ((?v0 A_list_list$)) (= (less$ zero$ (size$ ?v0)) (not (= ?v0 nil$)))) :named a3))
(assert (! (forall ((?v0 A_list$)) (= (less$ zero$ (size$a ?v0)) (not (= ?v0 nil$a)))) :named a4))
(assert (! (= a$ (cons$a x$ xs$)) :named a5))
(assert (! (= (row_length$ (cons$ a$ ma$)) (size$a a$)) :named a6))
(assert (! (= (row_length$ nil$) zero$) :named a7))
(assert (! (not (less$ zero$ zero$)) :named a8))
(assert (! (not (= a$ nil$a)) :named a9))
(check-sat)
(get-proof)
