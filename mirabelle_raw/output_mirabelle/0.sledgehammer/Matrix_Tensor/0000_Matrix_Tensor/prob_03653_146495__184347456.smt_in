; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 302
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun a1$ () A$)
(declare-fun a2$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun u2$ () A_list$)
(declare-fun v1$ () A_list$)
(declare-fun v2$ () A_list$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ (append$ (times$ f$ a1$ w1$) (vec_vec_Tensor$ f$ u1$ w1$)) (append$ (times$ f$ a2$ w2$) (vec_vec_Tensor$ f$ u2$ w2$))) (fun_app$ (fun_app$a g$ (scalar_product$ f$ zer$ g$ (times$ f$ a1$ w1$) (times$ f$ a2$ w2$))) (scalar_product$ f$ zer$ g$ (vec_vec_Tensor$ f$ u1$ w1$) (vec_vec_Tensor$ f$ u2$ w2$))))) :named conjecture0))
(assert (! (= (size$ (times$ f$ a1$ w1$)) (size$ (times$ f$ a2$ w2$))) :named a1))
(assert (! (= (size$ (vec_vec_Tensor$ f$ u2$ w2$)) (size$ (vec_vec_Tensor$ f$ u1$ w1$))) :named a2))
(assert (! (= (scalar_product$ f$ zer$ g$ (vec_vec_Tensor$ f$ v1$ w1$) (vec_vec_Tensor$ f$ v2$ w2$)) (scalar_product$ f$ zer$ g$ (append$ (times$ f$ a1$ w1$) (vec_vec_Tensor$ f$ u1$ w1$)) (append$ (times$ f$ a2$ w2$) (vec_vec_Tensor$ f$ u2$ w2$)))) :named a3))
(check-sat)
(get-proof)
