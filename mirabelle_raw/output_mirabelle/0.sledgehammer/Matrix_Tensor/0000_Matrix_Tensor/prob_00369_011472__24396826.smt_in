(declare-sort A_list_list$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-sort A_list_list_list_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun n$ () A_list_list$)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list_list$)
(declare-fun nil$b () A_list_list_list_list_list$)
(declare-fun nil$c () A_list_list_list_list$)
(declare-fun nil$d () A_list_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun concat$ (A_list_list_list_list_list$) A_list_list_list_list$)
(declare-fun concat$a (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$b (A_list_list_list$) A_list_list$)
(declare-fun concat$c (A_list_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ (cons$ a$ n$)) (size$ a$))) :named conjecture0))
(assert (! (= (row_length$ (cons$ nil$ nil$a)) zero$) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$a) zero$ (size$ (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (hd$ (cons$ ?v0 ?v1)) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a3))
(assert (! (= (concat$ nil$b) nil$c) :named a4))
(assert (! (= (concat$a nil$c) nil$d) :named a5))
(assert (! (= (concat$b nil$d) nil$a) :named a6))
(assert (! (= (concat$c nil$a) nil$) :named a7))
(check-sat)
(get-proof)
