; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 299
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun n$ () A_list_list$)
(declare-fun w$ () A_list$)
(declare-fun hd$ (A_list$) A$)
(declare-fun hd$a (A_list_list$) A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun nil$a () A_list$)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun reduct$ (A_list_list$) A_list_list$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ (cons$ w$ n$)) (size$ w$))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a1))
(assert (! (= (size$a nil$) zero$) :named a2))
(assert (! (= (size$ nil$a) zero$) :named a3))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (hd$ (cons$a ?v0 ?v1)) ?v0) :pattern ((cons$a ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (hd$a (cons$ ?v0 ?v1)) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a5))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$ (hd$a ?v0)))) :pattern ((row_length$ ?v0)))) :named a6))
(assert (! (= (reduct$ nil$) nil$) :named a7))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a8))
(assert (! (not (less_eq$ one$ zero$)) :named a9))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$a (cons$ ?v0 ?v1)) (fun_app$ suc$ (size$a ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a10))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$a ?v0 ?v1)) (fun_app$ suc$ (size$ ?v1))) :pattern ((cons$a ?v0 ?v1)))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (minus$ ?v0 ?v1) zero$) (less_eq$ ?v0 ?v1))) :named a12))
(assert (! (= (plus$ one$) suc$) :named a13))
(check-sat)
(get-proof)
