; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 231
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_b_fun$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_b_list_fun$ 0)
(declare-sort B_list_b_fun$ 0)
(declare-sort B_list_b_list_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun m$ () B_list_list$)
(declare-fun v$ () B_list$)
(declare-fun uu$ () B_list_b_fun$)
(declare-fun map$ (B_list_b_fun$ B_list_list$) B_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun cons$ (B_list$ B_list_list$) B_list_list$)
(declare-fun map$a (B_list_b_list_fun$ B_list_list$) B_list_list$)
(declare-fun map$b (B_b_list_fun$ B_list$) B_list_list$)
(declare-fun map$c (B_b_fun$) B_list_b_list_fun$)
(declare-fun cons$a (B$) B_list_b_list_fun$)
(declare-fun fun_app$ (B_list_b_fun$ B_list$) B$)
(declare-fun fun_app$a (B_list_b_list_fun$ B_list$) B_list$)
(declare-fun fun_app$b (B_b_list_fun$ B$) B_list$)
(declare-fun fun_app$c (B_b_fun$ B$) B$)
(assert (! (forall ((?v0 B_list$)) (! (= (fun_app$ uu$ ?v0) (nth$ ?v0 i$)) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (= (map$ uu$ (cons$ v$ m$)) (fun_app$a (cons$a (nth$ v$ i$)) (map$ uu$ m$)))) :named conjecture1))
(assert (! (forall ((?v0 B_list_b_list_fun$) (?v1 B_list$) (?v2 B_list_list$)) (! (= (map$a ?v0 (cons$ ?v1 ?v2)) (cons$ (fun_app$a ?v0 ?v1) (map$a ?v0 ?v2))) :pattern ((map$a ?v0 (cons$ ?v1 ?v2))))) :named a2))
(assert (! (forall ((?v0 B_list_b_fun$) (?v1 B_list$) (?v2 B_list_list$)) (! (= (map$ ?v0 (cons$ ?v1 ?v2)) (fun_app$a (cons$a (fun_app$ ?v0 ?v1)) (map$ ?v0 ?v2))) :pattern ((map$ ?v0 (cons$ ?v1 ?v2))))) :named a3))
(assert (! (forall ((?v0 B_b_list_fun$) (?v1 B$) (?v2 B_list$)) (! (= (map$b ?v0 (fun_app$a (cons$a ?v1) ?v2)) (cons$ (fun_app$b ?v0 ?v1) (map$b ?v0 ?v2))) :pattern ((map$b ?v0 (fun_app$a (cons$a ?v1) ?v2))))) :named a4))
(assert (! (forall ((?v0 B_b_fun$) (?v1 B$) (?v2 B_list$)) (! (= (fun_app$a (map$c ?v0) (fun_app$a (cons$a ?v1) ?v2)) (fun_app$a (cons$a (fun_app$c ?v0 ?v1)) (fun_app$a (map$c ?v0) ?v2))) :pattern ((fun_app$a (map$c ?v0) (fun_app$a (cons$a ?v1) ?v2))))) :named a5))
(check-sat)
(get-proof)
