; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A$)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun w$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun cons$a (A_list$ A_list_list$) A_list_list$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (cons$ (nth$ w$ (modulo$ i$ (row_length$ (cons$a w$ n$)))) (row$ n$ (modulo$ i$ (row_length$ (cons$a w$ n$))))) (cons$ (nth$ w$ (modulo$ i$ (size$ w$))) (row$ n$ (modulo$ i$ (row_length$ n$)))))) :named conjecture0))
(assert (! (= (row$ (cons$a w$ n$) (modulo$ i$ (row_length$ (cons$a w$ n$)))) (cons$ (nth$ w$ (modulo$ i$ (row_length$ (cons$a w$ n$)))) (row$ n$ (modulo$ i$ (row_length$ (cons$a w$ n$)))))) :named a1))
(assert (! (= w$ (cons$ a$ w2$)) :named a2))
(assert (! (= (row_length$ (cons$a w$ n$)) (size$ w$)) :named a3))
(assert (! (= (row_length$ (cons$a w$ n$)) (row_length$ n$)) :named a4))
(check-sat)
(get-proof)
