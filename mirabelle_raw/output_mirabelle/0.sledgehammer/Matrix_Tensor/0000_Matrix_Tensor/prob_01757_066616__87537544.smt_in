; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun m$ () A_list_list$)
(declare-fun p$ () A_list_list$)
(declare-fun u$ () A_list$)
(declare-fun v$ () A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (mat$ (row_length$ (cons$ v$ m$)) (size$ (cons$ v$ m$)) (cons$ v$ m$)) (= (row_length$ (cons$ v$ m$)) (row_length$ m$)))) :named conjecture0))
(assert (! (= m$ (cons$ u$ p$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list_list$)) (! (=> (mat$ (row_length$ (cons$ ?v0 (cons$ ?v1 ?v2))) (size$ (cons$ ?v0 (cons$ ?v1 ?v2))) (cons$ ?v0 (cons$ ?v1 ?v2))) (= (row_length$ (cons$ ?v0 (cons$ ?v1 ?v2))) (row_length$ (cons$ ?v1 ?v2)))) :pattern ((cons$ ?v0 (cons$ ?v1 ?v2))))) :named a2))
(check-sat)
(get-proof)
