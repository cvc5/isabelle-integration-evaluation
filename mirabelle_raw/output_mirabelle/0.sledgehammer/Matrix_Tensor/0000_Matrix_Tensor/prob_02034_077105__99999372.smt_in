; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 256
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort B$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort B_list_list$ 0)
(declare-sort B_list_b_fun$ 0)
(declare-sort B_list_list_list$ 0)
(declare-sort B_list_list_list_list$ 0)
(declare-sort B_list_list_b_list_fun$ 0)
(declare-sort B_list_list_list_list_list$ 0)
(declare-sort B_list_b_fun_b_list_list_b_list_fun_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun uu$ () B_list_b_fun$)
(declare-fun map$ () B_list_b_fun_b_list_list_b_list_fun_fun$)
(declare-fun nil$ () B_list_list$)
(declare-fun nth$ (B_list$ Nat$) B$)
(declare-fun nil$a () B_list$)
(declare-fun nil$b () B_list_list_list_list_list$)
(declare-fun nil$c () B_list_list_list_list$)
(declare-fun nil$d () B_list_list_list$)
(declare-fun concat$ (B_list_list_list_list_list$) B_list_list_list_list$)
(declare-fun concat$a (B_list_list_list_list$) B_list_list_list$)
(declare-fun concat$b (B_list_list_list$) B_list_list$)
(declare-fun concat$c (B_list_list$) B_list$)
(declare-fun fun_app$ (B_list_b_fun$ B_list$) B$)
(declare-fun fun_app$a (B_list_list_b_list_fun$ B_list_list$) B_list$)
(declare-fun fun_app$b (B_list_b_fun_b_list_list_b_list_fun_fun$ B_list_b_fun$) B_list_list_b_list_fun$)
(declare-fun map_tailrec$ () B_list_b_fun_b_list_list_b_list_fun_fun$)
(assert (! (forall ((?v0 B_list$)) (! (= (fun_app$ uu$ ?v0) (nth$ ?v0 i$)) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (= (fun_app$a (fun_app$b map$ uu$) nil$) nil$a)) :named conjecture1))
(assert (! (= map$ map_tailrec$) :named a2))
(assert (! (= (concat$ nil$b) nil$c) :named a3))
(assert (! (= (concat$a nil$c) nil$d) :named a4))
(assert (! (= (concat$b nil$d) nil$) :named a5))
(assert (! (= (concat$c nil$) nil$a) :named a6))
(check-sat)
(get-proof)
