; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 230
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun j$ () Nat$)
(declare-fun m2$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (=> (and (less$ j$ (times$ (size$ nil$) (size$ m2$))) (and (mat$ (row_length$ nil$) (size$ nil$) nil$) (mat$ (row_length$ m2$) (size$ m2$) m2$))) (= (col$ (tensor$ f$ nil$ m2$) j$) (vec_vec_Tensor$ f$ (col$ nil$ (divide$ j$ (size$ m2$))) (col$ m2$ (modulo$ j$ (size$ m2$))))))) :named conjecture0))
(assert (! (= (size$ nil$) zero$) :named a1))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a2))
(check-sat)
(get-proof)
