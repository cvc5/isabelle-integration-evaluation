(declare-fun nth$a (A_list_list$ Nat$) A_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (forall ((?v0 Nat$) (?v1 Nat$)) (= (fun_app$ (fun_app$a f$ (nth$ (nth$a m1$ (divide$ ?v1 (times$ (size$ m2$) (size$ m3$)))) (divide$ ?v0 (times$ (row_length$ m2$) (row_length$ m3$))))) (fun_app$ (fun_app$a f$ (nth$ (nth$a m2$ (modulo$ (divide$ ?v1 (size$ m3$)) (size$ m2$))) (modulo$ (divide$ ?v0 (row_length$ m3$)) (row_length$ m2$)))) (nth$ (nth$a m3$ (modulo$ ?v1 (size$ m3$))) (modulo$ ?v0 (row_length$ m3$))))) (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ (nth$ (nth$a m1$ (divide$ ?v1 (times$ (size$ m2$) (size$ m3$)))) (divide$ ?v0 (times$ (row_length$ m2$) (row_length$ m3$))))) (nth$ (nth$a m2$ (modulo$ (divide$ ?v1 (size$ m3$)) (size$ m2$))) (modulo$ (divide$ ?v0 (row_length$ m3$)) (row_length$ m2$))))) (nth$ (nth$a m3$ (modulo$ ?v1 (size$ m3$))) (modulo$ ?v0 (row_length$ m3$))))))) :named conjecture0))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A$)) (= (fun_app$ (fun_app$a f$ (fun_app$ (fun_app$a f$ ?v0) ?v1)) ?v2) (fun_app$ (fun_app$a f$ ?v0) (fun_app$ (fun_app$a f$ ?v1) ?v2)))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A_a_a_fun_fun$) (?v2 A$) (?v3 A$) (?v4 A$)) (=> (mult$ ?v0 ?v1) (= (fun_app$ (fun_app$a ?v1 (fun_app$ (fun_app$a ?v1 ?v2) ?v3)) ?v4) (fun_app$ (fun_app$a ?v1 ?v2) (fun_app$ (fun_app$a ?v1 ?v3) ?v4))))) :named a2))
(assert (! (mult$ id$ f$) :named a3))
(check-sat)
