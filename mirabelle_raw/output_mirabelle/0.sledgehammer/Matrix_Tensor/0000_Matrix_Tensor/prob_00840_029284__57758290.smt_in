; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () B_list$)
(declare-fun z$ () C$)
(declare-fun zs$ () C_list$)
(declare-fun nil$ () C_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (C$ C_list$) C_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nil$a () B_list$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (C_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$a y$))) (less$ i$ (plus$ (times$ (size$ zs$) (size$a y$)) (size$a y$))))) :named conjecture0))
(assert (! (=> (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$a y$))) (less$ i$ (times$ (plus$ (size$ zs$) one$) (size$a y$)))) :named a1))
(assert (! (= one$ (suc$ zero$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (! (= (times$ (suc$ ?v0) ?v1) (plus$ ?v1 (times$ ?v0 ?v1))) :pattern ((times$ (suc$ ?v0) ?v1)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 ?v1) (plus$ ?v1 ?v0))) :named a5))
(assert (! (= (size$ nil$) zero$) :named a6))
(assert (! (= (size$a nil$a) zero$) :named a7))
(assert (! (forall ((?v0 Nat$)) (= ?v0 (plus$ ?v0 zero$))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (less_eq$ (suc$ ?v0) ?v1))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less_eq$ (suc$ ?v0) ?v1) (less$ ?v0 ?v1))) :named a10))
(check-sat)
(get-proof)
