; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 253
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_set$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_bool_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun x$ () A_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun set$ (A_list_list$) A_list_set$)
(declare-fun vec$ (Nat$) A_list_bool_fun$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun member$ (A_list$ A_list_set$) Bool)
(declare-fun fun_app$ (A_list_bool_fun$ A_list$) Bool)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (=> (member$ x$ (set$ (cons$ a$ m1a$))) (fun_app$ (vec$ (row_length$ (cons$ a$ m1a$))) x$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (= (mat$ ?v0 ?v1 ?v2) (and (= (size$ ?v2) ?v1) (forall ((?v3 A_list$)) (=> (member$ ?v3 (set$ ?v2)) (fun_app$ (vec$ ?v0) ?v3)))))) :named a1))
(assert (! (mat$ (row_length$ (cons$ a$ m1a$)) (size$ (cons$ a$ m1a$)) (cons$ a$ m1a$)) :named a2))
(assert (! (forall ((?v0 A_list_set$) (?v1 A_list_bool_fun$)) (= (forall ((?v2 A_list$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))) (forall ((?v2 A_list$)) (=> (member$ ?v2 ?v0) (fun_app$ ?v1 ?v2))))) :named a3))
(check-sat)
(get-proof)
