; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 286
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(assert (! (not (= (nth$ zs$ (divide$ (minus$ i$ (size$ y$)) (size$ y$))) (nth$ (cons$ z$ zs$) (plus$ (divide$ (minus$ i$ (size$ y$)) (size$ y$)) one$)))) :named conjecture0))
(assert (! (= (nth$ zs$ j$) (nth$ (cons$ z$ zs$) (plus$ j$ one$))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v0) ?v1)) :named a2))
(assert (! (forall ((?v0 Nat$)) (less$ ?v0 (plus$ ?v0 one$))) :named a3))
(assert (! (forall ((?v0 Nat$)) (= (not (less$ zero$ ?v0)) (= ?v0 zero$))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (plus$ ?v0 ?v1) zero$) (and (= ?v0 zero$) (= ?v1 zero$)))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 A$) (?v2 A_list$)) (! (=> (less$ zero$ ?v0) (= (nth$ (cons$ ?v1 ?v2) ?v0) (nth$ ?v2 (minus$ ?v0 one$)))) :pattern ((nth$ (cons$ ?v1 ?v2) ?v0)))) :named a6))
(check-sat)
(get-proof)
