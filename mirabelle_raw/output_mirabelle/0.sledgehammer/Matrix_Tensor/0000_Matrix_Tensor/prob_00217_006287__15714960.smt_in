; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort Literal$ 0)
(declare-sort Nat_list$ 0)
(declare-sort Char_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Literal_list$ 0)
(declare-fun hd$ (A_list_list$) A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun nil$a () Literal_list$)
(declare-fun nil$b () Nat_list$)
(declare-fun nil$c () Char_list$)
(declare-fun nil$d () A_list$)
(declare-fun size$ (Literal_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (Nat_list$) Nat$)
(declare-fun size$b (A_list_list$) Nat$)
(declare-fun size$c (Char_list$) Nat$)
(declare-fun size$d (A_list$) Nat$)
(declare-fun zero$a () Literal$)
(declare-fun explode$ (Literal$) Char_list$)
(declare-fun sum_list$ (Nat_list$) Nat$)
(declare-fun sum_list$a (Literal_list$) Literal$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ nil$) zero$)) :named conjecture0))
(assert (! (= (size$ nil$a) zero$) :named a1))
(assert (! (= (size$a nil$b) zero$) :named a2))
(assert (! (= (size$b nil$) zero$) :named a3))
(assert (! (= (size$c nil$c) zero$) :named a4))
(assert (! (= (size$d nil$d) zero$) :named a5))
(assert (! (forall ((?v0 A_list_list$)) (! (= (row_length$ ?v0) (ite (= ?v0 nil$) zero$ (size$d (hd$ ?v0)))) :pattern ((row_length$ ?v0)))) :named a6))
(assert (! (= (sum_list$ nil$b) zero$) :named a7))
(assert (! (= (sum_list$a nil$a) zero$a) :named a8))
(assert (! (= (explode$ zero$a) nil$c) :named a9))
(check-sat)
(get-proof)
