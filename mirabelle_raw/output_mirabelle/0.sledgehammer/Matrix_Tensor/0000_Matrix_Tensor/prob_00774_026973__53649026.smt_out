unsat
(assume conjecture12 (! (not (=> (! (fun_app$e (fun_app$f less$ i$) (fun_app$l size$e nil$)) :named @p_1) (= (fun_app$k (nth$c (fun_app$m (times$ f$ a$) nil$)) i$) (fun_app$n (fun_app$o f$ a$) (fun_app$k (nth$c nil$) i$))))) :named @p_2))
(assume a28 (! (=> @p_1 false) :named @p_3))
(step t0 (cl (not (! (= @p_3 (! (not @p_1) :named @p_4)) :named @p_5)) (not @p_3) @p_4) :rule equiv_pos2)
(step t1 (cl @p_5) :rule rare_rewrite :args ("bool-impl-false1" @p_1))
(step t2 (cl @p_4) :rule resolution :premises (t0 t1 a28))
