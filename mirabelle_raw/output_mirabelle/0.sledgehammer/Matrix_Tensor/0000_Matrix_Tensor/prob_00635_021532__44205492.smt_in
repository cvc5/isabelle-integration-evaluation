; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 223
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun m2$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list_list$)
(declare-fun nil$a () B_list$)
(declare-fun size$ (B_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ (times$ (row_length$ nil$) (row_length$ m2$)) (times$ (size$ nil$a) (size$a m2$)) (tensor$ f$ nil$ m2$))) :named conjecture0))
(assert (! (= (times$ (size$ nil$a) (size$a m2$)) zero$) :named a1))
(assert (! (= (times$ (size$a nil$) (size$a m2$)) zero$) :named a2))
(assert (! (= (tensor$ f$ nil$ m2$) nil$) :named a3))
(assert (! (= (times$ (row_length$ nil$) (row_length$ m2$)) zero$) :named a4))
(check-sat)
(get-proof)
