; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 276
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun j$ () Nat$)
(declare-fun m2$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ () Nat_nat_fun$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ m2$) j$) (= (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) (minus$ (divide$ j$ (size$ m2$)) one$)))) :named conjecture0))
(assert (! (= one$ (fun_app$ suc$ zero$)) :named a1))
(assert (! (= (plus$ one$) suc$) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (minus$ zero$ ?v0) zero$)) :named a3))
(assert (! (forall ((?v0 A_list_list$)) (= (= (size$ ?v0) zero$) (= ?v0 nil$))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ zero$ ?v0) (less_eq$ ?v0 ?v1)) (= (divide$ ?v1 ?v0) (fun_app$ suc$ (divide$ (minus$ ?v1 ?v0) ?v0))))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (divide$ ?v0 ?v1) zero$) (or (less$ ?v0 ?v1) (= ?v1 zero$)))) :named a6))
(assert (! (forall ((?v0 Nat$)) (=> (less$ zero$ ?v0) (= (fun_app$ suc$ (minus$ ?v0 (fun_app$ suc$ zero$))) ?v0))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ zero$ (divide$ ?v0 ?v1)) (and (less_eq$ ?v1 ?v0) (less$ zero$ ?v1)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (= (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v0) ?v2)) (= ?v1 ?v2))) :named a9))
(check-sat)
(get-proof)
