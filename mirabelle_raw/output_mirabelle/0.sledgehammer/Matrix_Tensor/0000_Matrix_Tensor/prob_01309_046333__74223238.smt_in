; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 244
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a$ () A_list$)
(declare-fun j$ () Nat$)
(declare-fun ma$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(assert (! (not (= (nth$ (cons$ a$ ma$) (plus$ j$ one$)) (nth$ ma$ j$))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (plus$ ?v0 ?v1) zero$) (and (= ?v0 zero$) (= ?v1 zero$)))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v1) ?v0)) :named a2))
(assert (! (not (= zero$ one$)) :named a3))
(check-sat)
(get-proof)
