; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 240
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-fun m$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list_list$)
(declare-fun zero$ () Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (mat$ zero$ zero$ m$)) :named conjecture0))
(assert (! (= m$ nil$) :named a1))
(assert (! (= (row_length$ nil$) zero$) :named a2))
(check-sat)
(get-proof)
