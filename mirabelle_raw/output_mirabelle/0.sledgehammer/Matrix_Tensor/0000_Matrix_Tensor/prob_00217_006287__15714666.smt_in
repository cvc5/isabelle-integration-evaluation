; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 248
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_list_list$ 0)
(declare-sort A_list_list_list_list$ 0)
(declare-sort A_list_list_list_list_list$ 0)
(declare-fun nil$ () A_list_list$)
(declare-fun nil$a () A_list_list_list_list$)
(declare-fun nil$b () A_list$)
(declare-fun nil$c () A_list_list_list$)
(declare-fun nil$d () A_list_list_list_list_list$)
(declare-fun size$ (A_list_list_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list$) Nat$)
(declare-fun size$b (A_list_list_list$) Nat$)
(declare-fun size$c (A_list_list$) Nat$)
(declare-fun concat$ (A_list_list_list_list_list$) A_list_list_list_list$)
(declare-fun concat$a (A_list_list_list_list$) A_list_list_list$)
(declare-fun concat$b (A_list_list_list$) A_list_list$)
(declare-fun concat$c (A_list_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (row_length$ nil$) zero$)) :named conjecture0))
(assert (! (= (size$ nil$a) zero$) :named a1))
(assert (! (= (size$a nil$b) zero$) :named a2))
(assert (! (= (size$b nil$c) zero$) :named a3))
(assert (! (= (size$c nil$) zero$) :named a4))
(assert (! (= (concat$ nil$d) nil$a) :named a5))
(assert (! (= (concat$a nil$a) nil$c) :named a6))
(assert (! (= (concat$b nil$c) nil$) :named a7))
(assert (! (= (concat$c nil$) nil$b) :named a8))
(check-sat)
(get-proof)
