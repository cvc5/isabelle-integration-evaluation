(step t10 (cl (= @p_8 false)) :rule evaluate)
(step t11 (cl @p_7) :rule trans :premises (t9 t10))
(step t12 (cl false) :rule resolution :premises (t0 t11 conjecture0))
(step t13 (cl (not false)) :rule false)
(step t14 (cl) :rule resolution :premises (t12 t13))
