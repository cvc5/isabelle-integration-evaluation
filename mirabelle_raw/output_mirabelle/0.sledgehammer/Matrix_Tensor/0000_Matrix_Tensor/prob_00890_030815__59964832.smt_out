unsat
(assume conjecture0 (! (not (! (= (! (- a$ b$) :named @p_4) (! (+ a$ (! (* (! (- 1) :named @p_1) b$) :named @p_2)) :named @p_3)) :named @p_5)) :named @p_6))
(step t0 (cl (not (! (= @p_6 false) :named @p_7)) (not @p_6) false) :rule equiv_pos2)
(step t1 (cl (= @p_4 (! (+ a$ (! (* -1 b$) :named @p_9)) :named @p_10))) :rule poly_simp)
(step t2 (cl (= @p_1 -1)) :rule evaluate)
(step t3 (cl (= b$ b$)) :rule refl)
(step t4 (cl (= @p_2 @p_9)) :rule cong :premises (t2 t3))
(step t5 (cl (= @p_3 @p_10)) :rule cong :premises (t4))
(step t6 (cl (= @p_5 (! (= @p_10 @p_10) :named @p_11))) :rule cong :premises (t1 t5))
