; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 257
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_prod$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_a_prod_list$ 0)
(declare-sort A_a_a_a_fun_fun_fun$ 0)
(declare-sort A_a_prod_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun x$ () A$)
(declare-fun y$ () A$)
(declare-fun uu$ () A_a_a_a_fun_fun_fun$)
(declare-fun xs$ () A_list$)
(declare-fun ys$ () A_list$)
(declare-fun xss$ () A_list$)
(declare-fun yss$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun zip$ (A_list$ A_list$) A_a_prod_list$)
(declare-fun comp$ (A_a_fun$ A_a_fun$) A_a_fun$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun pair$ (A$ A$) A_a_prod$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun cons$a (A_a_prod$ A_a_prod_list$) A_a_prod_list$)
(declare-fun foldr$ (A_a_prod_a_a_fun_fun$ A_a_prod_list$) A_a_fun$)
(declare-fun foldr$a (A_a_a_fun_fun$ A_list$) A_a_fun$)
(declare-fun fun_app$ (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun fun_app$a (A_a_a_a_fun_fun_fun$ A$) A_a_a_fun_fun$)
(declare-fun fun_app$b (A_a_fun$ A$) A$)
(declare-fun fun_app$c (A_a_prod_a_a_fun_fun$ A_a_prod$) A_a_fun$)
(declare-fun case_prod$ (A_a_a_a_fun_fun_fun$) A_a_prod_a_a_fun_fun$)
(assert (! (forall ((?v0 A$) (?v1 A$)) (! (= (fun_app$ (fun_app$a uu$ ?v0) ?v1) (fun_app$ g$ (fun_app$b (fun_app$ f$ ?v0) ?v1))) :pattern ((fun_app$ (fun_app$a uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (= (fun_app$b (foldr$ (case_prod$ uu$) (zip$ xs$ ys$)) zer$) (fun_app$b (fun_app$ g$ (fun_app$b (fun_app$ f$ x$) y$)) (fun_app$b (foldr$ (case_prod$ uu$) (zip$ xss$ yss$)) zer$)))) :named conjecture1))
(assert (! (forall ((?v0 A_a_fun$) (?v1 A_a_fun$) (?v2 A$)) (! (= (fun_app$b (comp$ ?v0 ?v1) ?v2) (fun_app$b ?v0 (fun_app$b ?v1 ?v2))) :pattern ((fun_app$b (comp$ ?v0 ?v1) ?v2)))) :named a2))
(assert (! (forall ((?v0 A_a_a_fun_fun$) (?v1 A$) (?v2 A_list$)) (! (= (foldr$a ?v0 (cons$ ?v1 ?v2)) (comp$ (fun_app$ ?v0 ?v1) (foldr$a ?v0 ?v2))) :pattern ((foldr$a ?v0 (cons$ ?v1 ?v2))))) :named a3))
(assert (! (forall ((?v0 A_a_prod_a_a_fun_fun$) (?v1 A_a_prod$) (?v2 A_a_prod_list$)) (! (= (foldr$ ?v0 (cons$a ?v1 ?v2)) (comp$ (fun_app$c ?v0 ?v1) (foldr$ ?v0 ?v2))) :pattern ((foldr$ ?v0 (cons$a ?v1 ?v2))))) :named a4))
(assert (! (and (= ys$ (cons$ y$ yss$)) (= (size$ yss$) k$)) :named a5))
(assert (! (forall ((?v0 A_a_a_a_fun_fun_fun$) (?v1 A$) (?v2 A$)) (! (= (fun_app$c (case_prod$ ?v0) (pair$ ?v1 ?v2)) (fun_app$ (fun_app$a ?v0 ?v1) ?v2)) :pattern ((fun_app$c (case_prod$ ?v0) (pair$ ?v1 ?v2))))) :named a6))
(assert (! (and (= xs$ (cons$ x$ xss$)) (= (size$ xss$) k$)) :named a7))
(check-sat)
(get-proof)
