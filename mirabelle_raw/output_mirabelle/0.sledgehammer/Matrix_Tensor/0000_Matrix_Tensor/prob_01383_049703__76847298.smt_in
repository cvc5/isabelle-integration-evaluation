; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 265
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun b$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun j$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun nat$ (Int) Nat$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (=> (less$ zero$ j$) (= (nth$ (vec_mat_Tensor$ f$ v$ (cons$ b$ n$)) (nat$ (+ (of_nat$ j$) (- 1)))) (nth$ (vec_mat_Tensor$ f$ v$ (cons$ a$ (cons$ b$ n$))) j$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$) (?v2 A_list_list$)) (! (=> (less$ zero$ ?v0) (= (nth$ (cons$ ?v1 ?v2) ?v0) (nth$ ?v2 (nat$ (+ (of_nat$ ?v0) (- 1)))))) :pattern ((nth$ (cons$ ?v1 ?v2) ?v0)))) :named a1))
(assert (! (= zero$ (nat$ 0)) :named a2))
(check-sat)
(get-proof)
