; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun x$ () A$)
(declare-fun a1$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun w1$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun times$ (A_a_a_fun_fun$ A$) A_list_a_list_fun$)
(declare-fun fun_app$ (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun fun_app$a (A_a_fun$ A$) A$)
(declare-fun fun_app$b (A_a_a_fun_fun$ A$) A_a_fun$)
(assert (! (not (= (fun_app$ (times$ f$ x$) w1$) (cons$ (fun_app$a (fun_app$b f$ x$) a1$) (fun_app$ (times$ f$ x$) u1$)))) :named conjecture0))
(assert (! (forall ((?v0 A$)) (! (= (fun_app$ (times$ f$ ?v0) nil$) nil$) :pattern ((times$ f$ ?v0)))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A$) (?v2 A_list$)) (! (= (fun_app$ (times$ f$ ?v0) (cons$ ?v1 ?v2)) (cons$ (fun_app$a (fun_app$b f$ ?v0) ?v1) (fun_app$ (times$ f$ ?v0) ?v2))) :pattern ((fun_app$ (times$ f$ ?v0) (cons$ ?v1 ?v2))))) :named a2))
(assert (! (and (= w1$ (cons$ a1$ u1$)) (= (size$ u1$) k$)) :named a3))
(check-sat)
(get-proof)
