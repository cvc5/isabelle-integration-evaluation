; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort B_list$ 0)
(declare-sort C_list$ 0)
(declare-sort Nat_nat_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () B_list$)
(declare-fun z$ () C$)
(declare-fun zs$ () C_list$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (C$ C_list$) C_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (C_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$) Nat_nat_fun$)
(declare-fun size$a (B_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (= (less$ i$ (plus$ (times$ (size$ zs$) (size$a y$)) (size$a y$))) (less$ (fun_app$ (minus$ i$) (size$a y$)) (times$ (size$ zs$) (size$a y$))))) :named conjecture0))
(assert (! (less$ (size$a y$) i$) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$ (minus$ (plus$ ?v0 ?v1)) (plus$ ?v0 ?v2)) (fun_app$ (minus$ ?v1) ?v2))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (fun_app$ (minus$ (plus$ ?v0 ?v1)) (plus$ ?v2 ?v1)) (fun_app$ (minus$ ?v0) ?v2))) :named a3))
(assert (! (=> (less$ i$ (times$ (size$ (cons$ z$ zs$)) (size$a y$))) (less$ i$ (plus$ (times$ (size$ zs$) (size$a y$)) (size$a y$)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 ?v1) (plus$ ?v1 ?v0))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (plus$ (plus$ ?v0 ?v1) ?v2) (plus$ ?v0 (plus$ ?v1 ?v2)))) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (not (= ?v0 ?v1)) (or (less$ ?v0 ?v1) (less$ ?v1 ?v0)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$) (?v3 Nat$)) (=> (and (less$ ?v0 ?v1) (less$ ?v2 ?v3)) (less$ (plus$ ?v0 ?v2) (plus$ ?v1 ?v3)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (plus$ ?v0 ?v1) ?v2) (plus$ (times$ ?v0 ?v2) (times$ ?v1 ?v2)))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ (plus$ ?v0 ?v1) ?v2) (less$ ?v0 ?v2))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 ?v1) (less$ (fun_app$ (minus$ ?v0) ?v2) ?v1))) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (less$ ?v0 ?v1)) (= (plus$ ?v1 (fun_app$ (minus$ ?v0) ?v1)) ?v0))) :named a12))
(assert (! (= (size$ (cons$ z$ zs$)) (plus$ (size$ zs$) one$)) :named a13))
(assert (! (forall ((?v0 Nat$)) (= (times$ one$ ?v0) ?v0)) :named a14))
(assert (! (not (less$ one$ one$)) :named a15))
(assert (! (forall ((?v0 Nat$)) (= (not (less$ zero$ ?v0)) (= ?v0 zero$))) :named a16))
(assert (! (forall ((?v0 Nat$)) (= (plus$ zero$ ?v0) ?v0)) :named a17))
(assert (! (forall ((?v0 Nat$)) (! (= (fun_app$ (minus$ ?v0) ?v0) zero$) :pattern ((minus$ ?v0)))) :named a18))
(assert (! (forall ((?v0 Nat$)) (= (not (= ?v0 zero$)) (less$ zero$ ?v0))) :named a19))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (fun_app$ (minus$ ?v1) (fun_app$ (minus$ ?v1) ?v0)) ?v0))) :named a20))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (plus$ ?v0 (fun_app$ (minus$ ?v1) ?v0)) ?v1))) :named a21))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ zero$ (fun_app$ (minus$ ?v0) ?v1)) (less$ ?v1 ?v0))) :named a22))
(assert (! (less_eq$ zero$ one$) :named a23))
(check-sat)
(get-proof)
