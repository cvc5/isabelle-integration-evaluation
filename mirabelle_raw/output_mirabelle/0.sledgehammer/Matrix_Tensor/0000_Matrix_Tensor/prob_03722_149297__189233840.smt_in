; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 240
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_a_fun$ 0)
(declare-sort A_list_list_a_list_fun$ 0)
(declare-sort A_list_a_fun_a_list_list_a_list_fun_fun$ 0)
(declare-fun i$ () Nat$)
(declare-fun b1$ () A_list_list$)
(declare-fun uu$ () A_list_a_fun$)
(declare-fun map$ () A_list_a_fun_a_list_list_a_list_fun_fun$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_list_a_fun$ A_list$) A$)
(declare-fun fun_app$a (A_list_list_a_list_fun$ A_list_list$) A_list$)
(declare-fun fun_app$b (A_list_a_fun_a_list_list_a_list_fun_fun$ A_list_a_fun$) A_list_list_a_list_fun$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun map_tailrec$ () A_list_a_fun_a_list_list_a_list_fun_fun$)
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ uu$ ?v0) (nth$ ?v0 (modulo$ i$ (row_length$ b1$)))) :pattern ((fun_app$ uu$ ?v0)))) :named a0))
(assert (! (not (= (size$ (fun_app$a (fun_app$b map$ uu$) b1$)) (size$a b1$))) :named conjecture1))
(assert (! (less$ (modulo$ i$ (row_length$ b1$)) (row_length$ b1$)) :named a2))
(assert (! (= map$ map_tailrec$) :named a3))
(check-sat)
(get-proof)
