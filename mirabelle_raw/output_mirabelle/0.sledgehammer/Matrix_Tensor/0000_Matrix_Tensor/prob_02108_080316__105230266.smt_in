; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 230
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_list_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun i$ () Nat$)
(declare-fun n$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun w$ () A_list$)
(declare-fun uu$ (Nat$) A_list_a_fun$)
(declare-fun w1$ () A_list$)
(declare-fun map$ (A_list_a_fun$ A_list_list$) A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun cons$a (A$ A_list$) A_list$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_list_a_fun$ A_list$) A$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (forall ((?v0 Nat$) (?v1 A_list$)) (! (= (fun_app$ (uu$ ?v0) ?v1) (nth$ ?v1 ?v0)) :pattern ((fun_app$ (uu$ ?v0) ?v1)))) :named a0))
(assert (! (not (= (row$ (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) i$) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$)))) (row$ (cons$ w$ n$) (modulo$ i$ (row_length$ (cons$ w$ n$))))))) :named conjecture1))
(assert (! (= (row$ (vec_mat_Tensor$ f$ v$ (cons$ w$ n$)) i$) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ (cons$ w$ n$)))) (row$ (cons$ w$ n$) (modulo$ i$ (size$ w$))))) :named a2))
(assert (! (= (row_length$ (cons$ w$ n$)) (size$ w$)) :named a3))
(assert (! (forall ((?v0 A_list_list$) (?v1 Nat$)) (= (row$ ?v0 ?v1) (map$ (uu$ ?v1) ?v0))) :named a4))
(assert (! (= w$ (cons$a a$ w1$)) :named a5))
(check-sat)
(get-proof)
