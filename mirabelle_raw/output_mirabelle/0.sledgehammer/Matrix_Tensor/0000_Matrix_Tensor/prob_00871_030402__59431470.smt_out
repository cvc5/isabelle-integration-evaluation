unsat
(assume conjecture1 (! (not (! (=> (! (less$ i$ (size$ y$)) :named @p_2) (! (= (nth$ (fun_app$a (fun_app$b (vec_vec_Tensor$ f$) (cons$ z$ zs$)) y$) i$) (nth$ (times$ f$ z$ y$) i$)) :named @p_1)) :named @p_3)) :named @p_4))
