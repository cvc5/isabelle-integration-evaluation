; --no-e-matching --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 269
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-sort A_list_a_list_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun id$ () A$)
(declare-fun nil$ () A_list$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun times$ (A_a_a_fun_fun$ A$ A_list$) A_list$)
(declare-fun append$ (A_list$) A_list_a_list_fun$)
(declare-fun fun_app$ (A_list_a_list_fun$ A_list$) A_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (vec_vec_Tensor$ f$ (cons$ id$ nil$) v$) v$)) :named conjecture0))
(assert (! (forall ((?v0 A_list$)) (! (= (vec_vec_Tensor$ f$ nil$ ?v0) nil$) :pattern ((vec_vec_Tensor$ f$ nil$ ?v0)))) :named a1))
(assert (! (forall ((?v0 A$) (?v1 A_list$) (?v2 A_list$)) (! (= (vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2) (fun_app$ (append$ (times$ f$ ?v0 ?v2)) (vec_vec_Tensor$ f$ ?v1 ?v2))) :pattern ((vec_vec_Tensor$ f$ (cons$ ?v0 ?v1) ?v2)))) :named a2))
(assert (! (forall ((?v0 A_list$)) (! (= (fun_app$ (append$ ?v0) nil$) ?v0) :pattern ((append$ ?v0)))) :named a3))
(check-sat)
(get-proof)
