; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 355
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun k$ () Nat$)
(declare-fun m$ () A_list_list$)
(declare-fun v$ () A_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun one$ () Nat$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(assert (! (not (= (nth$ m$ k$) (nth$ (cons$ v$ m$) (plus$ k$ one$)))) :named conjecture0))
(assert (! (less$ k$ (size$ m$)) :named hypothesis1))
(assert (! (forall ((?v0 Nat$) (?v1 A_list$) (?v2 A_list_list$)) (! (=> (less$ zero$ ?v0) (= (nth$ (cons$ ?v1 ?v2) ?v0) (nth$ ?v2 (minus$ ?v0 one$)))) :pattern ((nth$ (cons$ ?v1 ?v2) ?v0)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v1) ?v0)) :named a3))
(assert (! (less$ zero$ one$) :named a4))
(assert (! (= (size$ nil$) zero$) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (less$ zero$ (plus$ ?v0 ?v1)) (or (less$ zero$ ?v0) (less$ zero$ ?v1)))) :named a6))
(check-sat)
(get-proof)
