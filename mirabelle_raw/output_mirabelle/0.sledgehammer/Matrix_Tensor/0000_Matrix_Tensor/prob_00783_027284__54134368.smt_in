(assert (! (not (forall ((?v0 Nat$)) (= (fun_app$ (nth$ (cons$ x$ xs$)) (fun_app$a (plus$ ?v0) one$)) (fun_app$ (nth$ xs$) ?v0)))) :named conjecture0))
