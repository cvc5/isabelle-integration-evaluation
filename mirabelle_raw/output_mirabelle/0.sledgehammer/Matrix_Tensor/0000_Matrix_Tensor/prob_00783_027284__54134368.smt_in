(assert (! (forall ((?v0 Nat$)) (= (fun_app$a (plus$ zero$) ?v0) ?v0)) :named a14))
(assert (! (=> (less$ i$ (size$ (cons$ x$ xs$))) (or (less$ i$ (size$ xs$)) (= i$ (size$ xs$)))) :named a15))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (fun_app$ (nth$ (cons$ ?v0 ?v1)) zero$) ?v0) :pattern ((cons$ ?v0 ?v1)))) :named a16))
(assert (! (forall ((?v0 A_list$)) (! (= (append$ nil$ ?v0) ?v0) :pattern ((append$ nil$ ?v0)))) :named a17))
(assert (! (forall ((?v0 A$) (?v1 A_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (fun_app$a suc$ (size$ ?v1))) :pattern ((cons$ ?v0 ?v1)))) :named a18))
