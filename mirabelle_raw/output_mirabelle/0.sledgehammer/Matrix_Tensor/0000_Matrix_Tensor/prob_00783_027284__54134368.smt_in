(assert (! (forall ((?v0 Nat$)) (not (= (fun_app$a suc$ ?v0) zero$))) :named a22))
(assert (! (forall ((?v0 A_list$)) (=> (and (=> (= ?v0 nil$) false) (forall ((?v1 A$) (?v2 A_list$)) (=> (= ?v0 (cons$ ?v1 ?v2)) false))) false)) :named a23))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 Nat$)) (= (fun_app$ (nth$ (append$ ?v0 ?v1)) (fun_app$a (plus$ (size$ ?v0)) ?v2)) (fun_app$ (nth$ ?v1) ?v2))) :named a24))
