; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 255
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun a1$ () A$)
(declare-fun a2$ () A$)
(declare-fun u1$ () A_list$)
(declare-fun u2$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_prodI$ (A$ A_a_a_fun_fun$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ (cons$ a1$ u1$) (cons$ a2$ u2$)) (fun_app$ (fun_app$a g$ (fun_app$ (fun_app$a f$ a1$) a2$)) (scalar_product$ f$ zer$ g$ u1$ u2$)))) :named conjecture0))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (! (= (scalar_product$ f$ zer$ g$ ?v0 ?v1) (scalar_prodI$ zer$ g$ f$ ?v0 ?v1)) :pattern ((scalar_product$ f$ zer$ g$ ?v0 ?v1)))) :named a1))
(check-sat)
(get-proof)
