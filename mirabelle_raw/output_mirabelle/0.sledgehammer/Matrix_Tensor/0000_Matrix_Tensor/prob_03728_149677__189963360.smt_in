; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun j$ () Nat$)
(declare-fun b1$ () A_list_list$)
(declare-fun b2$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (size$ (row$ b1$ (modulo$ i$ (row_length$ b1$)))) (size$ (col$ b2$ (modulo$ j$ (size$a b2$)))))) :named conjecture0))
(assert (! (= (size$ (col$ b2$ (modulo$ j$ (size$a b2$)))) (row_length$ b2$)) :named a1))
(assert (! (= (size$a b1$) (row_length$ b2$)) :named a2))
(assert (! (= (size$ (row$ b1$ (modulo$ i$ (row_length$ b1$)))) (size$a b1$)) :named a3))
(check-sat)
(get-proof)
