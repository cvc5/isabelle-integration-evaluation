(declare-fun divide$a (Int Int) Int)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (= (of_nat$ (divide$ a$ b$)) (of_nat$ (plus$ (divide$ (minus$ a$ b$) b$) one$)))) :named conjecture0))
(assert (! (= (+ (of_nat$ x$) 1) (of_nat$ (plus$ x$ one$))) :named a1))
(assert (! (= (divide$a (of_nat$ a$) (of_nat$ b$)) (of_nat$ (divide$ a$ b$))) :named a2))
(assert (! (= (divide$a (- (of_nat$ a$) (of_nat$ b$)) (of_nat$ b$)) (of_nat$ (divide$ (minus$ a$ b$) b$))) :named a3))
(assert (! (= (divide$a (of_nat$ a$) (of_nat$ b$)) (+ (divide$a (- (of_nat$ a$) (of_nat$ b$)) (of_nat$ b$)) 1)) :named a4))
