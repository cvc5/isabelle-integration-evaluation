(assert (! (= (of_nat$ one$) 1) :named a6))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (of_nat$a (plus$ ?v0 ?v1)) (plus$ (of_nat$a ?v0) (of_nat$a ?v1)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (of_nat$ (plus$ ?v0 ?v1)) (+ (of_nat$ ?v0) (of_nat$ ?v1)))) :named a8))
