; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 357
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun b1$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list_list$)
(declare-fun nth$ (A_list_list$ Nat$) A_list$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun transpose$ (Nat$ A_list_list$) A_list_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= (size$ (row$ b1$ (modulo$ i$ (row_length$ b1$)))) (size$a b1$))) :named conjecture0))
(assert (! (less$ (modulo$ i$ (row_length$ b1$)) (row_length$ b1$)) :named a1))
(assert (! (mat$ (row_length$ b1$) (size$a b1$) b1$) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (=> (mat$ ?v0 ?v1 ?v2) (mat$ (row_length$ ?v2) (size$a ?v2) ?v2))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$) (?v3 Nat$)) (=> (and (mat$ ?v0 ?v1 ?v2) (less$ ?v3 (size$a ?v2))) (= (size$ (nth$ ?v2 ?v3)) (row_length$ ?v2)))) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$) (?v3 Nat$) (?v4 Nat$)) (=> (and (mat$ ?v0 ?v1 ?v2) (and (mat$ ?v3 ?v4 ?v2) (not (= ?v2 nil$)))) (= ?v0 ?v3))) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$) (?v3 Nat$) (?v4 Nat$)) (=> (and (mat$ ?v0 ?v1 ?v2) (and (mat$ ?v3 ?v4 ?v2) (not (= ?v2 nil$)))) (= ?v1 ?v4))) :named a6))
(assert (! (forall ((?v0 A_list_list$) (?v1 Nat$)) (! (= (col$ ?v0 ?v1) (nth$ ?v0 ?v1)) :pattern ((col$ ?v0 ?v1)))) :named a7))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$) (?v3 Nat$)) (=> (and (mat$ ?v0 ?v1 ?v2) (less$ ?v3 ?v0)) (= (col$ (transpose$ ?v0 ?v2) ?v3) (row$ ?v2 ?v3)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (=> (and (mat$ ?v0 ?v1 ?v2) (= ?v2 nil$)) (= ?v1 zero$))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (=> (mat$ ?v0 ?v1 ?v2) (mat$ ?v1 ?v0 (transpose$ ?v0 ?v2)))) :named a10))
(assert (! (forall ((?v0 Nat$)) (not (less$ ?v0 zero$))) :named a11))
(check-sat)
(get-proof)
