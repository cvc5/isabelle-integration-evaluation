(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (modulo$ (plus$ (times$ ?v0 ?v1) ?v2) ?v0) (modulo$ ?v2 ?v0))) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (plus$ ?v1 (times$ ?v0 ?v2)) ?v0) (plus$ ?v2 (divide$ ?v1 ?v0))))) :named a19))
