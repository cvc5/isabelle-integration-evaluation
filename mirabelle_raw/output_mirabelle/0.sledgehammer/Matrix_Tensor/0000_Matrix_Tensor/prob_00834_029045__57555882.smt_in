; --finite-model-find --e-matching --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 247
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort C$ 0)
(declare-sort Nat$ 0)
(declare-sort C_list$ 0)
(declare-fun z$ () C$)
(declare-fun zs$ () C_list$)
(declare-fun nil$ () C_list$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (C$ C_list$) C_list$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (C_list$) Nat$)
(declare-fun zero$ () Nat$)
(assert (! (not (= (size$ (cons$ z$ zs$)) (plus$ (size$ zs$) one$))) :named conjecture0))
(assert (! (forall ((?v0 C$) (?v1 C_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a1))
(assert (! (= (size$ nil$) zero$) :named a2))
(check-sat)
(get-proof)
