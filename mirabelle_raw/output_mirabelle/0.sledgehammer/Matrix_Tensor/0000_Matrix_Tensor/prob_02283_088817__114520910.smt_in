(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (row$ (tensor$ f$ (cons$ v$ m$) m2$) i$) (append$ (times$ f$ (nth$ v$ (divide$ i$ (row_length$ m2$))) (row$ m2$ (modulo$ i$ (row_length$ m2$)))) (vec_vec_Tensor$ f$ (row$ m$ (divide$ i$ (row_length$ m2$))) (row$ m2$ (modulo$ i$ (row_length$ m2$))))))) :named conjecture0))
(assert (! (= (row$ (vec_mat_Tensor$ f$ v$ m2$) i$) (times$ f$ (nth$ v$ (divide$ i$ (row_length$ m2$))) (row$ m2$ (modulo$ i$ (row_length$ m2$))))) :named a1))
(assert (! (= (row$ (tensor$ f$ m$ m2$) i$) (vec_vec_Tensor$ f$ (row$ m$ (divide$ i$ (row_length$ m2$))) (row$ m2$ (modulo$ i$ (row_length$ m2$))))) :named a2))
(assert (! (= m$ (cons$ w$ n$)) :named a3))
(assert (! (= (row$ (tensor$ f$ (cons$ v$ m$) m2$) i$) (row$ (append$a (vec_mat_Tensor$ f$ v$ m2$) (tensor$ f$ m$ m2$)) i$)) :named a4))
(assert (! (= (row$ (append$a (vec_mat_Tensor$ f$ v$ m2$) (tensor$ f$ m$ m2$)) i$) (append$ (row$ (vec_mat_Tensor$ f$ v$ m2$) i$) (row$ (tensor$ f$ m$ m2$) i$))) :named a5))
