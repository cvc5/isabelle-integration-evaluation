(assert (! (forall ((?v0 B_list_list$)) (! (= (fun_app$a (append$ ?v0) nil$) ?v0) :pattern ((append$ ?v0)))) :named a2))
(assert (! (forall ((?v0 B_list$)) (! (= (fun_app$b (append$a ?v0) nil$a) ?v0) :pattern ((append$a ?v0)))) :named a3))
