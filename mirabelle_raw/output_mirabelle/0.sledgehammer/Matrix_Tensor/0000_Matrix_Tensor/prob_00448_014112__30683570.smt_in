(assert (! (= (vec_mat_Tensor$ f$ v$ nil$) nil$) :named a7))
(assert (! (= (row_length$ nil$) zero$) :named a8))
(assert (! (mat$ (row_length$ nil$) (size$b nil$) nil$) :named a9))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (= (row_length$ (vec_mat_Tensor$ f$ ?v0 ?v1)) (times$ (size$ ?v0) (row_length$ ?v1)))) :named a10))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a11))
(check-sat)
