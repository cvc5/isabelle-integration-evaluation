(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun matrix_match$ (A_list_list$ A_list_list$ A_list_list$ A_list_list$) Bool)
(assert (! (not (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (less$ ?v0 (times$ (row_length$ a1$) (row_length$ b1$))) (less$ ?v1 (times$ (size$ a2$) (size$ b2$)))) (= (size$a (row$ a1$ (divide$ ?v0 (row_length$ b1$)))) (size$a (col$ a2$ (divide$ ?v1 (size$ b2$)))))))) :named conjecture0))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$) (?v2 A_list_list$) (?v3 A_list_list$)) (! (= (matrix_match$ ?v0 ?v1 ?v2 ?v3) (and (mat$ (row_length$ ?v0) (size$ ?v0) ?v0) (and (mat$ (row_length$ ?v1) (size$ ?v1) ?v1) (and (mat$ (row_length$ ?v2) (size$ ?v2) ?v2) (and (mat$ (row_length$ ?v3) (size$ ?v3) ?v3) (and (= (size$ ?v0) (row_length$ ?v1)) (and (= (size$ ?v2) (row_length$ ?v3)) (and (not (= ?v0 nil$)) (and (not (= ?v1 nil$)) (and (not (= ?v2 nil$)) (not (= ?v3 nil$)))))))))))) :pattern ((matrix_match$ ?v0 ?v1 ?v2 ?v3)))) :named a1))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$) (?v2 A_list_list$) (?v3 A_list_list$) (?v4 Nat$) (?v5 Nat$)) (=> (and (mat$ (row_length$ ?v0) (size$ ?v0) ?v0) (and (mat$ (row_length$ ?v1) (size$ ?v1) ?v1) (and (mat$ (row_length$ ?v2) (size$ ?v2) ?v2) (and (mat$ (row_length$ ?v3) (size$ ?v3) ?v3) (and (= (size$ ?v0) (row_length$ ?v1)) (and (= (size$ ?v2) (row_length$ ?v3)) (and (and (not (= ?v0 nil$)) (and (not (= ?v1 nil$)) (and (not (= ?v2 nil$)) (not (= ?v3 nil$))))) (and (less$ ?v4 (times$ (row_length$ ?v0) (row_length$ ?v2))) (less$ ?v5 (times$ (size$ ?v1) (size$ ?v3))))))))))) (= (size$a (row$ ?v0 (divide$ ?v4 (row_length$ ?v2)))) (size$a (col$ ?v1 (divide$ ?v5 (size$ ?v3))))))) :named a2))
(check-sat)
(get-proof)
