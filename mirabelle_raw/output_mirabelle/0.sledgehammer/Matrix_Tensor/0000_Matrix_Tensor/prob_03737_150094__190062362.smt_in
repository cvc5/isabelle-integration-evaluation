; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 362
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-fun a1$ () A_list_list$)
(declare-fun a2$ () A_list_list$)
(declare-fun b1$ () A_list_list$)
(declare-fun b2$ () A_list_list$)
(declare-fun col$ (A_list_list$ Nat$) A_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list_list$)
(declare-fun row$ (A_list_list$ Nat$) A_list$)
