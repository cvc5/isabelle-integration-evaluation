unsat
(assume conjecture0 (! (not b$) :named @p_1))
(assume a11 (! (=> a$ b$) :named @p_2))
(assume a12 (! (=> (! (not a$) :named @p_3) b$) :named @p_4))
(step t0 (cl (not (! (= (! (or (! (not @p_3) :named @p_6) b$) :named @p_7) (! (or a$ b$) :named @p_5)) :named @p_8)) (not @p_7) @p_5) :rule equiv_pos2)
(step t1 (cl (= @p_6 a$)) :rule rare_rewrite :args ("bool-double-not-elim" a$))
(step t2 (cl (= b$ b$)) :rule refl)
(step t3 (cl @p_8) :rule cong :premises (t1 t2))
(step t4 (cl @p_6 b$) :rule implies :premises (a12))
