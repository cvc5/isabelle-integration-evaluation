(assert (! (less_eq$ (size$ m2$) j$) :named a1))
(assert (! (=> (less_eq$ (size$ m2$) j$) (less$ (minus$ j$ (size$ m2$)) (times$ (size$ m$) (size$ m2$)))) :named a2))
(assert (! (forall ((?v0 A_list_list$) (?v1 Nat$) (?v2 A_list$) (?v3 A_list_list$)) (=> (and (less$ (size$ ?v0) ?v1) (less$ ?v1 (times$ (size$ (cons$ ?v2 ?v3)) (size$ ?v0)))) (less$ (minus$ ?v1 (size$ ?v0)) (times$ (size$ ?v3) (size$ ?v0))))) :named a3))
(assert (! (less$ j$ (plus$ (size$ m2$) (times$ (size$ m$) (size$ m2$)))) :named a4))
(assert (! (forall ((?v0 A$) (?v1 A$)) (= (f$ ?v0 ?v1) (f$ ?v1 ?v0))) :named a5))
(assert (! (forall ((?v0 A_list_list$) (?v1 Nat$) (?v2 A_list$) (?v3 A_list_list$)) (=> (and (less$ (size$ ?v0) ?v1) (less$ ?v1 (times$ (size$ (cons$ ?v2 ?v3)) (size$ ?v0)))) (less$ (minus$ ?v1 (size$ ?v0)) (times$ (size$ ?v3) (size$ ?v0))))) :named a6))
(assert (! (=> (less_eq$ (size$ m2$) j$) (= (modulo$ (minus$ j$ (size$ m2$)) (size$ m2$)) (modulo$ j$ (size$ m2$)))) :named a7))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (size$ (cons$ ?v0 ?v1)) (plus$ (size$ ?v1) (suc$ zero$))) :pattern ((cons$ ?v0 ?v1)))) :named a8))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 ?v1) (plus$ ?v1 ?v0))) :named a9))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ (minus$ ?v0 ?v1) ?v2) (minus$ (times$ ?v0 ?v2) (times$ ?v1 ?v2)))) :named a10))
(assert (! (forall ((?v0 Nat$)) (= (plus$ ?v0 zero$) ?v0)) :named a11))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (and (less$ ?v0 ?v1) (less$ ?v0 ?v2)) (less$ (minus$ ?v2 ?v1) (minus$ ?v2 ?v0)))) :named a12))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (times$ ?v0 (minus$ ?v1 ?v2)) (minus$ (times$ ?v0 ?v1) (times$ ?v0 ?v2)))) :named a13))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (less$ (minus$ ?v1 ?v0) ?v2) (less$ ?v1 (plus$ ?v2 ?v0))))) :named a14))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less$ ?v0 ?v1) (less$ (minus$ ?v0 ?v2) ?v1))) :named a15))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (modulo$ ?v1 ?v0) (modulo$ (minus$ ?v1 ?v0) ?v0)))) :named a16))
(assert (! (= one$ (suc$ zero$)) :named a17))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (plus$ ?v0 ?v1) (plus$ ?v0 ?v2)) (less$ ?v1 ?v2))) :named a18))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))) :named a19))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a20))
(assert (! (forall ((?v0 A_list_list_bool_fun$) (?v1 A_list_list$)) (=> (forall ((?v2 A_list_list$)) (=> (forall ((?v3 A_list_list$)) (=> (less$ (size$ ?v3) (size$ ?v2)) (fun_app$ ?v0 ?v3))) (fun_app$ ?v0 ?v2))) (fun_app$ ?v0 ?v1))) :named a21))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ ?v0 (minus$ ?v1 ?v2)) (less$ (plus$ ?v0 ?v2) ?v1))) :named a22))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less$ ?v0 ?v1) (= (modulo$ ?v1 ?v0) (modulo$ (minus$ ?v1 ?v0) ?v0)))) :named a23))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$) (?v2 A_list$) (?v3 A_list_list$)) (= (= (cons$ ?v0 ?v1) (cons$ ?v2 ?v3)) (and (= ?v0 ?v2) (= ?v1 ?v3)))) :named a24))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (times$ ?v0 ?v1) zero$) (or (= ?v0 zero$) (= ?v1 zero$)))) :named a25))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (minus$ ?v1 (minus$ ?v1 ?v0)) ?v0))) :named a26))
(check-sat)
(get-proof)
