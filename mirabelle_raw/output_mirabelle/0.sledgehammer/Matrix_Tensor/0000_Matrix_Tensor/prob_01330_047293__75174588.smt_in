; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 274
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun v$ () A_list$)
(declare-fun ma$ () A_list_list$)
(declare-fun mat$ (Nat$ Nat$ A_list_list$) Bool)
(declare-fun nil$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun nth$a (A_list_list$ Nat$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun size$a (A_list_list$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun row_length$ (A_list_list$) Nat$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (forall ((?v0 Nat$)) (=> (less$ ?v0 (times$ (size$ a$) (size$ v$))) (= (nth$ (vec_vec_Tensor$ f$ v$ a$) ?v0) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ ?v0 (size$ a$)))) (nth$ a$ (modulo$ ?v0 (size$ a$)))))))) :named conjecture0))
(assert (! (not (= a$ nil$)) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$)) (=> (not (= ?v0 nil$)) (forall ((?v2 Nat$)) (=> (less$ ?v2 (times$ (size$ ?v1) (size$ ?v0))) (= (nth$ (vec_vec_Tensor$ f$ ?v1 ?v0) ?v2) (fun_app$ (fun_app$a f$ (nth$ ?v1 (divide$ ?v2 (size$ ?v0)))) (nth$ ?v0 (modulo$ ?v2 (size$ ?v0))))))))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (and (and (less$ ?v0 (times$ (size$ v$) (row_length$ ma$))) (less$ ?v1 (size$a ma$))) (mat$ (row_length$ ma$) (size$a ma$) ma$)) (= (nth$ (nth$a (vec_mat_Tensor$ f$ v$ ma$) ?v1) ?v0) (fun_app$ (fun_app$a f$ (nth$ v$ (divide$ ?v0 (row_length$ ma$)))) (nth$ (nth$a ma$ ?v1) (modulo$ ?v0 (row_length$ ma$))))))) :named a4))
(check-sat)
(get-proof)
