; --decision=internal --simplification=none --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 313
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A_list$ 0)
(declare-sort A_list_list$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun a$ () A_list$)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun m2$ () A_list_list$)
(declare-fun m1a$ () A_list_list$)
(declare-fun nil$ () A_list_list$)
(declare-fun cons$ (A_list$ A_list_list$) A_list_list$)
(declare-fun append$ (A_list_list$ A_list_list$) A_list_list$)
(declare-fun tensor$ (A_a_a_fun_fun$ A_list_list$ A_list_list$) A_list_list$)
(declare-fun vec_mat_Tensor$ (A_a_a_fun_fun$ A_list$ A_list_list$) A_list_list$)
(assert (! (not (= (tensor$ f$ (cons$ a$ m1a$) m2$) (vec_mat_Tensor$ f$ a$ m2$))) :named conjecture0))
(assert (! (= m1a$ nil$) :named a1))
(assert (! (forall ((?v0 A_list_list$)) (! (= (tensor$ f$ nil$ ?v0) nil$) :pattern ((tensor$ f$ nil$ ?v0)))) :named a2))
(assert (! (forall ((?v0 A_list_list$) (?v1 A_list_list$)) (= (= (append$ ?v0 ?v1) ?v0) (= ?v1 nil$))) :named a3))
(check-sat)
(get-proof)
