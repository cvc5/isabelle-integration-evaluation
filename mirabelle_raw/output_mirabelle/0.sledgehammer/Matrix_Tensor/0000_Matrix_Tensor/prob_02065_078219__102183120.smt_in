(declare-fun concat$c (A_list_list$) A_list$)
(declare-fun row_length$ (A_list_list$) Nat$)
(assert (! (not (= nr$ (size$ w$))) :named conjecture0))
(assert (! (mat$ nr$ (size$a (cons$ w$ n$)) (cons$ w$ n$)) :named hypothesis1))
(assert (! (= (row_length$ (cons$ w$ n$)) (size$ w$)) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 A_list_list$)) (=> (mat$ ?v0 ?v1 ?v2) (mat$ (row_length$ ?v2) (size$a ?v2) ?v2))) :named a3))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (! (= (reduct$ (cons$ ?v0 ?v1)) ?v1) :pattern ((cons$ ?v0 ?v1)))) :named a4))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= (cons$ ?v0 ?v1) ?v1))) :named a5))
(assert (! (= (reduct$ nil$) nil$) :named a6))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (member$ ?v0 (set$ (cons$ ?v0 ?v1)))) :named a7))
