(declare-fun less$ (Nat$ Nat$) Bool)
(declare-fun plus$ (Nat$) Nat_nat_fun$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun of_nat$ (Nat$) Int)
(declare-fun fun_app$ (Nat_nat_fun$ Nat$) Nat$)
(declare-fun of_nat$a (Nat$) Nat$)
(assert (! (not (=> (less$ zero$ j$) (= (less$ (nat$ (+ (of_nat$ j$) (- 1))) (size$ (cons$ b$ n$))) (less$ j$ (size$ (cons$ a$ (cons$ b$ n$))))))) :named conjecture0))
(assert (! (=> (and (less$ zero$ j$) (less$ (nat$ (+ (of_nat$ j$) (- 1))) (size$ (cons$ b$ n$)))) (less$ (fun_app$ (plus$ (nat$ (+ (of_nat$ j$) (- 1)))) one$) (size$ (cons$ a$ (cons$ b$ n$))))) :named a1))
(assert (! (forall ((?v0 Nat$)) (= (less$ zero$ (of_nat$a ?v0)) (less$ zero$ ?v0))) :named a2))
(assert (! (forall ((?v0 Nat$)) (= (< 0 (of_nat$ ?v0)) (less$ zero$ ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$)) (= (nat$ (of_nat$ ?v0)) ?v0)) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (less$ (fun_app$ (plus$ ?v0) ?v1) (fun_app$ (plus$ ?v0) ?v2)) (less$ ?v1 ?v2))) :named a5))
(assert (! (= (plus$ one$) suc$) :named a6))
(assert (! (forall ((?v0 Int)) (=> (<= 0 ?v0) (= (fun_app$ suc$ (nat$ ?v0)) (nat$ (+ 1 ?v0))))) :named a7))
(check-sat)
(get-proof)
