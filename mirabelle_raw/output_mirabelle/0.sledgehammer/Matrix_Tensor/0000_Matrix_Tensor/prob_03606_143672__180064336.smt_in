; --trigger-sel=max --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 228
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun v1$ () A_list$)
(declare-fun v2$ () A_list$)
(declare-fun w1$ () A_list$)
(declare-fun w2$ () A_list$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun zer$ () A$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(declare-fun vec_vec_Tensor$ (A_a_a_fun_fun$ A_list$ A_list$) A_list$)
(assert (! (not (= (size$ v2$) (suc$ k$))) :named conjecture0))
(assert (! (and (= (size$ v1$) (size$ v2$)) (and (= (size$ v1$) (suc$ k$)) (= (size$ w1$) (size$ w2$)))) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list$) (?v3 A_list$)) (=> (and (= (size$ ?v0) (size$ ?v1)) (and (= (size$ ?v0) k$) (= (size$ ?v2) (size$ ?v3)))) (= (fun_app$ (fun_app$a f$ (scalar_product$ f$ zer$ g$ ?v0 ?v1)) (scalar_product$ f$ zer$ g$ ?v2 ?v3)) (scalar_product$ f$ zer$ g$ (vec_vec_Tensor$ f$ ?v0 ?v2) (vec_vec_Tensor$ f$ ?v1 ?v3))))) :named a2))
(check-sat)
(get-proof)
