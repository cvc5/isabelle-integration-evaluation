; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 253
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-sort A_a_fun$ 0)
(declare-sort A_a_a_fun_fun$ 0)
(declare-fun f$ () A_a_a_fun_fun$)
(declare-fun g$ () A_a_a_fun_fun$)
(declare-fun k$ () Nat$)
(declare-fun ws$ () A_list$)
(declare-fun zs$ () A_list$)
(declare-fun xss$ () A_list$)
(declare-fun yss$ () A_list$)
(declare-fun zer$ () A$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun append$ (A_list$ A_list$) A_list$)
(declare-fun fun_app$ (A_a_fun$ A$) A$)
(declare-fun fun_app$a (A_a_a_fun_fun$ A$) A_a_fun$)
(declare-fun scalar_product$ (A_a_a_fun_fun$ A$ A_a_a_fun_fun$ A_list$ A_list$) A$)
(assert (! (not (= (scalar_product$ f$ zer$ g$ (append$ xss$ zs$) (append$ yss$ ws$)) (fun_app$ (fun_app$a g$ (scalar_product$ f$ zer$ g$ xss$ yss$)) (scalar_product$ f$ zer$ g$ zs$ ws$)))) :named conjecture0))
(assert (! (and (= (size$ xss$) (size$ yss$)) (= (size$ xss$) k$)) :named a1))
(assert (! (forall ((?v0 A_list$) (?v1 A_list$) (?v2 A_list$) (?v3 A_list$)) (=> (and (= (size$ ?v0) (size$ ?v1)) (and (= (size$ ?v2) (size$ ?v3)) (= (size$ ?v2) k$))) (= (scalar_product$ f$ zer$ g$ (append$ ?v2 ?v0) (append$ ?v3 ?v1)) (fun_app$ (fun_app$a g$ (scalar_product$ f$ zer$ g$ ?v2 ?v3)) (scalar_product$ f$ zer$ g$ ?v0 ?v1))))) :named a2))
(check-sat)
(get-proof)
