; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 655
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-sort A_list_list$ 0)
(declare-fun j$ () Nat$)
(declare-fun m2$ () A_list_list$)
(declare-fun one$ () Nat$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun size$ (A_list_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun less_eq$ (Nat$ Nat$) Bool)
(assert (! (not (=> (less_eq$ (size$ m2$) j$) (= (divide$ (minus$ j$ (size$ m2$)) (size$ m2$)) (minus$ (divide$ j$ (size$ m2$)) one$)))) :named conjecture0))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (=> (less_eq$ ?v0 ?v1) (= (= (minus$ ?v1 ?v0) ?v2) (= ?v1 (plus$ ?v2 ?v0))))) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (=> (not (= ?v0 zero$)) (= (divide$ (plus$ ?v0 ?v1) ?v0) (plus$ (divide$ ?v1 ?v0) one$)))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (minus$ (plus$ ?v0 ?v1) ?v0) ?v1)) :named a3))
(assert (! (forall ((?v0 Nat$)) (= (minus$ zero$ ?v0) zero$)) :named a4))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 ?v1) (plus$ ?v1 ?v0))) :named a5))
(assert (! (forall ((?v0 Nat$)) (= (divide$ ?v0 zero$) zero$)) :named a6))
(check-sat)
(get-proof)
