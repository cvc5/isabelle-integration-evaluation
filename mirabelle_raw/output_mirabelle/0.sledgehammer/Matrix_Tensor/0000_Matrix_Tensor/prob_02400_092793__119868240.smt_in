; --term-db-mode=relevant --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 265
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun zero$ () Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (= (divide$ (modulo$ a$ (times$ b$ c$)) c$) (modulo$ (divide$ a$ c$) b$))) :named conjecture0))
(assert (! (= (times$ b$ c$) zero$) :named a1))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$) (?v2 Nat$)) (= (divide$ ?v0 (times$ ?v1 ?v2)) (divide$ (divide$ ?v0 ?v1) ?v2))) :named a2))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a3))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (= (modulo$ ?v0 ?v1) ?v0) (= (divide$ ?v0 ?v1) zero$))) :named a4))
(check-sat)
(get-proof)
