; --relevant-triggers --full-saturate-quant --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 30000
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort A_list$ 0)
(declare-fun i$ () Nat$)
(declare-fun y$ () A_list$)
(declare-fun z$ () A$)
(declare-fun zs$ () A_list$)
(declare-fun nil$ () A_list$)
(declare-fun nth$ (A_list$ Nat$) A$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun cons$ (A$ A_list$) A_list$)
(declare-fun size$ (A_list$) Nat$)
(declare-fun zero$ () Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(assert (! (not (=> (= i$ (size$ y$)) (= (nth$ (cons$ z$ zs$) (divide$ i$ (size$ y$))) (nth$ zs$ zero$)))) :named conjecture0))
(assert (! (= (nth$ (cons$ z$ zs$) one$) (nth$ zs$ zero$)) :named a1))
(assert (! (=> (= i$ (size$ y$)) (= (divide$ i$ (size$ y$)) one$)) :named a2))
(assert (! (= one$ (suc$ zero$)) :named a3))
(assert (! (= (size$ nil$) zero$) :named a4))
(check-sat)
(get-proof)
