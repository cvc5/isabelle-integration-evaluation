; --full-saturate-quant --inst-when=full-last-call --inst-no-entail --term-db-mode=relevant --multi-trigger-linear --proof-format-mode=alethe --proof-granularity=dsl-rewrite --full-saturate-quant --proof-mode=full-proof-strict --no-stats --sat-random-seed=1 --lang=smt2 --proof-prune --proof-prune-input --proof-elim-subtypes --proof-alethe-define-skolems --proof-format-mode=alethe --tlimit 225
(set-option :produce-proofs true)
(set-logic AUFLIRA)
(declare-sort Nat$ 0)
(declare-fun a$ () Nat$)
(declare-fun b$ () Nat$)
(declare-fun c$ () Nat$)
(declare-fun x$ () Nat$)
(declare-fun y$ () Nat$)
(declare-fun dvd$ (Nat$ Nat$) Bool)
(declare-fun minus$ (Nat$ Nat$) Nat$)
(declare-fun times$ (Nat$ Nat$) Nat$)
(declare-fun divide$ (Nat$ Nat$) Nat$)
(declare-fun modulo$ (Nat$ Nat$) Nat$)
(assert (! (not (dvd$ b$ (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$)))) :named conjecture0))
(assert (! (= (times$ (minus$ x$ y$) b$) (minus$ (modulo$ (divide$ a$ c$) b$) (divide$ (modulo$ a$ (times$ b$ c$)) c$))) :named a1))
(check-sat)
(get-proof)
