(assert (! (not (= (size$ (tensor$ f$ (cons$ a$ m1a$) m2$)) (times$ (size$ (cons$ a$ m1a$)) (size$ m2$)))) :named conjecture0))
(assert (! (= (size$ (tensor$ f$ (cons$ a$ m1a$) m2$)) (size$ (append$ (vec_mat_Tensor$ f$ a$ m2$) (tensor$ f$ m1a$ m2$)))) :named a1))
(assert (! (= (size$ (append$ (vec_mat_Tensor$ f$ a$ m2$) (tensor$ f$ m1a$ m2$))) (times$ (fun_app$ (plus$ one$) (size$ m1a$)) (size$ m2$))) :named a2))
(assert (! (forall ((?v0 A_list$) (?v1 A_list_list$)) (not (= nil$ (cons$ ?v0 ?v1)))) :named a3))
(assert (! (forall ((?v0 A_list_list$)) (=> (not (= ?v0 nil$)) (= (fun_app$ (plus$ (size$ (reduct$ ?v0))) one$) (size$ ?v0)))) :named a4))
(assert (! (= (plus$ one$) suc$) :named a5))
(assert (! (forall ((?v0 Nat$) (?v1 Nat$)) (= (times$ ?v0 ?v1) (times$ ?v1 ?v0))) :named a6))
(assert (! (forall ((?v0 Nat$)) (= (fun_app$ suc$ ?v0) (fun_app$ (plus$ ?v0) one$))) :named a7))
(assert (! (= (numeral$ one$a) one$) :named a8))
(check-sat)
(get-proof)
