unsat
(
(assume a55 (! (not (! (= (! (fun_app$y (foldl$ step$ s_0$) (fun_app$z (fun_app$aa map$c fst$) xps$)) :named @p_1) @p_1) :named @p_2)) :named @p_3))
(step t0 (cl (not (! (= @p_3 false) :named @p_4)) (not @p_3) false) :rule equiv_pos2)
(step t1 (cl (= @p_2 true)) :rule rare_rewrite :args ("eq-refl" @p_1))
(step t2 (cl (= @p_3 (! (not true) :named @p_5))) :rule cong :premises (t1))
(step t3 (cl (= @p_5 false)) :rule evaluate)
(step t4 (cl @p_4) :rule trans :premises (t2 t3))
(step t5 (cl false) :rule resolution :premises (t0 t4 a55))
(step t6 (cl (not false)) :rule false)
